---
pagination: { data: locales, size: 1, alias: loc }
permalink: "{{ loc.dir }}docs/index.html"
layout: layouts/base.njk
isDocs: true
---
{#
  The same sheet at a smaller billing: the running order sits in the left
  margin, the body is the tail block of facts.
#}
<div class="band invert">
  <div class="docs">
    <aside class="docs-side">
      {%- for g in t.docs.groups %}
      <nav class="docs-group">
        <span class="docs-group-h t-3xs">{{ g.label }}</span>
        {%- for it in g.items %}
        <a class="t-2xs" href="#{{ it[0] }}">{{ it[1] }}</a>
        {%- endfor %}
      </nav>
      {%- endfor %}
    </aside>

    <div class="docs-body">
      <header class="docs-lede">
        <h1 class="t-l">{{ t.docs.title }}</h1>
        <p class="t-s measure">{{ t.docs.intro }}</p>
      </header>

      {%- for s in t.docs.sections %}
      <section id="{{ s.id }}" class="docs-section">
        <h2 class="t-m">{{ s.h }}</h2>
        {%- for b in s.blocks %}
          {%- if b.p %}<p class="docs-p t-xs measure">{{ b.p | safe }}</p>
          {%- elif b.code %}<pre class="docs-code"><code>{{ b.code }}</code></pre>
          {%- elif b.table %}
          <div class="docs-table">
            {%- for row in b.table %}
            <div class="docs-row"><span class="docs-k t-xs">{{ row[0] | safe }}</span><span class="docs-v t-xs">{{ row[1] | safe }}</span></div>
            {%- endfor %}
          </div>
          {%- endif %}
        {%- endfor %}
      </section>
      {%- endfor %}
    </div>
  </div>
</div>
