---
pagination: { data: locales, size: 1, alias: loc }
permalink: "{{ loc.dir }}docs/index.html"
layout: layouts/base.njk
isDocs: true
---
<div class="docs">
  <aside class="docs-side">
    {%- for g in t.docs.groups %}
    <div class="docs-group">
      <span class="docs-group-h">{{ g.label }}</span>
      {%- for it in g.items %}
      <a href="#{{ it[0] }}">{{ it[1] }}</a>
      {%- endfor %}
    </div>
    {%- endfor %}
  </aside>

  <div class="docs-body">
    <header class="docs-lede">
      <span class="eyebrow">{{ t.docs.eyebrow }}</span>
      <h1>{{ t.docs.title }}</h1>
      <p class="lead" style="font-size:17px">{{ t.docs.intro }}</p>
    </header>

    {%- for s in t.docs.sections %}
    <section id="{{ s.id }}" class="docs-section">
      <h2>{{ s.h }}</h2>
      {%- for b in s.blocks %}
        {%- if b.p %}<p class="docs-p">{{ b.p | safe }}</p>
        {%- elif b.code %}<pre class="docs-code"><code>{{ b.code }}</code></pre>
        {%- elif b.table %}
        <div class="docs-table">
          {%- for row in b.table %}
          <div class="docs-row"><span class="docs-k">{{ row[0] }}</span><span class="docs-v">{{ row[1] | safe }}</span></div>
          {%- endfor %}
        </div>
        {%- endif %}
      {%- endfor %}
    </section>
    {%- endfor %}
  </div>
</div>
