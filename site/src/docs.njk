---
pagination: { data: locales, size: 1, alias: loc, addAllPagesToCollections: true }
permalink: "{{ loc.dir }}docs/index.html"
layout: layouts/base.njk
isDocs: true
tags: sitemap
---
{% from "partials/guide_label.njk" import guideLabel %}
<div class="band">
  <div class="sheet docs-hub">
    <header class="docs-lede">
      <h1 class="t-l">{{ t.docs.title }}</h1>
      <p class="t-s measure">{{ t.docs.intro }}</p>
      <p class="t-2xs dim">{{ t.docs.startHere }} <a href="/{{ locale.dir }}docs/{{ guides[0].slug }}/">{{ guides[0][locale.code].title }}</a></p>
    </header>
    <div class="guide-list">
      {% for entry in guides %}
      {% set text = entry[locale.code] %}
      <section class="guide-card">
        <h2 class="t-m"><a class="guide-link" href="/{{ locale.dir }}docs/{{ entry.slug }}/">{{ guideLabel(entry, locale, t.docs.experimental, 23) }}</a></h2>
        <p class="t-xs measure">{{ text.description }}</p>
        <ul class="guide-topics t-2xs">
          {% for section in t.docs.sections | guideSections(entry.sections) %}
          <li id="{{ section.id }}"><a href="/{{ locale.dir }}docs/{{ entry.slug }}/#{{ section.id }}">{{ section.h }}</a></li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    </div>
  </div>
</div>
