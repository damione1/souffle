<!doctype html>
<html lang="{{ t.htmlLang }}">
<head>
  <meta charset="utf-8">
  {% include "partials/analytics.njk" %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle | escape }}</title>
  <meta name="description" content="{{ pageDescription | escape }}">
  {% if isNotFound %}<meta name="robots" content="noindex">{% endif %}
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/souffle-logo.svg" type="image/svg+xml" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="{{ '/css/site.css' | bust }}">
  {% if isHome %}<link rel="stylesheet" href="{{ '/css/mocks.css' | bust }}">{% endif %}
  {% if not isNotFound %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% for language in locales %}
  <link rel="alternate" hreflang="{{ language.code }}" href="{{ site.url }}/{{ language.dir }}{{ translationPath }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/{{ translationPath }}">
  {% endif %}
  <meta property="og:title" content="{{ pageTitle | escape }}">
  <meta property="og:description" content="{{ pageDescription | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-{{ t.htmlLang }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ t.meta.imageAlt }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ 'fr_CA' if t.htmlLang == 'fr' else 'en_US' }}">
  <meta property="og:locale:alternate" content="{{ 'en_US' if t.htmlLang == 'fr' else 'fr_CA' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle | escape }}">
  <meta name="twitter:description" content="{{ pageDescription | escape }}">
  <meta name="twitter:image" content="{{ site.url }}/og-{{ t.htmlLang }}.png">
  <meta name="twitter:image:alt" content="{{ t.meta.imageAlt }}">
  {%- if isHome %}
  {% set app = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": site.url + "/#software",
    "name": site.name,
    "description": t.meta.description,
    "url": site.url + page.url,
    "image": site.url + "/og-" + t.htmlLang + ".png",
    "operatingSystem": "macOS 13.0 or later",
    "processorRequirements": "Apple Silicon (ARM64)",
    "applicationCategory": "BusinessApplication",
    "offers": { "@type": "Offer", "price": 0 },
    "sameAs": [site.repo],
    "license": site.license,
    "downloadUrl": site.latest,
    "author": { "@type": "Person", "name": site.author, "url": site.authorUrl },
    "inLanguage": t.htmlLang
  } %}
  <script type="application/ld+json">{{ app | jsonld | safe }}</script>
  {%- endif %}
  {% if isContact %}<link rel="stylesheet" href="{{ '/css/contact.css' | bust }}">{% endif %}
</head>
<body>
  {% include "partials/nav.njk" %}
  <main>{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/site.js' | bust }}" defer></script>
  {% if isHome %}<script src="{{ '/js/mocks.js' | bust }}" defer></script>{% endif %}
  {% if isContact %}<script src="{{ '/js/contact.js' | bust }}" defer></script>{% endif %}
</body>
</html>
