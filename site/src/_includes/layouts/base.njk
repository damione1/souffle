<!doctype html>
<html lang="{{ t.htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle or t.meta.title }}</title>
  <meta name="description" content="{{ t.meta.description }}">
  <link rel="icon" href="/souffle-logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/mocks.css">
  <link rel="alternate" hreflang="en" href="/">
  <link rel="alternate" hreflang="fr" href="/fr/">
  <meta property="og:title" content="{{ pageTitle or t.meta.title }}">
  <meta property="og:description" content="{{ t.meta.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-{{ t.htmlLang }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ 'fr_CA' if t.htmlLang == 'fr' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle or t.meta.title }}">
  <meta name="twitter:description" content="{{ t.meta.description }}">
  <meta name="twitter:image" content="{{ site.url }}/og-{{ t.htmlLang }}.png">
</head>
<body>
  {% include "partials/nav.njk" %}
  <main>{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script src="/js/site.js" defer></script>
  <script src="/js/mocks.js" defer></script>
</body>
</html>
