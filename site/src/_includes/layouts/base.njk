<!doctype html>
<html lang="{{ t.htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle or t.meta.title }}</title>
  <meta name="description" content="{{ t.meta.description }}">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/souffle-logo.svg" type="image/svg+xml" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="{{ '/css/site.css' | bust }}">
  <link rel="stylesheet" href="{{ '/css/mocks.css' | bust }}">
  {% set altEn = "/docs/" if isDocs else "/" %}
  {% set altFr = "/fr/docs/" if isDocs else "/fr/" %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ altEn }}">
  <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ altFr }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altEn }}">
  <meta property="og:title" content="{{ pageTitle or t.meta.title }}">
  <meta property="og:description" content="{{ t.meta.ogDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-{{ t.htmlLang }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ t.meta.imageAlt }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ 'fr_CA' if t.htmlLang == 'fr' else 'en_US' }}">
  <meta property="og:locale:alternate" content="{{ 'en_US' if t.htmlLang == 'fr' else 'fr_CA' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle or t.meta.title }}">
  <meta name="twitter:description" content="{{ t.meta.ogDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/og-{{ t.htmlLang }}.png">
  <meta name="twitter:image:alt" content="{{ t.meta.imageAlt }}">
  {%- if not isDocs %}
  {% set app = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": site.name,
    "description": t.meta.description,
    "url": site.url + page.url,
    "image": site.url + "/og-" + t.htmlLang + ".png",
    "operatingSystem": "macOS 13.0 or later",
    "processorRequirements": "Apple Silicon (ARM64)",
    "license": site.license,
    "downloadUrl": site.latest,
    "author": { "@type": "Person", "name": site.author },
    "inLanguage": t.htmlLang
  } %}
  <script type="application/ld+json">{{ app | jsonld | safe }}</script>
  {%- endif %}
</head>
<body>
  {% include "partials/nav.njk" %}
  <main>{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/site.js' | bust }}" defer></script>
  <script src="{{ '/js/mocks.js' | bust }}" defer></script>
</body>
</html>
