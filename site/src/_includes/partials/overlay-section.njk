{% from "mocks/mocks.njk" import overlay %}
{#
  The second movement of the dictation act: the same dictation, outside the
  app. It is not its own act — one subject, one place on the bill.
#}
<h3 class="t-m act-movement" id="overlay">{{ t.overlay.title }}</h3>
<div class="act-cols">
  <p class="t-s">{{ t.overlay.body }}</p>
  <ul class="facts t-xs">
    {%- for b in t.overlay.bullets %}<li>{{ b }}</li>{% endfor %}
  </ul>
</div>
<figure class="act-plate">{{ overlay(t) }}</figure>
