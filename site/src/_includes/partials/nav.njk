{% from "icons.njk" import icon, logo %}
{% set home = "/" if loc.code == "en" else "/fr/" %}
{% set docs = "/docs/" if loc.code == "en" else "/fr/docs/" %}
{#
  Not a floating bar. This is the top line of the sheet: the wordmark, the
  bill of what is on the page, and the language. It scrolls away with the
  paper. The act you are reading inverts out of the sheet; the acts behind
  you take a struck rule, the way a bill marks a set that has played.
#}
<nav class="margin-run t-3xs" id="margin-run">
  <a class="wordmark" href="{{ home }}">{{ logo(26) }}<span>{{ site.name }}</span></a>
  <div class="run-acts" id="run-acts">
    {% if isDocs %}
      <a href="{{ home }}">{{ t.nav.home }}</a>
      <a href="{{ site.releases }}">{{ t.nav.releases }}</a>
    {% else %}
      <a href="#features" data-act="features">{{ t.nav.features }}</a>
      <a href="#models" data-act="models">{{ t.nav.models }}</a>
      <a href="#privacy" data-act="privacy">{{ t.nav.privacy }}</a>
      <a href="{{ docs }}">{{ t.nav.docs }}</a>
    {% endif %}
    <a href="{{ site.repo }}">{{ t.nav.github }}</a>
  </div>
  <div class="run-langs">
    <a href="{{ "/docs/" if isDocs else "/" }}" aria-current="{{ "true" if loc.code == "en" }}">EN</a>
    <a href="{{ "/fr/docs/" if isDocs else "/fr/" }}" aria-current="{{ "true" if loc.code == "fr" }}">FR</a>
  </div>
  <a class="run-word" href="{{ "#download" if not isDocs else site.latest }}">{{ t.nav.download }}</a>
  <button class="run-toggle t-3xs" type="button" aria-controls="run-acts" aria-expanded="false" aria-label="{{ t.nav.menu }}">
    <span class="run-toggle-open">{{ icon("menu", 15) }}</span>
    <span class="run-toggle-close" hidden>{{ icon("close", 15) }}</span>
  </button>
</nav>
