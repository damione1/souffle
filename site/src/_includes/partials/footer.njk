{% set docs = "/docs/" if loc.code == "en" else "/fr/docs/" %}
{#
  The strip along the bottom edge of the sheet: imprint left, the rest of
  the bill right, one hairline above it.
#}
<footer class="band invert">
  <div class="foot t-3xs">
    <span class="dim">{{ site.name }} · © 2026 {{ site.author }} · {{ site.license }}</span>
    <div class="foot-links">
      <a href="{{ docs }}">{{ t.footer.docs }}</a>
      <a href="{{ site.releases }}">{{ t.footer.releases }}</a>
      <a href="{{ site.issues }}">{{ t.footer.issues }}</a>
      <a href="{{ site.repo }}">{{ t.footer.github }}</a>
    </div>
  </div>
</footer>
