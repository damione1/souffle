{# Stroke icons on a 24px grid, matching the lucide set the app uses. #}
{% macro icon(name, size = 16, stroke = 2) %}
{%- if name == "download" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13"/><path d="M7 12l5 5 5-5"/><path d="M4 21h16"/></svg>
{%- elif name == "clock" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>
{%- elif name == "server" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>
{%- elif name == "mic" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
{%- elif name == "users" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M3 20c0-3 2.7-5 6-5s6 2 6 5"/><path d="M17 6.5a3 3 0 0 1 0 6"/><path d="M18.5 15.5c1.6.7 2.5 2 2.5 4.5"/></svg>
{%- elif name == "bulb" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4a4 4 0 0 1 4 4c1.7.7 2.8 2.3 2.8 4.2 0 2.6-2.1 4.8-4.8 4.8H9c-2.7 0-4.8-2.2-4.8-4.8 0-1.9 1.1-3.5 2.8-4.2A4 4 0 0 1 12 4Z"/><path d="M12 17v3"/></svg>
{%- elif name == "check" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
{%- elif name == "copy" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/></svg>
{%- elif name == "shield" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3Z"/><path d="M9.5 12.5l1.8 1.8 3.4-3.6"/></svg>
{%- elif name == "warning" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
{%- elif name == "github" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.4-3.4-1.4-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.2.7-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.2 9.2 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7 1 .7 2v3c0 .3.2.6.7.5A10.1 10.1 0 0 0 22 12.2C22 6.6 17.5 2 12 2Z"/></svg>
{%- elif name == "search" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg>
{%- elif name == "calendar" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 1.5"/></svg>
{%- elif name == "file" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/></svg>
{%- elif name == "sparkle" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3l2 5.6 5.6 2-5.6 2L12 21l-2-8.4L4.4 10.6 10 8.6Z"/></svg>
{%- elif name == "chevron" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
{%- elif name == "play" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5Z"/></svg>
{%- elif name == "square" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
{%- elif name == "clipboard" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1Z"/><path d="M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/><path d="M9 14l2 2 4-4"/></svg>
{%- elif name == "pencil" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 4.5l3 3L8 19H5v-3Z"/><path d="M14.5 6.5l3 3"/></svg>
{%- elif name == "checks" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6.5l2 2 3.5-3.5"/><path d="M3 14.5l2 2 3.5-3.5"/><path d="M12 7h9"/><path d="M12 15h9"/></svg>
{%- elif name == "target" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/></svg>
{%- elif name == "help" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.2a2.5 2.5 0 1 1 3.2 3.1c-.5.3-.8.8-.8 1.4"/><path d="M12 17h.01"/></svg>
{%- elif name == "send" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l16-8-6 16-2.5-6.5Z"/></svg>
{%- elif name == "cloudoff" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 7.2A4.5 4.5 0 0 1 16.5 10h.5a3.5 3.5 0 0 1 2.3 6.1"/><path d="M14 17H6.5a3.5 3.5 0 0 1-.6-6.95"/><path d="M3 3l18 18"/></svg>
{%- elif name == "person" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.4 3.1-5.5 7-5.5s7 2.1 7 5.5"/><path d="M3 3l18 18"/></svg>
{%- elif name == "folder" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h3.5l2 2.5H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>
{%- elif name == "trash" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/><path d="M10 11v6M14 11v6"/></svg>
{%- elif name == "plug" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3v5M15 3v5"/><path d="M7 8h10v3a5 5 0 0 1-10 0Z"/><path d="M12 16v5"/></svg>
{%- elif name == "arrow" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"/><path d="M13 6l6 6-6 6"/></svg>
{%- elif name == "hash" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" aria-hidden="true"><path d="M6 9h13M5 15h13M10 4l-2 16M16 4l-2 16"/></svg>
{%- endif -%}
{% endmacro %}

{% macro logo(size = 34) %}
<svg viewBox="0 0 512 512" width="{{ size }}" height="{{ size }}" role="img" aria-label="Soufflé">
  <defs>
    <linearGradient id="lg-bg-{{ size }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#39240f"/><stop offset="1" stop-color="#160e06"/></linearGradient>
    <linearGradient id="lg-dome-{{ size }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f8d089"/><stop offset="0.55" stop-color="#eab255"/><stop offset="1" stop-color="#d9973f"/></linearGradient>
    <linearGradient id="lg-ram-{{ size }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f2e7d1"/><stop offset="1" stop-color="#dccdb0"/></linearGradient>
  </defs>
  <rect x="32" y="32" width="448" height="448" rx="116" fill="url(#lg-bg-{{ size }})"/>
  <rect x="32.5" y="32.5" width="447" height="447" rx="115.5" fill="none" stroke="#e9ae55" stroke-opacity="0.28" stroke-width="1.5"/>
  <g fill="none" stroke="#f3e7d0" stroke-width="13" stroke-linecap="round">
    <path d="M206 158 C188 126 214 104 196 74" opacity="0.5"/>
    <path d="M256 150 C236 112 270 90 248 56" opacity="0.85"/>
    <path d="M306 158 C324 126 298 104 316 74" opacity="0.5"/>
  </g>
  <path d="M150 302 C150 190 200 150 256 150 C312 150 362 190 362 302 Z" fill="url(#lg-dome-{{ size }})"/>
  <path d="M193 236 C218 196 248 180 274 178" fill="none" stroke="#ffe6b4" stroke-width="15" stroke-linecap="round" opacity="0.65"/>
  <path d="M156 322 L356 322 L336 432 C332 456 316 460 300 460 L212 460 C196 460 180 456 176 432 Z" fill="url(#lg-ram-{{ size }})"/>
  <rect x="134" y="284" width="244" height="42" rx="21" fill="#fbf3e4"/>
  <g stroke="#d3bc93" stroke-width="9" stroke-linecap="round">
    <line x1="204" y1="336" x2="199" y2="448"/><line x1="256" y1="336" x2="256" y2="452"/><line x1="308" y1="336" x2="313" y2="448"/>
  </g>
</svg>
{% endmacro %}
