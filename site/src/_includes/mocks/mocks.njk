{% from "icons.njk" import icon %}

{# Window chrome. `anim` names the behaviour mocks.js drives inside it.
   The right-hand cluster mirrors App.svelte's own header: the model
   status pill, the theme toggle, and the settings button. #}
{% macro win(title, t, anim = "") %}
<div class="mock win"{% if anim %} data-mock="{{ anim }}"{% endif %}>
  <div class="win-bar">
    <span class="win-dot red"></span><span class="win-dot amber"></span><span class="win-dot green"></span>
    <span class="win-title">{{ title }}</span>
    <span class="win-bar-right">
      <span class="win-status"><span class="win-status-dot"></span>{{ t.mock.statusReady }}<span class="win-status-model">{{ t.mock.statusModel }}</span></span>
      <span class="win-icon-btn">{{ icon("moon", 13) }}</span>
      <span class="win-icon-btn">{{ icon("sliders", 13) }}</span>
    </span>
  </div>
  <div class="win-body">{{ caller() }}</div>
</div>
{% endmacro %}

{# LiveSessionCard's header row: badge + pulsing dot, waveform, running clock, stop. #}
{% macro liveHead(label, stop, start) %}
<div class="live-head">
  <span class="live-badge"><span class="rec-dot"></span>{{ label }}</span>
  <div class="wave"><canvas data-wave height="46" aria-hidden="true"></canvas></div>
  <span class="live-time mono" data-timer data-start="{{ start }}">{{ start }}</span>
  <span class="live-stop">{{ icon("square", 13) }}{{ stop }}</span>
</div>
{% endmacro %}

{# ── Live meeting: transcript streams in, then the notes card ── #}
{% macro meeting(t) %}
{% call win(t.mock.winMeeting, t, "meeting") %}
  <div class="m-stack">
    {{ liveHead(t.mock.liveMeeting, t.mock.stop, t.mock.meetingElapsed) }}
    <div class="m-card tr-card">
      <div class="tr-head">
        <h3>{{ t.mock.liveTranscript }}</h3>
        <span class="tr-audio"><i></i>{{ t.mock.systemAudio }}</span>
      </div>
      <p class="tr-hint">{{ t.mock.editHint }}</p>
      <div class="tr-body" data-transcript>
        {%- for p in t.mock.transcript %}
        <template data-para data-who="{{ p.who }}" data-at="{{ p.at }}"
                  data-label="{{ t.mock.me if p.who == 'me' else t.mock.them }}">{{ p.text }}</template>
        {%- endfor %}
      </div>
    </div>
    <section class="m-card-sm notes">
      <div class="notes-head">
        <h3>{{ icon("pencil", 14) }}{{ t.mock.notesTitle }}</h3>
        <span class="notes-state">{{ t.mock.notesSaved }}</span>
      </div>
      <div class="notes-field">{{ t.mock.notesText }}</div>
    </section>
  </div>
{% endcall %}
{% endmacro %}

{# ── Dictation: text types itself in, caret blinks, auto-paste footer ── #}
{% macro dictation(t) %}
{% call win(t.mock.winDictation, t, "dictation") %}
  <div class="m-stack">
    {{ liveHead(t.mock.liveDictation, t.mock.stop, "0:00") }}
    <div class="m-card dict-card">
      <p class="dict-text"><span data-typed data-text="{{ t.mock.dictationText }}"></span><span class="caret"></span></p>
      <div style="flex:1"></div>
      <div class="dict-foot">{{ icon("clipboard", 15) }}{{ t.mock.autopaste }}</div>
    </div>
  </div>
{% endcall %}
{% endmacro %}

{# ── Home: action cards, search, today's calendar, the timeline ── #}
{% macro home(t) %}
{% call win(t.mock.winHome, t) %}
  <div style="display:flex;flex-direction:column;gap:26px">
    <div class="hero-grid">
      <div class="action">
        <span class="action-icon accent">{{ icon("mic", 20) }}</span>
        <span class="action-body">
          <span class="action-title">{{ t.mock.dictate }}</span>
          <span class="action-sub">{{ t.mock.press }}<span class="kbd">⌘⇧Space</span></span>
        </span>
      </div>
      <div class="action">
        <span class="action-icon secondary">{{ icon("users", 20) }}</span>
        <span class="action-body">
          <span class="action-title">{{ t.mock.meeting }}</span>
          <span class="action-sub">{{ t.mock.meetingHint }}</span>
        </span>
      </div>
    </div>

    <div class="m-search">{{ icon("search", 16) }}{{ t.mock.search }}</div>

    <section class="m-section">
      <h4>{{ t.mock.upcoming }}</h4>
      <div class="m-list">
        {%- for e in t.mock.events %}
        <div class="m-row{% if e.now %} is-now{% endif %}">
          <span class="m-row-icon secondary">{{ icon("calendar", 15) }}</span>
          <span style="display:flex;min-width:0;flex:1;align-items:center;gap:9px">
            <span class="m-row-title">{{ e.title }}</span>
            {%- if e.now %}<span class="now-tag">{{ t.mock.now }}</span>{% endif %}
          </span>
          {%- if e.people %}<span class="m-row-meta">{{ icon("users", 13) }}{{ e.people }}</span>{% endif %}
          <span class="m-row-meta"><span class="mono">{{ e.time }}</span></span>
          <span class="m-play">{{ icon("play", 13) }}</span>
        </div>
        {%- endfor %}
      </div>
    </section>

    <section class="m-section">
      <h4>{{ t.mock.today }}</h4>
      <div class="m-list">
        {%- for i in t.mock.timeline %}
        <div class="m-row">
          <span class="m-row-icon {{ 'accent' if i.kind == 'meeting' else 'muted' }}">
            {{ icon("users", 15) if i.kind == "meeting" else icon("file", 15) }}
          </span>
          <span class="m-row-title dim">{{ i.title }}</span>
          <span class="m-row-meta">
            {%- if i.summary %}<span style="display:flex;color:var(--m-accent)">{{ icon("sparkle", 14) }}</span>{% endif %}
            <span class="mono">{{ i.duration }}</span><span class="mono">{{ i.at }}</span>
            {%- if i.kind == "meeting" %}{{ icon("chevron", 15) }}{% endif %}
          </span>
        </div>
        {%- endfor %}
      </div>
    </section>
  </div>
{% endcall %}
{% endmacro %}

{# ── Outcomes ── #}
{% macro outcomes(t) %}
{% call win(t.mock.winOutcomes, t) %}
  <div class="m-card-sm out">
    <h3>{{ icon("checks", 15) }}{{ t.mock.outcomes }}</h3>
    <div class="out-group">
      <h4>{{ icon("target", 13) }}{{ t.mock.decisions }}</h4>
      <div class="out-wrap">
        {%- for d in t.mock.outcomeDecisions %}<span class="out-chip decision">{{ d }}</span>{% endfor %}
      </div>
    </div>
    <div class="out-group">
      <h4>{{ t.mock.actionItems }}</h4>
      <div class="out-grid">
        {%- for a in t.mock.outcomeActions %}
        <div class="out-item"><p>{{ a.text }}</p><span class="out-owner mono">{{ t.mock.owner }}: {{ a.owner }}</span></div>
        {%- endfor %}
      </div>
    </div>
    <div class="out-group">
      <h4>{{ icon("help", 13) }}{{ t.mock.openQuestions }}</h4>
      <div class="out-wrap">
        {%- for q in t.mock.outcomeQuestions %}<span class="out-chip question">{{ q }}</span>{% endfor %}
      </div>
    </div>
  </div>
{% endcall %}
{% endmacro %}

{# ── The overlay demo ──
   The chat client is a fictional product, "E Corp Chat", with its own
   cold corporate palette so it cannot be mistaken for part of Soufflé:
   the whole point is that the pill is floating over somebody else's app. #}
{% macro overlay(t) %}
{% set c = t.mock.chat %}
<div class="overlay-stage" data-mock="overlay" data-polishing="{{ t.mock.pillPolishing }}"
     data-me="{{ c.me.name }}" data-me-initials="{{ c.me.initials }}"
     data-me-colour="{{ c.me.colour }}" data-me-at="{{ c.me.at }}">
  <div class="mock win chat-win">
    <div class="win-bar chat-bar">
      <span class="win-dot red"></span><span class="win-dot amber"></span><span class="win-dot green"></span>
      <span class="win-title">{{ c.app }}</span>
    </div>
    <div class="chat">
      <aside class="chat-side">
        <div class="chat-ws">
          <span class="chat-ws-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="miter">
              <g transform="rotate(-32 12 12)">
                <path d="M8 5h9.5M8 5v14M8 12h7M8 19h9.5"/>
              </g>
            </svg>
          </span>
          <span class="chat-ws-name">{{ c.workspace }}</span>
          <svg class="chat-ws-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </div>

        <div class="chat-group">
          <span class="chat-group-h">{{ c.channelsLabel }}</span>
          {%- for ch in c.channels %}
          <div class="chat-item{% if ch.active %} is-active{% endif %}">
            <span class="chat-hash">#</span>
            <span class="chat-item-name">{{ ch.name }}</span>
            {%- if ch.unread %}<span class="chat-badge">{{ ch.unread }}</span>{% endif %}
          </div>
          {%- endfor %}
        </div>

        <div class="chat-group">
          <span class="chat-group-h">{{ c.dmsLabel }}</span>
          {%- for d in c.dms %}
          <div class="chat-item">
            <span class="chat-dm-avatar" style="background:{{ d.colour }}">{{ d.initials }}<i class="chat-presence is-{{ d.presence }}"></i></span>
            <span class="chat-item-name">{{ d.name }}</span>
            {%- if d.unread %}<span class="chat-badge">{{ d.unread }}</span>{% endif %}
          </div>
          {%- endfor %}
        </div>
      </aside>

      <div class="chat-main">
        <div class="chat-head">
          <div class="chat-head-title"><span class="chat-hash">#</span>{{ c.active }}</div>
          <div class="chat-head-meta">
            <span class="chat-members">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 19c0-2.8 2.7-4.5 6-4.5s6 1.7 6 4.5"/><path d="M17 5.5a2.8 2.8 0 0 1 0 5.5"/></svg>
              {{ c.members }}
            </span>
            <span class="chat-topic">{{ c.topic }}</span>
          </div>
        </div>
        <div class="chat-thread" data-thread>
          {%- for m in c.messages %}
          <div class="chat-msg">
            <span class="chat-avatar" style="background:{{ m.colour }}">{{ m.initials }}</span>
            <div class="chat-body">
              <div><span class="chat-name">{{ m.from }}</span><span class="chat-at">{{ m.at }}</span></div>
              <p class="chat-text">{{ m.text }}</p>
            </div>
          </div>
          {%- endfor %}
        </div>
        {# Focused from the start: the whole point is that the text lands where
           the cursor already was, so the field cannot come alive afterwards. #}
        <div class="chat-composer is-focused" data-composer>
          <div class="chat-field">
            <span class="chat-typed" data-input></span><span class="chat-caret" aria-hidden="true"></span><span class="chat-ph" data-ph>{{ c.placeholder }}</span>
          </div>
          <span class="chat-send" data-send>{{ icon("send", 15) }}</span>
        </div>
      </div>
    </div>
  </div>

  {# The shortcut, flashed for a beat so the trigger is legible before the
     pill shows up. #}
  <div class="keycast" data-keycast aria-hidden="true">
    <div class="keycast-keys">
      {%- for k in t.mock.shortcutKeys %}
      <kbd class="keycap{% if k == 'Space' %} is-wide{% endif %}">{{ k }}</kbd>
      {%- endfor %}
    </div>
    <span class="keycast-caption">{{ t.mock.shortcutCaption }}</span>
  </div>

  {# PillApp.svelte: 280px compact, 440px once there is live text. #}
  <div class="pill-overlay" data-pill aria-hidden="true">
    <div class="pill-shell">
      <div class="pill-row">
        <span class="pill-dot" data-pill-dot></span>
        <span class="pill-label" data-pill-label>{{ t.mock.pillDictation }}</span>
        <div class="pill-wave" data-pill-wave><canvas data-wave height="32"></canvas></div>
        <div class="pill-spinner" data-pill-spinner hidden><i></i></div>
        <span class="pill-stop" data-pill-stop>{{ icon("square", 12) }}</span>
      </div>
      <p class="pill-text" data-pill-text hidden></p>
    </div>
  </div>

  <div class="stage-steps" data-steps>
    {%- for s in t.overlay.steps %}<span class="stage-step" data-step="{{ loop.index0 }}">{{ s }}</span>{% endfor %}
  </div>
  <p class="mock-caption">{{ t.overlay.caption }}</p>

  <span hidden data-raw>{{ c.raw }}</span>
  <span hidden data-polished>{{ c.polished }}</span>
</div>
{% endmacro %}
