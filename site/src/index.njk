---
pagination: { data: locales, size: 1, alias: loc }
permalink: "{{ loc.dir }}index.html"
layout: layouts/base.njk
---
{% from "icons.njk" import icon %}
{% from "mocks/mocks.njk" import meeting, dictation, home, outcomes, overlay %}
{% set docs = "/docs/" if loc.code == "en" else "/fr/docs/" %}

{#
  One sheet. Hierarchy is size and line breaks; there are no cards, no
  panels and no containers on this page. The only images it contains are
  the app mocks, printed onto the sheet as plates.
#}

{% macro plate(name, t) %}
  {%- if name == "home" %}{{ home(t) }}
  {%- elif name == "dictation" %}{{ dictation(t) }}
  {%- elif name == "outcomes" %}{{ outcomes(t) }}
  {%- else %}{{ meeting(t) }}{% endif %}
{% endmacro %}

{% macro copyline(cmd, label) %}
<button class="copyline t-2xs" data-copy="{{ cmd }}" type="button">
  <code>{{ cmd }}</code>
  <span class="copyline-do t-3xs">{{ label }}</span>
</button>
{% endmacro %}

{# ── THE TOP OF THE SHEET ── #}
<section class="band">
  <div class="sheet hero">
    <h1 class="t-xl" data-fit>
      {%- for line in t.hero.titleLines %}<span class="hl">{{ line }}</span>{% endfor %}
    </h1>

    <div class="hero-under">
      <p class="t-s measure">{{ t.hero.sub }}</p>
      <div class="hero-do">
        <a class="act-ruled" href="{{ site.latest }}">{{ t.hero.cta }}{{ icon("arrow", 22) }}</a>
        {{ copyline(site.brew, t.nav.copy) }}
        <p class="t-3xs dim" style="padding-top:10px;border-top:1px solid var(--rule)">{{ t.hero.note }} · {{ t.hero.badge }}</p>
      </div>
    </div>

    <figure class="hero-plate">
      {{ meeting(t) }}
      <figcaption class="plate-note">
        <span class="t-3xs" style="flex-shrink:0">{{ t.mock.liveMeeting }}</span>
        <span class="t-2xs dim">{{ t.hero.caption }}</span>
      </figcaption>
    </figure>
  </div>
</section>

{# ── THE ACTS ── #}
<section id="features" class="band">
  <div class="sheet">
    {%- for f in t.features %}
    <article class="act" id="act-{{ f.id }}" data-act-watch="features">
      <div class="act-head">
        <h2 class="bill-{{ loop.index }}" data-act-head>{{ f.title }}</h2>
      </div>
      <div class="act-cols">
        <p class="t-s">{{ f.body | safe }}</p>
        <ul class="facts t-xs">
          {%- for b in f.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
      </div>
      <figure class="act-plate">{{ plate(f.mock, t) }}</figure>
    </article>

    {%- if f.overlayAfter %}{% include "partials/overlay-section.njk" %}{% endif %}
    {%- endfor %}
  </div>
</section>

{# ── THE REVERSE OF THE SHEET: the dense factual half ── #}
<div class="screen-band" aria-hidden="true"></div>
<section id="models" class="band invert">
  <div class="sheet act">
    <h2 class="bill-3" data-act-head data-act-watch="models">{{ t.models.title }}</h2>
    <p class="t-s measure" style="margin-top:20px">{{ t.models.sub }}</p>

    <div class="bill-list" style="margin-top:clamp(22px,2.6vw,34px)">
      {%- for m in t.models.cards %}
      <div class="bill-row{% if m.featured %} is-billed{% endif %}">
        <p class="bill-name"><span class="t-m">{{ m.name }}</span>{% if m.tag %}<span class="t-3xs dim bill-tag">{{ m.tag }}</span>{% endif %}</p>
        <p class="t-xs">{{ m.desc }}</p>
        <div class="specs">
          {%- for c in m.chips %}<span class="spec">{{ c }}</span>{% endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section id="privacy" class="band invert">
  <div class="sheet act">
    <h2 class="bill-3" data-act-head data-act-watch="privacy">{{ t.privacy.title }}</h2>
    <p class="t-s measure" style="margin-top:20px">{{ t.privacy.sub }}</p>
    <div class="points">
      {%- for p in t.privacy.points %}
      <div>
        <h3 class="t-m">{{ p.h }}</h3>
        <p class="t-xs dim">{{ p.d }}</p>
      </div>
      {%- endfor %}
    </div>
    <a class="more-link t-2xs" href="{{ docs }}#privacy">{{ t.privacy.more }}{{ icon("arrow", 14) }}</a>
  </div>
</section>

<section class="band invert">
  <div class="sheet act">
    <h2 class="bill-4" data-act-head data-act-watch="privacy">{{ t.owndata.title }}</h2>
    <p class="t-s measure" style="margin-top:20px">{{ t.owndata.sub }}</p>
    <div class="points">
      {%- for p in t.owndata.points %}
      <div>
        <h3 class="t-m">{{ p.h }}</h3>
        <p class="t-xs dim">{{ p.d }}</p>
      </div>
      {%- endfor %}
    </div>
    <a class="more-link t-2xs" href="{{ docs }}#export">{{ t.owndata.more }}{{ icon("arrow", 14) }}</a>
  </div>
</section>

{# ── THE TAIL: the smallest facts, packed at the foot of the sheet ── #}
<section class="band invert">
  <div class="sheet act">
    <div class="act-cols" style="border-top:0;margin-top:0;padding-top:0">
      <div>
        <h3 class="t-m">{{ t.requirements.title }}</h3>
        <div class="kv t-xs" style="margin-top:16px">
          {%- for r in t.requirements.rows %}
          <div><span class="dim">{{ r.k }}</span><span>{{ r.v | safe }}</span></div>
          {%- endfor %}
        </div>
      </div>
      <div>
        <h3 class="t-m">{{ t.requirements.permTitle }}</h3>
        <p class="t-2xs dim" style="margin-top:10px">{{ t.requirements.permSub }}</p>
        <div class="kv t-xs" style="margin-top:14px">
          {%- for p in t.requirements.perms %}
          <div><span class="dim">{{ p.k }}</span><span>{{ p.v }}</span></div>
          {%- endfor %}
        </div>
      </div>
    </div>
    <p class="tail t-2xs"><b>{{ t.requirements.statusTitle }}</b> {{ t.requirements.status }}</p>
  </div>
</section>

{# ── THE CLOSE ── #}
<section id="download" class="band">
  <div class="sheet close">
    <h2 class="t-xl" data-fit><span class="hl">{{ t.cta.title }}</span></h2>
    <div class="close-under">
      <p class="t-s measure">{{ t.cta.sub | safe }}</p>
      <div class="close-do">
        <a class="act-ruled" href="{{ site.latest }}">{{ t.cta.primary }}{{ icon("arrow", 22) }}</a>
        <a class="act-ruled is-quiet" href="{{ site.repo }}">{{ t.cta.secondary }}{{ icon("arrow", 22) }}</a>
        {{ copyline(site.brew, t.nav.copy) }}
      </div>
    </div>
  </div>
</section>
