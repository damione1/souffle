#: ui/components/settings/permissions_section.slint:25
msgctxt "PermissionsSection"
msgid ""
"Revérifier les permissions macOS si le collage ou l'enregistrement cesse de "
"fonctionner."
msgstr "Recheck macOS permissions if pasting or recording stops working."

#: ui/components/settings/permissions_section.slint:32
msgctxt "PermissionsSection"
msgid "Vérifier les permissions"
msgstr "Check permissions"

#: ui/components/settings/summarization_section.slint:7
msgctxt "SummarizationSection"
msgid "EXPÉRIMENTAL"
msgstr "EXPERIMENTAL"

#: ui/components/settings/summarization_section.slint:21
msgctxt "SummarizationSection"
msgid "Résumés de réunion"
msgstr "Summarization"

#: ui/components/settings/summarization_section.slint:22
msgctxt "SummarizationSection"
msgid ""
"Active les résumés de réunion et la compaction expérimentaux. La qualité des "
"longs résumés locaux reste à évaluer."
msgstr ""
"Enable experimental meeting summaries and compaction. Long local summaries "
"are still being evaluated."

