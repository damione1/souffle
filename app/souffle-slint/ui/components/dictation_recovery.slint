import { ButtonIntent, KitButton, KitCard, KitCardHeader, KitInline, KitTextArea, SurfaceLevel } from "@kit";
import { LucideText } from "@kit-icons/text.slint";
import { Theme } from "../theme.slint";

// Kept on the home screen when stopping succeeded but persistence or text
// insertion did not. The transcript remains selectable/editable until the
// user explicitly copies or discards it; an error can therefore never turn
// into silent data loss merely because RecordingView unmounted.
export component DictationRecovery inherits KitCard {
    in-out property <string> text;

    callback copy-requested();
    callback discard-requested();

    level: SurfaceLevel.raised;
    inset: regular;
    border-color: Theme.warning;

    KitCardHeader {
        title: @tr("Dictée à récupérer");
        description: @tr("Le texte reste ici tant que vous ne l’avez pas copié ou supprimé.");
    }
    KitTextArea {
        text <=> root.text;
        min-lines: 4;
        max-lines: 4;
        accessible-name: @tr("Texte de dictée à récupérer");
    }
    KitInline {
        alignment: end;
        KitButton {
            text: @tr("Supprimer");
            intent: ButtonIntent.quiet;
            activated => { root.discard-requested(); }
        }
        KitButton {
            text: @tr("Copier le texte");
            intent: ButtonIntent.primary;
            leading-icon: LucideText.copy();
            activated => { root.copy-requested(); }
        }
    }
}
