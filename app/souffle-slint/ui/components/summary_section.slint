import { Theme } from "../theme.slint";
import { ThemedComboBox } from "themed_combo.slint";
import { LucideIcon, IconSet } from "lucide_icon.slint";

// Port of MeetingSummarySection.svelte + MeetingStructuredSummarySection.svelte
// (SOU-187 milestone 9, SOU-221/SOU-233): display, model picker and
// generation ("Générer"/"Régénérer" -> `generate-requested`, handled by
// `on_meeting_detail_summarize` in main.rs). Not ported: the template
// picker (generation always uses the Settings default template).
export struct StructuredActionItem {
    text: string,
    owner: string, // empty when there's no owner
}

export component SummarySection inherits VerticalLayout {
    in property <string> summary; // empty means "no summary yet"
    in property <bool> summary-is-stale: false;
    in property <string> summary-model-label;
    in property <[string]> available-models;
    in property <[string]> available-model-ids;
    in-out property <string> selected-model-id;
    // Display label for `selected-model-id`. Rust seeds this alongside the
    // id when it picks the default model; the picker below keeps it in sync
    // on user selection via `selected-index` (id and label can differ, e.g.
    // "apple-intelligence" vs "Apple Intelligence").
    in-out property <string> selected-model-label;

    in property <[string]> key-points;
    in property <[string]> decisions;
    in property <[StructuredActionItem]> action-items;
    in property <[string]> open-questions;
    in property <bool> is-generating: false;
    in property <string> generation-progress: "";
    // Last generation failure, empty when the last attempt succeeded or none
    // was made. Kept apart from `generation-progress`, which is only
    // rendered while `is-generating` - an error written there vanished the
    // instant generation stopped, so a failed click looked like a no-op.
    in property <string> generation-error: "";

    callback generate-requested();
    // Copy `summary` to the pasteboard (Rust owns the pasteboard write).
    callback copy-requested();

    // "Copié" feedback for 1.5s after a copy, like the Tauri CopyButton.
    property <bool> just-copied: false;
    function copy-summary() {
        root.copy-requested();
        root.just-copied = true;
    }
    Timer {
        interval: 1.5s;
        running: root.just-copied;
        triggered => { root.just-copied = false; }
    }

    spacing: 8px;

    // MeetingSummarySection.svelte's collapsed "generate" CTA card, with the
    // model picker kept inline (SOU-233 AC4) instead of Tauri's picker-less
    // one-click card.
    if root.summary == "" && !root.is-generating: Rectangle {
        border-width: 1px;
        border-color: Theme.ghost-border;

        VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 13px;
            alignment: start;

            Rectangle {
                width: 26px;
                height: 34px;
                horizontal-stretch: 0;

                LucideIcon {
                    size: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.WandSparkles;
                    icon-color: Theme.accent;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: @tr("Générer le résumé");
                    font-family: "Archivo SemiBold";
                    font-size: 14px;
                    color: Theme.text-primary;
                }
                Text {
                    text: @tr("Points clés et actions, générés sur l’appareil");
                    font-size: 12px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        if root.available-models.length == 0: Text {
            text: @tr("Aucun fournisseur de résumé disponible. Activez Apple Intelligence ou connectez Ollama dans Réglages › IA.");
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.generation-error != "": Text {
            text: @tr("La génération du résumé a échoué : {}", root.generation-error);
            font-size: 12px;
            color: Theme.danger;
            wrap: word-wrap;
        }

        if root.available-models.length > 0: HorizontalLayout {
            alignment: start;
            spacing: 8px;

            ThemedComboBox {
                model: root.available-models;
                option-values: root.available-model-ids;
                current-value: root.selected-model-label;
                combo-width: 250px;
                selected(id) => { root.selected-model-id = id; }
                selected-index(idx) => {
                    root.selected-model-label = (idx >= 0 && idx < root.available-models.length)
                        ? root.available-models[idx]
                        : root.selected-model-id;
                }
            }

            gen-btn := Rectangle {
                width: gen-txt.preferred-width + 24px;
                height: Theme.settings-control-height;
                border-radius: 4px;
                border-width: gen-focus.has-focus ? 2px : 0px;
                border-color: Theme.text-primary;
                background: gen-area.pressed ? Theme.accent.darker(0.2) : gen-area.has-hover ? Theme.accent.darker(0.1) : Theme.accent;

                accessible-role: button;
                accessible-label: @tr("Générer le résumé");
                accessible-action-default => { root.generate-requested(); }

                forward-focus: gen-focus;
                gen-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            root.generate-requested();
                            return accept;
                        }
                        return reject;
                    }
                }

                gen-area := TouchArea {
                    clicked => {
                        gen-focus.focus();
                        root.generate-requested();
                    }
                }

                gen-txt := Text {
                    text: @tr("Générer");
                    font-family: "Archivo SemiBold";
                    font-size: 13px;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        }
    }

    if root.is-generating: VerticalLayout {
        spacing: 10px;

        HorizontalLayout {
            height: 22px;
            vertical-stretch: 0;
            spacing: 8px;

            Rectangle {
                width: 15px;
                horizontal-stretch: 0;

                LucideIcon {
                    size: 15px;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.Sparkles;
                    icon-color: Theme.accent;
                    filled: true;
                }
            }

            Text {
                text: @tr("R\u{e9}sum\u{e9}");
                font-family: "Archivo SemiBold";
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        Rectangle {
            min-height: 80px;
            border-width: 1px;
            border-color: Theme.surface-4;

            VerticalLayout {
                padding: 12px;

                Text {
                    text: root.generation-progress != "" ? root.generation-progress : @tr("Génération en cours...");
                    color: Theme.text-muted;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
        }
    }

    if root.summary != "" && !root.is-generating: VerticalLayout {
        spacing: 10px;

        // Title row as in MeetingSummarySection.svelte: icon + title on the
        // left, the model that produced it on the right. The picker and
        // "Régénérer" live in their own row at the bottom (below), where a
        // 36px combo no longer towers over a 24px button in the title line.
        HorizontalLayout {
            height: 22px;
            vertical-stretch: 0;
            spacing: 8px;

            Rectangle {
                width: 15px;
                horizontal-stretch: 0;

                LucideIcon {
                    size: 15px;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.Sparkles;
                    icon-color: Theme.accent;
                    filled: true;
                }
            }

            Text {
                text: @tr("R\u{e9}sum\u{e9}");
                font-family: "Archivo SemiBold";
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.summary-model-label != "": Text {
                text: root.summary-model-label;
                font-family: "JetBrains Mono";
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            // MeetingSummarySection.svelte's CopyButton next to the model
            // badge: copies the summary text as stored (`meeting.summary`).
            copy-btn := Rectangle {
                width: copy-content.preferred-width + 16px;
                height: 22px;
                horizontal-stretch: 0;
                border-radius: 4px;
                border-width: copy-focus.has-focus ? 2px : 0px;
                border-color: Theme.accent;
                background: copy-area.pressed ? Theme.surface-4 : copy-area.has-hover ? Theme.surface-3 : transparent;

                accessible-role: button;
                accessible-label: @tr("Copier le résumé");
                accessible-action-default => { root.copy-summary(); }

                forward-focus: copy-focus;
                copy-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            root.copy-summary();
                            return accept;
                        }
                        return reject;
                    }
                }

                copy-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        copy-focus.focus();
                        root.copy-summary();
                    }
                }

                copy-content := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 5px;
                    alignment: center;

                    Rectangle {
                        width: 13px;
                        horizontal-stretch: 0;

                        LucideIcon {
                            size: 13px;
                            y: (parent.height - self.height) / 2;
                            icon: root.just-copied ? IconSet.Check : IconSet.Copy;
                            icon-color: root.just-copied ? Theme.accent : Theme.text-secondary;
                        }
                    }
                    Text {
                        text: root.just-copied ? @tr("Copié") : @tr("Copier");
                        font-size: 11.5px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.generation-error != "": Text {
            text: @tr("La génération du résumé a échoué : {}", root.generation-error);
            font-size: 12px;
            color: Theme.danger;
            wrap: word-wrap;
        }

        if root.summary-is-stale: Text {
            text: @tr("R\u{e9}sum\u{e9} obsol\u{e8}te (audio ajout\u{e9} depuis)");
            color: Theme.warning;
            font-size: 11px;
        }

        if root.key-points.length > 0: VerticalLayout {
            spacing: 6px;

            for point[index] in root.key-points: HorizontalLayout {
                spacing: 8px;

                Text {
                    text: (index + 1) + ".";
                    font-family: "monospace";
                    font-size: 11px;
                    color: Theme.accent;
                    width: 18px;
                }
                Text {
                    text: point;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.surface-4;

            VerticalLayout {
                padding: 12px;

                Text {
                    text: root.summary;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
        }

        if root.decisions.length > 0: VerticalLayout {
            spacing: 6px;

            Text {
                text: @tr("D\u{e9}cisions");
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            for decision in root.decisions: Text {
                text: @tr("\u{2022} {}", decision);
                font-size: 12px;
                color: Theme.accent;
                wrap: word-wrap;
            }
        }

        if root.action-items.length > 0: VerticalLayout {
            spacing: 6px;

            Text {
                text: @tr("Actions");
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            for item in root.action-items: VerticalLayout {
                Text {
                    text: item.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if item.owner != "": Text {
                    text: @tr("\u{2192} {}", item.owner);
                    font-family: "monospace";
                    font-size: 10.5px;
                    color: Theme.text-faint;
                }
            }
        }

        if root.open-questions.length > 0: VerticalLayout {
            spacing: 6px;

            Text {
                text: @tr("Questions ouvertes");
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            for question in root.open-questions: Text {
                text: @tr("\u{2022} {}", question);
                font-size: 12px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        if root.available-models.length > 0: HorizontalLayout {
            alignment: start;
            spacing: 8px;

            ThemedComboBox {
                model: root.available-models;
                option-values: root.available-model-ids;
                current-value: root.selected-model-label;
                combo-width: 250px;
                selected(id) => { root.selected-model-id = id; }
                selected-index(idx) => {
                    root.selected-model-label = (idx >= 0 && idx < root.available-models.length)
                        ? root.available-models[idx]
                        : root.selected-model-id;
                }
            }

            Rectangle {
                width: regen-txt.preferred-width + 24px;
                height: Theme.settings-control-height;
                horizontal-stretch: 0;
                border-radius: 4px;
                border-width: regen-focus.has-focus ? 2px : 1px;
                border-color: regen-focus.has-focus ? Theme.accent : Theme.ghost-border;
                background: regen-area.pressed ? Theme.surface-2 : regen-area.has-hover ? Theme.surface-4 : Theme.surface-3;

                accessible-role: button;
                accessible-label: @tr("Régénérer");
                accessible-action-default => { root.generate-requested(); }

                forward-focus: regen-focus;
                regen-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            root.generate-requested();
                            return accept;
                        }
                        return reject;
                    }
                }

                regen-area := TouchArea {
                    clicked => {
                        regen-focus.focus();
                        root.generate-requested();
                    }
                }

                regen-txt := Text {
                    text: @tr("Régénérer");
                    font-family: "Archivo SemiBold";
                    font-size: 13px;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
