import { AppText, Typography } from "@typography";
import { AlertActions, AlertSeverity, ButtonIntent, CardBorderStyle, ElevationLevel, IconGlyph, KitAlert, KitButton, KitCard, KitDivider, KitIcon, KitInline, KitProgress, KitStack, KitThemeContext, ProgressMode, SurfaceLevel } from "@kit";
import { LucideArrows } from "@kit-icons/arrows.slint";
import { Theme } from "../theme.slint";
import { LucideCursors } from "@kit-icons/cursors.slint";
import { LucideText } from "@kit-icons/text.slint";
import { LucideNotifications } from "@kit-icons/notifications.slint";
import { CatalogPicker } from "catalog_picker.slint";
import { BannerAlert, CompactButton } from "./app_controls.slint";

export struct StructuredActionItem {
    text: string,
    owner: string, // empty when there's no owner
}

component SummaryTitle inherits KitInline {
    in property <string> model-label;
    // The mockup's single four-point star, which the kit icon set lacks.
    private property <IconGlyph> sparkle-glyph: { stroke: "M 12 3 l -1.9 5.8 a 2 2 0 0 1 -1.3 1.3 L 3 12 l 5.8 1.9 a 2 2 0 0 1 1.3 1.3 L 12 21 l 1.9 -5.8 a 2 2 0 0 1 1.3 -1.3 L 21 12 l -5.8 -1.9 a 2 2 0 0 1 -1.3 -1.3 Z", fill: "", viewbox: 24 };
    gap: compact;
    alignment: stretch;

    KitIcon {
        glyph: root.sparkle-glyph;
        ink: KitThemeContext.current.accent-ink;
        y: (parent.height - self.height) / 2;
    }
    AppText {
        text: @tr("Résumé");
        typography: Typography.hero-title;
        color: Theme.text-primary;
        vertical-alignment: center;
    }
    if root.model-label != "": AppText {
        text: root.model-label;
        typography: Typography.mono;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

component SummaryModelRow inherits KitInline {
    in property <[string]> models;
    in property <[string]> model-ids;
    in-out property <string> selected-id;
    in property <string> action-label;
    in property <string> action-name;
    callback action-triggered();

    gap: compact;

    CatalogPicker {
        combo-width: 250px;
        model: root.models;
        option-values: root.model-ids;
        current-value: root.selected-id;
        value-chosen(id) => { root.selected-id = id; }
    }
    VerticalLayout {
        alignment: center;

        CompactButton {
            accessible-name: root.action-name;
            text: root.action-label;
            intent: ButtonIntent.secondary;
            leading-icon: LucideArrows.refresh-cw();
            activated => { root.action-triggered(); }
        }
    }
}

component SummaryColumn inherits KitStack {
    in property <string> title;
    gap: compact;
    horizontal-stretch: 1;
    // Equal columns whatever their text.
    min-width: 0px;
    preferred-width: 0px;

    AppText {
        text: root.title.to-uppercase();
        accessible-label: root.title;
        typography: Typography.timeline-heading;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    @children
}

component SummaryBullet inherits KitInline {
    in property <string> text;
    gap: none;
    spacing: 4px;
    alignment: stretch;

    AppText {
        text: "\u{2022}";
        typography: Typography.field-strong;
        color: Theme.accent;
        horizontal-stretch: 0;
        vertical-alignment: top;
    }
    AppText {
        text: root.text;
        typography: Typography.field-label;
        line-height-factor: 1.24;
        color: Theme.text-primary;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

export component SummarySection inherits KitStack {
    in property <string> summary; // empty means "no summary yet"
    in property <string> summary-body; // `summary` without the lines listed in `key-points`
    in property <bool> summary-is-stale: false;
    in property <string> summary-model-label;
    in property <[string]> available-models;
    in property <[string]> available-model-ids;
    in-out property <string> selected-model-id;

    in property <[string]> key-points;
    in property <[string]> decisions;
    in property <[StructuredActionItem]> action-items;
    in property <[string]> open-questions;
    in property <bool> is-generating: false;
    in property <string> generation-progress: "";
    // Rendered while idle, unlike `generation-progress`, so a failed attempt stays visible.
    in property <string> generation-error: "";

    callback generate-requested();
    callback copy-requested();

    property <bool> just-copied: false;
    property <bool> has-structure: root.key-points.length > 0 || root.decisions.length > 0 || root.action-items.length > 0 || root.open-questions.length > 0;
    function copy-summary() {
        root.copy-requested();
        root.just-copied = true;
    }
    Timer {
        interval: 1.5s;
        running: root.just-copied;
        triggered => { root.just-copied = false; }
    }

    gap: compact;

    if root.summary == "" && !root.is-generating && root.available-models.length == 0: BannerAlert {
        severity: AlertSeverity.warning;
        message: @tr("Aucun fournisseur de résumé disponible. Activez Apple Intelligence ou connectez Ollama dans Réglages › IA.");
    }

    if root.summary == "" && !root.is-generating && root.generation-error != "": BannerAlert {
        actions-placement: AlertActions.inline;
        severity: AlertSeverity.error;
        message: @tr("La génération du résumé a échoué : {}", root.generation-error);
        if root.available-models.length > 0: CompactButton {
            text: @tr("Réessayer");
            intent: ButtonIntent.secondary;
            activated => { root.generate-requested(); }
        }
    }

    if root.summary == "" && !root.is-generating && root.available-models.length > 0: KitCard {
        level: SurfaceLevel.flat;
        elevation: ElevationLevel.none;
        border-style: CardBorderStyle.dashed;
        border-color: Theme.line-strong;
        inset: none;
        gap: none;

        HorizontalLayout {
            padding-top: 20px;
            padding-bottom: 20px;
            padding-left: 22px;
            padding-right: 22px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 12px;
                    background: Theme.accent-tint;

                    KitIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        glyph: LucideCursors.wand-sparkles();
                        ink: Theme.accent;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;

                AppText {
                    text: @tr("Générer le résumé (expérimental)");
                    typography: Typography.body-strong;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                AppText {
                    text: @tr("Points clés et actions, générés sur l’appareil");
                    typography: Typography.content;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                CatalogPicker {
                    combo-width: 220px;
                    model: root.available-models;
                    option-values: root.available-model-ids;
                    current-value: root.selected-model-id;
                    value-chosen(id) => { root.selected-model-id = id; }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                KitButton {
                    accessible-name: @tr("Générer le résumé (expérimental)");
                    text: @tr("Générer");
                    intent: ButtonIntent.primary;
                    activated => { root.generate-requested(); }
                }
            }
        }
    }

    if root.is-generating: KitCard {
        level: SurfaceLevel.flat;
        inset: none;
        gap: none;

        VerticalLayout {
            padding-top: 20px;
            padding-bottom: 20px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 14px;

            SummaryTitle { }
            KitProgress {
                mode: ProgressMode.indeterminate;
                bar-fill: @linear-gradient(90deg, Theme.brand 0%, Theme.accent-tint 100%);
                caption: root.generation-progress != "" ? root.generation-progress : @tr("Génération en cours...");
                accessible-label: self.caption;
            }
        }
    }

    if root.summary != "" && !root.is-generating: KitCard {
        level: SurfaceLevel.flat;
        inset: none;
        gap: none;

        VerticalLayout {
            padding-top: 24px;
            padding-bottom: 24px;
            padding-left: 26px;
            padding-right: 26px;
            spacing: 20px;

            SummaryTitle {
                model-label: root.summary-model-label;

                // MeetingSummarySection.svelte's CopyButton: copies the summary as stored.
                CompactButton {
                    accessible-name: @tr("Copier le résumé");
                    text: root.just-copied ? @tr("Copié") : @tr("Copier");
                    intent: ButtonIntent.quiet;
                    leading-icon: root.just-copied ? LucideNotifications.check() : LucideText.copy();
                    activated => { root.copy-summary(); }
                }
            }

            if root.generation-error != "": BannerAlert {
                severity: AlertSeverity.error;
                message: @tr("La génération du résumé a échoué : {}", root.generation-error);
            }

            if root.summary-is-stale: KitAlert { bordered: false;
                corner-radius: 12px;
                inset: 9px;
                message-size: Typography.hint.size;
                severity: AlertSeverity.warning;
                message: @tr("Résumé obsolète (audio ajouté depuis)");
            }

            if root.key-points.length > 0: KitStack {
                gap: none;
                spacing: 12px;

                AppText {
                    text: @tr("Points clés").to-uppercase();
                    accessible-label: @tr("Points clés");
                    typography: Typography.timeline-heading;
                    color: Theme.text-muted;
                }
                for point[index] in root.key-points: HorizontalLayout {
                    spacing: 12px;

                    AppText {
                        text: (index + 1) + ".";
                        typography: Typography.mono-emphasis;
                        // The point's line box, so both first lines sit level.
                        line-height-factor: 1.28;
                        color: Theme.accent;
                        horizontal-stretch: 0;
                        vertical-alignment: top;
                    }
                    AppText {
                        text: point;
                        typography: Typography.reading;
                        line-height-factor: 1.28;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }

            if root.summary-body != "": AppText {
                text: root.summary-body;
                typography: Typography.reading;
                line-height-factor: 1.28;
                color: Theme.text-primary;
                wrap: word-wrap;
            }

            if root.decisions.length > 0 || root.action-items.length > 0 || root.open-questions.length > 0: KitDivider { }

            if root.decisions.length > 0 || root.action-items.length > 0 || root.open-questions.length > 0: KitInline {
                gap: roomy;
                alignment: stretch;

                if root.decisions.length > 0: SummaryColumn {
                    title: @tr("Décisions");
                    for decision in root.decisions: SummaryBullet { text: decision; }
                }
                if root.action-items.length > 0: SummaryColumn {
                    title: @tr("Actions");
                    for item in root.action-items: KitStack {
                        gap: none;

                        AppText {
                            text: item.text;
                            typography: Typography.field-label;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        if item.owner != "": AppText {
                            text: @tr("→ {}", item.owner);
                            typography: Typography.mono-small;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.open-questions.length > 0: SummaryColumn {
                    title: @tr("Questions ouvertes");
                    for question in root.open-questions: SummaryBullet { text: question; }
                }
            }

            if root.available-models.length > 0: KitDivider { }

            if root.available-models.length > 0: SummaryModelRow {
                models: root.available-models;
                model-ids: root.available-model-ids;
                selected-id <=> root.selected-model-id;
                action-name: @tr("Régénérer");
                action-label: @tr("Régénérer");
                action-triggered => { root.generate-requested(); }
            }
        }
    }
}
