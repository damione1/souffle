import { AppText, Typography } from "@typography";
import { ButtonIntent, ChatBubbleTone, ChatSide, ControlSize, ControlWidth, FieldDecoration, KitButton, KitCard, KitChatBubble, KitLayoutMetrics, KitPressable, KitSearchField, KitSegmentedControl, KitText, KitThemeContext, LayoutSpace, ListView, OptionRow, Ownership, SegmentedAppearance, SurfaceLevel, TypographyRole } from "@kit";
import { LucideText } from "@kit-icons/text.slint";
import { LucideNotifications } from "@kit-icons/notifications.slint";
import { Theme } from "../theme.slint";
import { TranscriptWord, TranscriptWordFlow, DictionaryAliasPopover, TranscriptNaturalWidth } from "transcript_words.slint";
export { TranscriptWord }
import { SpeakerRole } from "../types.slint";

// Port of MeetingTranscriptSection.svelte - paragraph grouping with speaker
// labels and session-break dividers, click-to-seek on a paragraph's
// timestamp, virtualized scrolling (the kit list), and per-word dictionary-alias
// popover (TranscriptWordLine.svelte, milestone 8d). Not yet ported: bulk
// edit mode (the "Edit" affordance next to this title) - copying and
// exporting the transcript (SOU-195-slice) don't need it.

export enum TranscriptLayout { conversation, text }

// Display names of the Me/Them lanes, shared by this post-meeting view
// and the live view (recording_view.slint).
export global SpeakerLabels {
    pure public function of(role: SpeakerRole) -> string {
        if role == SpeakerRole.me { return @tr("Moi"); }
        return @tr("Eux");
    }
}

export struct TranscriptBlock {
    can-edit: bool,
    is-session-break: bool,
    // Diarized lane of the paragraph. `has-speaker` false means an
    // undiarized (mono) paragraph: no label at all, `speaker` is then
    // meaningless. The label text is `SpeakerLabels.of()`, above, so it is
    // translated with the rest of the UI instead of arriving as a French
    // string built in Rust (SOU-246).
    has-speaker: bool,
    speaker: SpeakerRole,
    timestamp: string,
    text: string,
    // SOU-223: rendered as a `FlexboxLayout` of `Text`/`TouchArea` items
    // (see the `words` loop below) instead of a `StyledText` Markdown link
    // render. The previous approach could make a word clickable but could
    // not stop `StyledText`'s `Style::Link` from forcing an underline
    // painted with the same brush as the glyph fill (`i-slint-core`'s
    // `textlayout/sharedparley.rs`) - no public property could suppress
    // that independently of link color. `FlexboxLayout` with `flex-wrap`
    // gives natural paragraph reflow without going through `StyledText` at
    // all, so a clickable word is just a `Text` with normal styling inside
    // a `TouchArea`, no link semantics and no underline. Only became viable
    // once Slint moved `FlexboxLayout` from `builtin_experimental()` to the
    // stable builtin set in 1.18.1 (SOU-223 bumped the pin from 1.17.1).
    words: [TranscriptWord],
    // -1 when the paragraph isn't attributed to any recorded audio session.
    recording-session-index: int,
    start-time: float,
    end-time: float,
    end-label: string,
    start-label: string,
}

// The search, layout and copy controls of the transcript view. They sit above
// the page's scroll region, so they stay on screen while the list scrolls.
export component TranscriptToolbar inherits KitCard {
    in-out property <string> search;
    in-out property <TranscriptLayout> layout: TranscriptLayout.conversation;
    in property <bool> can-copy: true;

    callback search-changed(string);
    // Rust renders the text fresh from the whole meeting, whatever the search
    // currently shows.
    callback copy-requested();

    property <bool> just-copied: false;
    property <[OptionRow]> layout-options: [
        { token: 0, generation: 0, label: @tr("Conversation"), description: "", disabled: false },
        { token: 1, generation: 0, label: @tr("Texte"), description: "", disabled: false },
    ];
    function copy-transcript() {
        root.copy-requested();
        root.just-copied = true;
    }
    Timer {
        interval: 1.5s;
        running: root.just-copied;
        triggered => { root.just-copied = false; }
    }

    level: SurfaceLevel.raised;
    inset: none;
    gap: none;

    HorizontalLayout {
        padding: 10px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            KitSearchField {
                control-size: ControlSize.compact;
                decoration: FieldDecoration.bare;
                leading-icon-ink: Theme.text-muted;
                padding-inline: 4px;
                clear-label: @tr("Effacer");
                accessible-name: @tr("Rechercher dans la transcription");
                placeholder: @tr("Rechercher dans la transcription");
                text <=> root.search;
                edited(text) => { root.search-changed(text); }
            }
        }

        KitSegmentedControl {
            ownership: Ownership.controlled;
            appearance: SegmentedAppearance.raised;
            control-width: ControlWidth.intrinsic;
            horizontal-stretch: 0;
            control-size: ControlSize.compact;
            label: @tr("Affichage de la transcription");
            options: root.layout-options;
            selected: { present: true, token: root.layout == TranscriptLayout.text ? 1 : 0 };
            chosen(row) => { root.layout = row.token == 1 ? TranscriptLayout.text : TranscriptLayout.conversation; }
        }

        if root.can-copy: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            KitButton {
                accessible-name: @tr("Copier la transcription");
                text: root.just-copied ? @tr("Copié") : @tr("Copier");
                control-size: ControlSize.compact;
                intent: ButtonIntent.quiet;
                leading-icon: root.just-copied ? LucideNotifications.check() : LucideText.copy();
                activated => { root.copy-transcript(); }
            }
        }
    }
}

// The kit button takes no typography role, so the mono time is its own label.
component TimestampButton inherits KitPressable {
    in property <string> text;

    control-size: ControlSize.compact;
    intent: ButtonIntent.quiet;
    min-height: 24px;
    padding-inline: 8px;
    padding-block: 0px;
    preferred-width: label.preferred-width + 2 * self.padding-inline;
    min-width: self.preferred-width;

    label := AppText {
        text: root.text;
        typography: Typography.mono-small;
        color: root.disabled ? Theme.text-faint : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component TranscriptRowHeader inherits HorizontalLayout {
    in property <TranscriptBlock> block;
    in property <bool> has-audio;
    in property <bool> mirrored;
    callback seek-requested();

    spacing: 2 * KitThemeContext.current.spacing.unit;
    alignment: root.mirrored ? end : start;

    if root.mirrored: TimestampButton {
        accessible-name: @tr("Aller à {}", root.block.timestamp);
        text: root.block.timestamp;
        disabled: !root.has-audio;
        activated => { root.seek-requested(); }
    }

    if root.block.has-speaker: AppText {
        text: SpeakerLabels.of(root.block.speaker);
        typography: Typography.secondary-emphasis;
        color: root.block.speaker == SpeakerRole.me ? Theme.accent : Theme.secondary;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    if !root.mirrored: TimestampButton {
        accessible-name: @tr("Aller à {}", root.block.timestamp);
        text: root.block.timestamp;
        disabled: !root.has-audio;
        activated => { root.seek-requested(); }
    }
}

// One paragraph or session break of the list, with the gap below it. A direct
// child of the list's repeater, so it is created only while it is on screen.
component TranscriptRow inherits Rectangle {
    in property <TranscriptBlock> block;
    in property <bool> has-audio;
    in property <TranscriptLayout> layout;
    in property <bool> playing;
    // The width of the centred reading column inside the full-width row.
    in property <length> column-width;
    in property <length> gap-above;
    in property <length> gap-below;

    callback seek-requested();
    callback word-clicked(string, length, length);
    callback background-clicked();

    property <length> unit: KitThemeContext.current.spacing.unit;
    property <length> ring-width: 2px;
    // KitChatBubble pads its content slot by 3.5 units on every side.
    property <length> bubble-padding: 3.5 * root.unit;
    // `content-share` only splits spare space, so a long paragraph also needs a
    // cap on its natural width to wrap.
    property <float> bubble-share: 0.78;
    property <length> bubble-text-limit: root.bubble-share * root.column-width - 2 * root.bubble-padding;
    property <bool> mine: root.block.speaker == SpeakerRole.me && root.block.has-speaker;
    // A paragraph this long is wider than the cap whatever its glyphs are (no
    // text averages under 0.29 em a character), so its one-line width is not
    // measured: that costs a second text per word.
    property <bool> fills-bubble: root.block.text.character-count * Typography.reading.size * 0.29 >= root.bubble-text-limit;

    // The list keeps unhandled presses, so the page could never see them.
    TouchArea {
        clicked => { root.background-clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        padding-top: root.gap-above;
        padding-bottom: root.gap-below;

        VerticalLayout {
            width: root.column-width;

            if !root.block.is-session-break: VerticalLayout {
                spacing: 5px;

                TranscriptRowHeader {
                    block: root.block;
                    has-audio: root.has-audio;
                    mirrored: root.layout == TranscriptLayout.conversation && root.mine;
                    seek-requested => { root.seek-requested(); }
                }

                // SOU-223: click-to-correct words, no underline and no
                // link look. Always the word flow, never swapped for a
                // wrapped Text on hover: the two break lines differently
                // (SOU-258).
                if root.layout == TranscriptLayout.conversation: KitChatBubble {
                    side: root.mine ? ChatSide.end : ChatSide.start;
                    tone: root.mine ? ChatBubbleTone.accent-subtle : ChatBubbleTone.muted;
                    content-share: root.bubble-share;
                    hug: true;

                    Rectangle {
                        preferred-width: root.fills-bubble ? root.bubble-text-limit : min(one-line.preferred-width, root.bubble-text-limit);
                        preferred-height: bubble-flow.preferred-height;

                        one-line := TranscriptNaturalWidth {
                            // Positioned, so its unwrapped min-width does not
                            // propagate to the bubble and defeat the cap.
                            x: 0px;
                            y: 0px;
                            words: root.fills-bubble ? [] : root.block.words;
                            typography: Typography.reading;
                        }

                        if root.playing: playing-ring := Rectangle {
                            x: -root.bubble-padding - root.ring-width;
                            y: -root.bubble-padding - root.ring-width;
                            width: parent.width + 2 * (root.bubble-padding + root.ring-width);
                            height: parent.height + 2 * (root.bubble-padding + root.ring-width);
                            border-width: root.ring-width;
                            border-color: Theme.brand;
                            border-radius: KitThemeContext.current.shape.radius-container + root.ring-width;
                        }

                        bubble-flow := TranscriptWordFlow {
                            width: parent.width;
                            words: root.block.words;
                            typography: Typography.reading;
                            line-ratio: 1.55;
                            word-clicked(word, at-x, at-y) => { root.word-clicked(word, at-x, at-y); }
                        }
                    }
                }

                if root.layout == TranscriptLayout.text: TranscriptWordFlow {
                    words: root.block.words;
                    word-clicked(word, at-x, at-y) => { root.word-clicked(word, at-x, at-y); }
                }
            }

            if root.block.is-session-break: HorizontalLayout {
                spacing: 3 * root.unit;

                VerticalLayout {
                    alignment: center;
                    Rectangle { height: 1px; background: Theme.line; }
                }
                AppText {
                    text: @tr("Fin de l'enregistrement précédent") + " · " + @tr("Nouvelle session d'enregistrement");
                    typography: Typography.caption;
                    color: Theme.text-faint;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle { height: 1px; background: Theme.line; }
                }
            }
        }
    }
}

// The transcript and its scroller. `blocks` is the whole (or searched)
// transcript: the kit list creates a row only while it is on screen, lays it out
// at its real height and estimates the rest for the scroll bar, so no height is
// guessed here and scrolling costs the same whatever the meeting length.
export component TranscriptSection inherits Rectangle {
    in property <[TranscriptBlock]> blocks;
    in property <int> segment-count;
    in property <bool> has-audio: false;
    in property <TranscriptLayout> layout: TranscriptLayout.conversation;
    // True while a search narrows the list, so an empty list reads as "no
    // match" and not as an empty meeting.
    in property <bool> filtered: false;
    // The paragraph holding the audio position gets the brand ring.
    in property <float> audio-position-seconds: 0.0;
    in property <int> audio-session-index: -1;
    // The width of the reading column, centred in the list.
    in property <length> column-width: 820px;
    // Free space under the last paragraph.
    in property <length> bottom-inset: 0px;
    in-out property <length> scroll-top <=> list.content-y;
    // How far the list can scroll, from its current height estimate.
    out property <length> scroll-travel: max(0px, list.content-height - list.visible-height);

    // (recording-session-index, start-time) of the clicked paragraph.
    callback paragraph-clicked(int, float);
    // (term, pronunciation) once the user saves the alias popover.
    callback alias-save-requested(string, string);
    // A click on the transcript that no word or timestamp handled - lets
    // the page drop keyboard focus from the title field.
    callback background-clicked();

    property <length> row-gap: KitLayoutMetrics.space(KitThemeContext.current, LayoutSpace.regular);

    pure function playing(block: TranscriptBlock) -> bool {
        return root.has-audio
            && (block.recording-session-index < 0 || block.recording-session-index == root.audio-session-index)
            && root.audio-position-seconds >= block.start-time
            && root.audio-position-seconds < block.end-time;
    }

    // One shared popover rather than one instance per word. Opens under
    // the clicked word.
    alias-popup := DictionaryAliasPopover {
        save-requested(term, pronunciation) => { root.alias-save-requested(term, pronunciation); }
    }

    if root.segment-count == 0 || (root.filtered && root.blocks.length == 0): HorizontalLayout {
        alignment: center;

        VerticalLayout {
            width: root.column-width;
            alignment: start;

            empty-note := KitText {
                text: root.segment-count == 0
                    ? @tr("Aucun texte transcrit pour cette r\u{e9}union.")
                    : @tr("Aucun passage ne correspond à la recherche.");
                role: TypographyRole.caption;
            }
        }
    }

    list := ListView {
        width: 100%;
        height: 100%;
        overlay-scrollbars: true;
        horizontal-scrollbar-policy: always-off;

        for block[index] in root.blocks: TranscriptRow {
            width: list.visible-width;
            block: block;
            has-audio: root.has-audio;
            layout: root.layout;
            playing: root.playing(block);
            column-width: root.column-width;
            gap-above: index == 0 ? root.row-gap : 0px;
            gap-below: index + 1 == root.blocks.length ? root.row-gap + root.bottom-inset : root.row-gap;
            seek-requested => { root.paragraph-clicked(block.recording-session-index, block.start-time); }
            word-clicked(word, at-x, at-y) => { alias-popup.open(word, at-x, at-y); }
            background-clicked => { root.background-clicked(); }
        }
    }
}
