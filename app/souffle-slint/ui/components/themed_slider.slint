import { Theme } from "../theme.slint";

// Port of the volume slider in FeedbackSoundsSettingsSection. Stock Slider
// uses a Fluent blue track that ignores Theme.
export component ThemedSlider inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;
    in property <string> control-label: @tr("Valeur");

    callback changed(int);

    width: 140px;
    height: 18px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.5;
    border-width: key-focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    border-radius: 4px;

    accessible-role: slider;
    accessible-label: root.control-label;
    accessible-enabled: root.enabled;
    accessible-read-only: !root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(v) => {
        if root.enabled && v.is-float() {
            root.publish(round(v.to-float()));
        }
    }
    accessible-action-increment => { root.increment(); }
    accessible-action-decrement => { root.decrement(); }

    forward-focus: key-focus;

    key-focus := FocusScope {
        key-pressed(event) => {
            if !root.enabled {
                return reject;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.decrement();
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.increment();
                return accept;
            }
            if event.text == Key.Home {
                root.publish(root.minimum);
                return accept;
            }
            if event.text == Key.End {
                root.publish(root.maximum);
                return accept;
            }
            return reject;
        }
    }

    property <float> fraction: root.maximum <= root.minimum
        ? 0
        : max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));

    Rectangle {
        y: 7px;
        height: 4px;
        width: parent.width;
        border-radius: 2px;
        background: Theme.surface-3;
    }
    Rectangle {
        y: 7px;
        height: 4px;
        width: parent.width * root.fraction;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: parent.width * root.fraction - 7px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        border-width: 1px;
        border-color: Theme.ghost-border;
    }

    track := TouchArea {
        enabled: root.enabled;
        // SOU-217: drive the fraction from this TouchArea's own geometry
        // (`self.mouse-x` / `self.width`) instead of the parent `root`'s.
        // Both happen to match today (TouchArea has no explicit geometry,
        // so it expands to fill `root`), but computing the ratio from two
        // different elements' properties was a latent trap: any future
        // padding/margin added around the track (or a change to how this
        // TouchArea is sized) would silently desync `mouse-x`'s origin from
        // the denominator, producing a fraction that no longer lines up
        // with the pointer - i.e. exactly the "erratic" drag this ticket
        // reports. Keeping both halves of the ratio on `self` makes the
        // mapping correct by construction.
        //
        // `pointer-event` (Down) additionally snaps the thumb to the
        // initial press position immediately, matching native slider
        // behaviour: previously a press-and-hold with no movement left the
        // thumb untouched until either a `moved` (drag) or the matching
        // `clicked` (release) fired, which made a click that started a
        // (later aborted) drag look like it had been silently ignored.
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                key-focus.focus();
                root.apply(self.mouse-x, self.width);
            }
        }
        moved => {
            if (self.pressed) {
                root.apply(self.mouse-x, self.width);
            }
        }
        clicked => {
            root.apply(self.mouse-x, self.width);
        }
    }

    function publish(candidate: int) {
        if !root.enabled {
            return;
        }
        let bounded = max(root.minimum, min(root.maximum, candidate));
        if bounded != root.value {
            root.changed(bounded);
        }
    }

    function increment() {
        root.publish(root.value + root.step);
    }

    function decrement() {
        root.publish(root.value - root.step);
    }

    function apply(mouse-x: length, track-width: length) {
        if !root.enabled || track-width <= 0px {
            return;
        }
        root.publish(round(root.minimum + (root.maximum - root.minimum) * max(0, min(1, mouse-x / track-width))));
    }
}
