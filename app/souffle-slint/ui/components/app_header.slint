import { ButtonIntent, ControlSize, ElevationLevel, KitBadge, KitIconButton, KitImage, KitWrap, KitSurface, KitDivider, KitText, KitLayoutMetrics, KitMetrics, Tone } from "@kit";
import { LucideAccount } from "@kit-icons/account.slint";
import { LucideAccessibility } from "@kit-icons/accessibility.slint";
import { AppText, Typography } from "@typography";
import { Theme } from "../theme.slint";
import { TranscriptionLabels } from "transcription_labels.slint";
import { RecordingMode, TranscriptionPhase } from "../types.slint";

// macOS draws its traffic lights over this region. The native window owns dragging.
export component AppHeader inherits KitSurface {
    in property <bool> settings-open: false;
    in property <TranscriptionPhase> model-phase;
    in property <RecordingMode> recording-mode: RecordingMode.idle;
    in property <string> model-label: "";

    callback settings-toggled();
    // main.rs flips the real `Theme.dark` (and persists the choice) on this
    // callback - the icon below reads `Theme.dark` directly rather than
    // keeping its own copy, so it can't drift from the actual palette.
    callback theme-toggle-requested();

    property <string> status-label: root.model-phase == TranscriptionPhase.failed ? @tr("Erreur du modèle")
        : root.model-phase == TranscriptionPhase.audio-failed ? @tr("Erreur de capture audio")
        : root.recording-mode != RecordingMode.idle ? @tr("Enregistrement")
        : root.model-phase == TranscriptionPhase.download-required ? @tr("Téléchargement requis")
        : root.model-phase == TranscriptionPhase.downloading ? @tr("Téléchargement…")
        : root.model-phase == TranscriptionPhase.load-required ? @tr("Chargement requis")
        : root.model-phase == TranscriptionPhase.loading ? @tr("Chargement…")
        : root.model-phase == TranscriptionPhase.ready ? @tr("Prêt")
        : root.model-phase == TranscriptionPhase.unloading ? @tr("Déchargement…")
        : "";
    property <bool> show-model-label: root.recording-mode == RecordingMode.idle && root.model-phase == TranscriptionPhase.ready && root.model-label != "";

    public function focus-settings() { settings-area.take-focus(); }
    border: none;
    elevation: ElevationLevel.none;
    corner-radius: 0px;
    inset: none;
    gap: none;
    background: root.theme.canvas;
    max-height: self.preferred-height;

    bar := KitWrap {
        flex-wrap: no-wrap;
        cross-axis-alignment: center;
        theme: root.theme;
        alignment: space-between;
        padding-left: 100px; // Native traffic-light clearance.
        padding-right: 20px;
        padding-top: KitLayoutMetrics.space(root.theme, compact);
        padding-bottom: self.padding-top;
        min-height: Theme.header-height;
        brand := KitWrap {
            flex-wrap: no-wrap;
            cross-axis-alignment: center;
            theme: root.theme;
            spacing: 12px;
            logo := KitImage {
                theme: root.theme;
                width: 26px;
                source: @image-url("../assets/icon.png");
            }
            AppText {
                typography: Typography.action-strong;
                color: Theme.text-primary;
                wrap: no-wrap;
                overflow: elide;
                min-width: 0px;
                max-width: max(0px, root.width - bar.padding-left - bar.padding-right
                    - bar.spacing - 26px - brand.spacing - status.preferred-width
                    - 2 * KitMetrics.control-height(root.theme, ControlSize.medium) - 2 * actions.spacing);
                text: @tr("Soufflé");
                vertical-alignment: center;
            }
        }
        actions := KitWrap {
            flex-wrap: no-wrap;
            cross-axis-alignment: center;
            theme: root.theme;
            spacing: 12px;
            if root.show-model-label: KitText {
                theme: root.theme;
                text: root.model-label == "__APPLE_SPEECH_SYSTEM__" ? TranscriptionLabels.speech-short-label() : root.model-label;
                role: caption;
                min-width: 0px;
                max-width: max(0px, root.width - bar.padding-left - bar.padding-right
                    - 2 * bar.spacing - brand.preferred-width - status.preferred-width
                    - 2 * KitMetrics.control-height(root.theme, ControlSize.medium) - 3 * parent.spacing);
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
            status := KitBadge {
                theme: root.theme;
                text: root.status-label;
                tone: root.recording-mode != RecordingMode.idle ? Tone.danger
                    : root.model-phase == TranscriptionPhase.ready ? Tone.accent : Tone.warning;
                subtle: true;
                dot: true;
            }
            theme-area := KitIconButton {
                theme: root.theme;
                accessible-name: @tr("Basculer clair / sombre");
                control-size: medium;
                glyph: Theme.dark ? LucideAccessibility.sun() : LucideAccessibility.moon();
                activated => { root.theme-toggle-requested(); }
            }
            settings-area := KitIconButton {
                theme: root.theme;
                accessible-name: @tr("Réglages");
                control-size: medium;
                intent: root.settings-open ? ButtonIntent.secondary : ButtonIntent.quiet;
                glyph: LucideAccount.sliders-horizontal();
                activated => { root.settings-toggled(); }
            }
        }
    }
    rule := KitDivider { theme: root.theme; }
}
