import { AvatarShape, ButtonIntent, ControlSize, KitAvatar, KitButton, KitDivider, KitIcon, KitPressable, Tone } from "@kit";
import { LucideCursors } from "@kit-icons/cursors.slint";
import { LucideAccount } from "@kit-icons/account.slint";
import { LucideText } from "@kit-icons/text.slint";
import { LucideFiles } from "@kit-icons/files.slint";
import { LucideArrows } from "@kit-icons/arrows.slint";
import { AppText, AppNumericText, Typography } from "@typography";
import { TimelineKind } from "../types.slint";
import { ActionGuards, MeetingDeletePermission } from "../action_guards.slint";
import { Theme } from "../theme.slint";

// Port of features/timeline/components/TimelineItem.svelte. Struct name
// avoids "TimelineItem" itself: Slint generates a Rust type of the same
// name, and that name is also the Svelte component's - kept distinct to
// avoid confusing the two in Rust.
export struct HistoryEntry {
    kind: TimelineKind,
    id: string,
    title: string,
    time-label: string,
    duration-label: string,
    has-summary: bool,
    summary-is-stale: bool,
}

export component TimelineItemRow inherits Rectangle {
    in property <HistoryEntry> entry;
    in property <bool> is-live: false;
    in property <bool> expanded: false;
    in property <bool> first: false;

    // Driven by the parent list (`TimelineSection`), not owned locally: a
    // plain `TouchArea` click doesn't grab keyboard focus in Slint, so a
    // local `focus-lost`-based reset never fired when clicking a *different*
    // row - only a single shared "which row is confirming" id one level up
    // can be cleared by any other row's click. See `TimelineSection`'s
    // `confirming-delete-id`.
    in property <bool> confirming-delete: false;
    callback opened();
    callback removed();
    callback copy-requested();
    callback confirm-delete-requested();

    property <MeetingDeletePermission> delete-permission: ActionGuards.meeting-delete(root.entry.id, ActionGuards.revision);
    property <bool> delete-blocked: root.entry.kind == TimelineKind.meeting && root.delete-permission.blocked;
    property <bool> copied: false;
    property <bool> is-dictation: root.entry.kind == TimelineKind.dictation;
    // Action buttons also stay visible while navigating the row by keyboard.
    property <bool> actions-visible: root.confirming-delete || row-area.hovered || row-area.has-focus || copy-area.hovered || copy-area.has-focus || delete-area.hovered || delete-area.has-focus;

    Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    VerticalLayout {
        alignment: start;

        if root.delete-blocked: HorizontalLayout {
            padding-left: 48px;
            padding-right: 16px;
            AppText {
                text: ActionGuards.reason(root.delete-permission);
                typography: Typography.caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        if !root.first: KitDivider {}

        content := Rectangle {
        background: root.actions-visible ? Theme.surface-2 : transparent;

        row-area := KitPressable {
            intent: ButtonIntent.quiet;
            padding-inline: 0px;
            padding-block: 0px;
            accessible-name: root.entry.title;
            activated => {
                root.opened();
            }
        }
        HorizontalLayout {
            padding-top: 13px;
            padding-bottom: 13px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 14px;

            VerticalLayout {
                alignment: root.is-dictation && root.expanded ? start : center;
                horizontal-stretch: 0;

                KitAvatar {
                    shape: AvatarShape.rounded;
                    size: 32px;
                    bordered: false;
                    decorative: true;
                    tone: root.is-dictation ? Tone.neutral : Tone.accent;
                    muted: root.is-dictation;
                    fallback-icon: root.is-dictation ? LucideFiles.file-text() : LucideAccount.users();
                }
            }

            // Collapsed: one line + ellipsis if it does not fit.
            // Expanded: same Text unwraps in place, so the hidden
            // remainder appears under the first line instead of a
            // second copy of the whole dictation.
            AppText {
                text: root.entry.title;
                wrap: root.is-dictation && root.expanded ? word-wrap : no-wrap;
                overflow: root.is-dictation && root.expanded ? clip : elide;
                horizontal-stretch: 1;
                // A collapsed title shares the action row's visual
                // axis. Expanded dictations still grow downward.
                vertical-alignment: root.is-dictation && root.expanded ? top : center;
                typography: Typography.field-label;
                color: Theme.text-primary;
            }

            VerticalLayout {
                alignment: start;
                vertical-stretch: 0;
                // Trailing column (duration, time, copy, delete/confirm):
                // only its children have widths, not the column itself,
                // so without this it keeps the default non-zero stretch
                // and competes with the title `Text` for leftover space.
                // Pin it to exactly its content width, so the title is
                // the only thing that grows or elides, and the
                // "Confirmer" pill widening the delete slot can only take
                // space from the title, never from the time (SOU-215).
                horizontal-stretch: 0;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    if root.entry.has-summary: KitIcon {
                        glyph: {stroke: LucideCursors.sparkles().stroke, fill: LucideCursors.sparkles().stroke, viewbox: LucideCursors.sparkles().viewbox};
                        ink: root.entry.summary-is-stale ? Theme.warning : Theme.accent;

                        width: 15px; height: 15px;
                        y: (parent.height - self.height) / 2;
                    }

                    AppNumericText {
                        text: root.entry.duration-label;
                        width: Theme.row-duration-width;
                        horizontal-alignment: right;
                        text-color: Theme.text-muted;
                        typography: Typography.small;
                        vertical-alignment: center;
                    }

                    AppNumericText {
                        text: root.entry.time-label;
                        width: Theme.row-timeline-time-width;
                        horizontal-alignment: right;
                        text-color: Theme.text-muted;
                        typography: Typography.small;
                        vertical-alignment: center;
                    }

                    copy-area := KitButton {
                        visible: root.is-dictation;
                        disabled: !root.is-dictation;
                        control-size: ControlSize.compact;
                        intent: ButtonIntent.quiet;
                        padding-inline: 4px;
                        text: root.copied ? @tr("Copié !") : @tr("Copier");
                        leading-icon: LucideText.copy();
                        opacity: root.actions-visible ? 1 : 0;
                        activated => { root.copy-requested(); root.copied = true; }
                    }

                    delete-area := KitButton {
                        disabled: root.delete-blocked;
                        control-size: ControlSize.compact;
                        padding-inline: 4px;
                        intent: root.confirming-delete && !root.delete-blocked ? ButtonIntent.destructive : ButtonIntent.quiet;
                        accessible-name: root.delete-blocked ? ActionGuards.reason(root.delete-permission) : root.confirming-delete ? @tr("Confirmer la suppression") : @tr("Supprimer");
                        text: root.confirming-delete && !root.delete-blocked ? @tr("Confirmer") : "";
                        leading-icon: root.confirming-delete && !root.delete-blocked ? { stroke: "", fill: "", viewbox: 24 }
                            : root.actions-visible ? LucideFiles.trash() : LucideArrows.chevron-right();
                        opacity: root.actions-visible || root.entry.kind == TimelineKind.meeting ? 1 : 0;
                        activated => {
                            if root.delete-blocked { return; }
                            if root.confirming-delete { root.removed(); }
                            else { root.confirm-delete-requested(); }
                        }
                    }
                }
            }
        }
        }
    }
}
