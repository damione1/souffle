import { AppText, Typography } from "@typography";
import { ButtonIntent, IconGlyph, KitBadge, KitIcon, KitPressable, KitThemeContext } from "@kit";
import { LucideAccount } from "@kit-icons/account.slint";
import { LucideCommunication } from "@kit-icons/communication.slint";
import { Theme } from "../theme.slint";

component CaptureAction inherits KitPressable {
    in property <IconGlyph> glyph;
    in property <color> ink;
    in property <string> title;
    in property <length> subtitle-height;
    out property <length> natural-subtitle-height: subtitle-content.preferred-height;

    intent: ButtonIntent.outline;
    padding-block: 0px;
    padding-inline: 0px;
    min-height: content.preferred-height;

    content := HorizontalLayout {
        padding: KitThemeContext.current.spacing.unit * 4;
        spacing: KitThemeContext.current.spacing.unit * 3;
        alignment: start;

        VerticalLayout {
            alignment: center;
            KitIcon {
                glyph: root.glyph;
                ink: root.ink;
                width: 22px;
                height: 22px;
            }
        }

        VerticalLayout {
            spacing: KitThemeContext.current.spacing.unit;
            alignment: center;
            AppText {
                text: root.title;
                typography: Typography.action-title;
                color: Theme.text-primary;
            }

            VerticalLayout {
                height: root.subtitle-height;
                alignment: center;
                subtitle-content := HorizontalLayout {
                    alignment: start;
                    spacing: KitThemeContext.current.spacing.unit;
                    @children
                }
            }
        }
    }
}

export component ActionHero inherits HorizontalLayout {
    in property <string> dictation-shortcut;
    in property <bool> model-ready: true;
    in property <bool> actions-enabled: true;
    property <bool> can-start: root.model-ready && root.actions-enabled;

    callback dictate-requested();
    callback meeting-requested();

    spacing: KitThemeContext.current.spacing.unit * 3;
    property <length> subtitle-height: max(dictate.natural-subtitle-height, meeting.natural-subtitle-height);

    dictate := CaptureAction {
        width: (root.width - root.spacing) / 2;
        subtitle-height: root.subtitle-height;
        disabled: !root.can-start;
        accessible-name: @tr("Démarrer une dictée");
        activated => { root.dictate-requested(); }
        title: @tr("Dicter");
        glyph: LucideCommunication.mic();
        ink: Theme.accent;

        AppText {
            text: root.dictation-shortcut == "" ? @tr("Définissez un raccourci") : @tr("Appuyez sur");
            typography: Typography.hint;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        if root.dictation-shortcut != "": KitBadge { text: root.dictation-shortcut; }
    }

    meeting := CaptureAction {
        width: (root.width - root.spacing) / 2;
        subtitle-height: root.subtitle-height;
        disabled: !root.can-start;
        accessible-name: @tr("Démarrer une réunion");
        activated => { root.meeting-requested(); }
        title: @tr("Démarrer une réunion");
        glyph: LucideAccount.users();
        ink: Theme.secondary;

        AppText {
            text: @tr("Transcrire en direct avec l’audio système");
            typography: Typography.hint;
            color: Theme.text-muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
