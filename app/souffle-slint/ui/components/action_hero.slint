import { AppText, Typography } from "@typography";
import { AvatarShape, ButtonIntent, ButtonRecipe, ControlSize, IconGlyph, KitAvatar, KitKeycap, KitPressable, KitThemeContext, KitThemes, SurfaceLevel } from "@kit";
import { LucideAccount } from "@kit-icons/account.slint";
import { LucideCommunication } from "@kit-icons/communication.slint";
import { Theme } from "../theme.slint";

component CaptureAction inherits KitPressable {
    in property <IconGlyph> glyph;
    in property <color> ink;
    in property <color> tint;
    in property <string> title;
    in property <length> subtitle-height;
    out property <length> natural-subtitle-height: subtitle-content.preferred-height;

    private property <ButtonRecipe> base: KitThemes.button-recipe(KitThemeContext.current, ButtonIntent.outline, ControlSize.medium);
    intent: ButtonIntent.outline;
    recipe: {
        fill: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).fill,
        hover-fill: KitThemeContext.current.hover,
        pressed-fill: KitThemeContext.current.pressed,
        disabled-fill: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).fill,
        foreground: root.base.foreground,
        disabled-foreground: root.base.disabled-foreground,
        border: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).border,
        radius: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).radius,
        padding-inline: 0px,
        padding-block: 0px,
        border-width: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).border-width,
        elevation: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).elevation,
        shadow: KitThemes.surface-recipe(KitThemeContext.current, SurfaceLevel.raised).shadow,
        focus: root.base.focus,
    };
    padding-block: 0px;
    padding-inline: 0px;
    min-height: content.preferred-height;

    content := VerticalLayout {
        padding: KitThemeContext.current.spacing.unit * 5;
        spacing: KitThemeContext.current.spacing.unit * 3.5;
        alignment: start;

        HorizontalLayout {
            alignment: start;
            KitAvatar {
                shape: AvatarShape.rounded;
                size: KitThemeContext.current.spacing.unit * 10;
                bordered: false;
                decorative: true;
                fill: root.tint;
                ink: root.ink;
                fallback-icon: root.glyph;
            }
        }

        VerticalLayout {
            spacing: KitThemeContext.current.spacing.unit * 0.75;
            AppText {
                text: root.title;
                typography: Typography.action-title;
                color: Theme.text-primary;
            }

            VerticalLayout {
                height: root.subtitle-height;
                alignment: start;
                subtitle-content := HorizontalLayout {
                    alignment: start;
                    spacing: KitThemeContext.current.spacing.unit * 2;
                    @children
                }
            }
        }
    }
}

export component ActionHero inherits HorizontalLayout {
    in property <string> dictation-shortcut;
    in property <bool> model-ready: true;
    in property <bool> actions-enabled: true;
    property <bool> can-start: root.model-ready && root.actions-enabled;

    callback dictate-requested();
    callback meeting-requested();

    spacing: KitThemeContext.current.spacing.unit * 4;
    property <length> subtitle-height: max(dictate.natural-subtitle-height, meeting.natural-subtitle-height);

    dictate := CaptureAction {
        width: (root.width - root.spacing) / 2;
        subtitle-height: root.subtitle-height;
        disabled: !root.can-start;
        accessible-name: @tr("Démarrer une dictée");
        activated => { root.dictate-requested(); }
        title: @tr("Dicter");
        glyph: LucideCommunication.mic();
        ink: Theme.accent;
        tint: Theme.accent-tint;

        AppText {
            text: root.dictation-shortcut == "" ? @tr("Définissez un raccourci") : @tr("Appuyez sur");
            typography: Typography.hint;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        if root.dictation-shortcut != "": VerticalLayout {
            alignment: center;
            KitKeycap { text: root.dictation-shortcut; }
        }
    }

    meeting := CaptureAction {
        width: (root.width - root.spacing) / 2;
        subtitle-height: root.subtitle-height;
        disabled: !root.can-start;
        accessible-name: @tr("Démarrer une réunion");
        activated => { root.meeting-requested(); }
        title: @tr("Démarrer une réunion");
        glyph: LucideAccount.users();
        ink: Theme.secondary;
        tint: Theme.secondary-tint;

        AppText {
            text: @tr("Transcrire en direct avec l’audio système");
            typography: Typography.hint;
            color: Theme.text-muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
