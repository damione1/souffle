import { AppText, Typography, TypographyStyle } from "@typography";
import { KitModalContext, ButtonIntent, ControlSize, KitButton, KitCard, KitIconButton, KitInline, KitStack, KitTextField, KitWrap, LayoutSpace, SurfaceLevel, Tone } from "@kit";
import { LucideMath } from "@kit-icons/math.slint";
import { Theme } from "../theme.slint";

// Click-a-word -> dictionary alias (SOU-223), shared by the post-meeting
// transcript (transcript_section.slint) and the live meeting view
// (recording_view.slint, SOU-256).

// One token of a paragraph's text (see `TranscriptBlock.words`): either a
// clickable word (dictionary-alias candidate) or a literal run of
// whitespace/punctuation/short/numeric text rendered as-is. Built in Rust
// (`transcript::build_words`) from the same `tokenize_words`/
// `is_clickable_word` logic `build_markdown_text` used to feed `StyledText`.
export struct TranscriptWord {
    // The word/non-whitespace run. This is also the exact dictionary target
    // for clickable entries.
    text: string,
    // Punctuation and whitespace that follow `text`. Keeping both in one
    // Flexbox item prevents a standalone space from wrapping onto the next
    // line while leaving the clickable area limited to `text`.
    trailing-text: string,
    clickable: bool,
    // A word the engine is still holding (tentative): shown dimmed rather
    // than hidden, so a word that was heard is visibly on screen even
    // while its final form is pending.
    provisional: bool,
}

// SOU-223: a paragraph as a wrapping `FlexboxLayout` of `Text` items, a
// clickable word being a plain `Text` in a `TouchArea` - no link styling,
// no underline (see `TranscriptBlock.words` in transcript_section.slint for
// why not `StyledText`).
export component TranscriptWordFlow inherits KitWrap {
    in property <[TranscriptWord]> words;
    in property <TypographyStyle> typography: Typography.content;
    in property <brush> color: Theme.text-primary;
    // An insertion mark after the last word, for the dictation surface.
    in property <bool> caret: false;
    // Line box as a multiple of the font size; 0 keeps the font's own height.
    in property <float> line-ratio: 0;
    // The exact token text of the clicked word, and the window position
    // of its bottom-left corner (where the alias popover opens).
    callback word-clicked(string, length, length);

    gap: none;

    for word in root.words: Rectangle {
        width: word-label.preferred-width + trailing-label.preferred-width;
        height: max(word-label.preferred-height, trailing-label.preferred-height, root.typography.size * root.line-ratio);

        word-area := TouchArea {
            // The item also reserves the trailing text's width. Slint
            // would otherwise center the word in that wider item, making
            // it overlap the punctuation drawn at word-area.width.
            x: 0px;
            width: word-label.preferred-width;
            enabled: word.clickable;
            mouse-cursor: word.clickable ? pointer : default;
            clicked => {
                if word.clickable {
                    root.word-clicked(word.text, self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }

            word-label := AppText {
                text: word.text;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                color: root.color;
                typography: root.typography;
                opacity: word.provisional ? Theme.provisional-opacity : 1.0;
            }
        }

        trailing-label := AppText {
            x: word-area.width;
            y: (parent.height - self.height) / 2;
            text: word.trailing-text;
            width: self.preferred-width;
            color: root.color;
            typography: root.typography;
            opacity: word.provisional ? Theme.provisional-opacity : 1.0;
        }
    }

    if root.caret: Rectangle {
        width: 7px;
        height: root.typography.size * max(1.2, root.line-ratio);

        Rectangle {
            x: 2px;
            y: (parent.height - self.height) / 2;
            width: 5px;
            height: root.typography.size * 1.2;
            background: Theme.accent;
        }
    }
}

// The width of a `TranscriptWordFlow` paragraph on one line, from the same
// separately measured pieces. A wrapping flow's own preferred width is only a
// compact estimate, and the joined text measures narrower than its pieces.
export component TranscriptNaturalWidth inherits HorizontalLayout {
    in property <[TranscriptWord]> words;
    in property <TypographyStyle> typography: Typography.content;
    visible: false;
    width: 0px;
    height: 0px;

    for word in root.words: HorizontalLayout {
        AppText { text: word.text; typography: root.typography; accessible-role: none; }
        AppText { text: word.trailing-text; typography: root.typography; accessible-role: none; }
    }
}

// The "add to dictionary" popover. One instance per view, opened for the
// clicked word with `open(word, x, y)`, which moves this anchor under the
// word before showing the popup. It keeps its own drafts, so the text
// underneath can keep changing (live transcript) while it is open.
//
// A zero-size anchor rather than a `PopupWindow` subclass: Slint rejects any
// access from an enclosing component to something inside a `PopupWindow`
// (only builtin `show()`/`close()` are reachable), so the drafts and `open`
// live on this wrapper and the popup content just reads `root.*`. Place it
// under a plain (non-layout) parent so it takes no layout space.
export component DictionaryAliasPopover inherits Rectangle {
    // (term, pronunciation) once the user saves.
    callback save-requested(string, string);

    // Moved under the clicked word by `open`. Left to the default, a child
    // of a plain Rectangle is centred in it, so the popup opened from the
    // middle of the card/transcript box, far from the word, and ran off
    // the bottom of a short window.
    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    property <string> term-draft;
    property <string> pronunciation-draft;

    // `at-x`/`at-y`: window position to open at, e.g. a word's bottom-left
    // (`TranscriptWordFlow.word-clicked`). Slint keeps the popup inside the
    // window.
    public function open(heard-as: string, at-x: length, at-y: length) {
        root.x = at-x - (root.absolute-position.x - root.x);
        root.y = at-y + 4px - (root.absolute-position.y - root.y);
        root.term-draft = "";
        root.pronunciation-draft = heard-as;
        popup.show();
    }

    function save-and-close() {
        if root.term-draft != "" {
            root.save-requested(root.term-draft, root.pronunciation-draft);
            popup.close();
        }
    }

    popup := PopupWindow {
        width: 300px;
        height: 252px;
        // The default `close-policy` (`close-on-click`, now deprecated)
        // dismisses the popup on *any* click, including ones on its own
        // `LineEdit`s/button - not just clicks outside it (found the hard
        // way: every attempt to focus a field or press Save just closed the
        // popup instead, confirmed by reading `i-slint-core-1.17.1/window.rs`:
        // the old property maps to closing on every pressed event, while
        // `close-on-click-outside` specifically checks `!mouse_inside_popup()`).
        close-policy: PopupClosePolicy.close-on-click-outside;
        // PopupWindow transfers focus to this scope when shown. Without
        // forward-focus, a mouse-opened popup never receives Escape.
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            enabled: !KitModalContext.inert(0);
            key-pressed(event) => {
                if event.text == Key.Escape {
                    popup.close();
                    accept
                } else {
                    reject
                }
            }

            KitCard {
                level: SurfaceLevel.popover;
                tone: Tone.accent;
                inset: LayoutSpace.roomy;
                gap: LayoutSpace.regular;

                KitInline {
                    alignment: space-between;

                    AppText {
                        text: @tr("Alias de dictionnaire");
                        typography: Typography.body-strong;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    cancel-btn := KitIconButton {
                        accessible-name: @tr("Fermer");
                        control-size: ControlSize.compact;

                        glyph: LucideMath.x();
                        activated => { popup.close(); }
                    }
                }

                KitStack {
                    gap: tight;

                    AppText {
                        text: @tr("Terme correct").to-uppercase();
                        typography: Typography.timeline-heading;
                        color: Theme.text-muted;
                        // The field below already carries this name.
                        accessible-role: none;
                    }
                    KitTextField {
                        accessible-name: self.placeholder;
                        placeholder: @tr("Terme correct");
                        text <=> root.term-draft;
                        commit-requested => { root.save-and-close(); }
                    }
                }

                KitStack {
                    gap: tight;

                    AppText {
                        text: @tr("Prononciation entendue").to-uppercase();
                        typography: Typography.timeline-heading;
                        color: Theme.text-muted;
                        // The field below already carries this name.
                        accessible-role: none;
                    }
                    KitTextField {
                        accessible-name: self.placeholder;
                        placeholder: @tr("Prononciation entendue");
                        text <=> root.pronunciation-draft;
                        commit-requested => { root.save-and-close(); }
                    }
                }

                save-btn := KitButton {
                    accessible-name: @tr("Enregistrer l'alias");
                    text: @tr("Enregistrer");
                    control-size: ControlSize.compact;
                    intent: ButtonIntent.primary;
                    disabled: root.term-draft == "";
                    activated => { root.save-and-close(); }
                }
            }
        }
    }
}
