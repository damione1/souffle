import { Theme } from "../theme.slint";
import { LucideIcon, IconSet } from "lucide_icon.slint";
// Native audio player for MeetingDetail (SOU-187 milestone 7, AC14/AC16).
// New engineering, not a port: MeetingAudioPlayerSection.svelte is a bare
// `<input type="range">` next to an HTML `<audio>` element, no waveform at
// all. Click-to-seek only (no drag-to-scrub) - a real, honest v1 boundary,
// not a hidden gap.
export component AudioPlayerSection inherits VerticalLayout {
    in property <bool> has-audio: false;
    in property <bool> is-playing: false;
    in property <[float]> peaks;
    in property <float> progress; // 0.0..1.0
    in property <string> position-label;
    in property <string> duration-label;
    in property <string> download-error;

    callback play-pause-requested();
    callback seek-requested(float); // 0.0..1.0
    // Native save panel + copy of the recorded session(s) to disk
    // (SOU-195-slice, backed by the already-existing `native::dialog`/
    // `commands::meetings::save_meeting_audio_export` from SOU-191).
    callback download-requested();

    spacing: 8px;

    if !root.has-audio: Text {
        text: @tr("Aucun enregistrement audio pour cette r\u{e9}union.");
        color: Theme.text-muted;
        font-size: 12px;
    }

    if root.has-audio: HorizontalLayout {
        vertical-stretch: 0;
        alignment: space-between;

        Text {
            text: @tr("Audio");
            font-family: "Archivo SemiBold";
            font-size: 13px;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        download-btn := Rectangle {
            width: download-content.preferred-width + 16px;
            height: 24px;
            horizontal-stretch: 0;
            border-radius: 4px;
            border-width: download-focus.has-focus ? 2px : 0px;
            border-color: Theme.accent;
            background: download-area.pressed ? Theme.surface-4 : download-area.has-hover ? Theme.surface-3 : Theme.surface-2;

            accessible-role: button;
            accessible-label: @tr("T\u{e9}l\u{e9}charger l'audio");
            accessible-action-default => { root.download-requested(); }

            forward-focus: download-focus;
            download-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        root.download-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            download-area := TouchArea {
                clicked => {
                    download-focus.focus();
                    root.download-requested();
                }
            }

            download-content := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 5px;
                alignment: center;

                LucideIcon {
                    width: 13px;
                    height: 13px;
                    icon: IconSet.Download;
                    icon-color: Theme.text-secondary;
                }
                Text {
                    text: @tr("T\u{e9}l\u{e9}charger");
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.download-error != "": Text {
        text: root.download-error;
        color: Theme.danger;
        font-size: 11px;
        wrap: word-wrap;
    }

    if root.has-audio: HorizontalLayout {
        spacing: 10px;

        play-btn := Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            border-width: play-focus.has-focus ? 2px : 0px;
            border-color: Theme.accent;
            background: play-area.pressed ? Theme.surface-2 : play-area.has-hover ? Theme.surface-3 : Theme.surface-4;

            accessible-role: button;
            accessible-label: root.is-playing ? @tr("Pause") : @tr("Lecture");
            accessible-action-default => { root.play-pause-requested(); }

            forward-focus: play-focus;
            play-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        root.play-pause-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            play-area := TouchArea {
                clicked => {
                    play-focus.focus();
                    root.play-pause-requested();
                }
            }

            // Lucide Play/Pause like MeetingAudioPlayerSection.svelte, not a
            // bare U+23F8/U+25B6 glyph: those fall through to the emoji
            // font on macOS and render as a colored emoji tile.
            LucideIcon {
                size: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: root.is-playing ? IconSet.Pause : IconSet.Play;
                icon-color: Theme.text-primary;
                filled: true;
            }
        }

        Text {
            text: root.position-label + @tr(" / {}", root.duration-label);
            color: Theme.text-muted;
            font-size: 11px;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }

    if root.has-audio: waveform-area := Rectangle {
        height: 56px;
        border-width: waveform-focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;

        accessible-role: slider;
        accessible-label: @tr("Position de lecture");
        accessible-value: root.position-label;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 5;

        forward-focus: waveform-focus;
        waveform-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.LeftArrow {
                    root.seek-requested(max(0, root.progress - 0.05));
                    return accept;
                }
                if event.text == Key.RightArrow {
                    root.seek-requested(min(1, root.progress + 0.05));
                    return accept;
                }
                return reject;
            }
        }

        seek-area := TouchArea {
            clicked => {
                waveform-focus.focus();
                root.seek-requested(self.mouse-x / self.width);
            }
        }

        HorizontalLayout {
            spacing: 1px;

            // Each bar is centered in its column (not top-anchored), so it
            // extends both up and down from the row's vertical middle - the
            // usual mirrored waveform look, not a bar chart hanging from
            // the top.
            for peak[i] in root.peaks: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                Rectangle {
                    height: max(2px, peak * waveform-area.height);
                    background: (i * 1.0 / root.peaks.length) < root.progress ? Theme.accent : Theme.surface-4;
                }
            }
        }
    }
}
