import { ButtonIntent, ControlSize, KitCard, KitIconButton, KitInline, KitStack, KitText, SurfaceLevel, TextViewFont, TypographyRole } from "@kit";
import { ProWaveformSeek } from "@kit-pro";
import { LucideMultimedia } from "@kit-icons/multimedia.slint";
import { LucideArrows } from "@kit-icons/arrows.slint";

export component AudioPlayerSection inherits KitStack {
    in property <bool> has-audio: false;
    in property <bool> is-playing: false;
    in property <bool> loading: false;
    // One SVG path for the whole overview in a `waveform-bars` x 1 viewbox.
    in property <string> waveform-commands;
    in property <int> waveform-bars: 0;
    in property <float> progress; // 0.0..1.0
    in property <string> position-label;
    in property <string> duration-label;

    callback play-pause-requested();
    callback seek-requested(float); // 0.0..1.0

    if !root.has-audio: KitText {
        text: @tr("Aucun enregistrement audio pour cette r\u{e9}union.");
        role: TypographyRole.caption;
    }

    if root.has-audio: KitCard {
        level: SurfaceLevel.raised;
        inset: regular;
        gap: none;

        KitInline {
            gap: regular;
            alignment: stretch;

            KitStack {
                alignment: center;

                KitIconButton {
                    accessible-name: root.loading ? @tr("Chargement de l'audio…") : root.is-playing ? @tr("Pause") : @tr("Lecture");
                    intent: ButtonIntent.primary;
                    control-size: ControlSize.comfortable;
                    disabled: root.loading;
                    glyph: root.is-playing ? LucideMultimedia.pause() : LucideArrows.play();
                    activated => { root.play-pause-requested(); }
                }
            }

            KitStack {
                gap: compact;
                horizontal-stretch: 1;

                ProWaveformSeek {
                    accessible-name: @tr("Position de lecture");
                    commands: root.waveform-commands;
                    bars: root.waveform-bars;
                    progress: root.progress;
                    position-label: root.position-label;
                    drag-seeking: false;
                    seek-requested(fraction) => { root.seek-requested(fraction); }
                }

                if root.duration-label == "": KitText {
                    text: @tr("Chargement de l'audio…");
                    role: TypographyRole.caption;
                }
                if root.duration-label != "": KitInline {
                    alignment: space-between;
                    KitText {
                        text: root.position-label;
                        role: TypographyRole.caption;
                        font: TextViewFont.monospace;
                    }
                    KitText {
                        text: root.duration-label;
                        role: TypographyRole.caption;
                        font: TextViewFont.monospace;
                    }
                }
            }
        }
    }
}
