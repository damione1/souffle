import { AppText, AppNumericText, Typography } from "@typography";
import { ButtonIntent, ControlSize, IconGlyph, KitCard, KitIcon, KitIconButton, KitStack, SurfaceLevel } from "@kit";
import { Theme } from "../theme.slint";
import { ProWaveformSeek } from "@kit-pro";
import { LucideMultimedia } from "@kit-icons/multimedia.slint";

export component AudioPlayerSection inherits KitStack {
    in property <bool> has-audio: false;
    in property <bool> is-playing: false;
    in property <bool> loading: false;
    // One SVG path for the whole overview in a `waveform-bars` x 1 viewbox.
    in property <string> waveform-commands;
    in property <int> waveform-bars: 0;
    in property <float> progress; // 0.0..1.0
    in property <string> position-label;
    in property <string> duration-label;

    callback play-pause-requested();
    callback seek-requested(float); // 0.0..1.0

    // Lucide only ships the outlined triangle.
    private property <IconGlyph> play-glyph: { stroke: "", fill: "M 6 3 L 20 12 L 6 21 Z", viewbox: 24 };

    if !root.has-audio: KitCard {
        level: SurfaceLevel.raised;
        inset: none;
        gap: none;

        HorizontalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 14px;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: Theme.surface-2;

                KitIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: LucideMultimedia.volume-2();
                    ink: Theme.text-muted;
                }
            }

            AppText {
                text: @tr("Aucun enregistrement audio pour cette r\u{e9}union.");
                typography: Typography.body;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
    }

    if root.has-audio: KitCard {
        level: SurfaceLevel.raised;
        inset: none;
        gap: none;

        HorizontalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                KitIconButton {
                    width: 44px;
                    height: 44px;
                    corner-radius: self.height / 2;
                    accessible-name: root.loading ? @tr("Chargement de l'audio…") : root.is-playing ? @tr("Pause") : @tr("Lecture");
                    intent: ButtonIntent.primary;
                    control-size: ControlSize.comfortable;
                    disabled: root.loading;
                    glyph: root.is-playing ? LucideMultimedia.pause() : root.play-glyph;
                    activated => { root.play-pause-requested(); }
                }
            }

            ProWaveformSeek {
                accessible-name: @tr("Position de lecture");
                commands: root.waveform-commands;
                bars: root.waveform-bars;
                progress: root.progress;
                position-label: root.position-label;
                drag-seeking: false;
                horizontal-stretch: 1;
                seek-requested(fraction) => { root.seek-requested(fraction); }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                if root.duration-label == "": AppText {
                    text: @tr("Chargement de l'audio…");
                    typography: Typography.hint;
                    color: Theme.text-muted;
                }
                if root.duration-label != "": AppNumericText {
                    text: root.position-label + " / " + root.duration-label;
                    typography: Typography.hint-emphasis;
                    text-color: Theme.text-primary;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
