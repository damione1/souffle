import { Theme } from "../theme.slint";
import { LucideIcon, IconSet } from "lucide_icon.slint";
// Native audio player for MeetingDetail (SOU-187 milestone 7, AC14/AC16).
// New engineering, not a port: MeetingAudioPlayerSection.svelte is a bare
// `<input type="range">` next to an HTML `<audio>` element, no waveform at
// all. Click-to-seek only (no drag-to-scrub) - a real, honest v1 boundary,
// not a hidden gap.
export component AudioPlayerSection inherits VerticalLayout {
    in property <bool> has-audio: false;
    in property <bool> is-playing: false;
    // SOU-258: decoding + opening the output stream runs on a worker, so
    // the section shows (from the cached summary) before playback is ready.
    in property <bool> loading: false;
    // One SVG path for the whole overview (`audio_player::waveform_commands`)
    // in a `waveform-bars` x 1 viewbox: two `Path` items instead of a layout
    // and a `Rectangle` per bar. Empty until a summary is known.
    in property <string> waveform-commands;
    in property <int> waveform-bars: 0;
    in property <float> progress; // 0.0..1.0
    in property <string> position-label;
    in property <string> duration-label;

    callback play-pause-requested();
    callback seek-requested(float); // 0.0..1.0

    spacing: 8px;

    if !root.has-audio: Text {
        text: @tr("Aucun enregistrement audio pour cette r\u{e9}union.");
        color: Theme.text-muted;
        font-size: 12px;
    }

    if root.has-audio: HorizontalLayout {
        spacing: 10px;

        play-btn := Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            border-width: play-focus.has-focus ? 2px : 0px;
            border-color: Theme.accent;
            background: root.loading ? Theme.surface-3 : play-area.pressed ? Theme.surface-2 : play-area.has-hover ? Theme.surface-3 : Theme.surface-4;
            opacity: root.loading ? 0.55 : 1.0;

            accessible-role: button;
            accessible-label: root.loading ? @tr("Chargement de l'audio…") : root.is-playing ? @tr("Pause") : @tr("Lecture");
            accessible-enabled: !root.loading;
            accessible-action-default => { root.play-pause-requested(); }

            forward-focus: play-focus;
            play-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        root.play-pause-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            play-area := TouchArea {
                enabled: !root.loading;
                mouse-cursor: root.loading ? default : pointer;
                clicked => {
                    play-focus.focus();
                    root.play-pause-requested();
                }
            }

            // Lucide Play/Pause like MeetingAudioPlayerSection.svelte, not a
            // bare U+23F8/U+25B6 glyph: those fall through to the emoji
            // font on macOS and render as a colored emoji tile.
            LucideIcon {
                size: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: root.is-playing ? IconSet.Pause : IconSet.Play;
                icon-color: Theme.text-primary;
                filled: true;
            }
        }

        Text {
            text: root.duration-label == "" ? @tr("Chargement de l'audio…") : root.position-label + @tr(" / {}", root.duration-label);
            color: Theme.text-muted;
            font-size: 11px;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }

    if root.has-audio: waveform-area := Rectangle {
        height: 56px;
        border-width: waveform-focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;

        accessible-role: slider;
        accessible-label: @tr("Position de lecture");
        accessible-value: root.position-label;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 5;

        forward-focus: waveform-focus;
        waveform-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.LeftArrow {
                    root.seek-requested(max(0, root.progress - 0.05));
                    return accept;
                }
                if event.text == Key.RightArrow {
                    root.seek-requested(min(1, root.progress + 0.05));
                    return accept;
                }
                return reject;
            }
        }

        seek-area := TouchArea {
            clicked => {
                waveform-focus.focus();
                root.seek-requested(self.mouse-x / self.width);
            }
        }

        // Bars centred on the middle line (the usual mirrored waveform
        // look). The played part is the same path in the accent colour,
        // clipped to `progress`.
        if root.waveform-bars > 0: Path {
            x: 0px;
            y: 0px;
            width: waveform-area.width;
            height: waveform-area.height;
            commands: root.waveform-commands;
            viewbox-width: root.waveform-bars;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.surface-4;
        }
        if root.waveform-bars > 0: Rectangle {
            x: 0px;
            y: 0px;
            width: waveform-area.width * clamp(root.progress, 0, 1);
            height: waveform-area.height;
            clip: true;

            Path {
                x: 0px;
                y: 0px;
                width: waveform-area.width;
                height: waveform-area.height;
                commands: root.waveform-commands;
                viewbox-width: root.waveform-bars;
                viewbox-height: 1;
                fit: fill;
                fill: Theme.accent;
            }
        }
        if root.waveform-bars == 0: Rectangle {
            y: (waveform-area.height - self.height) / 2;
            height: 2px;
            background: Theme.surface-4;
        }
    }
}
