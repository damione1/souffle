import { AlertSeverity, ButtonIntent } from "@kit";
import { BannerAlert, CompactButton } from "./app_controls.slint";

export component StatusBanner inherits BannerAlert {
    in property <string> action-label;
    in property <ButtonIntent> action-intent: ButtonIntent.secondary;
    callback action-triggered();

    severity: AlertSeverity.warning;
    dismissible: true;
    dismiss-label: @tr("Fermer");
    if root.action-label != "": CompactButton {
        text: root.action-label;
        intent: root.action-intent;
        activated => { root.action-triggered(); }
    }
}
