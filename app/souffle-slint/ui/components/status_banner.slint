import { AlertSeverity, ButtonIntent, ControlSize, KitAlert, KitButton } from "@kit";

export component StatusBanner inherits KitAlert { bordered: false;
    in property <string> action-label;
    callback action-triggered();

    severity: AlertSeverity.warning;
    dismissible: true;
    dismiss-label: @tr("Fermer");
    if root.action-label != "": KitButton {
        text: root.action-label;
        intent: ButtonIntent.secondary;
        control-size: ControlSize.compact;
        activated => { root.action-triggered(); }
    }
}
