import { AlertSeverity, ButtonIntent, DialogSize, DialogTabPolicy, FieldAccess, KitAlert, KitDialog, KitTextArea } from "@kit";

export component LiveParagraphEditor inherits KitDialog {
    in-out property <string> text;
    in property <bool> busy;
    in property <bool> failed;
    callback save-requested(string);
    callback close-requested();

    title: @tr("Corriger le paragraphe");
    description: @tr("Seul le texte confirmé est modifié. L’enregistrement continue.");
    close-label: @tr("Fermer");
    tab-policy: DialogTabPolicy.native;
    modal-layer: 1;
    size: DialogSize.medium;
    actions: [
        { token: 1, text: @tr("Annuler"), intent: ButtonIntent.secondary, disabled: root.busy },
        { token: 2, text: @tr("Enregistrer"), intent: ButtonIntent.primary, disabled: root.busy || root.text == "" },
    ];
    dismiss(reason) => { root.close-requested(); }
    action-activated(token) => {
        if token == 1 { root.close-requested(); }
        if token == 2 { root.save-requested(root.text); }
    }

    KitTextArea {
        modal-layer: root.modal-layer;
        text <=> root.text;
        accessible-name: @tr("Texte du paragraphe");
        access: root.busy ? FieldAccess.disabled : FieldAccess.editable;
    }
    if root.failed: KitAlert {
        severity: AlertSeverity.error;
        message: @tr("Correction impossible. Fermez puis rouvrez le paragraphe pour réessayer.");
    }
}
