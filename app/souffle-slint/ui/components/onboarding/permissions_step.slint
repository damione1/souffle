import {
    AlertSeverity, ButtonIntent, KitAlert, KitAvatar, KitBadge, KitDivider,
    KitText, KitThemeContext, Tone, TypographyRole, AvatarShape
} from "@kit";
import { IconGlyph } from "@kit";
import { LucideCommunication } from "@kit-icons/communication.slint";
import { LucideMultimedia } from "@kit-icons/multimedia.slint";
import { LucideDevices } from "@kit-icons/devices.slint";
import { LucideTime } from "@kit-icons/time.slint";
import { AppText, Typography } from "@typography";
import { AccessState, PermissionKind } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { BannerAlert, CompactButton } from "../app_controls.slint";

// Port of PermissionsStep.svelte. Each row's status comes from a real,
// repeatedly-polled `get_permission_status()` snapshot (main.rs polls every
// 600ms while this is visible) - never a value fixed once at launch (AC7,
// added after PR #248 shipped exactly that fake pattern).
export struct PermissionRow {
    kind: PermissionKind,
    state: AccessState,
    busy: bool,
}

export component PermissionsStep inherits VerticalLayout {
    in property <int> modal-layer;
    in property <bool> compact;

    pure function row-label(kind: PermissionKind) -> string {
        if kind == PermissionKind.microphone { return @tr("Microphone"); }
        if kind == PermissionKind.system-audio { return @tr("Audio système"); }
        if kind == PermissionKind.accessibility { return @tr("Accessibilité"); }
        if kind == PermissionKind.calendar { return @tr("Calendrier"); }
        return "";
    }
    pure function row-description(kind: PermissionKind) -> string {
        if kind == PermissionKind.microphone { return @tr("Nécessaire pour la dictée et les réunions."); }
        if kind == PermissionKind.system-audio { return @tr("Capture l'autre côté d'un appel dans les réunions."); }
        if kind == PermissionKind.accessibility { return @tr("Nécessaire pour le collage automatique et certains raccourcis."); }
        if kind == PermissionKind.calendar { return @tr("Affiche vos réunions du jour sur l'accueil."); }
        return "";
    }
    pure function row-icon(kind: PermissionKind) -> IconGlyph {
        if kind == PermissionKind.microphone { return LucideCommunication.mic(); }
        if kind == PermissionKind.system-audio { return LucideMultimedia.volume-2(); }
        if kind == PermissionKind.accessibility { return LucideDevices.keyboard(); }
        return LucideTime.calendar-clock();
    }
    pure function row-action-label(kind: PermissionKind) -> string {
        if kind == PermissionKind.accessibility { return @tr("Ouvrir les Réglages"); }
        return @tr("Autoriser");
    }
    pure function row-hint(kind: PermissionKind, state: AccessState) -> string {
        if kind == PermissionKind.accessibility && state == AccessState.denied { return @tr("Accessibilité refusée ? Ouvrez Réglages Système > Confidentialité et sécurité > Accessibilité."); }
        if kind == PermissionKind.microphone && state == AccessState.denied { return @tr("Refusé. Ouvrez Réglages Système pour l'autoriser."); }
        if kind == PermissionKind.microphone && state == AccessState.no-device { return @tr("Aucun microphone détecté."); }
        return "";
    }
    pure function row-hint-action-label(kind: PermissionKind, state: AccessState) -> string {
        if kind == PermissionKind.microphone && state == AccessState.denied { return @tr("Réglages Système"); }
        return "";
    }

    in property <[PermissionRow]> rows;
    in property <string> error-message;
    in property <bool> repair-busy;
    in property <bool> repair-success;
    in property <bool> repair-cooldown;

    callback grant-requested(PermissionKind);
    callback hint-action-requested(PermissionKind);
    callback repair-requested();

    private property <length> unit: KitThemeContext.current.spacing.unit;

    spacing: root.compact ? 16px : 18px;

    VerticalLayout {
        for row in root.rows: VerticalLayout {
            KitDivider {}

            HorizontalLayout {
                padding-top: root.compact ? root.unit * 2.75 : root.unit * 3;
                padding-bottom: root.compact ? root.unit * 2.75 : root.unit * 3;
                spacing: root.compact ? root.unit * 3 : root.unit * 3.5;
                cross-axis-alignment: CrossAxisAlignment.center;

                KitAvatar {
                    shape: AvatarShape.rounded;
                    size: root.unit * 8;
                    tone: Tone.neutral;
                    muted: true;
                    bordered: false;
                    decorative: true;
                    fallback-icon: row-icon(row.kind);
                    glyph-size: 16px;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    AppText {
                        text: row-label(row.kind);
                        typography: Typography.field-heading;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    if !root.compact: AppText {
                        text: row-description(row.kind);
                        typography: Typography.hint;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }

                if row.state == AccessState.granted: KitBadge {
                    text: @tr("Accordé");
                    tone: Tone.success;
                    subtle: true;
                    dot: true;
                }
                if row.state == AccessState.unsupported: KitText {
                    text: @tr("Non pris en charge");
                    role: TypographyRole.caption;
                    vertical-alignment: center;
                }
                if row.state != AccessState.granted && row.state != AccessState.unsupported: CompactButton {
                    modal-layer: root.modal-layer;
                    intent: ButtonIntent.secondary;
                    text: row.busy ? @tr("Vérification…") : row-action-label(row.kind);
                    disabled: row.busy;
                    activated => { root.grant-requested(row.kind); }
                }
            }
        }

        // Hints follow the whole list so they never split it. The compact
        // list skips the Accessibility one: its row button still opens Settings.
        for row in root.rows: VerticalLayout {
            if row-hint(row.kind, row.state) != "" && !(root.compact && row.kind == PermissionKind.accessibility): VerticalLayout {
                padding-top: root.unit * 3;

                BannerAlert {
                    message-size: Typography.hint.size;
                    severity: AlertSeverity.information;
                    // Away from its row, the microphone hint has to name it.
                    title: row.kind == PermissionKind.microphone ? row-label(row.kind) : "";
                    message: row-hint(row.kind, row.state);
                    message-ink: Theme.text-primary;
                    if row-hint-action-label(row.kind, row.state) != "": CompactButton {
                        modal-layer: root.modal-layer;
                        intent: ButtonIntent.link;
                        text: row-hint-action-label(row.kind, row.state);
                        activated => { root.hint-action-requested(row.kind); }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: root.unit * 3;

        AppText {
            text: root.repair-success
                ? @tr("Réparation effectuée, en attente de confirmation macOS.")
                : @tr("Un problème persiste ? Réparez l'entrée Accessibilité.");
            typography: Typography.hint;
            color: Theme.text-muted;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        CompactButton {
            modal-layer: root.modal-layer;
            intent: ButtonIntent.quiet;
            text: root.repair-busy ? @tr("Vérification…") : @tr("Réparer");
            disabled: root.repair-busy || root.repair-cooldown;
            activated => { root.repair-requested(); }
        }
    }

    if root.error-message != "": KitAlert { bordered: false;
        severity: AlertSeverity.error;
        message: root.error-message;
    }
}
