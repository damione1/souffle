import { MarkdownBlock } from "markdown_block.slint";
import { ReleaseNotesBox } from "markdown_view.slint";
import { ModalDialog } from "../modal_dialog.slint";
import { ThemedButton, ThemedButtonKind } from "../themed_button.slint";

// Port of WhatsNewDialog.svelte. Content is pre-parsed into `MarkdownBlock`s
// on the Rust side (`markdown.rs`) - see that module's doc comment for why
// Slint's `@markdown()` builtin (literal-only) can't take this dynamic
// content directly. Chrome comes from `ModalDialog`; the only action is
// the reference's `btn btn-active` "Compris".
export component WhatsNewDialog inherits ModalDialog {
    in property <string> version;
    in property <[MarkdownBlock]> content-blocks;

    callback dismissed();
    callback link-clicked(string);

    title: @tr("Nouveautés");
    subtitle: @tr("Mis à jour vers v{}", root.version);
    close-requested => { root.dismissed(); }

    ReleaseNotesBox {
        blocks: root.content-blocks;
        link-clicked(url) => { root.link-clicked(url); }
    }

    HorizontalLayout {
        alignment: end;
        vertical-stretch: 0;

        ThemedButton {
            text: @tr("Compris");
            kind: ThemedButtonKind.active;
            clicked => { root.dismissed(); }
        }
    }
}
