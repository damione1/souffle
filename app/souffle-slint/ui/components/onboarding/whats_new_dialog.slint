import { ControlSize, DialogSize, DialogTabPolicy, ButtonIntent, KitDialog } from "@kit";
import { Typography } from "@typography";
import { MarkdownBlock } from "markdown_block.slint";
import { MarkdownView } from "markdown_view.slint";

// Release notes are parsed into MarkdownBlock rows in Rust.
export component WhatsNewDialog inherits KitDialog {
    tab-policy: DialogTabPolicy.native;
    modal-layer: 2;
    size: DialogSize.medium;
    quiet-initial-focus: true;
    close-control-size: ControlSize.compact;
    stacked-header: true;
    panel-width: 470px;
    inset: 26px;
    content-gap: 16px;
    overlay-body-scrollbar: true;
    title-size: Typography.preview.size;
    title-weight: Typography.dialog-strong.weight;
    description-size: Typography.field-label.size;
    body-label: @tr("Notes de version");
    close-label: @tr("SettingsPermissionsDialog" => "Fermer");
    in property <string> version;
    in property <[MarkdownBlock]> content-blocks;

    callback dismissed();
    callback link-clicked(string);

    title: @tr("Nouveautés");
    description: @tr("Mis à jour vers v{}", root.version);
    dismiss(reason) => { root.dismissed(); }

    MarkdownView {
        modal-layer: root.modal-layer;
        blocks: root.content-blocks;
        link-clicked(url) => { root.link-clicked(url); }
    }

    actions: [{token: 1, text: @tr("Compris"), intent: ButtonIntent.primary}];
    action-activated(token) => { root.dismissed(); }
}
