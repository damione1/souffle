import { ButtonIntent, ControlSize, KitButton } from "@kit";
import { MarkdownBlock } from "markdown_block.slint";
import { MarkdownBlockKind } from "../../types.slint";
import { Theme } from "../../theme.slint";

export component MarkdownView inherits VerticalLayout {
    in property <int> modal-layer;
    in property <[MarkdownBlock]> blocks;

    callback link-clicked(string);

    alignment: start;
    spacing: 6px;

    for block in root.blocks: VerticalLayout {
        if block.kind == MarkdownBlockKind.heading: Text {
            text: block.text;
            font-size: 13.5px;
            font-weight: 700;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
        if block.kind == MarkdownBlockKind.bullet: HorizontalLayout {
            spacing: 6px;
            Text { text: @tr("•"); color: Theme.text-muted; font-size: 12px; }
            Text {
                text: block.text;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if block.kind == MarkdownBlockKind.paragraph: Text {
            text: block.text;
            color: Theme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
        if block.kind == MarkdownBlockKind.link: KitButton {
            modal-layer: root.modal-layer;
            text: block.text;
            intent: ButtonIntent.link;
            control-size: ControlSize.compact;
            text-wrap: word-wrap;
            activated => { root.link-clicked(block.url); }
        }
    }
}
