import { MarkdownBlock } from "markdown_block.slint";
import { ReleaseNotesBox } from "markdown_view.slint";
import { ModalDialog } from "../modal_dialog.slint";
import { ThemedButton, ThemedButtonKind } from "../themed_button.slint";
import { InstallBlockReason, UpdatePhase } from "../../types.slint";
import { Theme } from "../../theme.slint";

// Port of UpdateAvailableDialog.svelte + UpdateAction.svelte. `download_update`/
// `install_update` are real commands (`commands/updater.rs`). No live download
// progress here (same simplification as the Data tab's archive export in
// SOU-188): the button shows a busy state and the final result.
// `get_update_install_block` is a real state-machine query for why "Install
// and restart" may be greyed out; Rust projects it onto the
// `install-blocked` / `install-block-reason` pair (`update_ui.rs`) and the
// label per reason lives here, one `@tr` per variant - never the raw enum
// token. Release notes go through the same pre-parsed `MarkdownBlock`
// rendering as What's New (`markdown.rs`).
//
// Action row follows UpdateAction.svelte per phase: idle → Télécharger;
// downloading → disabled busy label; ready → Installer (disabled while
// blocked, reason underneath); failed → error text, Réessayer, and the
// GitHub fallback. Not ported: cancelling an in-flight download (no
// `cancel_update_download` wiring in this shell yet).
export component UpdateAvailableDialog inherits ModalDialog {
    in property <string> latest-version;
    in property <[MarkdownBlock]> release-notes-blocks;
    in property <UpdatePhase> phase: UpdatePhase.idle;
    in property <string> error-message;
    in property <bool> install-blocked: false;
    in property <InstallBlockReason> install-block-reason;

    callback download-requested();
    callback install-requested();
    callback open-release-requested();
    callback dismiss-requested();
    callback link-clicked(string);

    pure function block-label(reason: InstallBlockReason) -> string {
        if reason == InstallBlockReason.recording-dictation { return @tr("Terminez la dictée avant d'installer."); }
        if reason == InstallBlockReason.recording-meeting { return @tr("Arrêtez la réunion avant d'installer."); }
        if reason == InstallBlockReason.stopping { return @tr("Attendez la fin de l'arrêt de l'enregistrement."); }
        if reason == InstallBlockReason.downloading { return @tr("Attendez la fin du téléchargement du modèle."); }
        if reason == InstallBlockReason.loading { return @tr("Attendez la fin du chargement du modèle."); }
        if reason == InstallBlockReason.unloading { return @tr("Attendez la fin du déchargement du modèle."); }
        return "";
    }

    title: @tr("Mise à jour disponible");
    subtitle: @tr("Version {}", root.latest-version);
    panel-height: 440px;
    close-requested => { root.dismiss-requested(); }

    ReleaseNotesBox {
        blocks: root.release-notes-blocks;
        link-clicked(url) => { root.link-clicked(url); }
    }

    if root.error-message != "": Text {
        text: root.error-message;
        color: Theme.danger-soft;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }

    if root.phase == UpdatePhase.ready && root.install-blocked: Text {
        text: block-label(root.install-block-reason);
        color: Theme.text-muted;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        vertical-stretch: 0;

        ThemedButton {
            text: @tr("Plus tard");
            clicked => { root.dismiss-requested(); }
        }

        if root.phase == UpdatePhase.idle: ThemedButton {
            text: @tr("Télécharger la mise à jour");
            kind: ThemedButtonKind.active;
            clicked => { root.download-requested(); }
        }
        if root.phase == UpdatePhase.downloading: ThemedButton {
            text: @tr("Téléchargement…");
            kind: ThemedButtonKind.active;
            enabled: false;
        }
        if root.phase == UpdatePhase.ready: ThemedButton {
            text: @tr("Installer et redémarrer");
            kind: ThemedButtonKind.active;
            enabled: !root.install-blocked;
            clicked => { root.install-requested(); }
        }
        if root.phase == UpdatePhase.failed: ThemedButton {
            text: @tr("Réessayer");
            kind: ThemedButtonKind.active;
            clicked => { root.download-requested(); }
        }
        if root.phase == UpdatePhase.failed: ThemedButton {
            text: @tr("Ouvrir la page de release");
            kind: ThemedButtonKind.ghost;
            clicked => { root.open-release-requested(); }
        }
    }
}
