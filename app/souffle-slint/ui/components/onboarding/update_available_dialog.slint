import { AppText, AppTextInput, Typography, TypographyStyle } from "@typography";
import { DialogTabPolicy, ButtonIntent, KitButton, KitDialog } from "@kit";
import { MarkdownBlock } from "markdown_block.slint";
import { MarkdownView } from "markdown_view.slint";
import { InstallBlockReason, UpdatePhase } from "../../types.slint";
import { Theme } from "../../theme.slint";
import { UpdateCopy } from "../update_copy.slint";

// Port of UpdateAvailableDialog.svelte + UpdateAction.svelte. `download_update`/
// `install_update` are real commands (`commands/updater.rs`). No live download
// progress here (same simplification as the Data tab's archive export in
// SOU-188): the button shows a busy state and the final result.
// `get_update_install_block` is a real state-machine query for why "Install
// and restart" may be greyed out; Rust projects it onto the
// `install-blocked` / `install-block-reason` pair (`update_ui.rs`) and the
// label per reason lives in `UpdateCopy` (shared with Settings), one `@tr`
// per variant - never the raw enum token. Release notes go through the same
// pre-parsed `MarkdownBlock` rendering as What's New (`markdown.rs`).
//
// Action row follows UpdateAction.svelte per phase: idle → Télécharger;
// downloading → disabled busy label; ready → Installer (disabled while
// blocked, reason underneath); failed → error text, Réessayer, and the
// GitHub fallback. Not ported: cancelling an in-flight download (no
// `cancel_update_download` wiring in this shell yet).
export component UpdateAvailableDialog inherits KitDialog {
    tab-policy: DialogTabPolicy.native;
    modal-layer: 3;
    close-label: @tr("SettingsPermissionsDialog" => "Fermer");
    in property <string> latest-version;
    in property <[MarkdownBlock]> release-notes-blocks;
    in property <UpdatePhase> phase: UpdatePhase.idle;
    in property <string> error-message;
    in property <bool> install-blocked: false;
    in property <InstallBlockReason> install-block-reason;

    callback download-requested();
    callback install-requested();
    callback open-release-requested();
    callback dismiss-requested();
    callback link-clicked(string);

    title: @tr("Mise à jour disponible");
    description: @tr("Version {}", root.latest-version);
    dismiss(reason) => { root.dismiss-requested(); }

    MarkdownView {
        modal-layer: root.modal-layer;
        blocks: root.release-notes-blocks;
        link-clicked(url) => { root.link-clicked(url); }
    }

    if root.error-message != "": AppText {
        text: root.error-message;
        color: Theme.danger-soft;
        typography: Typography.secondary;
        wrap: word-wrap;
        vertical-stretch: 0;
    }

    if root.phase == UpdatePhase.ready && root.install-blocked: AppText {
        text: UpdateCopy.install-block-label(root.install-block-reason);
        color: Theme.text-muted;
        typography: Typography.secondary;
        wrap: word-wrap;
        vertical-stretch: 0;
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        vertical-stretch: 0;

        KitButton {
            modal-layer: root.modal-layer;
            text: @tr("Plus tard");
            activated => { root.dismiss-requested(); }
        }

        if root.phase == UpdatePhase.idle: KitButton {
            modal-layer: root.modal-layer;
            text: @tr("Télécharger la mise à jour");
            intent: ButtonIntent.primary;
            activated => { root.download-requested(); }
        }
        if root.phase == UpdatePhase.downloading: KitButton {
            modal-layer: root.modal-layer;
            text: @tr("Téléchargement…");
            intent: ButtonIntent.primary;
            disabled: true;
        }
        if root.phase == UpdatePhase.ready: KitButton {
            modal-layer: root.modal-layer;
            text: @tr("Installer et redémarrer");
            intent: ButtonIntent.primary;
            disabled: root.install-blocked;
            activated => { root.install-requested(); }
        }
        if root.phase == UpdatePhase.failed: KitButton {
            modal-layer: root.modal-layer;
            text: @tr("Réessayer");
            intent: ButtonIntent.primary;
            activated => { root.download-requested(); }
        }
        if root.phase == UpdatePhase.failed: KitButton {
            modal-layer: root.modal-layer;
            text: @tr("Ouvrir la page de release");
            intent: ButtonIntent.quiet;
            activated => { root.open-release-requested(); }
        }
    }
}
