import { FieldSetAppearance, ButtonIntent, ChoiceLabelPosition, ControlWidth, KitSwitch, Ownership, KitFieldSet, KitFieldSeparator, KitThemeContext, KitThemes } from "@kit";
import { LucideText } from "@kit-icons/text.slint";
import { Theme } from "../../theme.slint";
import { CompactButton, SettingsFieldRow } from "../app_controls.slint";

export component DiagnosticsSection inherits VerticalLayout {
    in property <bool> detailed-logging;
    in property <bool> copying-diagnostics: false;

    callback detailed-logging-changed(bool);
    callback copy-diagnostics-requested();



    spacing: 20px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("DIAGNOSTICS");
        appearance: FieldSetAppearance.card;

        SettingsFieldRow {
            theme: KitThemeContext.current;
            focus-requested => { logging-switch.take-focus(); }
            private property <bool> control-focused: logging-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Journalisation détaillée");
            description: @tr("Écrit plus de détails dans le fichier journal pour le dépannage, dont le texte reconnu. Pendant une dictée ou une réunion, garde aussi les 3 premières secondes de micro dans un fichier supprimé dès la fin de la session.");

            logging-switch := KitSwitch {
                theme: KitThemeContext.current;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Journalisation détaillée");
                checked: root.detailed-logging;
                toggled(new) => { root.detailed-logging-changed(new); }
            }
        }

        KitFieldSeparator { }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 16px;

            HorizontalLayout {
                alignment: start;
                CompactButton {
                    theme: KitThemeContext.current;
                    text: root.copying-diagnostics ? @tr("Copie…") : @tr("Copier les diagnostics");
                    intent: ButtonIntent.secondary;
                    leading-icon: LucideText.copy();
                    disabled: root.copying-diagnostics;
                    activated => { root.copy-diagnostics-requested(); }
                }
            }
        }
    }
}
