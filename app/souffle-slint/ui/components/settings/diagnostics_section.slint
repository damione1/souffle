import { AppText, AppTextInput, Typography } from "@typography";
import { ButtonIntent, ChoiceLabelPosition, ControlSize, ControlWidth, KitButton, KitSurface, KitSwitch, LayoutSpace, Ownership, ScrollFrame, SurfaceLevel, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow, KitMetrics } from "@kit";
import { LucideText } from "@kit-icons/text.slint";
import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { Theme } from "../../theme.slint";
import { LogLevel } from "../../types.slint";

// Port of DiagnosticsSettingsSection.svelte. The live log is virtualized
// (SOU-224): main.rs owns the full tail and only pushes the visible slice
// (`log-lines`) plus estimated spacers, same pattern as TranscriptSection.
// The refresh/scroll timers only run while the Système tab is actually
// active (see `sync_settings_log_timers` in main.rs), not for the whole
// life of the Settings sheet.
export component DiagnosticsSection inherits VerticalLayout {
    in-out property <bool> debug-transcription;
    in property <LogLevel> log-level;
    // Only the currently visible slice of the log tail - main.rs owns the
    // full line list and re-windows it as `log-scroll-top` moves (SOU-224).
    in property <[string]> log-lines;
    in property <int> log-line-count;
    // Estimated px height of the lines scrolled past above/below the
    // mounted slice - plain `float` for the same set_*/get_* reason as
    // TranscriptSection's spacers.
    in property <float> log-spacer-before: 0.0;
    in property <float> log-spacer-after: 0.0;
    // Two-way bound up to MainWindow so main.rs can react to the real scroll
    // position and decide the next slice.
    in-out property <length> log-scroll-top: 0px;
    in property <bool> copying-diagnostics: false;

    callback debug-transcription-changed(bool);
    callback log-level-changed(LogLevel);
    callback copy-diagnostics-requested();



    spacing: 22px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("DIAGNOSTICS");

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            focus-requested => { level-picker.take-focus(); }
            private property <bool> control-focused: level-picker.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            show-divider: false;
            label: @tr("Niveau de journal");
            description: @tr("Quantité de détails que Soufflé écrit dans le fichier journal.");

            level-picker := ClosedSettingsPicker {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label: @tr("Niveau de journal");
                choices: SettingsOptions.log-level-options(root.log-level);
                chosen(row) => { root.log-level-changed(SettingsOptions.log-level-value(row, root.log-level)); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            focus-requested => { logging-switch.take-focus(); }
            private property <bool> control-focused: logging-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Journaux détaillés de transcription");
            description: @tr("Enregistre des détails supplémentaires sur la reconnaissance vocale pour le dépannage.");

            logging-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Journaux détaillés de transcription");
                checked: root.debug-transcription;
                toggled(new) => { root.debug-transcription-changed(new); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Orientation.vertical;
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            label: @tr("Journal en direct");
            description: @tr("Fin du fichier journal actuel, actualisé toutes les quelques secondes.");

            KitSurface {
                theme: KitThemeContext.current;
                level: SurfaceLevel.inset;
                inset: LayoutSpace.compact;
                fill: true;
                height: 96px;
                clip: true;
                accessible-role: groupbox;
                accessible-label: @tr("Journal en direct");

                log-viewport := ScrollFrame {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: lines.preferred-height;
                    content-y <=> root.log-scroll-top;

                    lines := VerticalLayout {
                        width: log-viewport.visible-width;
                        spacing: 0px;
                        alignment: start;

                        Rectangle { height: root.log-spacer-before * 1px; }

                        if root.log-line-count == 0: AppText {
                            text: @tr("Aucune entrée de journal pour l'instant.");
                            typography: Typography.micro-detail;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        // One read-only TextInput per mounted line so a poll
                        // that appends lines never relayouts rendered ones
                        // (SOU-224).
                        for line in root.log-lines: AppTextInput {
                            text: line;
                            typography: Typography.micro-detail;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                            single-line: false;
                            read-only: true;
                            selection-background-color: Theme.accent.with-alpha(0.28);
                        }

                        Rectangle { height: root.log-spacer-after * 1px; }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: KitMetrics.field-gap(KitThemeContext.current);
            padding-right: KitMetrics.field-gap(KitThemeContext.current);
            padding-bottom: KitMetrics.field-gap(KitThemeContext.current);
            alignment: start;
            KitButton {
                theme: KitThemeContext.current;
                modal-layer: 0;
                text: root.copying-diagnostics ? @tr("Copie…") : @tr("Copier les diagnostics");
                intent: ButtonIntent.secondary;
                control-size: ControlSize.compact;
                leading-icon: LucideText.copy();
                disabled: root.copying-diagnostics;
                activated => { root.copy-diagnostics-requested(); }
            }
        }
    }
}
