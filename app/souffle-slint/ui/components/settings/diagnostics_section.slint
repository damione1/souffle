import { ChoiceLabelPosition, ControlSize, ControlWidth, FieldAccess, KitButton, KitFieldRow, KitFieldSet, KitInline, KitMetrics, KitStack, LayoutSpace, KitModalContext, KitSurface, KitSwitch, KitText, KitTextArea, KitThemeContext, KitThemes, ListView, Ownership, TypographyRole } from "@kit";
import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { Theme } from "../../theme.slint";
import { LogLevel } from "../../types.slint";

// One read-only editor per log line: the native editor selects and copies any
// substring of its line, and the line wraps to its real height. The row keeps
// the focus ring's margin so the list viewport does not clip it.
component LogLine inherits KitTextArea {
    access: FieldAccess.read-only;
    min-lines: 1;
    max-lines: 100000;
    show-description: false;
    control-size: ControlSize.compact;
    corner-radius: 0px;
    text-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
    text-font-family: root.theme.typography.family-monospace;
}

component LogRow inherits KitStack {
    in property <string> line;
    in property <string> label;
    in property <length> row-width;
    in property <int> modal-layer;
    callback focus-observed(bool);

    width: root.row-width;
    gap: LayoutSpace.none;
    padding: KitThemes.focus-outset(root.theme.focus);

    LogLine {
        theme: root.theme;
        modal-layer: root.modal-layer;
        text: root.line;
        accessible-name: root.label;
        focus-observed(focused) => { root.focus-observed(focused); }
    }
}

// `log-lines` is the whole tail the host keeps. The ListView only builds the
// rows near its viewport, so the page does not mount every line, and a refresh
// that appends leaves the rows already shown, and the reader's place, alone.
// The host polls only while this page is the visible one.
export component DiagnosticsSection inherits KitFieldSet {
    in property <bool> debug-transcription;
    in property <LogLevel> log-level;
    in property <[string]> log-lines;
    in property <bool> copying-diagnostics: false;
    in property <int> modal-layer: 0;

    callback debug-transcription-changed(bool);
    callback log-level-changed(LogLevel);
    callback copy-diagnostics-requested();

    theme: KitThemeContext.current;
    legend: @tr("DIAGNOSTICS");

    level-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        focus-requested => { level-picker.take-focus(); }
        show-divider: false;
        label: @tr("Niveau de journal");
        description: @tr("Quantité de détails que Soufflé écrit dans le fichier journal.");

        level-picker := ClosedSettingsPicker {
            theme: root.theme;
            modal-layer: level-row.modal-layer;
            label: @tr("Niveau de journal");
            choices: SettingsOptions.log-level-options(root.log-level);
            chosen(row) => { root.log-level-changed(SettingsOptions.log-level-value(row, root.log-level)); }
        }
    }

    logging-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { logging-switch.take-focus(); }
        label: @tr("Journaux détaillés de transcription");
        description: @tr("Enregistre des détails supplémentaires sur la reconnaissance vocale pour le dépannage.");

        logging-switch := KitSwitch {
            theme: root.theme;
            modal-layer: logging-row.modal-layer;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-name: logging-row.label;
            accessible-description: logging-row.description;
            checked: root.debug-transcription;
            toggled(new) => { root.debug-transcription-changed(new); }
            focus-observed(focused) => {
                if focused { logging-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    log-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Orientation.vertical;
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Journal en direct");
        description: @tr("Fin du fichier journal actuel, actualisé toutes les quelques secondes.");

        log-surface := KitSurface {
            theme: root.theme;
            inset: LayoutSpace.tight;
            gap: LayoutSpace.none;
            clip: true;
            accessible-role: groupbox;
            accessible-label: log-row.label;

            if root.log-lines.length == 0: KitText {
                theme: root.theme;
                role: caption;
                text: @tr("Aucune entrée de journal pour l'instant.");
            }
            log := ListView {
                theme: root.theme;
                height: root.log-lines.length == 0 ? 0px : Theme.settings-log-height;
                enabled: !KitModalContext.inert(root.modal-layer);
                for line in root.log-lines: LogRow {
                    theme: root.theme;
                    modal-layer: root.modal-layer;
                    row-width: log.visible-width;
                    line: line;
                    label: log-row.label;
                    focus-observed(focused) => {
                        if focused { log-surface.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
                    }
                }
            }
        }

        KitInline {
            theme: root.theme;
            alignment: end;
            inset: compact;
            copy-button := KitButton {
                theme: root.theme;
                modal-layer: log-row.modal-layer;
                text: root.copying-diagnostics ? @tr("Copie…") : @tr("Copier les diagnostics");
                text-wrap: word-wrap;
                disabled: root.copying-diagnostics;
                activated => { root.copy-diagnostics-requested(); }
                focus-observed(focused) => {
                    if focused { copy-button.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }
            }
        }
    }
}
