import { AppText, AppTextInput, Typography, TypographyStyle } from "@typography";
import { Theme } from "../../theme.slint";
import { SettingsFieldVertical } from "settings_field_vertical.slint";
import { SettingsGroup } from "settings_group.slint";
import { ThemedButton } from "../themed_button.slint";
import { ThemedLineEdit } from "../themed_line_edit.slint";
import { ThemedTextArea } from "../themed_text_area.slint";

// Port of SnippetsSettingsSection.svelte. Which row is being edited is
// tracked in Rust (`snippets_editing` in main.rs), not local `.slint`
// state, so only one row edits at a time and the edit form always reads
// the real backing entry.
export struct SnippetRow {
    id: int,
    trigger: string,
    expansion: string,
    editing: bool,
}

export component SnippetsSection inherits VerticalLayout {
    // Only the currently visible slice of the snippet list (SOU-229) -
    // `lists_ui.rs` owns the full row list and windows it with the same
    // spacer-before/spacer-after pattern as `transcript_section.slint`; see
    // `dictionary_section.slint` for the full rationale.
    in property <[SnippetRow]> entries;
    in property <int> entry-count: 0;
    in property <float> list-content-height: 0.0;
    in property <float> list-spacer-before: 0.0;
    in property <float> list-spacer-after: 0.0;
    in-out property <length> list-scroll-top: 0px;
    in-out property <string> new-trigger-draft: "";
    in-out property <string> new-expansion-draft: "";
    in property <string> add-error;
    in property <int> delete-error-id;
    in property <string> delete-error;
    in-out property <string> edit-trigger-draft: "";
    in-out property <string> edit-expansion-draft: "";
    in property <string> update-error;

    callback add-requested(string, string);
    callback delete-requested(int);
    callback edit-requested(int);
    callback cancel-edit-requested();
    callback save-edit-requested(int, string, string);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: @tr("EXTRAITS VOCAUX");

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-top: 15px;
        padding-bottom: 15px;
        spacing: 8px;

        AppText {
            text: @tr("Dites une phrase déclencheur au début d'une dictée pour insérer un bloc de texte. La comparaison ignore la casse et les accents ; aucune retouche IA n'est appliquée quand un extrait correspond.");
            typography: Typography.secondary;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        AppText { text: @tr("DÉCLENCHEUR"); typography: Typography.table-heading; color: Theme.text-tertiary;   }
        ThemedLineEdit {
            text <=> root.new-trigger-draft;
            placeholder: @tr("Phrase déclencheur");
            control-label: @tr("Phrase déclencheur");
        }
        AppText { text: @tr("EXPANSION"); typography: Typography.table-heading; color: Theme.text-tertiary;   }
        ThemedTextArea {
            text <=> root.new-expansion-draft;
            area-height: 72px;
            placeholder: @tr("Texte à insérer");
            control-label: @tr("Texte de l'extrait vocal");
        }

        HorizontalLayout {
            alignment: end;
            ThemedButton {
                text: @tr("Ajouter un extrait");
                enabled: root.new-trigger-draft != "" && root.new-expansion-draft != "";
                clicked => {
                    root.add-requested(root.new-trigger-draft, root.new-expansion-draft);
                }
            }
        }

        if root.add-error != "": AppText {
            text: root.add-error;
            color: Theme.danger;
            typography: Typography.caption;
        }

        if root.entry-count == 0: AppText {
            text: @tr("Aucune formule.");
            color: Theme.text-muted;
            typography: Typography.secondary;
        }
    }

    snippets-list := Flickable {
        height: min(root.list-content-height * 1px, 420px);
        visible: root.entry-count > 0;
        content-width: self.width;
        content-height: root.list-content-height * 1px;
        content-y <=> root.list-scroll-top;

        VerticalLayout {
        width: snippets-list.width;
        alignment: start;

        Rectangle { height: root.list-spacer-before * 1px; }

        for row in root.entries: Rectangle {
            height: row.editing ? 236px : (root.delete-error != "" && root.delete-error-id == row.id ? 116px : 96px);

            Rectangle {
                x: Theme.settings-inset;
                width: parent.width - 2 * Theme.settings-inset;
                height: parent.height - 6px;
                border-width: 1px;
                border-color: Theme.border-soft;
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    if !row.editing: VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;
                            AppText {
                                text: row.trigger;
                                typography: Typography.hint-emphasis;

                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                ThemedButton {
                                    text: @tr("Modifier");
                                    clicked => { root.edit-requested(row.id); }
                                }
                                ThemedButton {
                                    text: @tr("Supprimer");
                                    clicked => { root.delete-requested(row.id); }
                                }
                            }
                        }
                        AppText {
                            text: row.expansion;
                            typography: Typography.caption;
                            color: Theme.text-muted;
                            max-height: 38px;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }

                    if row.editing: VerticalLayout {
                        spacing: 4px;

                        AppText { text: @tr("DÉCLENCHEUR"); typography: Typography.table-heading; color: Theme.text-tertiary;   }
                        ThemedLineEdit {
                            text <=> root.edit-trigger-draft;
                            control-label: @tr("Phrase déclencheur");
                        }
                        AppText { text: @tr("EXPANSION"); typography: Typography.table-heading; color: Theme.text-tertiary;   }
                        ThemedTextArea {
                            text <=> root.edit-expansion-draft;
                            area-height: 72px;
                            control-label: @tr("Texte de l'extrait vocal");
                        }
                        if root.update-error != "": AppText {
                            text: root.update-error;
                            color: Theme.danger;
                            typography: Typography.caption;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 4px;
                            ThemedButton {
                                text: @tr("Annuler");
                                clicked => { root.cancel-edit-requested(); }
                            }
                            ThemedButton {
                                text: @tr("Enregistrer");
                                enabled: root.edit-trigger-draft != "" && root.edit-expansion-draft != "";
                                clicked => { root.save-edit-requested(row.id, root.edit-trigger-draft, root.edit-expansion-draft); }
                            }
                        }
                    }

                    if root.delete-error != "" && root.delete-error-id == row.id: AppText {
                        text: root.delete-error;
                        color: Theme.danger;
                        typography: Typography.caption;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle { height: root.list-spacer-after * 1px; }
        }
    }
    }
}
