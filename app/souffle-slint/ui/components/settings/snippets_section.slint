import { AppText, Typography } from "@typography";
import { FieldSetAppearance, FieldRowAppearance, ButtonIntent, ControlSize, KitButton, KitFieldError, KitFieldRow, KitFieldSeparator, KitFieldSet, KitTextArea, KitTextField, KitThemeContext, ListView, ResizePolicy, KitOverline } from "@kit";
import { Theme } from "../../theme.slint";

// Port of SnippetsSettingsSection.svelte. Which row is being edited is
// tracked in Rust (`snippets_editing` in main.rs), not local `.slint`
// state, so only one row edits at a time and the edit form always reads
// the real backing entry.
export struct SnippetRow {
    id: int,
    trigger: string,
    expansion: string,
    editing: bool,
}

export component SnippetsSection inherits VerticalLayout {
    // The whole snippet list (SOU-229), virtualized by the kit list below; see
    // `dictionary_section.slint`. Row heights must match the constants in
    // `lists_ui.rs`.
    in property <[SnippetRow]> entries;
    in property <int> entry-count: 0;
    in property <float> list-content-height: 0.0;
    in-out property <length> list-scroll-top: 0px;
    in-out property <string> new-trigger-draft: "";
    in-out property <string> new-expansion-draft: "";
    in property <string> add-error;
    in property <int> delete-error-id;
    in property <string> delete-error;
    in-out property <string> edit-trigger-draft: "";
    in-out property <string> edit-expansion-draft: "";
    in property <string> update-error;

    callback add-requested(string, string);
    callback delete-requested(int);
    callback edit-requested(int);
    callback cancel-edit-requested();
    callback save-edit-requested(int, string, string);

    spacing: 20px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("EXTRAITS VOCAUX");
        appearance: FieldSetAppearance.card;

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            label: @tr("Dites une phrase déclencheur au début d'une dictée");
            description: @tr("La comparaison ignore la casse et les accents ; aucune retouche IA n'est appliquée quand un extrait correspond.");
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                alignment: stretch;

                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    width: 220px;
                    horizontal-stretch: 0;
                    KitOverline { label: @tr("DÉCLENCHEUR"); }
                    KitTextField {
                        text <=> root.new-trigger-draft;
                        placeholder: @tr("Phrase déclencheur");
                        accessible-name: @tr("Phrase déclencheur");
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    horizontal-stretch: 1;
                    KitOverline { label: @tr("EXPANSION"); }
                    KitTextArea {
                        text <=> root.new-expansion-draft;
                        placeholder: @tr("Texte à insérer");
                        accessible-name: @tr("Texte de l'extrait vocal");
                        resize-policy: ResizePolicy.fixed;
                        padding-block-start: 11px;
                        // Enough lines to ask for more than 72px, so the editor fills it.
                        min-lines: 4;
                        height: 72px;
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                KitButton {
                    text: @tr("Ajouter un extrait");
                    intent: ButtonIntent.primary;
                    disabled: root.new-trigger-draft == "" || root.new-expansion-draft == "";
                    activated => {
                        root.add-requested(root.new-trigger-draft, root.new-expansion-draft);
                    }
                }
            }

            if root.add-error != "": KitFieldError { text: root.add-error; }

            if root.entry-count == 0: AppText {
                text: @tr("Aucun extrait.");
                color: Theme.text-muted;
                typography: Typography.secondary;
            }
        }

        snippets-list := ListView {
            // Rows pad their own trailing edge, so their dividers reach the card's.
            overlay-scrollbars: true;
            // Seven whole rows, as in the dictionary list.
            height: min(root.list-content-height * 1px, 406px);
            visible: root.entry-count > 0;
            horizontal-scrollbar-policy: always-off;
            content-y <=> root.list-scroll-top;

            for row in root.entries: VerticalLayout {
                width: snippets-list.visible-width;
                height: row.editing ? 236px : (root.delete-error != "" && root.delete-error-id == row.id ? 80px : 58px);
                alignment: start;

                KitFieldSeparator { theme: KitThemeContext.current; }

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 6px;
                    alignment: start;

                    if !row.editing: HorizontalLayout {
                        spacing: 12px;
                        alignment: stretch;

                        AppText {
                            text: row.trigger;
                            typography: Typography.field-heading;
                            color: Theme.text-primary;
                            overflow: elide;
                            width: 200px;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        AppText {
                            text: row.expansion;
                            typography: Typography.content;
                            color: Theme.text-muted;
                            max-height: 32px;
                            wrap: word-wrap;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;
                            alignment: start;
                            KitButton {
                                text: @tr("Modifier");
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.quiet;
                                activated => { root.edit-requested(row.id); }
                            }
                            KitButton {
                                text: @tr("Supprimer");
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.quiet;
                                activated => { root.delete-requested(row.id); }
                            }
                        }
                    }

                    if row.editing: VerticalLayout {
                        spacing: 6px;

                        KitOverline { label: @tr("DÉCLENCHEUR"); }
                        KitTextField {
                            text <=> root.edit-trigger-draft;
                            accessible-name: @tr("Phrase déclencheur");
                        }
                        KitOverline { label: @tr("EXPANSION"); }
                        KitTextArea {
                            text <=> root.edit-expansion-draft;
                            accessible-name: @tr("Texte de l'extrait vocal");
                            resize-policy: ResizePolicy.fixed;
                            min-lines: 4;
                            height: 72px;
                        }
                        if root.update-error != "": KitFieldError { text: root.update-error; overflow: elide; }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            KitButton {
                                text: @tr("Annuler");
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.quiet;
                                activated => { root.cancel-edit-requested(); }
                            }
                            KitButton {
                                text: @tr("Enregistrer");
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.primary;
                                disabled: root.edit-trigger-draft == "" || root.edit-expansion-draft == "";
                                activated => { root.save-edit-requested(row.id, root.edit-trigger-draft, root.edit-expansion-draft); }
                            }
                        }
                    }

                    if root.delete-error != "" && root.delete-error-id == row.id: KitFieldError {
                        text: root.delete-error;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
