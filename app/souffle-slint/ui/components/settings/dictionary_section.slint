import { AppText, Typography } from "@typography";
import { FieldSetAppearance, FieldRowAppearance, ButtonIntent, ControlSize, KitBadge, KitButton, KitFieldRow, KitFieldSeparator, KitFieldSet, KitSegmentedControl, KitSurface, KitText, KitTextField, KitThemeContext, LayoutSpace, ListView, OptionRow, Ownership, SurfaceLevel, TypographyRole, TextViewFont, KitOverline, SegmentedAppearance, ControlWidth, SurfaceBorder } from "@kit";
import { LucideFiles } from "@kit-icons/files.slint";
import { Theme } from "../../theme.slint";
import { DictionaryLearningMode } from "../../types.slint";

export struct DictionaryRow {
    id: int,
    term: string,
    aliases-display: string,
    category: string,
}

export struct DictionaryLearningOption { mode: DictionaryLearningMode }
export struct DictionarySuggestionRow { id: int, misspelling: string, term: string }

export component DictionarySection inherits VerticalLayout {
    in property <DictionaryLearningMode> learning-mode;
    in property <[DictionaryLearningOption]> learning-options;
    in property <[DictionarySuggestionRow]> suggestions;
    in property <int> suggestion-count;
    in property <float> suggestion-content-height;
    in-out property <length> suggestion-scroll-top;
    in property <string> suggestion-error;
    in property <bool> suggestion-busy;
    // The whole dictionary (SOU-229). The kit list below creates a row only
    // while it is on screen, so a long dictionary costs the same as a short one.
    in property <[DictionaryRow]> entries;
    // Entry count (for the empty state) and px height of all the rows, which
    // sizes the list while it is shorter than its maximum - plain `float`
    // because `lists_ui.rs` adds up the row heights. They must match the row
    // heights below.
    in property <int> entry-count: 0;
    in property <float> list-content-height: 0.0;
    // Exposed for the design fixture, which shows the list scrolled.
    in-out property <length> list-scroll-top: 0px;
    in-out property <string> new-term-draft: "";
    in-out property <string> new-pronunciation-draft: "";
    in-out property <string> new-category-draft: "";
    in property <string> add-error;
    in property <int> delete-error-id;
    in property <string> delete-error;

    callback learning-mode-changed(DictionaryLearningMode);
    callback suggestion-accept-requested(int);
    callback suggestion-dismiss-requested(int);
    callback add-requested(string, string, string);
    callback delete-requested(int);

    pure function mode-token(mode: DictionaryLearningMode) -> int {
        return mode == DictionaryLearningMode.disabled ? 0 : mode == DictionaryLearningMode.suggestions ? 1 : 2;
    }
    pure function token-mode(token: int) -> DictionaryLearningMode {
        return token == 0 ? DictionaryLearningMode.disabled : token == 1 ? DictionaryLearningMode.suggestions : DictionaryLearningMode.automatic;
    }
    property <[OptionRow]> learning-rows: [
        { token: 0, generation: 0, label: @tr("Désactivé") },
        { token: 1, generation: 0, label: @tr("Suggestions") },
        { token: 2, generation: 0, label: @tr("Automatique") },
    ];

    spacing: 20px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("DICTIONNAIRE PERSONNALISÉ");
        appearance: FieldSetAppearance.card;

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        label: @tr("Apprentissage depuis les corrections");
        description: @tr("Suggestions propose des corrections après un collage et pendant une réunion. Automatique n'apprend qu'après un collage. L'apprentissage après collage demande que le collage automatique soit activé et réussisse. Quel que soit le mode, vos corrections en réunion s'appliquent à la suite de celle-ci si « Correction par dictionnaire » est activée.");
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 14px;
        alignment: start;
        KitSegmentedControl {
            ownership: Ownership.controlled;
            control-size: ControlSize.compact;
            appearance: SegmentedAppearance.raised;
            control-width: ControlWidth.intrinsic;
            horizontal-stretch: 0;
            label: @tr("Apprentissage depuis les corrections");
            options: root.learning-rows;
            selected: { present: true, token: root.mode-token(root.learning-mode) };
            chosen(row) => {
                if root.token-mode(row.token) != root.learning-mode { root.learning-mode-changed(root.token-mode(row.token)); }
            }
        }
    }

    if root.suggestion-count > 0 || root.suggestion-error != "": VerticalLayout {
        KitFieldSeparator { }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 6px;
            spacing: 8px;
            KitOverline { label: @tr("CORRECTIONS À VALIDER"); }
            if root.suggestion-error != "": AppText {
                text: root.suggestion-error; color: Theme.danger; typography: Typography.caption; wrap: word-wrap;
            }
            suggestion-list := ListView {
                // A reserved scrollbar gutter would shorten the correction strips.
                overlay-scrollbars: true;
                height: min(root.suggestion-content-height * 1px, 240px);
                horizontal-scrollbar-policy: always-off;
                content-y <=> root.suggestion-scroll-top;

                for row in root.suggestions: Rectangle {
                    width: suggestion-list.visible-width;
                    height: 52px;
                    KitSurface {
                        y: 0px;
                        height: 46px;
                        level: SurfaceLevel.inset;
                        border: SurfaceBorder.none;
                        corner-radius: 10px;
                        inset: LayoutSpace.none;
                        HorizontalLayout {
                            height: 46px;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 10px;
                            alignment: stretch;
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                horizontal-stretch: 1;
                                AppText {
                                    text: @tr("Correction :");
                                    accessible-label: @tr("Correction : {} → {}", row.misspelling, row.term);
                                    typography: Typography.content;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                KitText {
                                    text: row.misspelling;
                                    role: TypographyRole.control;
                                    font: TextViewFont.monospace;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                AppText {
                                    text: "→";
                                    typography: Typography.content;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                                AppText {
                                    text: row.term;
                                    typography: Typography.section;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            KitButton {
                                text: @tr("Ignorer");
                                accessible-label: @tr("Ignorer {} → {}", row.misspelling, row.term);
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.quiet;
                                disabled: root.suggestion-busy;
                                activated => { root.suggestion-dismiss-requested(row.id); }
                            }
                            KitButton {
                                text: @tr("Accepter");
                                accessible-label: @tr("Accepter {} → {}", row.misspelling, row.term);
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.primary;
                                disabled: root.suggestion-busy;
                                activated => { root.suggestion-accept-requested(row.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    KitFieldSeparator { }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 8px;

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 12px;
                KitOverline { label: @tr("TERME"); horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
                KitOverline { label: @tr("PRONONCIATION"); horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
                KitOverline { label: @tr("CATÉGORIE"); width: 100px; }
                Rectangle { width: 110px; height: 1px; horizontal-stretch: 0; }
            }

            HorizontalLayout {
                spacing: 12px;
                KitTextField {
                    text <=> root.new-term-draft;
                    placeholder: @tr("ex. Kubernetes");
                    accessible-name: @tr("Terme");
                    horizontal-stretch: 1;
                }
                KitTextField {
                    text <=> root.new-pronunciation-draft;
                    placeholder: @tr("ex. vaysix");
                    accessible-name: @tr("Prononciation facultative");
                    horizontal-stretch: 1;
                }
                KitTextField {
                    text <=> root.new-category-draft;
                    placeholder: @tr("ex. tech");
                    accessible-name: @tr("Catégorie facultative");
                    width: 100px;
                }
                KitButton {
                    text: @tr("Ajouter");
                    intent: ButtonIntent.primary;
                    disabled: root.new-term-draft == "";
                    activated => {
                        root.add-requested(root.new-term-draft, root.new-pronunciation-draft, root.new-category-draft);
                    }
                }
            }
        }

        if root.add-error != "": AppText {
            text: root.add-error;
            color: Theme.danger;
            typography: Typography.caption;
        }

        if root.entry-count == 0: AppText {
            text: @tr("Aucune entrée.");
            typography: Typography.secondary;
            color: Theme.text-muted;
        }
    }

    dictionary-list := ListView {
        // Rows pad their own trailing edge, so their dividers reach the card's.
        overlay-scrollbars: true;
        // Seven whole rows, so the card edge never cuts one at either end.
        height: min(root.list-content-height * 1px, 357px);
        visible: root.entry-count > 0;
        horizontal-scrollbar-policy: always-off;
        content-y <=> root.list-scroll-top;

        for row in root.entries: Rectangle {
            width: dictionary-list.visible-width;
            height: root.delete-error != "" && root.delete-error-id == row.id ? 72px : 51px;

            KitFieldSeparator { y: 0px; }
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 4px;
                alignment: center;

                HorizontalLayout {
                    spacing: 12px;
                    AppText {
                        text: row.term;
                        typography: Typography.field-heading;
                        color: Theme.text-primary;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        // Equal columns whatever the text, so they line up across rows.
                        preferred-width: 0px;
                    }
                    KitText {
                        text: row.aliases-display;
                        role: TypographyRole.caption;
                        font: TextViewFont.monospace;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                    }
                    // Reserved even without a category.
                    HorizontalLayout {
                        min-width: 100px;
                        horizontal-stretch: 0;
                        alignment: end;
                        if row.category != "": VerticalLayout {
                            alignment: center;
                            KitBadge { text: row.category; subtle: true; }
                        }
                    }
                    KitButton {
                        text: @tr("Supprimer");
                        control-size: ControlSize.compact;
                        intent: ButtonIntent.quiet;
                        leading-icon: LucideFiles.trash();
                        activated => { root.delete-requested(row.id); }
                    }
                }

                if root.delete-error != "" && root.delete-error-id == row.id: AppText {
                    text: root.delete-error;
                    color: Theme.danger;
                    typography: Typography.caption;
                    overflow: elide;
                }
            }
        }
    }
    }
}
