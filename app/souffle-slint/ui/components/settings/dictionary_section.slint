import { AppText, Typography } from "@typography";
import { ButtonIntent, ControlSize, KitBadge, KitButton, KitFieldRow, KitFieldSeparator, KitFieldSet, KitMetrics, KitSegmentedControl, KitSurface, KitText, KitTextField, KitThemeContext, LayoutSpace, OptionRow, Ownership, ScrollFrame, SurfaceLevel, TypographyRole, TextViewFont } from "@kit";
import { Theme } from "../../theme.slint";
import { DictionaryLearningMode } from "../../types.slint";

export struct DictionaryRow {
    id: int,
    term: string,
    aliases-display: string,
    category: string,
}

export struct DictionaryLearningOption { mode: DictionaryLearningMode }
export struct DictionarySuggestionRow { id: int, misspelling: string, term: string }

export component DictionarySection inherits VerticalLayout {
    in property <DictionaryLearningMode> learning-mode;
    in property <[DictionaryLearningOption]> learning-options;
    in property <[DictionarySuggestionRow]> suggestions;
    in property <int> suggestion-count;
    in property <float> suggestion-content-height;
    in property <float> suggestion-spacer-before;
    in property <float> suggestion-spacer-after;
    in-out property <length> suggestion-scroll-top;
    in property <string> suggestion-error;
    in property <bool> suggestion-busy;
    // Only the currently visible slice of the dictionary, not the whole
    // thing (SOU-229) - `lists_ui.rs` owns the full row list and pushes a
    // new slice in whenever `list-scroll-top` moves far enough, same
    // spacer-before/spacer-after windowing as `transcript_section.slint`
    // (Slint's `ListView` is a `ScrollView { @children }` that mounts every
    // model row, so it can't bound instantiation itself).
    in property <[DictionaryRow]> entries;
    // Full entry count (for the empty state) and estimated px height of the
    // whole list - plain `float`s because Rust's stable `set_*` API has no
    // `length` type, see `transcript_section.slint`.
    in property <int> entry-count: 0;
    in property <float> list-content-height: 0.0;
    in property <float> list-spacer-before: 0.0;
    in property <float> list-spacer-after: 0.0;
    // Two-way bound up to `MainWindow` so `lists_ui.rs` can react to the real
    // scroll position and decide the next slice.
    in-out property <length> list-scroll-top: 0px;
    in-out property <string> new-term-draft: "";
    in-out property <string> new-pronunciation-draft: "";
    in-out property <string> new-category-draft: "";
    in property <string> add-error;
    in property <int> delete-error-id;
    in property <string> delete-error;

    callback learning-mode-changed(DictionaryLearningMode);
    callback suggestion-accept-requested(int);
    callback suggestion-dismiss-requested(int);
    callback add-requested(string, string, string);
    callback delete-requested(int);

    pure function mode-token(mode: DictionaryLearningMode) -> int {
        return mode == DictionaryLearningMode.disabled ? 0 : mode == DictionaryLearningMode.suggestions ? 1 : 2;
    }
    pure function token-mode(token: int) -> DictionaryLearningMode {
        return token == 0 ? DictionaryLearningMode.disabled : token == 1 ? DictionaryLearningMode.suggestions : DictionaryLearningMode.automatic;
    }
    property <[OptionRow]> learning-rows: [
        { token: 0, generation: 0, label: @tr("Désactivé") },
        { token: 1, generation: 0, label: @tr("Suggestions") },
        { token: 2, generation: 0, label: @tr("Automatique") },
    ];

    spacing: 22px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("DICTIONNAIRE PERSONNALISÉ");

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: false;
        label: @tr("Apprentissage depuis les corrections");
        description: @tr("Suggestions propose les corrections après collage et en réunion. Automatique apprend après collage. Les corrections de session restent immédiates.");
    }

    HorizontalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 14px;
        alignment: start;
        KitSegmentedControl {
            ownership: Ownership.controlled;
            control-size: ControlSize.compact;
            label: @tr("Apprentissage depuis les corrections");
            options: root.learning-rows;
            selected: { present: true, token: root.mode-token(root.learning-mode) };
            chosen(row) => {
                if root.token-mode(row.token) != root.learning-mode { root.learning-mode-changed(root.token-mode(row.token)); }
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        spacing: 8px;
        AppText { text: @tr("CORRECTIONS À VALIDER"); color: Theme.text-muted; typography: Typography.secondary; }
        if root.suggestion-count == 0: AppText {
            text: @tr("Aucune suggestion en attente."); color: Theme.text-muted; typography: Typography.secondary;
        }
        if root.suggestion-error != "": AppText {
            text: root.suggestion-error; color: Theme.danger; typography: Typography.caption; wrap: word-wrap;
        }
        suggestion-list := ScrollFrame {
            height: min(root.suggestion-content-height * 1px, 240px);
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: root.suggestion-content-height * 1px;
            content-y <=> root.suggestion-scroll-top;
            VerticalLayout {
                width: suggestion-list.visible-width;
                alignment: start;
                Rectangle { height: root.suggestion-spacer-before * 1px; }
                for row in root.suggestions: Rectangle {
                    height: 64px;
                    KitSurface {
                        y: 4px;
                        height: parent.height - 8px;
                        level: SurfaceLevel.inset;
                        inset: LayoutSpace.compact;
                        HorizontalLayout {
                            spacing: KitMetrics.inline-gap(KitThemeContext.current);
                            alignment: stretch;
                            KitText {
                                text: @tr("Correction : {} → {}", row.misspelling, row.term);
                                role: TypographyRole.body;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            KitButton {
                                text: @tr("Ignorer");
                                accessible-label: @tr("Ignorer {} → {}", row.misspelling, row.term);
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.quiet;
                                disabled: root.suggestion-busy;
                                activated => { root.suggestion-dismiss-requested(row.id); }
                            }
                            KitButton {
                                text: @tr("Accepter");
                                accessible-label: @tr("Accepter {} → {}", row.misspelling, row.term);
                                control-size: ControlSize.compact;
                                intent: ButtonIntent.primary;
                                disabled: root.suggestion-busy;
                                activated => { root.suggestion-accept-requested(row.id); }
                            }
                        }
                    }
                }
                Rectangle { height: root.suggestion-spacer-after * 1px; }
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 8px;

        AppText {
            text: @tr("Termes techniques, noms propres ou acronymes mal reconnus.");
            typography: Typography.secondary;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 12px;
                AppText { text: @tr("TERME"); typography: Typography.table-heading; color: Theme.text-tertiary; horizontal-stretch: 1; }
                AppText { text: @tr("PRONONCIATION"); typography: Typography.table-heading; color: Theme.text-tertiary; horizontal-stretch: 1; }
                AppText { text: @tr("CATÉGORIE"); typography: Typography.table-heading; color: Theme.text-tertiary; width: 100px; }
                Rectangle { width: 110px; height: 1px; horizontal-stretch: 0; }
            }

            HorizontalLayout {
                spacing: 12px;
                KitTextField {
                    text <=> root.new-term-draft;
                    placeholder: @tr("ex. Kubernetes");
                    accessible-name: @tr("Terme");
                    horizontal-stretch: 1;
                }
                KitTextField {
                    text <=> root.new-pronunciation-draft;
                    placeholder: @tr("ex. vaysix");
                    accessible-name: @tr("Prononciation facultative");
                    horizontal-stretch: 1;
                }
                KitTextField {
                    text <=> root.new-category-draft;
                    placeholder: @tr("ex. tech");
                    accessible-name: @tr("Catégorie facultative");
                    width: 100px;
                }
                KitButton {
                    text: @tr("Ajouter");
                    intent: ButtonIntent.primary;
                    disabled: root.new-term-draft == "";
                    activated => {
                        root.add-requested(root.new-term-draft, root.new-pronunciation-draft, root.new-category-draft);
                    }
                }
            }
        }

        if root.add-error != "": AppText {
            text: root.add-error;
            color: Theme.danger;
            typography: Typography.caption;
        }

        if root.entry-count == 0: AppText {
            text: @tr("Aucune entrée.");
            typography: Typography.secondary;
            color: Theme.text-muted;
        }
    }

    dictionary-list := ScrollFrame {
        height: min(root.list-content-height * 1px, 360px);
        visible: root.entry-count > 0;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: root.list-content-height * 1px;
        content-y <=> root.list-scroll-top;

        VerticalLayout {
        width: dictionary-list.visible-width;
        alignment: start;

        Rectangle { height: root.list-spacer-before * 1px; }

        for row in root.entries: Rectangle {
            height: root.delete-error != "" && root.delete-error-id == row.id ? 88px : 64px;

            KitFieldSeparator { y: 0px; }
            VerticalLayout {
                padding-left: Theme.settings-inset;
                padding-right: Theme.settings-inset;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;
                alignment: center;

                HorizontalLayout {
                    spacing: 12px;
                    KitText {
                        text: row.term;
                        role: TypographyRole.subtitle;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    KitText {
                        text: row.aliases-display;
                        role: TypographyRole.caption;
                        font: TextViewFont.monospace;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if row.category != "": KitBadge { text: row.category; }
                    KitButton {
                        text: @tr("Supprimer");
                        control-size: ControlSize.compact;
                        intent: ButtonIntent.quiet;
                        activated => { root.delete-requested(row.id); }
                    }
                }

                if root.delete-error != "" && root.delete-error-id == row.id: AppText {
                    text: root.delete-error;
                    color: Theme.danger;
                    typography: Typography.caption;
                    overflow: elide;
                }
            }
        }

        Rectangle { height: root.list-spacer-after * 1px; }
        }
    }
    }
}
