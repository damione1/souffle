import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { DictionaryLearningMode } from "../../types.slint";
import { ThemedButton, ThemedButtonKind } from "../themed_button.slint";
import { ThemedLineEdit } from "../themed_line_edit.slint";


// Port of DictionarySettingsSection.svelte. Simplified: aliases (comma-
// separated pronunciations) show as plain text per entry rather than
// individually removable chips - add/delete/list are the real thing
// against the dictionary DB, this only drops the one-alias-at-a-time
// removal affordance (documented gap, not a placeholder).
export struct DictionaryRow {
    id: int,
    term: string,
    aliases-display: string,
    category: string,
}

export struct DictionaryLearningOption { mode: DictionaryLearningMode }
export struct DictionarySuggestionRow { id: int, misspelling: string, term: string }

export component DictionarySection inherits VerticalLayout {
    in property <DictionaryLearningMode> learning-mode;
    in property <[DictionaryLearningOption]> learning-options;
    in property <[DictionarySuggestionRow]> suggestions;
    in property <int> suggestion-count;
    in property <float> suggestion-content-height;
    in property <float> suggestion-spacer-before;
    in property <float> suggestion-spacer-after;
    in-out property <length> suggestion-scroll-top;
    in property <string> suggestion-error;
    in property <bool> suggestion-busy;
    // Only the currently visible slice of the dictionary, not the whole
    // thing (SOU-229) - `lists_ui.rs` owns the full row list and pushes a
    // new slice in whenever `list-scroll-top` moves far enough, same
    // spacer-before/spacer-after windowing as `transcript_section.slint`
    // (Slint's `ListView` is a `ScrollView { @children }` that mounts every
    // model row, so it can't bound instantiation itself).
    in property <[DictionaryRow]> entries;
    // Full entry count (for the empty state) and estimated px height of the
    // whole list - plain `float`s because Rust's stable `set_*` API has no
    // `length` type, see `transcript_section.slint`.
    in property <int> entry-count: 0;
    in property <float> list-content-height: 0.0;
    in property <float> list-spacer-before: 0.0;
    in property <float> list-spacer-after: 0.0;
    // Two-way bound up to `MainWindow` so `lists_ui.rs` can react to the real
    // scroll position and decide the next slice.
    in-out property <length> list-scroll-top: 0px;
    in-out property <string> new-term-draft: "";
    in-out property <string> new-pronunciation-draft: "";
    in-out property <string> new-category-draft: "";
    in property <string> add-error;
    in property <int> delete-error-id;
    in property <string> delete-error;

    callback learning-mode-changed(DictionaryLearningMode);
    callback suggestion-accept-requested(int);
    callback suggestion-dismiss-requested(int);
    callback add-requested(string, string, string);
    callback delete-requested(int);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: @tr("DICTIONNAIRE PERSONNALISÉ");

    SettingsField {
        show-divider: false;
        label: @tr("Apprentissage depuis les corrections");
        description: @tr("Suggestions propose les corrections après collage et en réunion. Automatique apprend après collage. Les corrections de session restent immédiates.");

        HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 0;
            for option in root.learning-options: ThemedButton {
                text: option.mode == DictionaryLearningMode.disabled ? @tr("Désactivé") :
                    option.mode == DictionaryLearningMode.suggestions ? @tr("Suggestions") :
                    option.mode == DictionaryLearningMode.automatic ? @tr("Automatique") : "";
                compact: true;
                kind: root.learning-mode == option.mode ? ThemedButtonKind.active : ThemedButtonKind.default;
                clicked => {
                    if root.learning-mode != option.mode { root.learning-mode-changed(option.mode); }
                }
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        spacing: 8px;
        Text { text: @tr("CORRECTIONS À VALIDER"); color: Theme.text-muted; font-size: 12px; }
        if root.suggestion-count == 0: Text {
            text: @tr("Aucune suggestion en attente."); color: Theme.text-muted; font-size: 12px;
        }
        if root.suggestion-error != "": Text {
            text: root.suggestion-error; color: Theme.danger; font-size: 11px; wrap: word-wrap;
        }
        suggestion-list := Flickable {
            height: min(root.suggestion-content-height * 1px, 240px);
            content-width: self.width;
            content-height: root.suggestion-content-height * 1px;
            content-y <=> root.suggestion-scroll-top;
            VerticalLayout {
                width: suggestion-list.width;
                alignment: start;
                Rectangle { height: root.suggestion-spacer-before * 1px; }
                for row in root.suggestions: Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text {
                            text: @tr("Correction : {} → {}", row.misspelling, row.term);
                            color: Theme.text-primary; font-size: 12px;
                            overflow: elide; horizontal-stretch: 1;
                        }
                        ThemedButton { text: @tr("Accepter"); enabled: !root.suggestion-busy; clicked => { root.suggestion-accept-requested(row.id); } }
                        ThemedButton { text: @tr("Ignorer"); enabled: !root.suggestion-busy; clicked => { root.suggestion-dismiss-requested(row.id); } }
                    }
                }
                Rectangle { height: root.suggestion-spacer-after * 1px; }
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 8px;

        Text {
            text: @tr("Termes techniques, noms propres ou acronymes mal reconnus.");
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: @tr("TERME");
                    font-size: 10.5px;
                    color: Theme.text-tertiary;
                    font-family: "Archivo Bold";
                    letter-spacing: 1px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("PRONONCIATION");
                    font-size: 10.5px;
                    color: Theme.text-tertiary;
                    font-family: "Archivo Bold";
                    letter-spacing: 1px;
                    width: 110px;
                }
                Text {
                    text: @tr("CATÉGORIE");
                    font-size: 10.5px;
                    color: Theme.text-tertiary;
                    font-family: "Archivo Bold";
                    letter-spacing: 1px;
                    width: 100px;
                }
                Rectangle {
                    width: 88px;
                    height: 1px;
                    horizontal-stretch: 0;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                ThemedLineEdit {
                    text <=> root.new-term-draft;
                    placeholder: @tr("ex. Kubernetes");
                    control-label: @tr("Terme");
                    horizontal-stretch: 1;
                }
                ThemedLineEdit {
                    text <=> root.new-pronunciation-draft;
                    placeholder: @tr("ex. vaysix");
                    control-label: @tr("Prononciation facultative");
                    width: 110px;
                }
                ThemedLineEdit {
                    text <=> root.new-category-draft;
                    placeholder: @tr("ex. tech");
                    control-label: @tr("Catégorie facultative");
                    width: 100px;
                }
                ThemedButton {
                    text: @tr("Ajouter");
                    enabled: root.new-term-draft != "";
                    clicked => {
                        root.add-requested(root.new-term-draft, root.new-pronunciation-draft, root.new-category-draft);
                    }
                }
            }
        }

        if root.add-error != "": Text {
            text: root.add-error;
            color: Theme.danger;
            font-size: 11px;
        }

        if root.entry-count == 0: Text {
            text: @tr("Aucune entrée.");
            font-size: 12px;
            color: Theme.text-muted;
        }
    }

    dictionary-list := Flickable {
        height: min(root.list-content-height * 1px, 360px);
        visible: root.entry-count > 0;
        content-width: self.width;
        content-height: root.list-content-height * 1px;
        content-y <=> root.list-scroll-top;

        VerticalLayout {
        width: dictionary-list.width;
        alignment: start;

        Rectangle { height: root.list-spacer-before * 1px; }

        for row in root.entries: Rectangle {
            height: root.delete-error != "" && root.delete-error-id == row.id ? 88px : 64px;

            Rectangle {
                x: Theme.settings-inset;
                width: parent.width - 2 * Theme.settings-inset;
                height: parent.height - 6px;
                border-width: 1px;
                border-color: Theme.border-soft;
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: row.term + (row.aliases-display == "" ? "" : "  (" + row.aliases-display + ")");
                                font-size: 12.5px;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            if row.category != "": Text {
                                text: row.category;
                                font-size: 10.5px;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }
                        ThemedButton {
                            text: @tr("Supprimer");
                            clicked => { root.delete-requested(row.id); }
                        }
                    }

                    if root.delete-error != "" && root.delete-error-id == row.id: Text {
                        text: root.delete-error;
                        color: Theme.danger;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle { height: root.list-spacer-after * 1px; }
        }
    }
    }
}
