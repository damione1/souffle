import { AppText, AppTextInput, Typography, TypographyStyle } from "@typography";
import { Theme } from "../../theme.slint";

// Port of components/ui/SettingsField.svelte + app.css `.setting-label` /
// `.setting-desc` / `.settings-rows > *`. The control on the right must set
// `horizontal-stretch: 0` (ThemedComboBox/Switch already do) so it does not
// inflate in this row's leftover space.
export component SettingsField inherits VerticalLayout {
    in property <string> label;
    in property <string> description: "";
    in property <bool> show-divider: true;

    spacing: 0px;
    alignment: start;
    vertical-stretch: 0;

    if root.show-divider: Rectangle {
        height: 1px;
        background: Theme.border-soft;
        vertical-stretch: 0;
    }

    HorizontalLayout {
        padding-top: 15px;
        padding-bottom: 15px;
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        spacing: 16px;

        VerticalLayout {
            spacing: 2px;
            alignment: start;
            horizontal-stretch: 1;
            vertical-stretch: 0;

            AppText {
                text: root.label;
                typography: Typography.field-label;
                color: Theme.text-secondary;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            if root.description != "": AppText {
                text: root.description;
                typography: Typography.secondary;
                color: Theme.text-muted;
                wrap: word-wrap;
                horizontal-alignment: left;
            }
        }

        @children
    }
}
