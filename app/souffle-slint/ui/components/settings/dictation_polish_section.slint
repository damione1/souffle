import { FieldSetAppearance, FieldRowAppearance, FieldRowAlignment, ChoiceLabelPosition, ControlWidth, KitFieldRow, KitFieldSet, KitSwitch, KitTextArea, KitThemeContext, KitThemes, Ownership, ResizePolicy } from "@kit";
import { CatalogPicker } from "../catalog_picker.slint";
import { Theme } from "../../theme.slint";
import { SettingsFieldRow } from "../app_controls.slint";

export component DictationPolishSection inherits KitFieldSet {
    in property <bool> enabled;
    in property <[string]> template-ids;
    in property <[string]> template-labels;
    in property <string> active-template-id;
    in-out property <string> active-prompt;

    callback enabled-changed(bool);
    callback template-changed(string);
    callback prompt-changed(string);

    theme: KitThemeContext.current;
    legend: @tr("POLISH DE LA DICTÉE");
    appearance: FieldSetAppearance.card;

    SettingsFieldRow {
        theme: KitThemeContext.current;
        focus-requested => { polish-switch.take-focus(); }
        private property <bool> control-focused: polish-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Nettoyer la dictée avec l'IA");
        description: @tr("Après la dictée, le moteur IA (Apple Intelligence ou Ollama) retouche le texte transcrit en suivant le gabarit de retouche.");

        polish-switch := KitSwitch {
            theme: KitThemeContext.current;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Nettoyer la dictée avec l'IA");
            checked: root.enabled;
            toggled(new) => { root.enabled-changed(new); }
        }
    }

    if root.enabled && root.template-labels.length > 0: SettingsFieldRow {
        theme: KitThemeContext.current;
        focus-requested => { model-picker.take-focus(); }
        private property <bool> control-focused: model-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Gabarit de retouche");

        model-picker := CatalogPicker {
            theme: KitThemeContext.current;
            control-label: @tr("Gabarit de retouche");
            model: root.template-labels;
            option-values: root.template-ids;
            current-value: root.active-template-id;
            value-chosen(id) => { root.template-changed(id); }
        }
    }

    if root.enabled && root.template-labels.length > 0: instruction-row := KitFieldRow {
        theme: KitThemeContext.current;
        orientation: self.width < 600px ? Orientation.vertical : Orientation.horizontal;
        row-alignment: FieldRowAlignment.top;
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { instruction-editor.take-focus(); }
        private property <bool> control-focused: instruction-editor.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Instruction");
        description: @tr("Prompt envoyé à l'IA pour retoucher le texte transcrit.");

        instruction-editor := KitTextArea {
            theme: KitThemeContext.current;
            width: 340px;
            min-lines: 4;
            max-lines: 4;
            padding-block-start: 11px;
            resize-policy: ResizePolicy.fixed;
            text <=> root.active-prompt;
            description: instruction-row.description;
            show-description: false;
            placeholder: @tr("Instruction de retouche");
            accessible-name: @tr("Instruction de retouche");
            edited(value) => { root.prompt-changed(value); }
        }
    }
}
