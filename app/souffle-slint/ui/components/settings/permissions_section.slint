import { Theme } from "../../theme.slint";
import { KitButton, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow, KitMetrics } from "@kit";

// Port of PermissionsSettingsSection.svelte.
export component PermissionsSection inherits VerticalLayout {
    callback review-requested();

    spacing: 22px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("PERMISSIONS");

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            focus-requested => { permissions-button.take-focus(); }
            private property <bool> control-focused: permissions-button.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            show-divider: false;
            label: @tr("Permissions");
            description: @tr("Revérifier les permissions macOS si le collage ou l'enregistrement cesse de fonctionner.");

            permissions-button := KitButton {
                theme: KitThemeContext.current;
                modal-layer: 0;
                text: @tr("Vérifier les permissions");
                activated => { root.review-requested(); }
            }
        }
    }
}
