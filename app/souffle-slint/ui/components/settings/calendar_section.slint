import { AlertSeverity, ChoiceLabelPosition, ButtonIntent, ControlSize, KitAlert, KitText, TypographyRole, CheckState, ControlWidth, KitButton, KitCheckbox, KitNumberStepper, KitSwitch, Ownership, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow, KitMetrics } from "@kit";
import { SettingsNoticeRow } from "settings_notice_row.slint";
import { Theme } from "../../theme.slint";
import { AccessState } from "../../types.slint";

export struct CalendarRow {
    id: string,
    title: string,
    source-title: string,
    selected: bool,
    show-header: bool,
}

export component CalendarSection inherits VerticalLayout {
    in property <bool> enabled;
    in property <AccessState> permission;
    in property <bool> autostart-enabled;
    in property <int> reminder-minutes;
    in property <int> reminder-minutes-min;
    in property <int> reminder-minutes-max;
    in property <[CalendarRow]> calendars;

    callback enabled-changed(bool);
    callback autostart-enabled-changed(bool);
    callback reminder-minutes-changed(int);
    callback calendar-toggled(string);
    callback open-system-settings-requested();

    spacing: 22px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("CALENDRIER");

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            focus-requested => { calendar-switch.take-focus(); }
            private property <bool> control-focused: calendar-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            show-divider: false;
            label: @tr("Intégration du calendrier");
            description: @tr("Afficher les réunions du jour sur l'accueil et rappeler avant qu'elles commencent.");

            calendar-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Intégration du calendrier");
                checked: root.enabled;
                toggled(new) => { root.enabled-changed(new); }
            }
        }

        if root.permission == AccessState.denied: SettingsNoticeRow {
            KitAlert { bordered: false;
                severity: AlertSeverity.warning;
                message: @tr("L'accès au calendrier a été refusé.");
                vertical-stretch: 0;

                KitButton {
                    text: @tr("Ouvrir les Réglages Système");
                    intent: ButtonIntent.secondary;
                    control-size: ControlSize.compact;
                    activated => { root.open-system-settings-requested(); }
                }
            }
        }

        if root.enabled && root.permission == AccessState.granted: KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            focus-requested => { reminder-switch.take-focus(); }
            private property <bool> control-focused: reminder-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Proposer au début de la réunion");
            description: @tr("Quand un événement commence et que l'audio système est actif, proposer de démarrer l'enregistrement.");

            reminder-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Proposer au début de la réunion");
                checked: root.autostart-enabled;
                toggled(new) => { root.autostart-enabled-changed(new); }
            }
        }

        if root.enabled && root.permission == AccessState.granted: KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            focus-requested => { delay-stepper.take-focus(); }
            private property <bool> control-focused: delay-stepper.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Délai du rappel");
            description: @tr("Minutes avant un événement pour proposer de démarrer une transcription.");

            delay-stepper := KitNumberStepper {
                theme: KitThemeContext.current;
                modal-layer: 0;
                width: 140px;
                increment-label: @tr("Augmenter");
                decrement-label: @tr("Diminuer");
                accessible-name: @tr("Délai du rappel en minutes");
                text: root.reminder-minutes;
                min: root.reminder-minutes-min;
                max: root.reminder-minutes-max;
                step: 1;
                committed(result) => { root.reminder-minutes-changed(result.value.text.to-float()); }
            }
        }

        if root.enabled && root.permission == AccessState.granted && root.calendars.length > 0: VerticalLayout {
            padding-top: 15px;
            padding-bottom: 10px;
            padding-left: Theme.settings-inset;
            padding-right: Theme.settings-inset;
            spacing: 4px;
            alignment: start;

            KitText {
                text: @tr("Calendriers");
                role: TypographyRole.control;
            }
            KitText {
                text: @tr("Tous les calendriers sont inclus ; décochez ceux à masquer.");
                role: TypographyRole.caption;
                wrap: word-wrap;
            }

            for row in root.calendars: VerticalLayout {
                alignment: start;

                if row.show-header && row.source-title != "": VerticalLayout {
                    padding-top: 10px;
                    KitText {
                        text: row.source-title;
                        role: TypographyRole.caption;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    KitCheckbox {
                        ownership: Ownership.controlled;
                        label: row.title;
                        state: row.selected ? CheckState.checked : CheckState.unchecked;
                        horizontal-stretch: 1;
                        toggled(_) => { root.calendar-toggled(row.id); }
                    }
                    if row.source-title != "": KitText {
                        text: row.source-title;
                        role: TypographyRole.caption;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
