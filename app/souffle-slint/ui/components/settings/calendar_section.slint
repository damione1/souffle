import { AppText, AppTextInput, Typography, TypographyStyle } from "@typography";
import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";
import { ThemedButton, ThemedButtonKind } from "../themed_button.slint";
import { ThemedSpinBox } from "../themed_spin.slint";
import { ThemedCheckbox } from "../themed_checkbox.slint";
import { AccessState } from "../../types.slint";

export struct CalendarRow {
    id: string,
    title: string,
    source-title: string,
    selected: bool,
    show-header: bool,
}

// Port of CalendarSettingsSection.svelte.
export component CalendarSection inherits VerticalLayout {
    in property <bool> enabled;
    in property <AccessState> permission;
    in property <bool> autostart-enabled;
    in property <int> reminder-minutes;
    in property <int> reminder-minutes-min;
    in property <int> reminder-minutes-max;
    in property <[CalendarRow]> calendars;

    callback enabled-changed(bool);
    callback autostart-enabled-changed(bool);
    callback reminder-minutes-changed(int);
    callback calendar-toggled(string);
    callback open-system-settings-requested();

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: @tr("CALENDRIER");

        SettingsField {
            show-divider: false;
            label: @tr("Intégration du calendrier");
            description: @tr("Afficher les réunions du jour sur l'accueil et rappeler avant qu'elles commencent.");

            ThemedSwitch {
                control-label: @tr("Intégration du calendrier");
                checked: root.enabled;
                toggled(new) => { root.enabled-changed(new); }
            }
        }

        if root.permission == AccessState.denied: Rectangle {
            background: Theme.danger.with-alpha(0.1);

            HorizontalLayout {
                padding: 12px;
                spacing: 16px;
                alignment: space-between;

                AppText {
                    text: @tr("L'accès au calendrier a été refusé.");
                    color: Theme.text-primary;
                    typography: Typography.field-label;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                ThemedButton {
                    text: @tr("Ouvrir les Réglages Système");
                    kind: ThemedButtonKind.primary;
                    clicked => { root.open-system-settings-requested(); }
                }
            }
        }

        if root.enabled && root.permission == AccessState.granted: SettingsField {
            label: @tr("Proposer au début de la réunion");
            description: @tr("Quand un événement commence et que l'audio système est actif, proposer de démarrer l'enregistrement.");

            ThemedSwitch {
                control-label: @tr("Proposer au début de la réunion");
                checked: root.autostart-enabled;
                toggled(new) => { root.autostart-enabled-changed(new); }
            }
        }

        if root.enabled && root.permission == AccessState.granted: SettingsField {
            label: @tr("Délai du rappel");
            description: @tr("Minutes avant un événement pour proposer de démarrer une transcription.");

            ThemedSpinBox {
                control-label: @tr("Délai du rappel en minutes");
                value: root.reminder-minutes;
                minimum: root.reminder-minutes-min;
                maximum: root.reminder-minutes-max;
                step: 1;
                edited(value) => { root.reminder-minutes-changed(value); }
            }
        }

        if root.enabled && root.permission == AccessState.granted && root.calendars.length > 0: VerticalLayout {
            padding-top: 15px;
            padding-bottom: 15px;
            padding-left: Theme.settings-inset;
            padding-right: Theme.settings-inset;
            spacing: 8px;
            alignment: start;

            AppText {
                text: @tr("Calendriers");
                typography: Typography.field-label;
                color: Theme.text-secondary;
            }
            AppText {
                text: @tr("Tous les calendriers sont inclus ; décochez ceux à masquer.");
                typography: Typography.secondary;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            for row in root.calendars: VerticalLayout {
                alignment: start;
                spacing: 4px;

                if row.show-header && row.source-title != "": VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 4px;
                    AppText {
                        text: row.source-title;
                        typography: Typography.table-heading;

                        color: Theme.text-tertiary;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    ThemedCheckbox {
                        checked: row.selected;
                        toggled(_) => { root.calendar-toggled(row.id); }
                    }
                    AppText {
                        text: row.title;
                        typography: Typography.field-label;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
