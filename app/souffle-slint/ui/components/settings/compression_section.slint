import { AppText, Typography } from "@typography";
import { CompressionUi } from "../../compression.slint";
import { Theme } from "../../theme.slint";
import { CompressionStatus } from "../compression_status.slint";
import { FieldSetAppearance, FieldRowAppearance, ChoiceLabelPosition, ControlWidth, KitFieldRow, KitFieldSet, KitSwitch, KitThemeContext, KitThemes, Ownership, KitFieldSeparator } from "@kit";

export component CompressionSection inherits VerticalLayout {
    spacing: 20px;
    alignment: start;
    vertical-stretch: 0;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("COMPRESSION DES TRANSCRIPTIONS");
        appearance: FieldSetAppearance.card;

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { summary-switch.take-focus(); }
            private property <bool> control-focused: summary-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Compresser les longues transcriptions avant le résumé");
            description: @tr("Réduit l'entrée des étapes intermédiaires et enregistre la version compacte avec la réunion. Les résumés courts utilisent le texte original.");

            summary-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Compresser avant le résumé");
                checked: CompressionUi.summary-enabled;
                toggled(new) => { CompressionUi.summary-changed(new); }
            }
        }
    }
}

export component CompressionStorageSection inherits VerticalLayout {
    spacing: 20px;
    alignment: start;
    vertical-stretch: 0;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("MODÈLE DE COMPRESSION LOCAL");
        appearance: FieldSetAppearance.card;

        KitFieldSeparator { }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 8px;
            CompressionStatus { allow-removal: true; }
            AppText {
                text: @tr("LLMLingua-2 de Microsoft, local et hors ligne après installation.");
                typography: Typography.secondary;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
