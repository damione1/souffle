import { KitTabs, KitScrollArea, LayoutSpace, TabActivation, Ownership, OptionRow, SelectionRef, TabsAppearance, KitTheme, KitThemeContext } from "@kit";
import { SettingsTab } from "../../types.slint";
import { Theme } from "../../theme.slint";

import { SettingsOptionList, SettingsOptions } from "settings_options.slint";

export component SettingsTabBar inherits KitTabs {
    in-out property <SettingsTab> current;
    callback changed(SettingsTab);
    appearance: TabsAppearance.underline;
    // Kit tab rows take their height from the theme only, so the strip gets a
    // copy with taller rows.
    private property <KitTheme> base-theme: KitThemeContext.current;
    private property <KitTheme> tab-theme;
    function refresh-theme() {
        root.tab-theme = root.base-theme;
        root.tab-theme.spacing.medium.height = 42px;
    }
    init => { root.refresh-theme(); }
    changed base-theme => { root.refresh-theme(); }
    theme: root.tab-theme;
    accessible-name: @tr("Sections des paramètres");
    activation: TabActivation.automatic;
    ownership: Ownership.controlled;
    private property <SettingsOptionList> choices: SettingsOptions.tab-options(root.current);
    selected: root.choices.selected;
    options: root.choices.rows;
    chosen(row) => {
        root.current = SettingsOptions.tab-value(row, root.current);
        root.changed(root.current);
    }
}

// Mount each page on first visit, then keep its controls and viewport alive.
// A single eager item tree for all six pages overflows a Rust test thread's stack.
export component SettingsTabPage inherits KitScrollArea {
    in property <bool> active;
    private property <bool> visited;
    out property <bool> mounted: root.active || root.visited;
    init => { if root.active { root.visited = true; } }
    changed active => { if root.active { root.visited = true; } }
    visible: root.active;
    clip: true;
    gap: LayoutSpace.none;
    overlay-scrollbars: true;
    enabled: root.active;
    focusable: root.active && self.scrollable;
    VerticalLayout {
        spacing: 20px;
        // Room for the card shadows inside the clipped viewport.
        padding-left: Theme.shadow-bleed;
        padding-right: Theme.shadow-bleed;
        padding-bottom: Theme.shadow-bleed;
        alignment: start;
        @children
    }
}
