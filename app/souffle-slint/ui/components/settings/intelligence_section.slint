import { KitAlert, KitBadge, KitButton, KitFieldRow, KitFieldSet, KitMetrics, KitTextField, KitThemeContext, KitThemes, KitWrap, Tone } from "@kit";
import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { CatalogPicker } from "../catalog_picker.slint";
import { Theme } from "../../theme.slint";
import { AppleIntelligenceUnavailableReason, SummaryProvider } from "../../types.slint";

// Provider, Apple Intelligence status, Ollama connection, model choice and
// recovery actions. Rust projects the facts (availability, per-reason enum,
// `provider-unavailable`, model catalogue); every user-facing message is
// localized here with @tr, and the free-form `refresh-error` from the service
// is shown as received. Summary models keep their open-set ids paired with
// labels through the picker so duplicate labels remain distinct.
export component IntelligenceSection inherits KitFieldSet {
    in property <bool> for-dictation: false;
    in property <SummaryProvider> summary-provider;
    in property <bool> apple-intelligence-available;
    in property <AppleIntelligenceUnavailableReason> apple-intelligence-reason;
    in property <string> ollama-url;
    in property <bool> ollama-available;
    in property <bool> ollama-checking;
    in property <int> summary-model-count;
    in property <bool> model-picker-visible;
    in property <[string]> model-ids;
    in property <[string]> model-labels;
    in property <string> selected-model-id;
    in property <bool> show-ollama-setup;
    in property <bool> ollama-pulling;
    in property <string> ollama-pull-status;
    in property <string> ollama-pull-error;
    in property <string> recommended-model;
    in property <string> refresh-error;
    in property <bool> provider-unavailable;

    callback summary-provider-changed(SummaryProvider);
    callback ollama-url-changed(string);
    callback ollama-model-changed(string);
    callback retry-requested();
    callback download-recommended-requested();
    callback open-apple-intelligence-settings-requested();

    pure function apple-reason-label(value: AppleIntelligenceUnavailableReason) -> string {
        if value == AppleIntelligenceUnavailableReason.device-not-eligible { return @tr("Ce Mac ne prend pas en charge Apple Intelligence."); }
        if value == AppleIntelligenceUnavailableReason.apple-intelligence-not-enabled { return @tr("Activez Apple Intelligence dans les Réglages Système, puis rouvrez Soufflé."); }
        if value == AppleIntelligenceUnavailableReason.model-not-ready { return @tr("macOS télécharge encore le modèle on-device ; réessayez plus tard."); }
        if value == AppleIntelligenceUnavailableReason.macos-too-old { return @tr("Apple Intelligence nécessite macOS 26 ou plus récent."); }
        if value == AppleIntelligenceUnavailableReason.stub { return @tr("Cette version ne comprend pas le support d'Apple Intelligence."); }
        if value == AppleIntelligenceUnavailableReason.unsupported-platform { return @tr("Apple Intelligence nécessite une puce Apple Silicon."); }
        if value == AppleIntelligenceUnavailableReason.unknown { return @tr("Apple Intelligence n'est pas disponible."); }
        return "";
    }

    theme: KitThemeContext.current;
    legend: root.for-dictation ? @tr("FOURNISSEUR IA DE LA DICTÉE") : @tr("RÉSUMÉS (EXPÉRIMENTAUX)");

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        focus-requested => { engine-picker.take-focus(); }
        private property <bool> control-focused: engine-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        show-divider: false;
        label: @tr("Moteur");
        description: root.for-dictation ? @tr("Le moteur qui nettoie la dictée.") : @tr("Le moteur qui rédige les résumés et nettoie la dictée.");

        engine-picker := ClosedSettingsPicker {
            theme: KitThemeContext.current;
            modal-layer: 0;
            label: root.for-dictation ? @tr("Moteur de dictée IA") : @tr("Moteur de résumé");
            choices: SettingsOptions.provider-options(root.summary-provider);
            chosen(row) => { root.summary-provider-changed(SettingsOptions.provider-value(row, root.summary-provider)); }
        }
    }

    if root.provider-unavailable: KitAlert {
        theme: root.theme;
        severity: warning;
        message: root.summary-provider == SummaryProvider.apple-intelligence
            ? @tr("Apple Intelligence n'est pas disponible sur cet appareil.")
            : @tr("Aucun modèle Ollama compatible n'est installé.");
    }

    if root.refresh-error != "": KitAlert {
        theme: root.theme;
        severity: error;
        message: root.refresh-error;
    }

    apple-row := KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Apple Intelligence");
        description: root.apple-intelligence-available ? "" : root.apple-reason-label(root.apple-intelligence-reason);

        KitWrap {
            theme: root.theme;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            KitBadge {
                theme: root.theme;
                text: root.apple-intelligence-available ? @tr("Disponible") : @tr("Non disponible");
                tone: root.apple-intelligence-available ? Tone.success : Tone.warning;
                dot: root.apple-intelligence-available;
            }
            if !root.apple-intelligence-available && root.apple-intelligence-reason == AppleIntelligenceUnavailableReason.apple-intelligence-not-enabled: KitButton {
                theme: root.theme;
                modal-layer: 0;
                control-size: compact;
                text: @tr("Réglages Système");
                text-wrap: word-wrap;
                focus-observed(focused) => {
                    if focused { apple-row.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
                }
                activated => { root.open-apple-intelligence-settings-requested(); }
            }
        }
    }

    url-row := KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        padding-bottom: KitThemes.focus-outset(self.theme.focus) + KitMetrics.help-gap(self.theme);
        show-divider: true;
        focus-requested => { url-editor.take-focus(); }
        private property <bool> control-focused: url-editor.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("URL Ollama");
        description: @tr("Adresse du serveur Ollama local ou distant.");

        url-editor := KitTextField {
            theme: KitThemeContext.current;
            modal-layer: 0;
            width: Theme.settings-control-width;
            accessible-name: @tr("URL Ollama");
            description: url-row.description;
            show-description: false;
            placeholder: @tr("http://localhost:11434");
            text: root.ollama-url;
            edited(value) => { root.ollama-url-changed(value); }
        }
    }

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { connection-button.take-focus(); }
        private property <bool> control-focused: connection-button.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("État de la connexion");
        description: root.summary-model-count == 0 ? @tr("Aucun modèle trouvé.")
            : root.summary-model-count == 1 ? @tr("1 modèle trouvé.")
            : @tr("{} modèles trouvés.", root.summary-model-count);

        KitWrap {
            theme: root.theme;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            KitBadge {
                theme: root.theme;
                text: root.ollama-available ? @tr("Connecté") : @tr("Non disponible");
                tone: root.ollama-available ? Tone.success : Tone.warning;
                dot: root.ollama-available;
            }
            connection-button := KitButton {
                theme: KitThemeContext.current;
                modal-layer: 0;
                control-size: compact;
                text: @tr("Réessayer");
                disabled: root.ollama-checking || root.ollama-pulling;
                activated => { root.retry-requested(); }
            }
        }
    }

    if root.model-picker-visible: KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { model-picker.take-focus(); }
        private property <bool> control-focused: model-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: root.for-dictation ? @tr("Modèle de dictée IA") : @tr("Modèle de résumé");

        model-picker := CatalogPicker {
            theme: KitThemeContext.current;
            modal-layer: 0;
            control-label: root.for-dictation ? @tr("Modèle de dictée IA") : @tr("Modèle de résumé");
            model: root.model-labels;
            option-values: root.model-ids;
            current-value: root.selected-model-id;
            value-chosen(id) => { root.ollama-model-changed(id); }
        }
    }

    if root.show-ollama-setup && root.ollama-pull-error != "": KitAlert {
        theme: root.theme;
        severity: error;
        message: @tr("Échec du téléchargement : {}", root.ollama-pull-error);
    }

    if root.show-ollama-setup: setup-row := KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Aucun modèle compatible installé.");
        description: root.ollama-pulling
            ? (root.ollama-pull-status == "" ? @tr("Téléchargement de {}…", root.recommended-model) : root.ollama-pull-status)
            : "";

        if !root.ollama-pulling: KitButton {
            theme: root.theme;
            modal-layer: 0;
            intent: primary;
            control-size: compact;
            text: @tr("Télécharger {}", root.recommended-model);
            text-wrap: word-wrap;
            focus-observed(focused) => {
                if focused { setup-row.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
            }
            activated => { root.download-recommended-requested(); }
        }
    }
}
