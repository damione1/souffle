import {
    AlertSeverity, ButtonIntent, ChoiceLabelPosition, ControlSize, ControlWidth,
    KitAlert, KitBadge, KitButton, KitFieldRow, KitFieldSet, KitIconButton,
    KitMetrics, KitModalContext, KitSection, KitSurface, KitSwitch,
    KitThemeContext, KitThemes, KitWrap, ListView, Ownership
} from "@kit";
import { LucideArrows } from "@kit-icons/arrows.slint";
import { LucideFiles } from "@kit-icons/files.slint";
import { CatalogPicker } from "../catalog_picker.slint";
import { PickerLabels } from "../picker_labels.slint";
import { Theme } from "../../theme.slint";

// microphone_list.rs merges the connected and remembered devices in priority order.
export struct MicrophoneRow {
    uid: string,
    name: string,
    transport-label: string,
    is-default: bool,
    connected: bool,
    hidden: bool,
    last-seen-age-seconds: int,
    is-first: bool,
    is-last: bool,
}

// A refresh can rebind a delegate between pointer/key down and activation.
component MicrophoneActionButton inherits KitIconButton {
    in property <string> device-uid;
    private property <string> pressed-uid;
    callback requested(string);

    control-size: compact;
    activation-started => { root.pressed-uid = root.device-uid; }
    activation-allowed => { return root.device-uid == root.pressed-uid; }
    changed device-uid => { root.cancel-press(); }
    activated => { root.requested(root.pressed-uid); }
}

component MicrophonePriorityRow inherits KitFieldRow {
    in property <MicrophoneRow> device;
    in property <string> last-seen;
    callback move-requested(string, int);
    callback hidden-requested(string, bool);
    callback remove-requested(string);

    orientation: Theme.settings-field-orientation(self.width);
    padding: KitMetrics.field-gap(self.theme);
    show-divider: !root.device.is-first;
    opacity: root.device.connected ? 1.0 : 0.7;
    label: root.device.name;
    description: PickerLabels.display(root.device.transport-label)
        + (root.device.is-default ? @tr("MicrophoneSection" => " · par défaut") : "")
        + (root.last-seen == "" ? "" : "\n" + root.last-seen);
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.description;
    focus-requested => { hide-switch.take-focus(); }

    KitWrap {
        theme: root.theme;
        gap: tight;
        cross-axis-alignment: center;

        MicrophoneActionButton {
            theme: root.theme;
            modal-layer: root.modal-layer;
            device-uid: root.device.uid;
            glyph: LucideArrows.chevron-up();
            accessible-name: @tr("MicrophoneSection" => "Monter {}", root.device.name);
            disabled: root.device.is-first;
            requested(uid) => { root.move-requested(uid, -1); }
            focus-observed(focused) => { if focused { root.ensure-visible(KitThemes.scroll-behavior(root.theme)); } }
        }
        MicrophoneActionButton {
            theme: root.theme;
            modal-layer: root.modal-layer;
            device-uid: root.device.uid;
            glyph: LucideArrows.chevron-down();
            accessible-name: @tr("MicrophoneSection" => "Descendre {}", root.device.name);
            disabled: root.device.is-last;
            requested(uid) => { root.move-requested(uid, 1); }
            focus-observed(focused) => { if focused { root.ensure-visible(KitThemes.scroll-behavior(root.theme)); } }
        }
        hide-switch := KitSwitch {
            theme: root.theme;
            modal-layer: root.modal-layer;
            control-size: compact;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            preferred-width: 120px * root.theme.text-scale;
            label: @tr("MicrophoneSection" => "Masquer");
            accessible-name: @tr("MicrophoneSection" => "Masquer {}", root.device.name);
            checked: root.device.hidden;
            private property <string> pressed-uid;
            private property <bool> pressed-hidden;
            activation-started => {
                self.pressed-uid = root.device.uid;
                self.pressed-hidden = self.checked;
            }
            activation-allowed => {
                return self.pressed-uid == root.device.uid && self.pressed-hidden == self.checked;
            }
            toggled(new) => { root.hidden-requested(self.pressed-uid, new); }
            focus-observed(focused) => { if focused { root.ensure-visible(KitThemes.scroll-behavior(root.theme)); } }
        }
        if !root.device.connected: MicrophoneActionButton {
            theme: root.theme;
            modal-layer: root.modal-layer;
            device-uid: root.device.uid;
            glyph: LucideFiles.trash();
            accessible-name: @tr("MicrophoneSection" => "Supprimer {}", root.device.name);
            intent: ButtonIntent.destructive;
            requested(uid) => { root.remove-requested(uid); }
            focus-observed(focused) => { if focused { root.ensure-visible(KitThemes.scroll-behavior(root.theme)); } }
        }
    }
}

export component MicrophoneSection inherits KitFieldSet {
    pure function format-last-seen(age: int) -> string {
        if age < 0 { return ""; }
        if age < 60 { return @tr("à l'instant"); }
        if age < 3600 { return @tr("il y a {} min", age / 60); }
        if age < 86400 { return @tr("il y a {} h", age / 3600); }
        return @tr("il y a {} j", age / 86400);
    }

    in property <[string]> device-labels;
    in property <[string]> device-ids;
    in property <int> default-device-index: -1;
    in property <string> selected-device-id;
    in property <bool> pin-unavailable;
    in property <string> sample-rate-label; // "" hides the row
    in property <bool> sample-rate-high;
    in property <bool> resetting-sample-rate;
    in property <bool> capture-busy;
    in property <bool> allow-bluetooth-mic;
    in property <[MicrophoneRow]> microphones;
    in property <bool> has-disconnected;

    callback device-changed(string);
    callback refresh-requested();
    callback reset-devices-requested();
    callback reset-sample-rate-requested();
    callback allow-bluetooth-mic-changed(bool);
    callback move-device-requested(string, int);
    callback toggle-hidden-requested(string, bool);
    callback remove-device-requested(string);

    theme: KitThemeContext.current;
    legend: @tr("MICROPHONE");

    device-field := KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        label: @tr("Périphérique d'entrée");
        description: @tr("Choisissez le microphone que Soufflé écoute et configurez le traitement audio.");
        focus-requested => { device-picker.take-focus(); }
        private property <bool> picker-focused: device-picker.has-focus;
        changed picker-focused => {
            if self.picker-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }

        KitWrap {
            theme: root.theme;
            cross-axis-alignment: center;
            device-picker := CatalogPicker {
                theme: root.theme;
                modal-layer: device-field.modal-layer;
                control-label: @tr("Microphone actif");
                model: root.device-labels;
                option-values: root.device-ids;
                default-device-index: root.default-device-index;
                current-value: root.selected-device-id;
                value-chosen(value) => { root.device-changed(value); }
            }
            KitIconButton {
                theme: root.theme;
                modal-layer: device-field.modal-layer;
                control-size: compact;
                glyph: LucideArrows.refresh-cw();
                accessible-name: @tr("Actualiser les microphones");
                activated => { root.refresh-requested(); }
                focus-observed(focused) => {
                    if focused { device-field.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }
            }
            if root.has-disconnected: KitButton {
                theme: root.theme;
                modal-layer: device-field.modal-layer;
                control-size: compact;
                text: @tr("Réinitialiser la liste");
                text-wrap: word-wrap;
                activated => { root.reset-devices-requested(); }
                focus-observed(focused) => {
                    if focused { device-field.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }
            }
        }
    }

    if root.pin-unavailable: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.warning;
        message: @tr("Le périphérique choisi n'est plus disponible ; un autre est utilisé en attendant.");
    }

    if root.sample-rate-label != "": KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Fréquence d'échantillonnage");
        description: @tr("Fréquence native du périphérique sélectionné.");

        KitBadge {
            theme: root.theme;
            text: root.sample-rate-label;
        }
    }

    if root.sample-rate-high: rate-alert := KitAlert {
        theme: root.theme;
        severity: AlertSeverity.warning;
        message: root.capture-busy
            ? @tr("Cette fréquence élevée peut perturber les appels en visioconférence pendant l'enregistrement.") + " " + @tr("Terminez l'enregistrement avant de réinitialiser la fréquence du microphone.")
            : @tr("Cette fréquence élevée peut perturber les appels en visioconférence pendant l'enregistrement.");

        KitButton {
            theme: root.theme;
            modal-layer: 0;
            control-size: compact;
            text-wrap: word-wrap;
            text: root.resetting-sample-rate ? @tr("Réinitialisation…") : @tr("Réinitialiser à 48 kHz");
            disabled: root.resetting-sample-rate || root.capture-busy;
            activated => { root.reset-sample-rate-requested(); }
            focus-observed(focused) => {
                if focused { rate-alert.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    priority := KitSection {
        theme: root.theme;
        gap: compact;
        padding: KitMetrics.field-gap(self.theme);
        title: @tr("Ordre de préférence");
        description: @tr("Utilisé quand plusieurs micros sont branchés en même temps.");

        if root.microphones.length > 0: KitSurface {
            theme: root.theme;
            inset: tight;
            priority-list := ListView {
                theme: root.theme;
                enabled: !KitModalContext.inert(0);
                accessible-label: priority.title;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                // Only the viewport is bounded. Each delegate measures its actual
                // copy and controls at the width left by the scrollbar.
                height: min(root.microphones.length, 3) * 3 * KitMetrics.row-height(self.theme, ControlSize.compact);
                for row[index] in root.microphones: MicrophonePriorityRow {
                    theme: root.theme;
                    modal-layer: 0;
                    width: priority-list.visible-width;
                    height: self.preferred-height;
                    device: row;
                    last-seen: !row.connected && row.last-seen-age-seconds >= 0
                        ? root.format-last-seen(row.last-seen-age-seconds) : "";
                    accessible-item-index: index;
                    accessible-item-count: root.microphones.length;
                    move-requested(uid, direction) => { root.move-device-requested(uid, direction); }
                    hidden-requested(uid, hidden) => { root.toggle-hidden-requested(uid, hidden); }
                    remove-requested(uid) => { root.remove-device-requested(uid); }
                }
            }
        }
    }

    bluetooth-field := KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { bluetooth-switch.take-focus(); }
        label: @tr("Autoriser les micros Bluetooth");
        description: @tr("Sinon, un casque Bluetooth n'est jamais sélectionné automatiquement (évite le mode mono basse qualité).");

        bluetooth-switch := KitSwitch {
            theme: root.theme;
            modal-layer: bluetooth-field.modal-layer;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-name: bluetooth-field.label;
            checked: root.allow-bluetooth-mic;
            toggled(new) => { root.allow-bluetooth-mic-changed(new); }
            focus-observed(focused) => {
                if focused { bluetooth-field.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }
}
