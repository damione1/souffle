import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { FieldSetAppearance, FieldRowAppearance, AlertActions, AlertSeverity, ButtonIntent, ChoiceLabelPosition, ControlSize, ControlWidth, FieldAccess, KeycapSize, KitAlert, KitButton, KitFieldRow, KitFieldSet, KitKeycap, KitMetrics, KitModalContext, KitNumberStepper, KitSegmentedControl, KitSwitch, KitText, KitThemeContext, KitThemes, Ownership, TypographyRole, SegmentedAppearance, StepperAppearance, TextViewFont, KitTheme } from "@kit";
import { LucideArrows } from "@kit-icons/arrows.slint";
import { SettingsNoticeRow } from "settings_notice_row.slint";
import { Theme } from "../../theme.slint";
import { AppTheme, AppLocale, PasteMethod, ShortcutField, ShortcutNotice, SettingsCaptureError } from "../../types.slint";

// The recorder's message for each `ShortcutNotice`, declared once for Settings
// and onboarding (#360).
export global ShortcutNoticeText {
    public pure function text(notice: ShortcutNotice) -> string {
        if notice == ShortcutNotice.missing-modifier { return @tr("Le raccourci doit inclure une touche de modification (Cmd, Ctrl, Maj, Alt) ou être une touche de fonction."); }
        if notice == ShortcutNotice.unusable-key { return @tr("Cette touche ne peut pas servir de raccourci."); }
        if notice == ShortcutNotice.types-character { return @tr("Ce raccourci n'utilise que ⌥ (ou ⌥⇧) : le caractère que cette combinaison tape, par exemple | avec ⌥⇧L en AZERTY, ne pourra plus être saisi dans aucune app."); }
        // ShortcutNotice.none: nothing to say.
        return "";
    }

    // A warning is saved anyway; the others refused the key.
    public pure function is-warning(notice: ShortcutNotice) -> bool {
        return notice == ShortcutNotice.types-character;
    }
}

// Captures the next key press as a shortcut accelerator. Slint's `KeyEvent`
// only hands over a produced character, not the physical key, so the
// accelerator is built in Rust (`shortcut_capture.rs`) from the physical key
// the winit hook recorded for this event plus the modifier booleans
// forwarded here; `text` is forwarded but not used for the key (#360). This
// component only owns focus/recording UI state. Exported so
// `onboarding_view.slint`'s shortcut step (SOU-190) reuses it instead of a
// second FocusScope implementation.
// Both show the shortcut as a key cap; `keycap` is the large one.
export enum ShortcutPresentation { button, keycap }

export component ShortcutRecorderButton inherits FocusScope {
    in property <ShortcutPresentation> presentation: ShortcutPresentation.button;
    private property <string> display-label: root.recording ? @tr("Appuyez…") : (root.shortcut-label == "" ? @tr("Non défini") : root.shortcut-label);
    enabled: !KitModalContext.inert(0);
    in property <string> shortcut-label;
    in property <bool> recording;

    accessible-role: button;
    accessible-label: root.shortcut-label == "" ? @tr("Enregistrer un raccourci") : root.shortcut-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.record-requested(); } }

    callback record-requested();
    callback captured(string, bool, bool, bool, bool);
    callback released(string, bool, bool, bool, bool);
    callback cleared();
    callback cancelled();

    private property <bool> large: root.presentation == ShortcutPresentation.keycap;
    // Settings recorders draw a compact cap, padded past the regular key cap.
    width: root.recording && !root.large ? 128px : cap-measure.preferred-width + (root.large ? 0px : 8px);
    height: KitMetrics.control-height(KitThemeContext.current, root.large ? ControlSize.medium : ControlSize.compact);
    horizontal-stretch: 0;
    cap-measure := KitKeycap { visible: false; size: root.large ? KeycapSize.large : KeycapSize.regular; text: root.display-label; }

    public function take-focus() { trigger.take-focus(); }

    trigger := KitButton {
        width: parent.width;
        height: parent.height;
        control-size: root.large ? ControlSize.medium : ControlSize.compact;
        text: root.recording ? root.display-label : "";
        accessible-name: root.display-label;
        disabled: !root.enabled;
        intent: root.recording ? ButtonIntent.primary : ButtonIntent.quiet;
        activated => {
            root.focus();
            root.record-requested();
        }
    }

    // An unset compact recorder takes a muted ink, which only the cap's theme
    // can carry.
    private property <KitTheme> base-theme: KitThemeContext.current;
    private property <KitTheme> muted-theme;
    function refresh-muted-theme() {
        root.muted-theme = root.base-theme;
        root.muted-theme.keycap-ink = Theme.text-muted;
    }
    init => { root.refresh-muted-theme(); }
    changed base-theme => { root.refresh-muted-theme(); }

    if !root.recording: KitKeycap {
        theme: !root.large && root.shortcut-label == "" ? root.muted-theme : root.base-theme;
        width: parent.width;
        height: parent.height;
        size: root.large ? KeycapSize.large : KeycapSize.regular;
        text: root.display-label;
        opacity: !root.enabled ? 0.45 : root.large && root.shortcut-label == "" ? 0.75 : 1;
    }

    key-pressed(event) => {
        if (!root.recording || !root.enabled) {
            return reject;
        }
        if (event.text == Key.Escape) {
            root.cancelled();
            return accept;
        }
        if (event.text == Key.Backspace || event.text == Key.Delete) {
            root.cleared();
            return accept;
        }
        root.captured(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
        return accept;
    }

    key-released(event) => {
        if (!root.recording || !root.enabled) {
            return reject;
        }
        root.released(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
        return accept;
    }
}

export component InterfaceSection inherits VerticalLayout {
    in property <bool> capture-busy;
    in property <AppTheme> theme;
    in property <AppLocale> locale;
    in property <bool> auto-paste;
    in property <PasteMethod> paste-method;
    in property <int> paste-delay-ms;
    in property <int> paste-delay-min;
    in property <int> paste-delay-max;
    in property <string> toggle-shortcut-label;
    in property <string> ptt-shortcut-label;
    in property <ShortcutField> recording-field;
    in property <string> shortcut-error;
    in property <SettingsCaptureError> shortcut-error-kind: SettingsCaptureError.operation-failed;
    in property <ShortcutNotice> shortcut-notice;
    in property <bool> native-tap-warning-visible;
    in property <bool> pill-hidden;
    in property <bool> pill-hidden-in-captures;

    callback theme-changed(AppTheme);
    callback locale-changed(AppLocale);
    callback auto-paste-changed(bool);
    callback paste-method-changed(PasteMethod);
    callback paste-delay-changed(int);
    callback pill-hidden-changed(bool);
    callback pill-hidden-in-captures-changed(bool);
    callback shortcut-record-requested(ShortcutField);
    callback shortcut-captured(ShortcutField, string, bool, bool, bool, bool);
    callback shortcut-released(ShortcutField, string, bool, bool, bool, bool);
    callback shortcut-cleared(ShortcutField);
    callback shortcut-cancelled();
    callback permissions-review-requested();

    spacing: 20px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("INTERFACE");
        appearance: FieldSetAppearance.card;

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { language-picker.take-focus(); }
            private property <bool> control-focused: language-picker.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Langue");
            description: @tr("Choisissez la langue de l'interface.");

            language-picker := KitSegmentedControl {
                theme: KitThemeContext.current;
                modal-layer: 0;
                horizontal-stretch: 0;
                appearance: SegmentedAppearance.raised;
                control-width: ControlWidth.intrinsic;
                control-size: ControlSize.compact;
                label: @tr("Langue de l'interface");
                options: SettingsOptions.locale-options(root.locale).rows;
                selected: SettingsOptions.locale-options(root.locale).selected;
                ownership: Ownership.controlled;
                chosen(row) => { root.locale-changed(SettingsOptions.locale-value(row, root.locale)); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { theme-picker.take-focus(); }
            private property <bool> control-focused: theme-picker.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Thème");
            description: @tr("Choisissez l'apparence de l'interface.");

            theme-picker := KitSegmentedControl {
                theme: KitThemeContext.current;
                modal-layer: 0;
                horizontal-stretch: 0;
                appearance: SegmentedAppearance.raised;
                control-width: ControlWidth.intrinsic;
                control-size: ControlSize.compact;
                label: @tr("Thème de l'interface");
                options: SettingsOptions.theme-options(root.theme).rows;
                selected: SettingsOptions.theme-options(root.theme).selected;
                ownership: Ownership.controlled;
                chosen(row) => { root.theme-changed(SettingsOptions.theme-value(row, root.theme)); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { paste-switch.take-focus(); }
            private property <bool> control-focused: paste-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Collage automatique après dictée");
            description: @tr("Colle automatiquement la transcription à l'arrêt de l'enregistrement.");

            paste-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Collage automatique après dictée");
                checked: root.auto-paste;
                toggled(new) => { root.auto-paste-changed(new); }
            }
        }

        if root.auto-paste: KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { method-picker.take-focus(); }
            private property <bool> control-focused: method-picker.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Méthode de collage");
            description: @tr("Le champ ciblé utilise l'accessibilité pour insérer dans la sélection. Utilisez la frappe simulée si une app refuse le ⌘V synthétique (terminaux, champs sécurisés).");

            method-picker := ClosedSettingsPicker {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label: @tr("Méthode de collage");
                choices: SettingsOptions.paste-method-options(root.paste-method);
                chosen(row) => { root.paste-method-changed(SettingsOptions.paste-method-value(row, root.paste-method)); }
            }
        }

        if root.auto-paste: KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { delay-stepper.take-focus(); }
            private property <bool> control-focused: delay-stepper.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Délai de collage (ms)");
            description: @tr("Temps d'attente avant le collage. Augmentez si le texte arrive dans la mauvaise application.");

            delay-stepper := KitNumberStepper {
                theme: KitThemeContext.current;
                modal-layer: 0;
                appearance: StepperAppearance.compact;
                value-font: TextViewFont.monospace;
                // The editor's end padding adds to this gap.
                value-button-gap: 5px;
                // Keeps the editor slack before the value, next to the unit and buttons.
                text-alignment: TextHorizontalAlignment.right;
                control-size: ControlSize.compact;
                decrement-glyph: LucideArrows.chevron-down();
                increment-glyph: LucideArrows.chevron-up();
                increment-label: @tr("Augmenter");
                decrement-label: @tr("Diminuer");
                accessible-name: @tr("Délai de collage en millisecondes");
                text: root.paste-delay-ms;
                min: root.paste-delay-min;
                max: root.paste-delay-max;
                step: 50;
                committed(result) => { root.paste-delay-changed(result.value.text.to-float()); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { toggle-recorder.take-focus(); }
            private property <bool> control-focused: toggle-recorder.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Basculer l'enregistrement");
            description: @tr("Appuyez une fois pour démarrer ou arrêter la dictée.");

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                horizontal-stretch: 0;

                toggle-recorder := ShortcutRecorderButton {
                    shortcut-label: root.toggle-shortcut-label;
                    enabled: !root.capture-busy;
                    recording: root.recording-field == ShortcutField.toggle;
                    record-requested => { root.shortcut-record-requested(ShortcutField.toggle); }
                    captured(text, ctrl, shift, alt, meta) => { root.shortcut-captured(ShortcutField.toggle, text, ctrl, shift, alt, meta); }
                    released(text, ctrl, shift, alt, meta) => { root.shortcut-released(ShortcutField.toggle, text, ctrl, shift, alt, meta); }
                    cleared => { root.shortcut-cleared(ShortcutField.toggle); }
                    cancelled => { root.shortcut-cancelled(); }
                }
                if root.toggle-shortcut-label != "": KitButton {
                    text: @tr("Effacer");
                    intent: ButtonIntent.quiet;
                    control-size: ControlSize.compact;
                    disabled: root.capture-busy;
                    activated => { root.shortcut-cleared(ShortcutField.toggle); }
                }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { ptt-recorder.take-focus(); }
            private property <bool> control-focused: ptt-recorder.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Appuyer pour parler");
            description: @tr("Maintenez pour enregistrer, relâchez pour arrêter.");

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                horizontal-stretch: 0;

                ptt-recorder := ShortcutRecorderButton {
                    shortcut-label: root.ptt-shortcut-label;
                    enabled: !root.capture-busy;
                    recording: root.recording-field == ShortcutField.ptt;
                    record-requested => { root.shortcut-record-requested(ShortcutField.ptt); }
                    captured(text, ctrl, shift, alt, meta) => { root.shortcut-captured(ShortcutField.ptt, text, ctrl, shift, alt, meta); }
                    released(text, ctrl, shift, alt, meta) => { root.shortcut-released(ShortcutField.ptt, text, ctrl, shift, alt, meta); }
                    cleared => { root.shortcut-cleared(ShortcutField.ptt); }
                    cancelled => { root.shortcut-cancelled(); }
                }
                if root.ptt-shortcut-label != "": KitButton {
                    text: @tr("Effacer");
                    intent: ButtonIntent.quiet;
                    control-size: ControlSize.compact;
                    disabled: root.capture-busy;
                    activated => { root.shortcut-cleared(ShortcutField.ptt); }
                }
            }
        }

        if root.capture-busy: SettingsNoticeRow {
            show-divider: false;
            KitText {
                theme: KitThemeContext.current;
                text: @tr("Terminez l'enregistrement avant de modifier les raccourcis.");
                role: TypographyRole.caption;
            }
        }

        if root.native-tap-warning-visible: SettingsNoticeRow {
            KitAlert { bordered: false; corner-radius: 12px; inset: 12px; actions-placement: AlertActions.trailing;
                theme: KitThemeContext.current;
                severity: AlertSeverity.warning;
                message: @tr("Votre raccourci sur une seule touche ne fonctionnera pas tant que l'Accessibilité n'est pas accordée.");
                KitButton {
                    theme: KitThemeContext.current;
                    control-size: ControlSize.compact;
                    text: @tr("Vérifier les permissions");
                    intent: ButtonIntent.secondary;
                    activated => { root.permissions-review-requested(); }
                }
            }
        }

        if root.shortcut-error != "": SettingsNoticeRow {
            KitAlert { bordered: false; corner-radius: 12px; inset: 12px; actions-placement: AlertActions.trailing;
                theme: KitThemeContext.current;
                severity: AlertSeverity.error;
                message: root.shortcut-error-kind == SettingsCaptureError.capture-busy ? @tr("Terminez l'enregistrement avant de modifier les raccourcis.")
                    : root.shortcut-error-kind == SettingsCaptureError.runtime-busy ? @tr("Une opération est en cours. Réessayez dans un instant.")
                    : root.shortcut-error;
            }
        }

        if root.shortcut-notice != ShortcutNotice.none: SettingsNoticeRow {
            KitAlert { bordered: false; corner-radius: 12px; inset: 12px; actions-placement: AlertActions.trailing;
                theme: KitThemeContext.current;
                severity: ShortcutNoticeText.is-warning(root.shortcut-notice) ? AlertSeverity.warning : AlertSeverity.error;
                message: ShortcutNoticeText.text(root.shortcut-notice);
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { overlay-switch.take-focus(); }
            private property <bool> control-focused: overlay-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Masquer l'overlay d'enregistrement");
            description: @tr("Ne pas afficher le HUD flottant pendant une dictée ou une réunion. Déplacez-le par glisser-déposer ; la position est mémorisée et reste à l'écran si la résolution change.");

            overlay-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Masquer l'overlay d'enregistrement");
                checked: root.pill-hidden;
                toggled(new) => { root.pill-hidden-changed(new); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            focus-requested => { screenshot-switch.take-focus(); }
            private property <bool> control-focused: screenshot-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Masquer l'overlay dans les captures d'écran");
            description: @tr("Quand l'overlay est affiché, l'exclure des captures d'écran, des enregistrements et des partages d'écran.");

            screenshot-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Masquer l'overlay dans les captures d'écran");
                access: !root.pill-hidden ? FieldAccess.editable : FieldAccess.disabled;
                checked: root.pill-hidden-in-captures;
                toggled(new) => { root.pill-hidden-in-captures-changed(new); }
            }
        }
    }
}
