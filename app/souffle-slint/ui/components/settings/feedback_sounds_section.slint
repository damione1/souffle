import {
    ChoiceLabelPosition, ControlWidth, KitFieldRow, KitFieldSet, KitInline,
    KitMetrics, KitSlider, KitSwitch, KitText, KitThemeContext, KitThemes, Ownership
} from "@kit";
import { Theme } from "../../theme.slint";

export component FeedbackSoundsSection inherits KitFieldSet {
    in property <bool> enabled;
    in property <int> volume;
    in property <int> volume-min;
    in property <int> volume-max;
    in property <int> volume-step;

    callback enabled-changed(bool);
    callback volume-changed(int);

    theme: KitThemeContext.current;
    legend: @tr("SONS DE DICTÉE");

    sounds-row := KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        label: @tr("Activer les sons");
        description: @tr("Jouer un son au démarrage et à l'arrêt de l'enregistrement.");
        focus-requested => { sounds-switch.take-focus(); }

        sounds-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-name: sounds-row.label;
            accessible-description: sounds-row.description;
            checked: root.enabled;
            toggled(new) => { root.enabled-changed(new); }
            focus-observed(focused) => {
                if focused { sounds-row.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
            }
        }
    }

    if root.enabled: volume-row := KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Volume");
        focus-requested => {
            volume-slider.take-focus();
            self.ensure-visible(KitThemes.scroll-behavior(root.theme));
        }

        KitInline {
            theme: root.theme;
            horizontal-stretch: 0;

            volume-slider := KitSlider {
                theme: root.theme;
                modal-layer: 0;
                ownership: Ownership.controlled;
                spec: { minimum: root.volume-min, maximum: root.volume-max, step: root.volume-step };
                label: @tr("Volume des sons de dictée");
                value: root.volume;
                value-label: @tr("{}%", root.volume);
                chosen(value) => { root.volume-changed(round(value.to-float())); }
            }

            KitText {
                theme: root.theme;
                role: caption;
                text: volume-slider.value-label;
                vertical-alignment: center;
            }
        }
    }
}
