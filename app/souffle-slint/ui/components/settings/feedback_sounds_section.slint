import { FieldSetAppearance, FieldRowAppearance, ChoiceLabelPosition, ControlWidth, KitSlider, KitSwitch, Ownership, SliderPresentation, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow } from "@kit";
import { AppText, Typography } from "@typography";
import { Theme } from "../../theme.slint";

export component FeedbackSoundsSection inherits KitFieldSet {
    in property <bool> enabled;
    in property <int> volume;
    in property <int> volume-min;
    in property <int> volume-max;

    callback enabled-changed(bool);
    callback volume-changed(int);

    theme: KitThemeContext.current;
    legend: @tr("SONS DE DICTÉE");
    appearance: FieldSetAppearance.card;

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { sounds-switch.take-focus(); }
        private property <bool> control-focused: sounds-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Activer les sons");
        description: @tr("Jouer un son au démarrage et à l'arrêt de l'enregistrement.");

        sounds-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Activer les sons");
            checked: root.enabled;
            toggled(new) => { root.enabled-changed(new); }
        }
    }

    if root.enabled: KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { volume-slider.take-focus(); }
        label: @tr("Volume");

        HorizontalLayout {
            alignment: center;
            horizontal-stretch: 0;

            volume-slider := KitSlider {
                theme: root.theme;
                modal-layer: 0;
                // The track is inset by the thumb on both sides: 174px visible.
                width: 196px;
                height: 20px;
                presentation: SliderPresentation.line;
                track-thickness: 6px;
                // A plain value bar; the kit still outlines the thumb on keyboard focus.
                handle-brush: transparent;
                track-brush: Theme.surface-3;
                ownership: Ownership.controlled;
                spec: { minimum: root.volume-min, maximum: root.volume-max, step: 1 };
                label: @tr("Volume des sons de dictée");
                value: root.volume;
                chosen(value) => { root.volume-changed(value.to-float()); }
            }

            AppText {
                text: @tr("{} %", root.volume);
                typography: Typography.mono;
                color: Theme.text-muted;
                wrap: no-wrap;
                vertical-alignment: center;
                width: 38px;
                horizontal-alignment: right;
            }
        }
    }
}
