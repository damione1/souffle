import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { FieldSetAppearance, FieldRowAppearance,
    ChoiceLabelPosition, ControlWidth, FieldAccess, KitFieldRow, KitFieldSet, KitSwitch, KitThemeContext, KitThemes, Ownership
} from "@kit";
import { PickerLabels } from "../picker_labels.slint";
import { CatalogPicker } from "../catalog_picker.slint";
import { SettingsAdvancedBlock } from "settings_advanced_block.slint";
import { Theme } from "../../theme.slint";
import { MeetingLanguage, AudioRetention } from "../../types.slint";

// Rust supplies the duration catalogues and clamshell device identities.
export component AudioSection inherits KitFieldSet {
    in property <bool> is-laptop;
    in property <[string]> clamshell-device-labels;
    in property <[string]> clamshell-device-ids;
    in property <int> default-device-index: -1;
    in property <string> clamshell-device-id;
    in property <string> clamshell-device-label;
    in property <bool> system-audio-supported;
    in property <bool> capture-system-audio;
    in property <bool> meeting-audio-diagnostic;
    in property <AudioRetention> meeting-audio-retention;
    in property <int> diagnostic-max-minutes;
    in property <int> diagnostic-megabytes-per-hour;
    in property <MeetingLanguage> meeting-transcription-language;
    in property <bool> meeting-autostop-enabled;
    in property <[string]> meeting-autostop-labels;
    in property <string> meeting-autostop-label;
    in property <[string]> meeting-max-duration-labels;
    in property <string> meeting-max-duration-label;
    in property <bool> vad-enabled;
    in property <bool> filler-removal;
    in property <bool> stutter-collapse;
    in property <bool> dictionary-correction;

    callback clamshell-device-changed(string);
    callback capture-system-audio-changed(bool);
    callback meeting-audio-diagnostic-changed(bool);
    callback meeting-transcription-language-changed(MeetingLanguage);
    callback meeting-autostop-enabled-changed(bool);
    callback meeting-autostop-changed(string);
    callback meeting-max-duration-changed(string);
    callback vad-enabled-changed(bool);
    callback filler-removal-changed(bool);
    callback stutter-collapse-changed(bool);
    callback dictionary-correction-changed(bool);

    theme: KitThemeContext.current;
    legend: @tr("AUDIO");
    appearance: FieldSetAppearance.card;

    if root.system-audio-supported: KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { system-audio-switch.take-focus(); }
        private property <bool> control-focused: system-audio-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Capturer l'audio système");
        description: @tr("Inclure le son des haut-parleurs (l'autre côté d'un appel) dans les réunions.");

        system-audio-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Capturer l'audio système");
            checked: root.capture-system-audio;
            toggled(new) => { root.capture-system-audio-changed(new); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { language-picker.take-focus(); }
        private property <bool> control-focused: language-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Langue de transcription (réunions)");
        description: @tr("Indice pour la détection de langue, jamais forcé sur le moteur.");

        language-picker := ClosedSettingsPicker {
            theme: root.theme;
            modal-layer: 0;
            label: @tr("Langue de transcription des réunions");
            choices: SettingsOptions.meeting-language-options(root.meeting-transcription-language);
            chosen(row) => { root.meeting-transcription-language-changed(SettingsOptions.meeting-language-value(row, root.meeting-transcription-language)); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { autostop-switch.take-focus(); }
        private property <bool> control-focused: autostop-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Arrêt automatique des réunions");
        description: @tr("Arrêter l'enregistrement quand plus personne ne parle depuis longtemps.");

        autostop-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Arrêt automatique des réunions");
            checked: root.meeting-autostop-enabled;
            toggled(new) => { root.meeting-autostop-enabled-changed(new); }
        }
    }

    if root.meeting-autostop-enabled: KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { delay-picker.take-focus(); }
        private property <bool> control-focused: delay-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Délai avant arrêt");

        delay-picker := CatalogPicker {
            theme: root.theme;
            modal-layer: 0;
            control-label: @tr("Délai avant arrêt automatique");
            model: root.meeting-autostop-labels;
            current-value: root.meeting-autostop-label;
            value-chosen(value) => { root.meeting-autostop-changed(value); }
        }
    }

    if root.meeting-autostop-enabled: KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { duration-picker.take-focus(); }
        private property <bool> control-focused: duration-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Durée maximale d'une réunion");

        duration-picker := CatalogPicker {
            theme: root.theme;
            modal-layer: 0;
            control-label: @tr("Durée maximale d'une réunion");
            model: root.meeting-max-duration-labels;
            current-value: root.meeting-max-duration-label;
            value-chosen(value) => { root.meeting-max-duration-changed(value); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { vad-switch.take-focus(); }
        private property <bool> control-focused: vad-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Détection de voix (VAD)");
        description: @tr("Ignorer les silences pour une transcription plus rapide et plus propre.");

        vad-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Détection de voix");
            checked: root.vad-enabled;
            toggled(new) => { root.vad-enabled-changed(new); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { filler-switch.take-focus(); }
        private property <bool> control-focused: filler-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Suppression des hésitations");
        description: @tr("Retirer les \"euh\", \"hum\" et autres marqueurs d'hésitation.");

        filler-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Suppression des hésitations");
            checked: root.filler-removal;
            toggled(new) => { root.filler-removal-changed(new); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { stutter-switch.take-focus(); }
        private property <bool> control-focused: stutter-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Réduction des bégaiements");
        description: @tr("Fusionner les répétitions et faux départs.");

        stutter-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Réduction des bégaiements");
            checked: root.stutter-collapse;
            toggled(new) => { root.stutter-collapse-changed(new); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { dictionary-switch.take-focus(); }
        private property <bool> control-focused: dictionary-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Correction par dictionnaire");
        description: @tr("Appliquer automatiquement les corrections du dictionnaire personnel.");

        dictionary-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Correction par dictionnaire");
            checked: root.dictionary-correction;
            toggled(new) => { root.dictionary-correction-changed(new); }
        }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { diagnostic-switch.take-focus(); }
        private property <bool> control-focused: diagnostic-switch.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Capture diagnostique avant AEC");
        description: root.meeting-audio-retention == AudioRetention.off
            ? @tr("Activez d'abord la conservation de l'audio dans Données. Aucun diagnostic n'est enregistré sans elle.")
            : @tr("À partir de la prochaine réunion, conserve les voies brutes séparées : micro à gauche, audio système à droite. WAV sans perte : environ {} Mo/heure, {} minutes maximum. Même conservation que l'audio de réunion.", root.diagnostic-megabytes-per-hour, root.diagnostic-max-minutes);

        diagnostic-switch := KitSwitch {
            theme: root.theme;
            modal-layer: 0;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-label: @tr("Capture diagnostique avant AEC");
            checked: root.meeting-audio-diagnostic;
            access: root.meeting-audio-retention != AudioRetention.off ? FieldAccess.editable : FieldAccess.disabled;
            toggled(new) => { root.meeting-audio-diagnostic-changed(new); }
        }
    }

    if root.is-laptop: SettingsAdvancedBlock {
        theme: root.theme;

        clamshell-field := KitFieldRow {
            theme: root.theme;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            focus-requested => { clamshell-picker.take-focus(); }
            private property <bool> control-focused: clamshell-picker.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Microphone quand le capot est fermé");
            description: @tr("Utiliser ce microphone à la place quand le capot est fermé avec un écran externe connecté.");

            clamshell-picker := CatalogPicker {
                theme: root.theme;
                modal-layer: 0;
                control-label: @tr("Microphone quand le capot est fermé");
                model: root.clamshell-device-labels;
                option-values: root.clamshell-device-ids;
                default-device-index: root.default-device-index;
                current-value: root.clamshell-device-id;
                unavailable-label: PickerLabels.display(root.clamshell-device-label);
                value-chosen(value) => { root.clamshell-device-changed(value); }
            }
        }
    }
}
