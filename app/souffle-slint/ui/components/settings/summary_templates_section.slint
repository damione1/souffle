import { FieldSetAppearance, FieldRowAppearance, ButtonIntent, KitButton, KitFieldRow, KitFieldSet, KitForm, KitTextArea, KitTextField, KitThemeContext, KitThemes, KitWrap, ControlSize } from "@kit";
import { CatalogPicker } from "../catalog_picker.slint";
import { Theme } from "../../theme.slint";

// Port of SummaryTemplatesSettingsSection.svelte. Which template is being
// edited is tracked in Rust (`summary_templates_state` in main.rs), not as
// local `.slint` state, because switching the edit target needs Rust to
// resolve the corresponding name/prompt/is-builtin fields anyway - same
// picker-forwards-an-id pattern as the other open-set catalogues.
export component SummaryTemplatesSection inherits KitFieldSet {
    in property <[string]> template-ids;
    in property <[string]> template-labels;
    in property <string> default-template-id;
    in property <string> editing-template-id;
    in property <bool> editing-is-builtin;
    in-out property <string> editing-name;
    in-out property <string> editing-prompt;
    in-out property <string> new-template-draft: "";

    callback default-changed(string);
    callback edit-target-changed(string);
    callback delete-requested();
    callback name-changed(string);
    callback prompt-changed(string);
    callback add-requested(string);

    theme: KitThemeContext.current;
    legend: @tr("MODÈLES DE RÉSUMÉ");
    appearance: FieldSetAppearance.card;

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { default-picker.take-focus(); }
        private property <bool> control-focused: default-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Modèle par défaut");
        description: @tr("Le modèle par défaut est utilisé lorsque vous générez le résumé d'une réunion terminée.");

        default-picker := CatalogPicker {
            theme: KitThemeContext.current;
            modal-layer: 0;
            control-label: @tr("Modèle de résumé par défaut");
            model: root.template-labels;
            option-values: root.template-ids;
            current-value: root.default-template-id;
            value-chosen(id) => { root.default-changed(id); }
        }
    }

    edit-target-row := KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { template-picker.take-focus(); }
        private property <bool> control-focused: template-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Modifier");
        description: root.editing-is-builtin ? @tr("Modèle intégré : le prompt peut être personnalisé mais pas supprimé.") : "";

        KitWrap {
            theme: root.theme;
            cross-axis-alignment: center;
            horizontal-stretch: 0;

            template-picker := CatalogPicker {
                theme: KitThemeContext.current;
                modal-layer: 0;
                control-label: @tr("Modèle de résumé à modifier");
                model: root.template-labels;
                option-values: root.template-ids;
                current-value: root.editing-template-id;
                value-chosen(id) => { root.edit-target-changed(id); }
            }
            if !root.editing-is-builtin: KitButton {
                theme: root.theme;
                modal-layer: 0;
                control-size: ControlSize.compact;
                text: @tr("Supprimer");
                focus-observed(focused) => {
                    if focused { edit-target-row.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
                }
                activated => { root.delete-requested(); }
            }
        }
    }

    if !root.editing-is-builtin: KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { name-editor.take-focus(); }
        private property <bool> control-focused: name-editor.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Nom");

        name-editor := KitTextField {
            theme: KitThemeContext.current;
            modal-layer: 0;
            width: Theme.settings-control-width;
            accessible-name: @tr("Nom du modèle de résumé");
            text <=> root.editing-name;
            edited(value) => { root.name-changed(value); }
        }
    }

    instruction-row := KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: vertical;
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        focus-requested => { instruction-editor.take-focus(); }
        private property <bool> control-focused: instruction-editor.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Instruction");
        description: @tr("Prompt envoyé à l'IA pour générer le résumé.");

        instruction-editor := KitTextArea {
            theme: KitThemeContext.current;
            modal-layer: 0;
            text <=> root.editing-prompt;
            description: instruction-row.description;
            show-description: false;
            placeholder: @tr("Instruction de génération du résumé");
            accessible-name: @tr("Instruction du modèle de résumé");
            edited(value) => { root.prompt-changed(value); }
        }
    }

    add-form := KitForm {
        theme: root.theme;
        modal-layer: 0;
        accessible-name: add-button.text;
        implicit-submit: false;
        valid: root.new-template-draft != "";
        validation-requested => { return self.valid; }
        submit-requested => { root.add-requested(root.new-template-draft); }

        add-row := KitFieldRow {
            theme: root.theme;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            label: @tr("Nom du nouveau modèle");
            focus-requested => { new-name-editor.take-focus(); }

            HorizontalLayout {
                // Wider than a settings control so the placeholder fits beside the button.
                width: 280px;
                spacing: 8px;
                new-name-editor := KitTextField {
                    theme: root.theme;
                    modal-layer: 0;
                    text <=> root.new-template-draft;
                    placeholder: @tr("Nom du nouveau modèle");
                    accessible-name: @tr("Nom du nouveau modèle de résumé");
                    horizontal-stretch: 1;
                    focus-observed(focused) => {
                        if focused { add-row.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    add-button := KitButton {
                        theme: root.theme;
                        modal-layer: 0;
                        control-size: ControlSize.compact;
                        text: @tr("Ajouter");
                        intent: ButtonIntent.primary;
                        disabled: !add-form.valid;
                        focus-observed(focused) => {
                            if focused { add-row.ensure-visible(KitThemes.scroll-behavior(root.theme)); }
                        }
                        activated => { add-form.submit(); }
                    }
                }
            }
        }
    }
}
