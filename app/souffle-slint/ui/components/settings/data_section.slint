import { AppText, Typography } from "@typography";
import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { KitButton, KitTextArea, FieldAccess, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow, KitMetrics, ControlSize } from "@kit";
import { LucideFiles } from "@kit-icons/files.slint";
import { LucideText } from "@kit-icons/text.slint";
import { Theme } from "../../theme.slint";
import { AudioRetention } from "../../types.slint";

component CodeBlock inherits KitTextArea {
    in property <string> body;
    text: root.body;
    access: FieldAccess.read-only;
    accessible-name: @tr("Bloc de code sélectionnable");
    height: 88px;
}

component CopyButton inherits KitButton {
    theme: KitThemeContext.current;
    control-size: ControlSize.compact;
    leading-icon: LucideText.copy();
    text: @tr("Copier");
}

// Port of DataSettingsSection.svelte. "Export archive" opens a native
// macOS folder picker (osascript `choose folder`) rather than the
// `@tauri-apps/plugin-dialog` the Svelte version uses - the ticket's own
// out-of-scope note defers the native-dialog abstraction to SOU-191 and
// allows consuming existing commands meanwhile. `export_archive` itself
// runs the real export on a background thread and returns immediately;
// this shell does not listen for the `ArchiveExportProgress` Tauri event,
// so there is no live progress bar or completion toast here (documented
// gap, not a placeholder - the export itself is real).
export component DataSection inherits VerticalLayout {
    in property <string> stats-line;
    in property <string> recordings-line;
    in property <AudioRetention> retention;
    in property <bool> exporting;
    in property <string> export-status;
    in property <bool> export-status-is-error;
    in property <string> mcp-binary-path;
    in property <bool> mcp-exists;
    in property <string> mcp-claude-desktop-snippet;
    in property <string> mcp-claude-code-command;
    in property <bool> testing-mcp;
    in property <string> mcp-test-status;

    callback retention-changed(AudioRetention);
    callback export-requested();
    callback reveal-requested();
    callback copy-desktop-snippet-requested();
    callback copy-code-command-requested();
    callback test-mcp-requested();



    spacing: 22px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("DONNÉES");

    if root.stats-line != "": VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-top: 12px;
        AppText {
            text: root.stats-line;
            typography: Typography.secondary;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
    if root.recordings-line != "": VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 4px;
        AppText {
            text: root.recordings-line;
            typography: Typography.secondary;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        focus-requested => { retention-picker.take-focus(); }
        private property <bool> control-focused: retention-picker.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        show-divider: root.stats-line != "" || root.recordings-line != "";
        label: @tr("Conservation audio des réunions");
        description: @tr("Durée de conservation des enregistrements audio bruts.");

        retention-picker := ClosedSettingsPicker {
            theme: KitThemeContext.current;
            modal-layer: 0;
            label: @tr("Conservation audio des réunions");
            choices: SettingsOptions.retention-options(root.retention);
            chosen(row) => { root.retention-changed(SettingsOptions.retention-value(row, root.retention)); }
        }
    }

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { export-button.take-focus(); }
        private property <bool> control-focused: export-button.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Exporter les données");
        description: @tr("Exporter réunions, dictées et journal dans un dossier.");

        export-button := KitButton {
            theme: KitThemeContext.current;
            modal-layer: 0;
            control-size: ControlSize.compact;
            text: root.exporting ? @tr("Export en cours…") : @tr("Exporter…");
            disabled: root.exporting;
            activated => { root.export-requested(); }
        }
    }

    KitFieldRow {
        theme: KitThemeContext.current;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { reveal-button.take-focus(); }
        private property <bool> control-focused: reveal-button.has-focus;
        changed control-focused => {
            if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
        }
        label: @tr("Afficher le dossier de données");

        reveal-button := KitButton {
            theme: KitThemeContext.current;
            modal-layer: 0;
            control-size: ControlSize.compact;
            leading-icon: LucideFiles.folder();
            text: @tr("Afficher dans le Finder");
            activated => { root.reveal-requested(); }
        }
    }

    if root.export-status != "": VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 12px;
        AppText {
            text: root.export-status-is-error ? root.export-status : @tr("Export terminé vers {}" , root.export-status);
            color: root.export-status-is-error ? Theme.danger : Theme.text-muted;
            typography: Typography.small;
            wrap: word-wrap;
        }
    }
    }

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("SERVEUR MCP");

        VerticalLayout {
            padding-left: Theme.settings-inset;
            padding-right: Theme.settings-inset;
            padding-top: 15px;
            padding-bottom: 8px;
            AppText {
                text: @tr("Permet à Claude Desktop, Claude Code ou un autre client MCP de lire vos transcriptions et résumés. Tout reste sur ce Mac.");
                typography: Typography.secondary;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            padding-left: Theme.settings-inset;
            padding-right: Theme.settings-inset;
            padding-top: 8px;
            padding-bottom: 12px;
            spacing: 8px;

            AppText {
                text: @tr("Binaire sidecar");
                typography: Typography.field-label;
                color: Theme.text-secondary;
            }
            CodeBlock {
                body: root.mcp-binary-path;
            }
            if !root.mcp-exists: AppText {
                text: @tr("Binaire introuvable. Compilez souffle-mcp pour le développement local.");
                color: Theme.warning;
                typography: Typography.secondary;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-soft;
            vertical-stretch: 0;
        }

        VerticalLayout {
            padding-left: Theme.settings-inset;
            padding-right: Theme.settings-inset;
            padding-top: 15px;
            padding-bottom: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    AppText {
                        text: @tr("Config Claude Desktop");
                        typography: Typography.field-label;
                        color: Theme.text-secondary;
                    }
                    AppText {
                        text: @tr("À coller dans claude_desktop_config.json sous mcpServers.");
                        typography: Typography.secondary;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
                CopyButton {
                    activated => { root.copy-desktop-snippet-requested(); }
                }
            }
            CodeBlock {
                body: root.mcp-claude-desktop-snippet;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-soft;
            vertical-stretch: 0;
        }

        VerticalLayout {
            padding-left: Theme.settings-inset;
            padding-right: Theme.settings-inset;
            padding-top: 15px;
            padding-bottom: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    AppText {
                        text: @tr("Claude Code");
                        typography: Typography.field-label;
                        color: Theme.text-secondary;
                    }
                    AppText {
                        text: @tr("À exécuter une fois dans un terminal pour enregistrer le serveur.");
                        typography: Typography.secondary;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
                CopyButton {
                    activated => { root.copy-code-command-requested(); }
                }
            }
            CodeBlock {
                body: root.mcp-claude-code-command;
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            focus-requested => { connection-button.take-focus(); }
            private property <bool> control-focused: connection-button.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Tester la connexion");
            description: root.mcp-test-status;

            connection-button := KitButton {
                theme: KitThemeContext.current;
                modal-layer: 0;
                control-size: ControlSize.compact;
                text: root.testing-mcp ? @tr("Test en cours…") : @tr("Tester la connexion");
                disabled: !(root.mcp-exists && !root.testing-mcp);
                activated => { root.test-mcp-requested(); }
            }
        }
    }
}
