import { SettingsOptions, ClosedSettingsPicker } from "settings_options.slint";
import { AlertSeverity, FieldAccess, KitAlert, KitButton, KitFieldRow, KitFieldSet, KitInline, KitMetrics, KitStack, KitTextArea, KitThemeContext, KitThemes, TypographyRole } from "@kit";
import { Theme } from "../../theme.slint";
import { AudioRetention, ExportStatus, McpStatus } from "../../types.slint";

// A selectable, read-only block for a path, a JSON document or a command. The
// text is the host's exact string: the native editor selects and copies it.
component CodeBlock inherits KitTextArea {
    access: FieldAccess.read-only;
    min-lines: 1;
    max-lines: 6;
    show-description: false;
    text-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
    text-font-family: root.theme.typography.family-monospace;
}

// The destination comes from the native folder dialog and the export itself
// runs in the host; this page shows the retention choice, the outcome and the
// stored sizes the host reports.
export component DataSection inherits KitFieldSet {
    in property <string> stats-line;
    in property <string> recordings-line;
    in property <AudioRetention> retention;
    in property <ExportStatus> export-status;
    in property <string> export-detail;
    in property <int> modal-layer: 0;

    callback retention-changed(AudioRetention);
    callback export-requested();
    callback reveal-requested();

    theme: KitThemeContext.current;
    legend: @tr("DONNÉES");

    if root.stats-line != "" || root.recordings-line != "": stats-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        padding: KitMetrics.field-gap(self.theme);
        description: root.recordings-line == "" ? root.stats-line : root.stats-line == "" ? root.recordings-line : root.stats-line + "\n" + root.recordings-line;
    }

    retention-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        focus-requested => { retention-picker.take-focus(); }
        show-divider: root.stats-line != "" || root.recordings-line != "";
        label: @tr("Conservation audio des réunions");
        description: @tr("Durée de conservation des enregistrements audio bruts.");

        retention-picker := ClosedSettingsPicker {
            theme: root.theme;
            modal-layer: retention-row.modal-layer;
            label: @tr("Conservation audio des réunions");
            choices: SettingsOptions.retention-options(root.retention);
            chosen(row) => { root.retention-changed(SettingsOptions.retention-value(row, root.retention)); }
        }
    }

    export-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { export-button.take-focus(); }
        label: @tr("Exporter les données");
        description: @tr("Exporter réunions, dictées et journal dans un dossier.");

        export-button := KitButton {
            theme: root.theme;
            modal-layer: export-row.modal-layer;
            private property <bool> exporting: root.export-status == ExportStatus.choosing || root.export-status == ExportStatus.running;
            text: self.exporting ? @tr("Export en cours…") : @tr("Exporter…");
            text-wrap: word-wrap;
            disabled: self.exporting;
            accessible-description: export-row.description;
            activated => { root.export-requested(); }
            focus-observed(focused) => {
                if focused { export-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    reveal-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { reveal-button.take-focus(); }
        label: @tr("Afficher le dossier de données");

        reveal-button := KitButton {
            theme: root.theme;
            modal-layer: reveal-row.modal-layer;
            text: @tr("Afficher dans le Finder");
            text-wrap: word-wrap;
            activated => { root.reveal-requested(); }
            focus-observed(focused) => {
                if focused { reveal-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    if root.export-status == ExportStatus.running: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.information;
        message: @tr("Export en cours vers {}…", root.export-detail);
    }
    if root.export-status == ExportStatus.succeeded: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.success;
        message: @tr("Export terminé vers {}", root.export-detail);
    }
    if root.export-status == ExportStatus.failed: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.error;
        message: root.export-detail;
    }
}

export component McpSection inherits KitFieldSet {
    in property <string> binary-path;
    in property <McpStatus> status;
    in property <string> status-detail;
    in property <string> claude-desktop-snippet;
    in property <string> claude-code-command;
    in property <int> modal-layer: 0;

    callback copy-desktop-snippet-requested();
    callback copy-code-command-requested();
    callback test-requested();

    theme: KitThemeContext.current;
    legend: @tr("SERVEUR MCP");

    KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        padding: KitMetrics.field-gap(self.theme);
        description: @tr("Permet à Claude Desktop, Claude Code ou un autre client MCP de lire vos transcriptions et résumés. Tout reste sur ce Mac.");
    }

    binary-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Orientation.vertical;
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { binary-block.take-focus(); }
        label: @tr("Binaire sidecar");

        binary-block := CodeBlock {
            theme: root.theme;
            modal-layer: binary-row.modal-layer;
            text: root.binary-path;
            accessible-name: binary-row.label;
            focus-observed(focused) => {
                if focused { binary-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    if root.status == McpStatus.absent: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.warning;
        message: @tr("Binaire introuvable. Compilez souffle-mcp pour le développement local.");
    }

    desktop-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Orientation.vertical;
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { desktop-block.take-focus(); }
        label: @tr("Config Claude Desktop");
        description: @tr("À coller dans claude_desktop_config.json sous mcpServers.");

        KitStack {
            theme: root.theme;
            gap: compact;
            desktop-block := CodeBlock {
                theme: root.theme;
                modal-layer: desktop-row.modal-layer;
                text: root.claude-desktop-snippet;
                accessible-name: desktop-row.label;
                focus-observed(focused) => {
                    if focused { desktop-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }
            }
            KitInline {
                theme: root.theme;
                alignment: end;
                desktop-copy := KitButton {
                    theme: root.theme;
                    modal-layer: desktop-row.modal-layer;
                    text: @tr("Copier");
                    accessible-description: desktop-row.label;
                    activated => { root.copy-desktop-snippet-requested(); }
                    focus-observed(focused) => {
                        if focused { desktop-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                    }
                }
            }
        }
    }

    code-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Orientation.vertical;
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { code-block.take-focus(); }
        label: @tr("Claude Code");
        description: @tr("À exécuter une fois dans un terminal pour enregistrer le serveur.");

        KitStack {
            theme: root.theme;
            gap: compact;
            code-block := CodeBlock {
                theme: root.theme;
                modal-layer: code-row.modal-layer;
                text: root.claude-code-command;
                accessible-name: code-row.label;
                focus-observed(focused) => {
                    if focused { code-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }
            }
            KitInline {
                theme: root.theme;
                alignment: end;
                code-copy := KitButton {
                    theme: root.theme;
                    modal-layer: code-row.modal-layer;
                    text: @tr("Copier");
                    accessible-description: code-row.label;
                    activated => { root.copy-code-command-requested(); }
                    focus-observed(focused) => {
                        if focused { code-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                    }
                }
            }
        }
    }

    test-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { connection-button.take-focus(); }
        label: @tr("Tester la connexion");

        connection-button := KitButton {
            theme: root.theme;
            modal-layer: test-row.modal-layer;
            text: root.status == McpStatus.testing ? @tr("Test en cours…") : @tr("Tester la connexion");
            text-wrap: word-wrap;
            disabled: root.status == McpStatus.absent || root.status == McpStatus.testing;
            activated => { root.test-requested(); }
            focus-observed(focused) => {
                if focused { test-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    if root.status == McpStatus.succeeded: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.success;
        message: @tr("Connexion réussie ({}).", root.status-detail);
    }
    if root.status == McpStatus.failed: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.error;
        message: root.status-detail;
    }
}
