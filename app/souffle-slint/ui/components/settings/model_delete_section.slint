import { AppText, Typography } from "@typography";
import { FieldSetAppearance, FieldRowAppearance, ButtonIntent, ControlSize, KitButton, KitFieldSet, KitThemeContext, KitFieldRow } from "@kit";
import { Theme } from "../../theme.slint";
import { TranscriptionPhase, ModelDeletionError } from "../../types.slint";

// Destructive "delete the downloaded model" action for Settings > Système
// (SOU-195-slice: the section itself was entirely missing from the Slint
// port). Two-step inline confirm rather than a modal - the sandbox blocks
// `confirm()`/`alert()`, and `timeline_item.slint`'s hover-reveal delete
// already established the same "click again to confirm" pattern for a
// destructive action in this codebase.
//
// The state machine (whether delete is even legal right now) is not
// reimplemented here: `commands::model::delete_model` in Rust is the single
// source of truth and refuses a currently-loaded or mid-transition model
// with a typed refusal localized here; operational failures keep their detail.
// `can-delete` below only decides whether to invite the click - it narrows
// to the one phase (downloaded, not loaded) that can never race that guard.
export component ModelDeleteSection inherits KitFieldSet {
    in property <TranscriptionPhase> model-phase;
    in property <string> model-label;
    in property <string> delete-error;
    in property <ModelDeletionError> delete-error-kind: ModelDeletionError.operation-failed;
    in property <bool> files-deletable;

    callback delete-requested();

    property <bool> confirming: false;
    property <bool> can-delete: root.files-deletable && root.model-phase == TranscriptionPhase.load-required;

    theme: KitThemeContext.current;
    legend: @tr("STOCKAGE DU MODÈLE");
    appearance: FieldSetAppearance.card;

    KitFieldRow {
        theme: root.theme;
        modal-layer: 0;
        orientation: Theme.settings-field-orientation(self.width);
        appearance: FieldRowAppearance.inset;
        show-divider: true;
        label: @tr("Supprimer le mod\u{e8}le t\u{e9}l\u{e9}charg\u{e9}");
        description: !root.files-deletable
            ? @tr("Les assets Apple Speech sont gérés par macOS. Soufflé ne les supprime pas.")
            : root.can-delete
            ? @tr("Supprime les fichiers de {} du disque. Il faudra le t\u{e9}l\u{e9}charger \u{e0} nouveau pour l'utiliser.", root.model-label)
            : @tr("Le mod\u{e8}le doit \u{ea}tre t\u{e9}l\u{e9}charg\u{e9} et d\u{e9}charg\u{e9} (pas en cours d'utilisation) pour \u{ea}tre supprim\u{e9}.");

        if root.files-deletable: HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;

            if !root.confirming: KitButton {
                text: @tr("Supprimer");
                control-size: ControlSize.compact;
                intent: ButtonIntent.destructive;
                disabled: !root.can-delete;
                activated => { root.confirming = true; }
            }

            if root.confirming: KitButton {
                text: @tr("Annuler");
                control-size: ControlSize.compact;
                intent: ButtonIntent.quiet;
                activated => { root.confirming = false; }
            }

            if root.confirming: KitButton {
                text: @tr("Confirmer");
                control-size: ControlSize.compact;
                intent: ButtonIntent.destructive;
                disabled: !root.can-delete;
                activated => {
                    root.confirming = false;
                    root.delete-requested();
                }
            }
        }
    }

    if root.delete-error != "": VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 12px;
        AppText {
            text: root.delete-error-kind == ModelDeletionError.managed-asset ? @tr("Les ressources Apple Speech sont gérées par macOS et ne peuvent pas être supprimées par Soufflé.")
                : root.delete-error-kind == ModelDeletionError.transition-busy ? @tr("Attendez la fin de l'opération sur le modèle avant de le supprimer.")
                : root.delete-error-kind == ModelDeletionError.active-model ? @tr("Déchargez le modèle actif ou choisissez un autre modèle avant de le supprimer.")
                : root.delete-error;
            color: Theme.danger;
            typography: Typography.small;
            wrap: word-wrap;
        }
    }
}
