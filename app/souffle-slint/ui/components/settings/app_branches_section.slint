import { FieldSetAppearance, FieldRowAppearance, ButtonIntent, ChoiceLabelPosition, ControlSize, ControlWidth, KitButton, KitFieldRow, KitFieldSeparator, KitFieldSet, KitSwitch, KitTextField, KitThemeContext, Ownership } from "@kit";
import { Theme } from "../../theme.slint";
import { CatalogPicker } from "../catalog_picker.slint";

export struct AppBranchRow {
    id: string,
    app-pattern: string,
    enabled: bool,
    target-label: string,
    pattern-rollback-revision: int,
}

export component AppBranchesSection inherits VerticalLayout {
    in property <[AppBranchRow]> rules;
    in property <[string]> target-labels;
    private property <int> new-target-index: 0;
    private property <string> new-pattern;

    callback rule-added(string, int);
    callback rule-deleted(string);
    callback rule-enabled(string, bool);
    callback rule-pattern-changed(string, string);
    callback rule-target-changed(string, int);
    callback rule-moved(string, int);

    spacing: 20px;
    alignment: start;
    vertical-stretch: 0;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("RETOUCHE PAR APPLICATION");
        appearance: FieldSetAppearance.card;

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            appearance: FieldRowAppearance.inset;
            show-divider: true;
            label: @tr("Règles par application");
            description: @tr("La première règle active valide gagne. Le nom de l'application contient le motif, sans tenir compte de la casse. Par défaut suit le modèle global ; les instructions sont partagées.");
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 14px;
            spacing: 12px;
            KitTextField {
                modal-layer: 0;
                text <=> root.new-pattern;
                placeholder: @tr("Nom d'application");
                accessible-name: @tr("Nouvelle règle d'application");
                horizontal-stretch: 1;
            }
            CatalogPicker {
                modal-layer: 0;
                control-label: @tr("Modèle de la nouvelle règle");
                model: root.target-labels;
                current-value: root.target-labels[root.new-target-index];
                selected-index(index) => { root.new-target-index = index; }
            }
            KitButton {
                modal-layer: 0;
                text: @tr("Ajouter");
                intent: ButtonIntent.primary;
                disabled: root.new-pattern == "";
                activated => {
                    root.rule-added(root.new-pattern, root.new-target-index);
                    root.new-pattern = "";
                }
            }
        }

        for rule[index] in root.rules: VerticalLayout {
            private property <string> pattern-rule-id: rule.id;
            changed pattern-rule-id => { pattern-field.text = rule.app-pattern; }
            private property <int> pattern-rollback-revision: rule.pattern-rollback-revision;
            changed pattern-rollback-revision => { pattern-field.text = rule.app-pattern; }
            KitFieldSeparator { }
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    KitSwitch {
                        modal-layer: 0;
                        label-position: ChoiceLabelPosition.start;
                        padding-inline: 0px;
                        ownership: Ownership.controlled;
                        control-width: ControlWidth.intrinsic;
                        accessible-label: @tr("Activer la règle {}", rule.app-pattern);
                        checked: rule.enabled;
                        toggled(value) => { root.rule-enabled(rule.id, value); }
                    }
                    pattern-field := KitTextField {
                        modal-layer: 0;
                        text: rule.app-pattern;
                        accessible-name: @tr("Motif de la règle");
                        horizontal-stretch: 1;
                        committed(result) => { root.rule-pattern-changed(rule.id, result.value.text); }
                    }
                    CatalogPicker {
                        modal-layer: 0;
                        control-label: @tr("Modèle partagé de la règle");
                        model: root.target-labels;
                        current-value: rule.target-label;
                        selected-index(value) => { root.rule-target-changed(rule.id, value); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    KitButton {
                        modal-layer: 0;
                        control-size: ControlSize.compact;
                        intent: ButtonIntent.quiet;
                        text: @tr("Monter");
                        disabled: index <= 0;
                        activated => { root.rule-moved(rule.id, index - 1); }
                    }
                    KitButton {
                        modal-layer: 0;
                        control-size: ControlSize.compact;
                        intent: ButtonIntent.quiet;
                        text: @tr("Descendre");
                        disabled: index + 1 >= root.rules.length;
                        activated => { root.rule-moved(rule.id, index + 1); }
                    }
                    KitButton {
                        modal-layer: 0;
                        control-size: ControlSize.compact;
                        intent: ButtonIntent.quiet;
                        text: @tr("Supprimer");
                        activated => { root.rule-deleted(rule.id); }
                    }
                }
            }
        }
    }
}
