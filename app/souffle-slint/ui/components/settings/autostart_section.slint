import { ChoiceLabelPosition, ControlWidth, KitSwitch, Ownership, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow, KitMetrics } from "@kit";
import { Theme } from "../../theme.slint";

// The switch is controlled: it shows what the host acknowledged, which is the
// state macOS reports after the login item change, not the click.
export component AutostartSection inherits KitFieldSet {
    in property <bool> autostart-enabled;
    in property <int> modal-layer: 0;

    callback autostart-changed(bool);

    theme: KitThemeContext.current;
    legend: @tr("DÉMARRAGE");

    autostart-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        focus-requested => { autostart-switch.take-focus(); }
        show-divider: false;
        label: @tr("Lancer à l'ouverture de session");
        description: @tr("Ouvrir Soufflé automatiquement au démarrage du Mac.");

        autostart-switch := KitSwitch {
            theme: root.theme;
            modal-layer: autostart-row.modal-layer;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-name: @tr("Lancer Soufflé à l'ouverture de session");
            accessible-description: autostart-row.description;
            checked: root.autostart-enabled;
            toggled(new) => { root.autostart-changed(new); }
            focus-observed(focused) => {
                if focused { autostart-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }
}
