import { AppText, AppTextInput, Typography, TypographyStyle } from "@typography";
import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { TranscriptionPhase, TranscriptionUnavailableReason, SystemSettingsPane } from "../../types.slint";
import { ThemedButton } from "../themed_button.slint";
import { ThemedComboBox } from "../themed_combo.slint";
import { StatusIndicator } from "status_indicator.slint";

// Port of ModelSettingsSection.svelte. The download/switch state machine
// itself is not reimplemented here (AC2): it stays entirely in Rust
// (`model_ui.rs`, calling the same `get_model_status`/`download_model`/
// `load_model` commands the Svelte controller calls), this component only
// displays whatever state Rust pushes and forwards the chosen label back.
export component ModelSection inherits VerticalLayout {
    in property <TranscriptionPhase> model-phase;
    in property <bool> ready;
    in property <[string]> model-labels;
    in property <string> selected-model-label;
    in property <bool> apple-speech-selected;
    in property <bool> apple-speech-unavailable;
    in property <TranscriptionUnavailableReason> apple-speech-unavailable-reason;
    callback open-system-settings-requested(SystemSettingsPane);
    in property <bool> busy;
    in property <bool> downloading;
    in property <string> download-progress-label;
    in property <float> download-progress-fraction;
    in property <[string]> unload-timeout-labels;
    in property <string> unload-timeout-label;
    in property <string> error-message;

    callback model-changed(string);
    callback unload-timeout-changed(string);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: @tr("MODÈLE DE TRANSCRIPTION");

    SettingsField {
        show-divider: false;
        label: @tr("Modèle de transcription");
        description: @tr("Choisissez un modèle : il se télécharge et se charge tout seul. Tout tourne sur ce Mac.");

        StatusIndicator {
            text: root.model-phase == TranscriptionPhase.download-required ? @tr("Téléchargement requis")
                : root.model-phase == TranscriptionPhase.downloading ? @tr("Téléchargement…")
                : root.model-phase == TranscriptionPhase.load-required ? @tr("Chargement requis")
                : root.model-phase == TranscriptionPhase.loading ? @tr("Chargement…")
                : root.model-phase == TranscriptionPhase.ready ? @tr("Prêt")
                : root.model-phase == TranscriptionPhase.unloading ? @tr("Déchargement…")
                : root.model-phase == TranscriptionPhase.failed ? @tr("Erreur du modèle")
                : "";
            indicator-color: root.ready ? Theme.accent : Theme.warning;
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 15px;
        combo-host := Rectangle {
            height: Theme.settings-control-height;
            vertical-stretch: 0;
            clip: true;
            ThemedComboBox {
                control-label: @tr("Modèle de transcription");
                width: parent.width;
                combo-width: parent.width;
                model: root.model-labels;
                current-value: root.selected-model-label;
                enabled: !root.busy;
                selected(value) => { root.model-changed(value); }
            }
        }
    }

    if root.apple-speech-selected && !root.apple-speech-unavailable: VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 15px;
        spacing: 10px;
        Text {
            text: @tr("La langue affichée est celle prise en charge par Apple Speech pour la langue et la région de ce Mac. Pour la modifier, ouvrez Réglages Système > Général > Langue et région, puis relancez Soufflé.");
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        Text {
            text: @tr("La transcription fonctionne sans activer Siri ou Apple Intelligence. macOS gère le modèle ; Soufflé libère les sessions inactives.");
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            ThemedButton {
                text: @tr("Ouvrir Langue et région");
                clicked => { root.open-system-settings-requested(SystemSettingsPane.language-and-region); }
            }
        }
    }

    if root.apple-speech-unavailable: VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 15px;
        spacing: 10px;
        Text {
            text: @tr("Apple Speech indisponible");
            font-size: 13px;
            color: Theme.text-secondary;
        }
        Text {
            text: root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.os-unsupported
                ? @tr("Apple Speech nécessite macOS 26 ou une version ultérieure. Vérifiez les mises à jour de macOS ou choisissez un autre modèle.")
                : root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.device-unsupported
                ? @tr("Apple Speech n'est pas pris en charge sur ce Mac. Choisissez un autre modèle de transcription.")
                : root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.build-unsupported
                ? @tr("Cette version de Soufflé n'inclut pas Apple Speech. Installez une version compatible ou choisissez un autre modèle.")
                : root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.locale-unsupported
                ? @tr("La langue et la région actuelles de ce Mac ne sont pas prises en charge par Apple Speech. Modifiez-les dans Réglages Système > Général > Langue et région, puis relancez Soufflé, ou choisissez un autre modèle.")
                : root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.assets-unsupported
                ? @tr("Les ressources Apple Speech ne sont pas disponibles pour la langue de ce Mac. Choisissez une autre langue dans Langue et région, puis relancez Soufflé, ou utilisez un autre modèle.")
                : root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.check-failed
                ? @tr("Impossible de vérifier la disponibilité d'Apple Speech. Relancez Soufflé pour réessayer ou choisissez un autre modèle.")
                : "";
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        if root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.locale-unsupported
            || root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.assets-unsupported: HorizontalLayout {
            alignment: start;
            ThemedButton {
                text: @tr("Ouvrir Langue et région");
                clicked => { root.open-system-settings-requested(SystemSettingsPane.language-and-region); }
            }
        }
        if root.apple-speech-unavailable-reason == TranscriptionUnavailableReason.os-unsupported: HorizontalLayout {
            alignment: start;
            ThemedButton {
                text: @tr("Ouvrir Mise à jour de logiciels");
                clicked => { root.open-system-settings-requested(SystemSettingsPane.software-update); }
            }
        }
    }

    if root.downloading: VerticalLayout {
        spacing: 4px;
        AppText {
            text: root.download-progress-label;
            typography: Typography.caption;
            color: Theme.text-muted;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface-3;
            Rectangle {
                height: 6px;
                width: parent.width * max(0.05, root.download-progress-fraction);
                border-radius: 3px;
                background: Theme.accent;
            }
        }
    }

    if root.error-message != "": AppText {
        text: root.error-message;
        color: Theme.danger;
        typography: Typography.small;
        wrap: word-wrap;
    }

    if !root.apple-speech-selected: SettingsField {
        label: @tr("Délai avant déchargement");
        description: @tr("Décharger le modèle de la mémoire après une période d'inactivité.");

        ThemedComboBox {
            control-label: @tr("Délai avant déchargement");
            model: root.unload-timeout-labels;
            current-value: root.unload-timeout-label;
            selected(value) => { root.unload-timeout-changed(value); }
        }
    }
    }
}
