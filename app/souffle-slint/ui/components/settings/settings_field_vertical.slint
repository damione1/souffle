import { Theme } from "../../theme.slint";

export component SettingsFieldVertical inherits VerticalLayout {
    in property <string> label;
    in property <string> description: "";
    in property <bool> show-divider: true;

    spacing: 0px;
    alignment: start;
    vertical-stretch: 0;

    if root.show-divider: Rectangle {
        height: 1px;
        background: Theme.border-soft;
        vertical-stretch: 0;
    }

    VerticalLayout {
        padding-top: 15px;
        padding-bottom: 15px;
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        spacing: 12px;

        VerticalLayout {
            spacing: 2px;
            alignment: start;
            horizontal-stretch: 1;
            vertical-stretch: 0;

            Text {
                text: root.label;
                font-size: 13.5px;
                color: Theme.text-secondary;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Theme.text-muted;
                wrap: word-wrap;
                horizontal-alignment: left;
            }
        }

        @children
    }
}
