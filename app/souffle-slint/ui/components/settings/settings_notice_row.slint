import { KitFieldSeparator } from "@kit";

export component SettingsNoticeRow inherits VerticalLayout {
    in property <bool> show-divider: true;

    vertical-stretch: 0;
    if root.show-divider: KitFieldSeparator { }
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 8px;
        @children
    }
}
