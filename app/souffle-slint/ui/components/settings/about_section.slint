import { ChoiceLabelPosition, ControlWidth, KitButton, KitSwitch, Ownership, KitFieldSet, KitThemeContext, KitThemes, KitFieldRow, KitMetrics } from "@kit";
import { Theme } from "../../theme.slint";

// Port of AboutSettingsSection.svelte. `UpdateAction` (the download-progress
// + install button shown once an update is found) is not built here - a
// full updater UI is a standalone feature disproportionate to this tab, and
// is left for a follow-up ticket. "Check for updates" itself is real
// (`check_for_updates`), it just reports the result as text rather than
// offering to install it.
export component AboutSection inherits VerticalLayout {
    in property <string> app-version;
    in property <string> transcription-label;
    in property <string> summary-label;
    in property <bool> auto-update-check;
    in property <bool> checking-updates;
    in property <string> update-status;

    callback check-updates-requested();
    callback auto-update-check-changed(bool);

    spacing: 22px;
    alignment: start;

    KitFieldSet {
        theme: KitThemeContext.current;
        legend: @tr("À PROPOS");

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: false;
            label: @tr("Version");

            Text {
                text: root.app-version == "local build" ? @tr("Build local") : @tr("v{}", root.app-version);
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                overflow: elide;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            label: @tr("Transcription");

            Text {
                text: root.transcription-label;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                overflow: elide;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            label: @tr("Résumés");

            Text {
                text: root.summary-label;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                overflow: elide;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            label: @tr("Confidentialité");

            Text {
                text: @tr("100% local");
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            focus-requested => { update-button.take-focus(); }
            private property <bool> control-focused: update-button.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Mises à jour");
            description: root.update-status;

            update-button := KitButton {
                theme: KitThemeContext.current;
                modal-layer: 0;
                text: root.checking-updates ? @tr("Vérification…") : @tr("Vérifier les mises à jour");
                disabled: root.checking-updates;
                activated => { root.check-updates-requested(); }
            }
        }

        KitFieldRow {
            theme: KitThemeContext.current;
            modal-layer: 0;
            orientation: Theme.settings-field-orientation(self.width);
            padding: KitMetrics.field-gap(self.theme);
            show-divider: true;
            focus-requested => { update-switch.take-focus(); }
            private property <bool> control-focused: update-switch.has-focus;
            changed control-focused => {
                if self.control-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
            label: @tr("Vérification automatique");
            description: @tr("Vérifier les mises à jour au démarrage.");

            update-switch := KitSwitch {
                theme: KitThemeContext.current;
                modal-layer: 0;
                label-position: ChoiceLabelPosition.start;
                padding-inline: 0px;
                ownership: Ownership.controlled;
                control-width: ControlWidth.intrinsic;
                accessible-label: @tr("Vérification automatique des mises à jour");
                checked: root.auto-update-check;
                toggled(new) => { root.auto-update-check-changed(new); }
            }
        }
    }
}
