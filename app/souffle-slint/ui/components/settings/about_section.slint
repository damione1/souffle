import { Theme } from "../../theme.slint";
import { UpdateCheckStatus } from "../../types.slint";
import { AlertSeverity, ChoiceLabelPosition, ControlWidth, KitAlert, KitButton, KitFieldRow, KitFieldSet, KitMetrics, KitSwitch, KitText, KitThemeContext, KitThemes, Ownership } from "@kit";

// A trailing value: the row's label names it and the text sits in the
// control column, elided when it is long.
component ValueText inherits KitText {
    role: control;
    tone: neutral;
    wrap: no-wrap;
    overflow: elide;
    horizontal-alignment: right;
    width: Theme.settings-control-width;
}

// The version and the labels come from the host. `update-status` is the
// outcome of the last manual check, shown with its own sentence.
export component AboutSection inherits KitFieldSet {
    in property <string> app-version;
    in property <string> transcription-label;
    in property <string> summary-label;
    in property <bool> auto-update-check;
    in property <UpdateCheckStatus> update-status;
    in property <string> update-detail;
    in property <int> modal-layer: 0;

    callback check-updates-requested();
    callback auto-update-check-changed(bool);

    theme: KitThemeContext.current;
    legend: @tr("À PROPOS");

    KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: false;
        label: @tr("Version");
        ValueText { theme: root.theme; text: root.app-version == "local build" ? @tr("Build local") : @tr("v{}", root.app-version); }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Transcription");
        ValueText { theme: root.theme; text: root.transcription-label; }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Résumés");
        ValueText { theme: root.theme; text: root.summary-label; }
    }

    KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        label: @tr("Confidentialité");
        ValueText { theme: root.theme; text: @tr("100% local"); }
    }

    update-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { update-button.take-focus(); }
        label: @tr("Mises à jour");

        update-button := KitButton {
            theme: root.theme;
            modal-layer: update-row.modal-layer;
            text: root.update-status == UpdateCheckStatus.checking ? @tr("Vérification…") : @tr("Vérifier les mises à jour");
            text-wrap: word-wrap;
            disabled: root.update-status == UpdateCheckStatus.checking;
            activated => { root.check-updates-requested(); }
            focus-observed(focused) => {
                if focused { update-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }

    if root.update-status == UpdateCheckStatus.up-to-date: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.success;
        message: @tr("À jour.");
    }
    if root.update-status == UpdateCheckStatus.available: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.information;
        message: @tr("Mise à jour disponible : v{}", root.update-detail);
    }
    if root.update-status == UpdateCheckStatus.failed: KitAlert {
        theme: root.theme;
        severity: AlertSeverity.error;
        message: root.update-detail;
    }

    update-switch-row := KitFieldRow {
        theme: root.theme;
        modal-layer: root.modal-layer;
        orientation: Theme.settings-field-orientation(self.width);
        padding: KitMetrics.field-gap(self.theme);
        show-divider: true;
        focus-requested => { update-switch.take-focus(); }
        label: @tr("Vérification automatique");
        description: @tr("Vérifier les mises à jour au démarrage.");

        update-switch := KitSwitch {
            theme: root.theme;
            modal-layer: update-switch-row.modal-layer;
            label-position: ChoiceLabelPosition.start;
            padding-inline: 0px;
            ownership: Ownership.controlled;
            control-width: ControlWidth.intrinsic;
            accessible-name: @tr("Vérification automatique des mises à jour");
            accessible-description: update-switch-row.description;
            checked: root.auto-update-check;
            toggled(new) => { root.auto-update-check-changed(new); }
            focus-observed(focused) => {
                if focused { update-switch-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
            }
        }
    }
}
