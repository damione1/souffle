import { AppText, Typography } from "@typography";
import { AlertSeverity, ButtonIntent, ControlSize, ControlWidth, KitAlert, KitButton, KitCard, KitInline, KitPressable, KitProgress, KitScrollArea, KitText, KitThemeContext, ProgressMode, SurfaceLevel, TypographyRole } from "@kit";
import { Theme } from "../theme.slint";
import { CompressionUi } from "../compression.slint";
import { CompactJobPhase } from "../types.slint";
import { CompressionStatus } from "compression_status.slint";

component CompactLine inherits Rectangle {
    in property <string> text;
    in property <bool> timed;
    in property <bool> expanded;
    in property <length> pad;
    in property <length> collapsed-height;
    callback activated();

    height: root.expanded ? row-text.preferred-height + 2 * root.pad : root.collapsed-height;

    if root.timed: KitPressable {
        intent: ButtonIntent.quiet;
        control-width: ControlWidth.fill;
        width: parent.width;
        height: parent.height;
        padding-inline: 0px;
        padding-block: 0px;
        accessible-name: root.text;
        activated => { root.activated(); }
    }
    row-text := KitText {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: root.expanded ? self.preferred-height : root.collapsed-height - 2 * root.pad;
        text: root.text;
        overflow: root.expanded ? clip : elide;
        accessible-role: none;
    }
}

export component CompactTranscriptSection inherits KitCard {
    property <length> row-padding: KitThemeContext.current.spacing.unit * 3;
    property <length> collapsed-row-height: 72px;
    property <bool> waiting: CompressionUi.job-phase == CompactJobPhase.waiting-for-model || CompressionUi.job-phase == CompactJobPhase.queued;

    level: SurfaceLevel.raised;
    inset: regular;
    gap: compact;

    KitInline {
        gap: compact;
        alignment: stretch;
        AppText {
            text: @tr("Version compacte (expérimentale)");
            typography: Typography.action-title;
            color: Theme.text-primary;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !CompressionUi.busy: KitButton {
            text: CompressionUi.has-compact ? @tr("Régénérer") : @tr("Générer");
            intent: ButtonIntent.secondary;
            control-size: ControlSize.compact;
            disabled: CompressionUi.ongoing || !CompressionUi.has-source;
            activated => { CompressionUi.generate(); }
        }
        if CompressionUi.busy: KitButton { text: @tr("Annuler"); control-size: ControlSize.compact; activated => { CompressionUi.cancel(); } }
        if CompressionUi.has-compact: KitButton { text: CompressionUi.copied ? @tr("Copié") : @tr("Copier"); control-size: ControlSize.compact; activated => { CompressionUi.copy(); } }
    }

    if CompressionUi.ongoing: KitText { text: @tr("Disponible une fois l'enregistrement terminé."); role: TypographyRole.caption; }
    if CompressionUi.stale: KitAlert { bordered: false;
        corner-radius: 12px;
        inset: 12px;
        severity: AlertSeverity.warning;
        message: @tr("Cette version compacte précède les dernières modifications de la transcription. Régénérez-la avant de l'utiliser.");
    }
    if root.waiting: KitProgress {
        mode: ProgressMode.indeterminate;
        label: CompressionUi.job-phase == CompactJobPhase.waiting-for-model ? @tr("En attente du modèle…") : @tr("En attente du moteur de compression…");
    }
    if CompressionUi.job-phase == CompactJobPhase.compressing: KitProgress {
        value: CompressionUi.progress / 100.0;
        label: @tr("Compression : {}%", CompressionUi.progress);
    }
    if CompressionUi.job-phase == CompactJobPhase.failed: KitAlert { bordered: false;
        corner-radius: 12px;
        inset: 12px;
        severity: AlertSeverity.error;
        message: @tr("La compression a échoué : {}", CompressionUi.job-error);
    }
    if CompressionUi.job-phase == CompactJobPhase.source-changed: KitAlert { bordered: false;
        corner-radius: 12px;
        inset: 12px;
        severity: AlertSeverity.warning;
        message: @tr("La transcription a changé. Relancez la compression.");
    }
    if CompressionUi.job-phase == CompactJobPhase.interrupted-by-recording: KitAlert { bordered: false;
        corner-radius: 12px;
        inset: 12px;
        severity: AlertSeverity.warning;
        message: @tr("Compression interrompue par un enregistrement. Réessayez après l'enregistrement.");
    }
    if CompressionUi.job-error != "" && CompressionUi.job-phase != CompactJobPhase.failed: KitAlert { bordered: false;
        corner-radius: 12px;
        inset: 12px;
        severity: AlertSeverity.error;
        message: @tr("L'opération a échoué : {}", CompressionUi.job-error);
    }

    if !CompressionUi.has-compact || CompressionUi.busy: CompressionStatus { }

    if CompressionUi.has-compact: KitText {
        text: @tr("LLMLingua-2 · cible {}% · {} · environ {} jetons", CompressionUi.compact-rate, CompressionUi.generated-at, CompressionUi.approx-tokens);
        role: TypographyRole.caption;
    }

    if CompressionUi.has-compact: KitCard {
        inset: none;
        gap: none;
        height: CompressionUi.expanded ? 320px : 160px;
        KitScrollArea {
            label: @tr("Version compacte");
            height: CompressionUi.expanded ? 320px : 160px;
            gap: none;
            for line in CompressionUi.lines: CompactLine {
                text: line.text;
                timed: line.timed;
                expanded: CompressionUi.expanded;
                pad: root.row-padding;
                collapsed-height: root.collapsed-row-height;
                activated => { CompressionUi.seek(line.session-index, line.seconds); }
            }
        }
    }

    if CompressionUi.has-compact: KitInline {
        KitButton { text: CompressionUi.expanded ? @tr("Réduire l'aperçu") : @tr("Développer l'aperçu"); control-size: ControlSize.compact; activated => { CompressionUi.expand(); } }
    }
    if CompressionUi.has-compact && CompressionUi.compact-rate < CompressionUi.rate-default: KitText { text: @tr("Une valeur basse omet des mots."); role: TypographyRole.caption; }
}
