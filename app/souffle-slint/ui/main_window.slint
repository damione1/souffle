    in-out property <bool> update-available-open: false;
    in property <string> update-latest-version;
    in property <[MarkdownBlock]> update-release-notes-blocks;
    in property <string> update-release-url;
    in property <UpdatePhase> update-phase;
    in property <string> update-error-message;
    // `Option<InstallBlockReason>` split across the boundary: Rust
    // (`update_ui::project_install_block`) always writes the pair together.
    in property <bool> update-install-blocked: false;
    in property <InstallBlockReason> update-install-block-reason;
    callback update-download-requested();
    callback update-install-requested();
    callback update-open-release-requested();
    callback update-dismiss-requested();
    callback update-link-clicked(string);

    // Header + content wrapped together so the gear icon (in `AppHeader`)
    // stays visible and clickable while Settings is open, matching
    // App.svelte's `<header>` staying mounted above `<HomeView>`/
    // `<SettingsView>` alike (see `AppHeader`'s doc comment). Onboarding
    // replaces this whole shell instead of living inside it - same as
    // App.svelte's `{#if showOnboarding} <OnboardingView /> {:else} ...`.
    if !root.onboarding-open: VerticalLayout {
        AppHeader {
            settings-open: root.settings-open;
            model-phase: root.model-runtime-phase;
            
            recording-mode: root.recording-mode;
            model-label: root.header-model-label;
            settings-toggled => {
                if root.settings-open {
                    root.settings-open = false;
                    root.settings-closed();
                } else {
                    root.settings-tab = SettingsTab.transcription;
                    root.settings-instrument-input(SettingsInteraction.open);
                    root.settings-requested();
                }
            }
            theme-toggle-requested => { root.theme-toggle-requested(); }
        }

        Rectangle {
    if root.recording-mode == RecordingMode.idle && root.active-meeting-id == "": IdleView {
        width: 100%;
        height: 100%;
        dictation-shortcut: root.dictation-shortcut;
        // A model unloaded after inactivity can be loaded lazily by Start.
        // The header still says LoadRequired until the FSM actually reaches Ready.
        model-ready: root.model-ready || root.model-runtime-phase == TranscriptionPhase.load-required;
        search-query <=> root.search-query;
        kind-filter: root.kind-filter;
        transcription-status-message: root.transcription-status-message;
        dictation-recovery-text <=> root.dictation-recovery-text;
        meeting-status-message: root.meeting-status-message;
        timeline-groups: root.timeline-groups;
        timeline-is-empty: root.timeline-is-empty;
        timeline-has-matches: root.timeline-has-matches;
        live-meeting-id: root.live-meeting-id;
        expanded-dictation-id <=> root.expanded-dictation-id;
        calendar-enabled: root.settings-calendar-enabled;
        calendar-permission: root.settings-calendar-permission;
        upcoming: root.upcoming-events;
        dictate-requested => { root.dictate-requested(); }
        meeting-requested => { root.meeting-requested(); }
        filter-changed(kind) => { root.filter-changed(kind); }
        search-changed(query) => { root.search-changed(query); }
        dismiss-transcription-status => { root.dismiss-transcription-status(); }
        copy-dictation-recovery => { root.copy-dictation-recovery(); }
        discard-dictation-recovery => { root.discard-dictation-recovery(); }
        dismiss-meeting-status => { root.dismiss-meeting-status(); }
        timeline-item-opened(kind, id) => { root.timeline-item-opened(kind, id); }
        timeline-item-removed(kind, id) => { root.timeline-item-removed(kind, id); }
        timeline-item-copy-requested(text) => { root.timeline-item-copy-requested(text); }
        calendar-setup-requested => {
            root.settings-tab = SettingsTab.meetings;
            root.settings-instrument-input(SettingsInteraction.open);
            root.settings-requested();
        }
        calendar-event-start-requested(id) => { root.calendar-event-start-requested(id); }
    }

    if root.recording-mode == RecordingMode.idle && root.active-meeting-id != "": MeetingDetail {
        width: 100%;
        height: 100%;
        title: root.meeting-detail-title;
        meta-line: root.meeting-detail-meta;
