        can-resume: root.meeting-detail-can-resume;
        resume-error: root.meeting-detail-resume-error;
        delete-error: root.meeting-detail-delete-error;
        back-requested => { root.meeting-detail-back(); }
        resume-requested => { root.meeting-detail-resume(); }
        summarize-requested => { root.meeting-detail-summarize(); }
        copy-summary-requested => { root.meeting-detail-copy-summary(); }
        delete-requested => { root.meeting-detail-delete(); }
        rename-requested(title) => { root.meeting-detail-rename(title); }
        notes-changed(value) => { root.meeting-detail-notes-changed(value); }
        audio-play-pause-requested => { root.meeting-detail-audio-play-pause-requested(); }
        audio-seek-requested(fraction) => { root.meeting-detail-audio-seek-requested(fraction); }
        transcript-paragraph-clicked(session, time) => { root.meeting-detail-transcript-paragraph-clicked(session, time); }
        transcript-alias-save-requested(term, pronunciation) => { root.meeting-detail-transcript-alias-save-requested(term, pronunciation); }
    }

    if root.recording-mode != RecordingMode.idle: rv := RecordingView {
        width: 100%;
        height: 100%;
        mode: root.recording-mode;
        live-text: root.live-text;
        live-tentative: root.live-tentative;
        live-transcript-blocks: root.live-transcript-blocks;
