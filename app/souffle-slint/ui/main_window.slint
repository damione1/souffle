        summary-template-prompt-changed(value) => { root.settings-summary-template-prompt-changed(value); }
        summary-template-add-requested(name) => { root.settings-summary-template-add-requested(name); }
        model-changed(value) => { root.settings-model-changed(value); }
        unload-timeout-changed(value) => { root.settings-unload-timeout-changed(value); }
        dictation-learn-from-edit-changed(value) => { root.settings-dictation-learn-from-edit-changed(value); }
        dictionary-add-requested(term, pronunciation, category) => { root.settings-dictionary-add-requested(term, pronunciation, category); }
        dictionary-delete-requested(id) => { root.settings-dictionary-delete-requested(id); }
        snippet-add-requested(trigger, expansion) => { root.settings-snippet-add-requested(trigger, expansion); }
        snippet-delete-requested(id) => { root.settings-snippet-delete-requested(id); }
        snippet-edit-requested(id) => { root.settings-snippet-edit-requested(id); }
        snippet-cancel-edit-requested => { root.settings-snippet-cancel-edit-requested(); }
        snippet-save-edit-requested(id, trigger, expansion) => { root.settings-snippet-save-edit-requested(id, trigger, expansion); }
    }
        }
    }

    // Drawn last of all: the first-run wizard takes over the whole window
    // until finished, above even the Settings overlay (the two are never
    // open at the same time in practice, but this ordering is the honest
    // one if they ever were).
    if root.onboarding-open: OnboardingView {
        width: 100%;
        height: 100%;
        locale: root.settings-locale;
        step-index: root.onboarding-step-index;
        step-count: root.onboarding-step-count;
        step: root.onboarding-step;
        status-message: root.onboarding-status-message;
        permission-rows: root.onboarding-permission-rows;
        permissions-error: root.onboarding-permissions-error;
        repair-busy: root.onboarding-repair-busy;
        repair-success: root.onboarding-repair-success;
        repair-cooldown: root.onboarding-repair-cooldown;
        device-labels: root.onboarding-device-labels;
        selected-device-label: root.onboarding-selected-device-label;
        model-phase: root.onboarding-model-phase;
        model-labels: root.onboarding-model-labels;
        selected-model-label: root.onboarding-selected-model-label;
        download-progress-label: root.onboarding-download-progress-label;
        download-progress-fraction: root.onboarding-download-progress-fraction;
        toggle-shortcut-label: root.onboarding-toggle-shortcut-label;
        shortcut-recording: root.onboarding-shortcut-recording;
        shortcut-error: root.onboarding-shortcut-error;
        auto-paste: root.onboarding-auto-paste;
        accessibility-granted: root.onboarding-accessibility-granted;
        busy: root.onboarding-busy;
        continue-enabled: root.onboarding-continue-enabled;
        locale-changed(value) => { root.onboarding-locale-changed(value); }
        grant-requested(kind) => { root.onboarding-grant-requested(kind); }
        hint-action-requested(kind) => { root.onboarding-hint-action-requested(kind); }
        repair-requested => { root.onboarding-repair-requested(); }
        device-changed(value) => { root.onboarding-device-changed(value); }
        refresh-devices-requested => { root.onboarding-refresh-devices-requested(); }
        model-picked(value) => { root.onboarding-model-picked(value); }
        shortcut-record-requested => { root.onboarding-shortcut-record-requested(); }
        shortcut-captured(text, ctrl, shift, alt, meta) => { root.onboarding-shortcut-captured(text, ctrl, shift, alt, meta); }
        shortcut-released(text, ctrl, shift, alt, meta) => { root.onboarding-shortcut-released(text, ctrl, shift, alt, meta); }
        shortcut-cleared => { root.onboarding-shortcut-cleared(); }
        shortcut-cancelled => { root.onboarding-shortcut-cancelled(); }
        auto-paste-changed(value) => { root.onboarding-auto-paste-changed(value); }
        review-accessibility-requested => { root.onboarding-review-accessibility-requested(); }
        back-requested => { root.onboarding-back-requested(); }
        continue-requested => { root.onboarding-continue-requested(); }
    }

    if root.settings-permissions-dialog-open: SettingsPermissionsDialog {
        width: 100%;
        height: 100%;
        rows: root.onboarding-permission-rows;
        error-message: root.onboarding-permissions-error;
        repair-busy: root.onboarding-repair-busy;
        repair-success: root.onboarding-repair-success;
        repair-cooldown: root.onboarding-repair-cooldown;
        close-requested => { root.settings-permissions-dialog-open = false; }
        grant-requested(kind) => { root.onboarding-grant-requested(kind); }
        hint-action-requested(kind) => { root.onboarding-hint-action-requested(kind); }
        repair-requested => { root.onboarding-repair-requested(); }
    }

    if root.whats-new-open: WhatsNewDialog {
        width: 100%;
        height: 100%;
        version: root.whats-new-version;
        content-blocks: root.whats-new-content-blocks;
        dismissed => {
            root.whats-new-open = false;
            root.whats-new-dismissed();
        }
        link-clicked(url) => { root.whats-new-link-clicked(url); }
    }

    if root.update-available-open: UpdateAvailableDialog {
        width: 100%;
        height: 100%;
        latest-version: root.update-latest-version;
        release-notes-blocks: root.update-release-notes-blocks;
        phase: root.update-phase;
        error-message: root.update-error-message;
        install-blocked: root.update-install-blocked;
        install-block-reason: root.update-install-block-reason;
        download-requested => { root.update-download-requested(); }
        install-requested => { root.update-install-requested(); }
        open-release-requested => { root.update-open-release-requested(); }
        dismiss-requested => {
            root.update-available-open = false;
            root.update-dismiss-requested();
        }
        link-clicked(url) => { root.update-link-clicked(url); }
    }
}
