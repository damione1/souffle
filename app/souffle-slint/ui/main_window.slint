import { IdleView } from "idle_view.slint";
import { RecordingView } from "recording_view.slint";
import { MeetingDetail } from "meeting_detail.slint";
import { SettingsView } from "settings_view.slint";
import { OnboardingView } from "onboarding_view.slint";
import { PermissionRow } from "components/onboarding/permissions_step.slint";
import { SettingsPermissionsDialog } from "components/settings/settings_permissions_dialog.slint";
import { WhatsNewDialog } from "components/onboarding/whats_new_dialog.slint";
import { UpdateAvailableDialog } from "components/onboarding/update_available_dialog.slint";
import { MarkdownBlock } from "components/onboarding/markdown_block.slint";
import { CalendarRow } from "components/settings/calendar_section.slint";
import { MicrophoneRow } from "components/settings/microphone_section.slint";
import { DictionaryRow } from "components/settings/dictionary_section.slint";
import { SnippetRow } from "components/settings/snippets_section.slint";
import { TimelineDayGroup, UpcomingEvent } from "components/timeline_section.slint";
import { TranscriptBlock } from "components/transcript_section.slint";
import { StructuredActionItem } from "components/summary_section.slint";
import { RecordingMode, LiveSystemAudio, SpeakerRole, TimelineFilter, TimelineKind, NotesSaveState, ModelPhase, TranscriptionPhase, UpcomingPhase, SettingsTab, SettingsInteraction, AppTheme, AppLocale, PasteMethod, MeetingLanguage, LogLevel, AudioRetention, AccessState, PermissionKind, ShortcutField, SummaryProvider, AppleIntelligenceUnavailableReason, OnboardingStep, UpdatePhase, InstallBlockReason } from "types.slint";
export { SettingsTab, SettingsInteraction, AppTheme, AppLocale, PasteMethod, MeetingLanguage, LogLevel, AudioRetention, AccessState, PermissionKind, ShortcutField, SummaryProvider, AppleIntelligenceUnavailableReason, SpeakerRole }
import { Theme } from "theme.slint";
// Re-exported (not just imported) so Slint's codegen generates a Rust
// accessor for it (`window.global::<Theme>()`) - main.rs sets `Theme.dark`
// at launch and on every theme toggle. A plain `import` alone is enough for
// every other `.slint` file to read `Theme.canvas` etc., but not for Rust
// to reach the global at all.
export { Theme }
import { AppHeader } from "components/app_header.slint";

// Self-hosted variable fonts from src/app.css, instantiated to static
// per-weight TTFs (scripts/... none checked in - see the ticket notes: Slint
// 1.17's renderer wants static instances, not a single variable font) so
// `font-family: "Archivo SemiBold"` etc. resolve to the right weight instead
// of the variable font's own default instance (600, SemiBold - which is
// what every unweighted Text would render as if only one file were embedded).
import "assets/fonts/archivo-regular.ttf";
import "assets/fonts/archivo-medium.ttf";
import "assets/fonts/archivo-semibold.ttf";
import "assets/fonts/archivo-bold.ttf";
import "assets/fonts/jetbrains-mono.ttf";

export component MainWindow inherits Window {
    title: @tr("Soufflé");
    // SOU-242: bumped from the original Tauri window (860x1040, still in
    // tauri.conf.json for the retired frontend) - onboarding/permissions and
    // the home view rendered visibly cramped at the old default on a fresh
    // install with no saved geometry yet (`window_width`/`window_height` in
    // `AppSettings::default()`, applied via `with_inner_size` in
    // `main.rs::main()`). This `preferred-*` pair is the value actually used
    // outside the macOS `with_inner_size` hook (non-macOS dev builds); keep
    // it in sync with `AppSettings::default()`. Home content still caps at a
    // 720px column (idle_view.slint) and onboarding at 512px
    // (onboarding_view.slint), so the extra width only adds side margin -
    // the fix is mainly the extra height. `min-width`/`min-height` are the
    // user-resizable floor (SOU-219) and are unrelated to this default.
    preferred-width: 1040px;
    preferred-height: 1280px;
    min-width: 680px;
    min-height: 560px;
    default-font-family: "Archivo";
    default-font-size: 14px;
    background: Theme.canvas;

    in property <string> dictation-shortcut;
    in property <TranscriptionPhase> model-runtime-phase: TranscriptionPhase.download-required;
    out property <bool> model-ready: root.model-runtime-phase == TranscriptionPhase.ready;
    in-out property <string> search-query;
    in-out property <TimelineFilter> kind-filter: TimelineFilter.all;
    in property <string> transcription-status-message;
    in property <string> meeting-status-message;
    in property <[TimelineDayGroup]> timeline-groups;
    in property <bool> timeline-is-empty: true;
    in property <bool> timeline-has-matches: true;
    in property <string> live-meeting-id;
    in-out property <string> expanded-dictation-id;
    in property <[UpcomingEvent]> upcoming-events;
    // Rust-driven, set after a real start/stop command succeeds, never
    // optimistically from the UI alone.
    in-out property <RecordingMode> recording-mode: RecordingMode.idle;
    in-out property <string> live-text;
    in-out property <string> live-tentative;
    in-out property <string> dictation-recovery-text;
    in property <[TranscriptBlock]> live-transcript-blocks;
    in property <bool> live-transcript-empty: true;
    in property <int> live-elapsed-offset-seconds: 0;
    in-out property <length> live-transcript-scroll-top: 0px;
    out property <float> live-transcript-scroll-top-px: root.live-transcript-scroll-top / 1px;
    in-out property <float> live-transcript-content-height;
    in-out property <float> live-transcript-viewport-height;
    in property <float> audio-level: 0.0;
    // Polled from souffle_lib's live system-audio snapshot while a meeting
    // records (main.rs). Not derived from Settings: the Settings flags say
    // what was *asked for*, not whether the tap actually came up.
    in property <LiveSystemAudio> live-system-audio: LiveSystemAudio.pending;
    in-out property <string> live-notes;

    // Non-empty while a completed meeting is open in MeetingDetail. Empty
    // means "show the Timeline instead" - checked together with
    // recording-mode below so a live meeting always shows RecordingView
    // first, never MeetingDetail underneath it.
    in-out property <string> active-meeting-id;
    in property <string> meeting-detail-title;
    in property <string> meeting-detail-meta;
    in property <string> meeting-detail-model-label;
    in property <[string]> meeting-detail-participants;
    in-out property <string> meeting-detail-notes;
    in property <NotesSaveState> meeting-detail-notes-save-state;
    in property <bool> meeting-detail-has-audio;
    in property <bool> meeting-detail-audio-is-playing;
    in property <[float]> meeting-detail-audio-peaks;
    in property <float> meeting-detail-audio-progress;
    in property <string> meeting-detail-audio-position-label;
    in property <string> meeting-detail-audio-duration-label;
    in property <[TranscriptBlock]> meeting-detail-transcript-blocks;
    in property <int> meeting-detail-transcript-segment-count;
    in property <float> meeting-detail-transcript-spacer-before: 0.0;
    in property <float> meeting-detail-transcript-spacer-after: 0.0;
    // `length`-typed so it can two-way bind all the way down to the real
    // Flickable inside TranscriptSection (see that component's doc comment
    // on `scroll-top`) - internal plumbing only, not read directly by Rust.
    in-out property <length> meeting-detail-transcript-scroll-top: 0px;
    // What `main.rs` actually polls on a timer to decide the next visible
    // slice (AC15): the same value as above, converted to a plain float so
    // Rust doesn't need Slint's internal `length`-wrapping type.
    out property <float> meeting-detail-transcript-scroll-top-px: root.meeting-detail-transcript-scroll-top / 1px;
    in property <string> meeting-detail-summary;
    in property <bool> meeting-detail-summary-is-stale;
    in property <string> meeting-detail-summary-model-label;
    in property <[string]> meeting-detail-summary-key-points;
    in property <[string]> meeting-detail-summary-decisions;
    in property <[StructuredActionItem]> meeting-detail-summary-action-items;
    in property <[string]> meeting-detail-summary-open-questions;
    in property <bool> meeting-detail-summary-is-generating: false;
    in property <string> meeting-detail-summary-generation-progress: "";
    in property <string> meeting-detail-summary-generation-error: "";
    in property <[string]> meeting-detail-summary-available-models;
    in property <[string]> meeting-detail-summary-available-model-ids;
    in-out property <string> meeting-detail-summary-selected-model-id;
    in-out property <string> meeting-detail-summary-selected-model-label;
    in property <bool> meeting-detail-can-resume: false;
    in property <string> meeting-detail-resume-error: "";
    in property <string> meeting-detail-delete-error: "";

    // SOU-188: Settings overlay. Toggled from IdleView's gear button;
    // `settings-requested` (not a plain property flip) because opening it
    // must first load the real settings from disk (see main.rs) - closing
    // needs no such round trip, so `settings-open` alone is enough there.
    in-out property <bool> settings-open: false;
    in-out property <bool> settings-permissions-dialog-open: false;
    // The gear opens Transcription; the homepage calendar CTA opens Meetings.
    in-out property <SettingsTab> settings-tab: SettingsTab.transcription;
    in property <bool> settings-autostart-enabled;
    in property <bool> settings-debug-transcription;
    in property <LogLevel> settings-log-level;
    // SOU-224: virtualized live-log tail. Rust owns the full line list and
    // only pushes the visible slice + estimated spacers, same pattern as
    // `meeting-detail-transcript-*` above.
    in property <[string]> settings-log-lines;
    in property <int> settings-log-line-count;
    in property <float> settings-log-spacer-before: 0.0;
    in property <float> settings-log-spacer-after: 0.0;
    in-out property <length> settings-log-scroll-top: 0px;
    // What `main.rs` polls to decide the next visible slice - same
    // float-conversion trick as `meeting-detail-transcript-scroll-top-px`.
    out property <float> settings-log-scroll-top-px: root.settings-log-scroll-top / 1px;
    in property <bool> settings-copying-diagnostics;
    in property <AppTheme> settings-theme;
    in property <AppLocale> settings-locale;
    in property <bool> settings-auto-paste;
    in property <PasteMethod> settings-paste-method;
    in property <int> settings-paste-delay-ms;
    in property <int> settings-paste-delay-min;
    in property <int> settings-paste-delay-max;
    in property <bool> settings-pill-hidden;
    in property <bool> settings-feedback-sounds-enabled;
    in property <int> settings-feedback-sounds-volume;
    in property <int> settings-feedback-sounds-volume-min;
    in property <int> settings-feedback-sounds-volume-max;
    in property <string> settings-toggle-shortcut-label;
    in property <string> settings-ptt-shortcut-label;
    in property <bool> settings-native-tap-warning-visible;
    in-out property <ShortcutField> settings-recording-field: ShortcutField.none;
    in-out property <string> settings-shortcut-error: "";
    in property <string> settings-save-error;
    in property <bool> settings-save-error-unavailable;
    in property <string> settings-draft-save-error;
    in property <bool> settings-draft-save-error-unavailable;
    in property <bool> settings-calendar-enabled;
    in property <AccessState> settings-calendar-permission;
    in property <bool> settings-calendar-autostart-enabled;
    in property <int> settings-calendar-reminder-minutes;
    in property <int> settings-calendar-reminder-minutes-min;
    in property <int> settings-calendar-reminder-minutes-max;
    in property <[CalendarRow]> settings-calendars;
    in property <[string]> settings-audio-device-labels;
    in property <string> settings-selected-device-label;
    in property <bool> settings-pin-unavailable;
    in property <string> settings-sample-rate-label;
    in property <bool> settings-sample-rate-high;
    in property <bool> settings-resetting-sample-rate;
    in property <bool> settings-allow-bluetooth-mic;
    in property <[MicrophoneRow]> settings-microphones;
    in property <bool> settings-has-disconnected-devices;
    in property <bool> settings-is-laptop;
    in property <[string]> settings-clamshell-device-labels;
    in property <string> settings-clamshell-device-label;
    in property <bool> settings-system-audio-supported;
    in property <bool> settings-capture-system-audio;
    in property <MeetingLanguage> settings-meeting-transcription-language;
    in property <bool> settings-meeting-autostop-enabled;
    in property <[string]> settings-meeting-autostop-labels;
    in property <string> settings-meeting-autostop-label;
    in property <[string]> settings-meeting-max-duration-labels;
    in property <string> settings-meeting-max-duration-label;
    in property <bool> settings-vad-enabled;
    in property <bool> settings-filler-removal;
    in property <bool> settings-stutter-collapse;
    in property <bool> settings-dictionary-correction;
    in property <string> settings-data-stats-line;
    in property <string> settings-data-recordings-line;
    in property <AudioRetention> settings-meeting-audio-retention;
    in property <bool> settings-data-exporting;
    in property <string> settings-data-export-status;
    in property <bool> settings-data-export-status-is-error;
    in property <string> settings-mcp-binary-path;
    in property <bool> settings-mcp-exists;
    in property <string> settings-mcp-claude-desktop-snippet;
    in property <string> settings-mcp-claude-code-command;
    in property <bool> settings-testing-mcp;
    in property <string> settings-mcp-test-status;
    in property <string> settings-app-version;
    in property <string> settings-about-transcription-label;
    in property <string> settings-about-summary-label;
    in property <bool> settings-auto-update-check;
    in property <bool> settings-checking-updates;
    in property <string> settings-update-status;
    in property <SummaryProvider> settings-summary-provider;
    in property <bool> settings-apple-intelligence-available;
    in property <AppleIntelligenceUnavailableReason> settings-apple-intelligence-reason: AppleIntelligenceUnavailableReason.unknown;
    in property <string> settings-ollama-url;
    in property <bool> settings-ollama-available;
    in property <bool> settings-ollama-checking;
    in property <int> settings-summary-model-count;
    in property <bool> settings-summary-model-picker-visible;
    in property <[string]> settings-summary-model-ids;
    in property <[string]> settings-summary-model-labels;
    in property <string> settings-selected-summary-model-label;
    in property <bool> settings-show-ollama-setup;
    in property <bool> settings-ollama-pulling;
    in property <string> settings-ollama-pull-status;
    in property <string> settings-ollama-pull-error;
    in property <string> settings-recommended-ollama-model;
    in property <string> settings-summary-refresh-error;
    in property <string> settings-summary-unusable-message;
    in property <bool> settings-dictation-polish-enabled;
    in property <bool> settings-dictation-polish-provider-available;
    in property <[string]> settings-dictation-polish-template-ids;
    in property <[string]> settings-dictation-polish-template-labels;
    in property <string> settings-active-dictation-polish-label;
    in-out property <string> settings-active-dictation-polish-prompt;
    in property <[string]> settings-summary-template-ids;
    in property <[string]> settings-summary-template-labels;
    in property <string> settings-default-summary-template-label;
    in property <string> settings-editing-summary-template-label;
    in property <bool> settings-editing-summary-template-is-builtin;
    in-out property <string> settings-editing-summary-template-name;
    in-out property <string> settings-editing-summary-template-prompt;
    in-out property <string> settings-new-summary-template-draft: "";
    in property <[string]> settings-model-labels;
    in property <string> settings-selected-model-label;
    // Bare model label ("STT 1B FR/EN") for AppHeader's status pill - kept
    // separate from `settings-selected-model-label` above, which is the
    // combined "Engine — Model" form the settings picker needs to
    // disambiguate engines (matches App.svelte's StatusChip reading
    // `findTranscriptionModel(...)?.label` instead of
    // `listAvailableModelOptions()`'s flat label).
    in property <string> header-model-label;
    out property <bool> settings-model-busy: root.model-runtime-phase == TranscriptionPhase.downloading
        || root.model-runtime-phase == TranscriptionPhase.loading
        || root.model-runtime-phase == TranscriptionPhase.unloading;
    out property <bool> settings-model-downloading: root.model-runtime-phase == TranscriptionPhase.downloading;
    in property <string> settings-model-download-progress-label;
    in property <float> settings-model-download-progress-fraction;
    in property <[string]> settings-unload-timeout-labels;
    in property <string> settings-unload-timeout-label;
    in property <string> settings-model-error-message;
    in property <bool> settings-dictation-learn-from-edit;
    // Windowed slice of the dictionary, not the full list (SOU-229) - same
    // spacer/scroll-mirror plumbing as `meeting-detail-transcript-*` above:
    // `lists_ui.rs` polls the `-px` mirror and pushes the next slice.
    in property <[DictionaryRow]> settings-dictionary-entries;
    in property <int> settings-dictionary-count: 0;
    in property <float> settings-dictionary-content-height: 0.0;
    in property <float> settings-dictionary-spacer-before: 0.0;
    in property <float> settings-dictionary-spacer-after: 0.0;
    in-out property <length> settings-dictionary-scroll-top: 0px;
    out property <float> settings-dictionary-scroll-top-px: root.settings-dictionary-scroll-top / 1px;
    in property <string> settings-dictionary-add-error;
    in property <int> settings-dictionary-delete-error-id;
    in property <string> settings-dictionary-delete-error;
    in-out property <string> settings-new-dictionary-term-draft: "";
    in-out property <string> settings-new-dictionary-pronunciation-draft: "";
    in-out property <string> settings-new-dictionary-category-draft: "";
    // Same SOU-229 windowing plumbing as `settings-dictionary-*`.
    in property <[SnippetRow]> settings-snippets;
    in property <int> settings-snippets-count: 0;
    in property <float> settings-snippets-content-height: 0.0;
    in property <float> settings-snippets-spacer-before: 0.0;
    in property <float> settings-snippets-spacer-after: 0.0;
    in-out property <length> settings-snippets-scroll-top: 0px;
    out property <float> settings-snippets-scroll-top-px: root.settings-snippets-scroll-top / 1px;
    in property <string> settings-snippet-add-error;
    in property <int> settings-snippet-delete-error-id;
    in property <string> settings-snippet-delete-error;
    in property <string> settings-snippet-update-error;
    in-out property <string> settings-new-snippet-trigger-draft: "";
    in-out property <string> settings-new-snippet-expansion-draft: "";
    in-out property <string> settings-edit-snippet-trigger-draft: "";
    in-out property <string> settings-edit-snippet-expansion-draft: "";

    callback settings-requested();
    callback settings-instrument-input(SettingsInteraction);
    callback settings-tab-changed();
    callback settings-closed();
