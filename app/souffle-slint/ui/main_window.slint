    // Invoked by `main.rs` (as `invoke_reset_meeting_detail_transcript_scroll`)
    // when a different meeting's transcript loads, so scrolling meeting A
    // down doesn't leave meeting B's transcript scrolled down too - a
    // `public function` rather than a Rust-side property write, since the
    // property below needs `length`, which isn't part of Slint's stable
    // Rust API (see the doc comment on it).
    public function reset-meeting-detail-transcript-scroll() {
        root.meeting-detail-transcript-scroll-top = 0px;
    }

    // SOU-190: first-run wizard, drawn above everything else while visible -
    // same overlay-not-replace pattern as `settings-open`.
