import { NotesSaveState, MeetingExportFormat } from "types.slint";
import { ThemedLineEdit } from "components/themed_line_edit.slint";
import { AudioPlayerSection } from "components/audio_player_section.slint";
import { TranscriptSection, TranscriptBlock } from "components/transcript_section.slint";
import { SummarySection, StructuredActionItem } from "components/summary_section.slint";
import { LucideIcon, IconSet } from "components/lucide_icon.slint";
import { ThemedTextArea } from "components/themed_text_area.slint";
import { ThemedButton, ThemedButtonKind } from "components/themed_button.slint";
import { Theme } from "theme.slint";

// Port of MeetingHeaderSection.svelte + MeetingNotesSection.svelte -
// completed-meeting variant only. The live-recording variant of
// MeetingHeaderSection (stop button, recording badge, system-audio notice)
// is out of scope: this app shows RecordingView instead while a meeting is
// live (see main_window.slint), never this component.
//
// Milestones 6-9 scope, said here rather than hidden: header (title,
// rename, date/duration/segment count, participants) + notes (load, edit,
// debounced autosave) + native audio playback/waveform + read-only
// transcript with speaker labels, virtualized for long meetings +
// summary (raw + structured, generation included, Copy) + whole-meeting
// export (Markdown/JSON/SRT/VTT through the native save panel), audio
// download and a transcript "Copy" (SOU-195-slice) + resume + delete. Not
// yet ported: transcript bulk/per-word edit (the "Edit" affordance next to
// the Transcription title - a materially bigger feature than copy/export,
// left for its own ticket).
//
// Parts of the header meta line (date, duration, segment and session
// counts). Zero-padded strings from Rust; the order and wording are @tr()
// patterns below, so English can read the date month-first (SOU-246).
export struct MeetingMeta {
    day: string,
    month: string,
    year: string,
    hour: string,
    minute: string,
    duration: string,
    segments: int,
    sessions: int,
}

// One invitee of the meeting's calendar event. The "(organisateur)" /
// "(vous)" suffixes are added here, behind @tr(), not by Rust (SOU-246).
export struct MeetingParticipantChip {
    name: string,
    is-organizer: bool,
    is-current-user: bool,
}

// One entry of the header's Export menu (MeetingHeaderSection.svelte's
// dropdown rows). `highlighted` is the keyboard cursor, hover is local.
component ExportMenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> highlighted: false;
    callback chosen();

    height: 30px;
    vertical-stretch: 0;
    border-radius: 3px;
    background: root.highlighted || row-area.has-hover ? Theme.surface-2 : transparent;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.label;
        font-size: 12.5px;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component MeetingDetail inherits Rectangle {
    in property <string> title;
    in property <MeetingMeta> meta;
    in property <string> model-label;
    in property <[MeetingParticipantChip]> participants;
    in-out property <string> notes;
    in property <NotesSaveState> notes-save-state;
    in property <bool> has-audio: false;
    in property <bool> audio-is-playing: false;
    in property <[float]> audio-peaks;
    in property <float> audio-progress;
    in property <string> audio-position-label;
    in property <string> audio-duration-label;
    in property <[TranscriptBlock]> transcript-blocks;
    in property <int> transcript-segment-count;
    in property <float> transcript-spacer-before: 0.0;
    in property <float> transcript-spacer-after: 0.0;
    in-out property <length> transcript-scroll-top: 0px;
    // The page's own single-scroll region (SOU-243) - unlike
    // transcript-scroll-top above, this has no reason to persist any
    // particular position across meetings, but MeetingDetail is a
    // keep-alive component (reused, not recreated, per meeting), so
    // page-scroll's Flickable would otherwise keep whatever scroll
    // offset was last left on it. Exposed so main_window.slint can reset
    // it to 0px on navigation, the same way it already resets
    // meeting-detail-transcript-scroll-top.
    in-out property <length> page-scroll-top: 0px;
    in property <string> summary;
    in property <bool> summary-is-stale: false;
    in property <string> summary-model-label;
    in property <[string]> summary-key-points;
    in property <[string]> summary-decisions;
    in property <[StructuredActionItem]> summary-action-items;
    in property <[string]> summary-open-questions;
    in property <bool> summary-is-generating: false;
    in property <string> summary-generation-progress: "";
    in property <string> summary-generation-error: "";
    in property <[string]> summary-available-models;
    in property <[string]> summary-available-model-ids;
    in-out property <string> summary-selected-model-id;
    in-out property <string> summary-selected-model-label;
    in property <bool> can-resume: true;
    in property <string> resume-error;
    // Why the last delete failed; empty otherwise. On success Rust closes
    // the view, so there is no success state to show here.
    in property <string> delete-error;
    in property <string> export-error;
    in property <string> audio-export-error;

    callback back-requested();
    callback resume-requested();
    callback summarize-requested();
    callback copy-summary-requested();
    // Confirmed by the user through the inline two-step row below.
    callback delete-requested();
    callback rename-requested(string);
    callback notes-changed(string);
    callback audio-play-pause-requested();
    callback audio-seek-requested(float);
    callback transcript-paragraph-clicked(int, float);
    callback transcript-alias-save-requested(string, string);
    // Whole-meeting export (notes + summary + transcript) to a file the
    // user picks via the native save panel (SOU-195-slice, SOU-191's
    // dialog). `format` is the export's file format, not the confirmed
    // path - Rust owns the save panel end to end.
    callback export-requested(MeetingExportFormat);
    // Copy recorded audio session(s) to a file via the same native panel.
    callback export-audio-requested();
    // Copy just the transcript text to the pasteboard.
    callback copy-transcript-requested();

    property <bool> editing-title: false;
    property <string> title-draft;
    property <bool> confirming-delete: false;

    function confirm-delete() {
        root.confirming-delete = false;
        root.delete-requested();
    }
    property <bool> is-empty-meeting: !root.has-audio && root.transcript-segment-count == 0 && root.summary == "";
    // Export menu (MeetingHeaderSection.svelte's EXPORT_FORMATS + the
    // audio entry): rows 0-3 are the file formats, row 4 the recorded audio,
    // only listed when there is audio. `export-highlighted` is the keyboard
    // cursor while the menu is open.
    property <int> export-item-count: root.has-audio ? 5 : 4;
    property <int> export-highlighted: 0;


    function commit-title(value: string) {
        // `accepted` (Enter) removes the field, which then also reports a
        // focus loss: only the first of the two may commit.
        if !root.editing-title { return; }
        root.editing-title = false;
        if (value != "" && value != root.title) {
            root.rename-requested(value);
        }
    }

    // Click-away focus sink. A plain `TouchArea` click does not move
    // keyboard focus in Slint, so without this the title field or the notes
    // editor kept focus (and its highlighted border) after the user clicked
    // somewhere else on the page. Declared before `content` so it sits
    // underneath it: it only receives clicks nothing in the page handled.
    focus-sink := FocusScope {
        width: 0px;
        height: 0px;
    }
    TouchArea {
        clicked => { focus-sink.focus(); }
    }

    content := VerticalLayout {
        width: min(root.width - 52px, 720px);
        height: root.height;
        x: (root.width - self.width) / 2;
        padding-top: 26px;
        padding-bottom: 34px;
        spacing: 14px;

        back-btn := Rectangle {
            height: 28px;
            vertical-stretch: 0;

            border-radius: 4px;
            border-width: back-focus.has-focus ? 2px : 0px;
            border-color: Theme.accent;
            background: back-area.pressed ? Theme.surface-3 : back-area.has-hover ? Theme.surface-2 : transparent;

            accessible-role: button;
            accessible-label: @tr("Retour \u{e0} l'historique");
            accessible-action-default => { root.back-requested(); }

            forward-focus: back-focus;
            back-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        root.back-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            back-area := TouchArea {
                clicked => {
                    back-focus.focus();
                    root.back-requested();
                }
            }

            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                height: 18px;
                spacing: 8px;
                alignment: start;
                LucideIcon {
                    width: 18px;
                    height: 18px;
                    icon: IconSet.ArrowLeft;
                    icon-color: Theme.text-secondary;
                }
                Text {
                    text: @tr("Historique");
                    font-size: 13px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            spacing: 14px;
            vertical-stretch: 0;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 14px;

                if !root.editing-title: title-btn := Rectangle {
                    height: 34px;
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    border-radius: 4px;
                    border-width: title-focus.has-focus ? 2px : 0px;
                    border-color: Theme.accent;
                    background: title-area.has-hover ? Theme.surface-2 : transparent;

                    accessible-role: button;
                    accessible-label: @tr("Renommer la r\u{e9}union");
                    accessible-action-default => {
                        root.title-draft = root.title;
                        root.editing-title = true;
                    }

                    forward-focus: title-focus;
                    title-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == Key.Return || event.text == Key.Space {
                                root.title-draft = root.title;
                                root.editing-title = true;
                                return accept;
                            }
                            return reject;
                        }
                    }

                    title-area := TouchArea {
                        clicked => {
                            title-focus.focus();
                            root.title-draft = root.title;
                            root.editing-title = true;
                        }
                    }

                    Text {
                        // Pinned to the left edge: without an explicit x/width a
                        // Text child is centred in this full-width hover box, which
                        // is what pushed the title right of "History" and the meta
                        // line below (SOU-241 AC1, seen live).
                        x: 0px;
                        width: parent.width;
                        text: root.title;
                        font-family: "Archivo SemiBold";
                        font-size: 24px;
                        font-weight: 700;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                // Created on demand, so `init` is the moment the user just
                // asked to rename: focus the field right away instead of
                // making them click into it a second time.
                if root.editing-title: ThemedLineEdit {
                    text <=> root.title-draft;
                    control-label: @tr("Titre de la réunion");
                    text-size: 22px;
                    init => { self.focus(); }
                    accepted(value) => { root.commit-title(value); }
                    // MeetingHeaderSection.svelte commits on blur too, so
                    // clicking anywhere else ends the edit instead of leaving
                    // a focused field stranded in the header.
                    focus-lost(value) => { root.commit-title(value); }
                }

                HorizontalLayout {
                    height: 26px;
                    vertical-stretch: 0;
                    spacing: 9px;
                    alignment: start;

                    Text {
                        text: root.meta.sessions > 1
                            ? @tr("{0}/{1}/{2} {3}:{4} · {5} · {6} segments · {7} sessions", root.meta.day, root.meta.month, root.meta.year, root.meta.hour, root.meta.minute, root.meta.duration, root.meta.segments, root.meta.sessions)
                            : @tr("{0}/{1}/{2} {3}:{4} · {5} · {6} segments", root.meta.day, root.meta.month, root.meta.year, root.meta.hour, root.meta.minute, root.meta.duration, root.meta.segments);
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    if root.model-label != "": Rectangle {
                        width: model-chip.preferred-width + 16px;
                        height: 24px;
                        horizontal-stretch: 0;
                        border-width: 1px;
                        border-color: Theme.surface-4;

                        model-chip := Text {
                            text: root.model-label;
                            color: Theme.accent;
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // MeetingHeaderSection.svelte's participant row: a Users icon
                // then one outlined chip per name, same 1px square outline
                // as the model chip above. Flexbox so a long invite list
                // wraps instead of overflowing the header.
                if root.participants.length > 0: HorizontalLayout {
                    spacing: 7px;
                    alignment: start;

                    Rectangle {
                        width: 13px;
                        height: 22px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;

                        LucideIcon {
                            size: 13px;
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.Users;
                            icon-color: Theme.text-muted;
                        }
                    }

                    FlexboxLayout {
                        flex-wrap: wrap;
                        spacing: 7px;
                        horizontal-stretch: 1;

                        for participant in root.participants: Rectangle {
                            width: chip-text.preferred-width + 18px;
                            height: 22px;
                            border-width: 1px;
                            border-color: Theme.rule;

                            chip-text := Text {
                                text: participant.is-organizer && participant.is-current-user ? @tr("{} (organisateur) (vous)", participant.name)
                                    : participant.is-organizer ? @tr("{} (organisateur)", participant.name)
                                    : participant.is-current-user ? @tr("{} (vous)", participant.name)
                                    : participant.name;
                                color: Theme.text-tertiary;
                                font-size: 11.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if !root.is-empty-meeting || root.can-resume || root.resume-error != "" || root.export-error != "" || root.audio-export-error != "": VerticalLayout {
                spacing: 8px;
                alignment: start;
                horizontal-stretch: 0;

                // MeetingHeaderSection.svelte: Resume then a ghost
                // "Export" button opening a format menu, on one row.
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    vertical-stretch: 0;

                    if root.can-resume: resume-btn := Rectangle {
                        width: resume-txt.preferred-width + 24px;
                        height: 32px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: 4px;
                        border-width: resume-focus.has-focus ? 2px : 0px;
                        border-color: Theme.text-primary;
                        background: resume-area.pressed ? Theme.accent.darker(0.2) : resume-area.has-hover ? Theme.accent.darker(0.1) : Theme.accent;

                        accessible-role: button;
                        accessible-label: @tr("Reprendre l'enregistrement");
                        accessible-action-default => { root.resume-requested(); }

                        forward-focus: resume-focus;
                        resume-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == Key.Space {
                                    root.resume-requested();
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        resume-area := TouchArea {
                            clicked => {
                                resume-focus.focus();
                                root.resume-requested();
                            }
                        }

                        resume-txt := Text {
                            text: @tr("Reprendre");
                            font-family: "Archivo SemiBold";
                            font-size: 13px;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if !root.is-empty-meeting: export-btn := Rectangle {
                        width: export-content.preferred-width;
                        height: 32px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: 4px;
                        border-width: export-focus.has-focus ? 2px : 0px;
                        border-color: Theme.accent;
                        background: export-area.pressed ? Theme.surface-3 : export-area.has-hover ? Theme.surface-2 : transparent;

                        function choose-export(index: int) {
                            export-menu.close();
                            if index == 0 { root.export-requested(MeetingExportFormat.markdown); }
                            if index == 1 { root.export-requested(MeetingExportFormat.json); }
                            if index == 2 { root.export-requested(MeetingExportFormat.srt); }
                            if index == 3 { root.export-requested(MeetingExportFormat.vtt); }
                            if index == 4 && root.has-audio { root.export-audio-requested(); }
                        }

                        function open-export-menu() {
                            root.export-highlighted = 0;
                            export-menu.show();
                        }

                        accessible-role: button;
                        accessible-label: @tr("Exporter la r\u{e9}union");
                        accessible-expandable: true;
                        accessible-expanded: export-menu.is-open;
                        accessible-action-default => { export-btn.open-export-menu(); }
                        accessible-action-expand => { export-btn.open-export-menu(); }

                        forward-focus: export-focus;
                        export-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow {
                                    export-btn.open-export-menu();
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        export-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                export-focus.focus();
                                export-btn.open-export-menu();
                            }
                        }

                        export-content := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Rectangle {
                                width: 14px;
                                horizontal-stretch: 0;
                                LucideIcon {
                                    size: 14px;
                                    y: (parent.height - self.height) / 2;
                                    icon: IconSet.Download;
                                    icon-color: Theme.text-secondary;
                                }
                            }
                            Text {
                                text: @tr("Exporter");
                                font-size: 12.5px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 13px;
                                horizontal-stretch: 0;
                                LucideIcon {
                                    size: 13px;
                                    y: (parent.height - self.height) / 2;
                                    icon: IconSet.ChevronDown;
                                    icon-color: Theme.text-secondary;
                                }
                            }
                        }

                        export-menu := PopupWindow {
                            close-policy: PopupClosePolicy.close-on-click-outside;
                            width: 176px;
                            x: parent.width - self.width;
                            y: parent.height + 6px;
                            forward-focus: export-menu-focus;

                            export-menu-focus := FocusScope {
                                key-pressed(event) => {
                                    if event.text == Key.DownArrow {
                                        root.export-highlighted = min(root.export-item-count - 1, root.export-highlighted + 1);
                                        return accept;
                                    }
                                    if event.text == Key.UpArrow {
                                        root.export-highlighted = max(0, root.export-highlighted - 1);
                                        return accept;
                                    }
                                    if event.text == Key.Return || event.text == Key.Space {
                                        export-btn.choose-export(root.export-highlighted);
                                        export-focus.focus();
                                        return accept;
                                    }
                                    if event.text == Key.Escape {
                                        export-menu.close();
                                        export-focus.focus();
                                        return accept;
                                    }
                                    return reject;
                                }

                                Rectangle {
                                    border-width: 1px;
                                    border-color: Theme.ghost-border;
                                    border-radius: 4px;
                                    background: Theme.surface-1;
                                    accessible-role: list;
                                    accessible-label: @tr("Format d'export");
                                    accessible-item-count: root.export-item-count;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 0px;
                                        alignment: start;

                                        ExportMenuRow {
                                            label: @tr("Markdown (.md)");
                                            highlighted: root.export-highlighted == 0;
                                            chosen => { export-btn.choose-export(0); }
                                        }
                                        ExportMenuRow {
                                            label: @tr("JSON (.json)");
                                            highlighted: root.export-highlighted == 1;
                                            chosen => { export-btn.choose-export(1); }
                                        }
                                        ExportMenuRow {
                                            label: @tr("Sous-titres (.srt)");
                                            highlighted: root.export-highlighted == 2;
                                            chosen => { export-btn.choose-export(2); }
                                        }
                                        ExportMenuRow {
                                            label: @tr("Sous-titres (.vtt)");
                                            highlighted: root.export-highlighted == 3;
                                            chosen => { export-btn.choose-export(3); }
                                        }
                                        if root.has-audio: ExportMenuRow {
                                            label: @tr("Audio (.ogg)");
                                            highlighted: root.export-highlighted == 4;
                                            chosen => { export-btn.choose-export(4); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.export-error != "": Text {
                    text: root.export-error;
                    color: Theme.danger;
                    font-size: 11px;
                    horizontal-alignment: right;
                    wrap: word-wrap;
                }

                if root.audio-export-error != "": Text {
                    text: root.audio-export-error;
                    color: Theme.danger;
                    font-size: 11px;
                    horizontal-alignment: right;
                    wrap: word-wrap;
                }

                if root.resume-error != "": Text {
                    text: root.resume-error;
                    color: Theme.danger;
                    font-size: 11px;
                }
            }
        }

        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.surface-4;
        }

        // Single scroll region (SOU-243 AC1): everything from Notes down is
        // one Flickable, so the page scrolls as a whole instead of Notes/
        // Summary each negotiating their own capped-height inner scroll.
        // The header above (back-btn, title row, divider) lives outside this
        // Flickable and stays on screen (sticky) while this area scrolls.
        // Transcript is the one exception (AC2, see transcript_section.slint):
        // it keeps its own internal virtualized Flickable rather than being
        // flattened into this flow, so long meetings never mount thousands
        // of paragraphs at once.
        page-scroll := Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: page-inner.preferred-height;
            viewport-y <=> root.page-scroll-top;

            // Same click-away sink as the root one, inside the scroller: a
            // Flickable keeps any press its content does not handle, so the
            // root sink never sees clicks made on the page body.
            TouchArea {
                width: parent.viewport-width;
                height: parent.viewport-height;
                clicked => { focus-sink.focus(); }
            }

            page-inner := VerticalLayout {
                width: parent.width - 12px;
                padding-right: 14px;
                spacing: 22px;

                VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        height: 24px;
                        vertical-stretch: 0;
                        spacing: 8px;

                        LucideIcon {
                            width: 18px;
                            height: 18px;
                            icon: IconSet.PenLine;
                            icon-color: Theme.accent;
                        }

                        Text {
                            text: @tr("Notes");
                            font-size: 13px;
                            font-family: "Archivo SemiBold";
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if root.notes-save-state == NotesSaveState.saved: Text {
                            text: @tr("Enregistr\u{e9}");
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        if root.notes-save-state == NotesSaveState.pending: Text {
                            text: @tr("Enregistrement\u{2026}");
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    notes-edit := ThemedTextArea {
                        text <=> root.notes;
                        area-height: 96px;
                        placeholder: @tr("Ajoutez les décisions, actions et noms importants…");
                        control-label: @tr("Notes de la réunion");
                        edited(value) => { root.notes-changed(value); }
                    }

                    Text {
                        text: @tr("Les notes sont enregistr\u{e9}es avec la r\u{e9}union et am\u{e9}liorent le r\u{e9}sum\u{e9}.");
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                }

                Rectangle {
                    height: 1px;
                    vertical-stretch: 0;
                    background: Theme.surface-4;
                }

                if root.is-empty-meeting: Rectangle {
                    height: 84px;
                    vertical-stretch: 0;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-soft;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 5px;
                        alignment: center;

                        Text {
                            text: @tr("Cette réunion ne contient aucun enregistrement.");
                            font-family: "Archivo SemiBold";
                            font-size: 13px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("Aucun audio, aucune transcription et aucun résumé.");
                            font-size: 11.5px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                    }
                }

                if !root.is-empty-meeting: AudioPlayerSection {
                    vertical-stretch: 0;
                    has-audio: root.has-audio;
                    is-playing: root.audio-is-playing;
                    peaks: root.audio-peaks;
                    progress: root.audio-progress;
                    position-label: root.audio-position-label;
                    duration-label: root.audio-duration-label;
                    play-pause-requested => { root.audio-play-pause-requested(); }
                    seek-requested(fraction) => { root.audio-seek-requested(fraction); }
                }

                if !root.is-empty-meeting: TranscriptSection {
                    blocks: root.transcript-blocks;
                    segment-count: root.transcript-segment-count;
                    has-audio: root.has-audio;
                    spacer-before: root.transcript-spacer-before;
                    spacer-after: root.transcript-spacer-after;
                    scroll-top <=> root.transcript-scroll-top;
                    paragraph-clicked(session, time) => { root.transcript-paragraph-clicked(session, time); }
                    background-clicked => { focus-sink.focus(); }
                    alias-save-requested(term, pronunciation) => { root.transcript-alias-save-requested(term, pronunciation); }
                    copy-requested => { root.copy-transcript-requested(); }
                }

                if !root.is-empty-meeting: SummarySection {
                    vertical-stretch: 0;
                    summary: root.summary;
                    summary-is-stale: root.summary-is-stale;
                    summary-model-label: root.summary-model-label;
                    available-models: root.summary-available-models;
                    available-model-ids: root.summary-available-model-ids;
                    selected-model-id <=> root.summary-selected-model-id;
                    selected-model-label <=> root.summary-selected-model-label;
                    key-points: root.summary-key-points;
                    decisions: root.summary-decisions;
                    action-items: root.summary-action-items;
                    open-questions: root.summary-open-questions;
                    is-generating: root.summary-is-generating;
                    generation-progress: root.summary-generation-progress;
                    generation-error: root.summary-generation-error;
                    generate-requested => { root.summarize-requested(); }
                    copy-requested => { root.copy-summary-requested(); }
                }

                // MeetingDetail.svelte's ConfirmAction at the bottom of the
                // page: a danger ghost link, then an inline "are you sure"
                // row (same two-step convention as the timeline's
                // hover-delete, no modal). "Annuler" or Escape drops it.
                // Wrapped in a start-aligned row: a fixed-width child placed
                // straight in this VerticalLayout caps the layout's max width
                // and shrank the whole page column to the link's width.
                HorizontalLayout {
                alignment: start;
                vertical-stretch: 0;

                if !root.confirming-delete: delete-link := Rectangle {
                    width: delete-content.preferred-width + 20px;
                    height: 30px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    border-radius: 4px;
                    border-width: delete-focus.has-focus ? 2px : 0px;
                    border-color: Theme.danger;
                    background: delete-area.pressed ? Theme.danger.with-alpha(0.16) : delete-area.has-hover ? Theme.danger.with-alpha(0.10) : transparent;

                    accessible-role: button;
                    accessible-label: @tr("Supprimer la réunion");
                    accessible-action-default => { root.confirming-delete = true; }

                    forward-focus: delete-focus;
                    delete-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == Key.Return || event.text == Key.Space {
                                root.confirming-delete = true;
                                return accept;
                            }
                            return reject;
                        }
                    }

                    delete-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirming-delete = true; }
                    }

                    delete-content := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;
                        alignment: center;

                        Rectangle {
                            width: 14px;
                            horizontal-stretch: 0;

                            LucideIcon {
                                size: 14px;
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.Trash2;
                                icon-color: Theme.danger-strong;
                            }
                        }
                        Text {
                            text: @tr("Supprimer la réunion");
                            font-size: 12.5px;
                            color: Theme.danger-strong;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.confirming-delete: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;

                    Text {
                        text: @tr("Supprimer cette réunion définitivement ?");
                        font-size: 13px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    confirm-btn := Rectangle {
                        width: confirm-txt.preferred-width + 24px;
                        height: Theme.settings-control-height;
                        horizontal-stretch: 0;
                        border-radius: 4px;
                        border-width: confirm-focus.has-focus ? 2px : 0px;
                        border-color: Theme.text-primary;
                        background: confirm-area.pressed ? Theme.danger-strong : confirm-area.has-hover ? Theme.danger.with-alpha(0.9) : Theme.danger;

                        accessible-role: button;
                        accessible-label: @tr("Oui, supprimer");
                        accessible-action-default => { root.confirm-delete(); }

                        forward-focus: confirm-focus;
                        confirm-focus := FocusScope {
                            init => { self.focus(); }
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == Key.Space {
                                    root.confirm-delete();
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    root.confirming-delete = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        confirm-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirm-delete(); }
                        }

                        confirm-txt := Text {
                            text: @tr("Oui, supprimer");
                            font-family: "Archivo SemiBold";
                            font-size: 13px;
                            color: Theme.on-danger;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    ThemedButton {
                        text: @tr("Annuler");
                        kind: ThemedButtonKind.ghost;
                        clicked => { root.confirming-delete = false; }
                    }
                }
                }

                if root.delete-error != "": Text {
                    text: @tr("Impossible de supprimer la réunion : {}", root.delete-error);
                    font-size: 12px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
            }
        }
    }
}
