import {
    AlertSeverity, ButtonIntent, ControlSize, FieldAccess, KitAlert, KitAppShell, KitButton, KitContainer,
    KitDivider, KitFieldRow, KitFooter, KitIcon, KitImage, KitInline, KitMetrics, KitProgress,
    KitScrollArea, KitSection, KitSegmentedControl, KitStack, KitText, KitThemes, KitWrap,
    LayoutSpace, Ownership, ProgressMode, TypographyRole
} from "@kit";
import { LucideSecurity } from "@kit-icons/security.slint";
import { CatalogPicker } from "components/catalog_picker.slint";
import { PermissionsStep, PermissionRow } from "components/onboarding/permissions_step.slint";
import { ShortcutMessages, ShortcutRecorderButton, ShortcutRejection } from "components/settings/interface_section.slint";
import { SettingsOptions } from "components/settings/settings_options.slint";
import { StatusBanner } from "components/status_banner.slint";
import { AppLocale, ModelPhase, OnboardingStep, PermissionKind } from "types.slint";
import { Theme } from "theme.slint";

// The first-run wizard. Rust owns the steps, the model and the shortcut; this
// view only shows the current one. Model download and shortcut capture reuse
// the same Rust modules (`model_ui.rs`, `shortcut_capture.rs`) the Settings tab
// uses, through their own `onboarding-*` window properties, so one overlay's
// state never leaks into the other's fields.
export component OnboardingView inherits KitAppShell {
    in property <AppLocale> locale;
    in property <int> step-index;
    in property <int> step-count;
    in property <OnboardingStep> step;
    in property <string> status-message;

    in property <[PermissionRow]> permission-rows;
    in property <string> permissions-error;
    in property <bool> repair-busy;
    in property <bool> repair-success;
    in property <bool> repair-cooldown;

    in property <[string]> device-labels;
    in property <[string]> device-ids;
    in property <int> default-device-index: -1;
    in property <int> selected-device-index;

    in property <ModelPhase> model-phase: ModelPhase.pick;
    in property <[string]> model-labels;
    in property <[string]> model-ids;
    in property <int> selected-model-index;
    in property <string> download-progress-label;
    in property <float> download-progress-fraction;

    in property <string> toggle-shortcut-label;
    in property <bool> shortcut-recording;
    in property <string> shortcut-error;
    in property <ShortcutRejection> shortcut-rejection;
    in property <bool> capture-eligible;
    in property <int> shortcut-generation;
    in property <bool> accessibility-granted;

    in property <bool> busy;
    in property <bool> continue-enabled: true;

    callback locale-changed(AppLocale);
    callback grant-requested(PermissionKind);
    callback hint-action-requested(PermissionKind);
    callback repair-requested();
    callback device-changed(int);
    callback refresh-devices-requested();
    callback model-picked(int);
    callback shortcut-record-requested();
    pure callback shortcut-key-allowed(string, bool, bool, bool, bool) -> bool;
    callback shortcut-rejected(string, bool, bool, bool, bool);
    callback shortcut-captured(string, bool, bool, bool, bool);
    callback shortcut-released(string, bool, bool, bool, bool);
    callback shortcut-cleared();
    callback shortcut-cancelled();
    callback review-accessibility-requested();
    callback back-requested();
    callback continue-requested();

    pure function step-title(step: OnboardingStep) -> string {
        if step == OnboardingStep.permissions { return @tr("Permissions"); }
        if step == OnboardingStep.microphone { return @tr("Choisissez votre microphone"); }
        if step == OnboardingStep.model { return @tr("Modèle de transcription"); }
        if step == OnboardingStep.shortcut { return @tr("Raccourci clavier"); }
        return "";
    }
    pure function step-subtitle(step: OnboardingStep) -> string {
        if step == OnboardingStep.permissions { return @tr("Soufflé a besoin de ces autorisations macOS pour fonctionner."); }
        if step == OnboardingStep.microphone { return @tr("Vous pourrez changer ce choix plus tard dans les Réglages."); }
        if step == OnboardingStep.model { return @tr("Téléchargé une seule fois, tout tourne ensuite hors ligne."); }
        if step == OnboardingStep.shortcut { return @tr("Utilisé pour démarrer et arrêter la dictée depuis n'importe quelle application."); }
        return "";
    }

    private property <string> shortcut-message: root.shortcut-rejection == ShortcutRejection.none
        ? root.shortcut-error : ShortcutMessages.rejection(root.shortcut-rejection);
    private property <bool> is-last-step: root.step-index == root.step-count - 1;
    private property <string> continue-label: root.step == OnboardingStep.model && root.model-phase != ModelPhase.ready ? @tr("Télécharger et continuer")
        : root.is-last-step ? @tr("Terminer")
        : @tr("Continuer");

    changed step => { viewport.content-y = 0px; }

    viewport := KitScrollArea {
        inset: LayoutSpace.roomy;
        overlay-scrollbars: true;
        focusable: self.scrollable;
        label: root.step-title(root.step);

        column := KitContainer {
            max-content-width: Theme.onboarding-column-width;
            gutter: LayoutSpace.none;

            KitStack {
                gap: LayoutSpace.compact;

                KitInline {
                    alignment: center;
                    KitImage {
                        width: Theme.onboarding-mark-size;
                        source: @image-url("assets/icon.png");
                    }
                }
                KitText {
                    role: TypographyRole.title;
                    horizontal-alignment: center;
                    text: @tr("Soufflé");
                }
                KitText {
                    horizontal-alignment: center;
                    text: @tr("Transcription vocale locale pour la dictée et les meetings.");
                }
                KitInline {
                    alignment: center;
                    KitIcon {
                        control-size: ControlSize.compact;
                        glyph: LucideSecurity.lock();
                    }
                    KitText {
                        role: TypographyRole.caption;
                        vertical-alignment: center;
                        text: @tr("100 % local : rien ne quitte votre Mac. Pas de compte, pas de cloud.");
                    }
                }
                if root.step-index == 0: KitInline {
                    alignment: center;
                    inset: LayoutSpace.tight;
                    private property <bool> choice-focused: locale-choice.has-focus;
                    changed choice-focused => {
                        if self.choice-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                    }
                    locale-choice := KitSegmentedControl {
                        control-size: ControlSize.compact;
                        horizontal-stretch: 0;
                        label: @tr("InterfaceSection" => "Langue de l'interface");
                        ownership: Ownership.controlled;
                        options: SettingsOptions.locale-options(root.locale).rows;
                        selected: SettingsOptions.locale-options(root.locale).selected;
                        chosen(row) => { root.locale-changed(SettingsOptions.locale-value(row, root.locale)); }
                    }
                }
            }

            if root.step-count > 1: KitProgress {
                value: (root.step-index + 1) / root.step-count;
                accessible-label: root.step-title(root.step);
            }

            KitSection {
                gap: LayoutSpace.tight;
                title: root.step-title(root.step);
                description: root.step-subtitle(root.step);
            }

            // Rust clears this on every step change and only ever puts a real
            // error message here (a failed save, download or load).
            if root.status-message != "": StatusBanner {
                message: root.status-message;
                dismissible: false;
            }

            if root.step == OnboardingStep.permissions: PermissionsStep {
                available-width: column.available-width;
                rows: root.permission-rows;
                error-message: root.permissions-error;
                repair-busy: root.repair-busy;
                repair-success: root.repair-success;
                repair-cooldown: root.repair-cooldown;
                grant-requested(kind) => { root.grant-requested(kind); }
                hint-action-requested(kind) => { root.hint-action-requested(kind); }
                repair-requested => { root.repair-requested(); }
            }

            if root.step == OnboardingStep.microphone: microphone-row := KitFieldRow {
                orientation: Orientation.vertical;
                padding: KitMetrics.field-gap(self.theme);
                focus-requested => { device-picker.take-focus(); }
                private property <bool> picker-focused: device-picker.has-focus;
                changed picker-focused => {
                    if self.picker-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }

                KitWrap {
                    cross-axis-alignment: center;
                    device-picker := CatalogPicker {
                        model: root.device-labels;
                        option-values: root.device-ids;
                        default-device-index: root.default-device-index;
                        selection: self.selection-at(root.selected-device-index);
                        control-label: @tr("Choisissez votre microphone");
                        selected-index(index) => { root.device-changed(index); }
                    }
                    KitButton {
                        control-size: ControlSize.compact;
                        text: @tr("Actualiser");
                        activated => { root.refresh-devices-requested(); }
                        focus-observed(focused) => {
                            if focused { microphone-row.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                        }
                    }
                }
            }

            if root.step == OnboardingStep.model && root.model-phase == ModelPhase.downloading: KitProgress {
                label: @tr("Téléchargement du modèle…");
                value: root.download-progress-fraction;
                value-text: root.download-progress-label;
            }
            if root.step == OnboardingStep.model && root.model-phase == ModelPhase.loading: KitProgress {
                mode: ProgressMode.indeterminate;
                label: @tr("Chargement du modèle…");
            }
            if root.step == OnboardingStep.model && root.model-phase == ModelPhase.ready: KitText {
                text: @tr("Modèle prêt.");
            }
            if root.step == OnboardingStep.model && root.model-phase == ModelPhase.pick: model-row := KitFieldRow {
                orientation: Orientation.vertical;
                padding: KitMetrics.field-gap(self.theme);
                access: root.busy ? FieldAccess.disabled : FieldAccess.editable;
                label: @tr("Modèle de transcription");
                focus-requested => { model-picker.take-focus(); }
                private property <bool> picker-focused: model-picker.has-focus;
                changed picker-focused => {
                    if self.picker-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }

                model-picker := CatalogPicker {
                    combo-width: model-row.width - 2 * KitMetrics.field-gap(model-row.theme);
                    model: root.model-labels;
                    option-values: root.model-ids;
                    selection: self.selection-at(root.selected-model-index);
                    control-label: @tr("Modèle de transcription");
                    enabled: !root.busy;
                    selected-index(index) => { root.model-picked(index); }
                }
            }

            if root.step == OnboardingStep.shortcut: shortcut-row := KitFieldRow {
                orientation: Orientation.vertical;
                padding: KitMetrics.field-gap(self.theme);
                focus-requested => { shortcut-recorder.take-focus(); }
                description: @tr("Cliquez sur le raccourci, puis appuyez sur les touches voulues. Échap annule.");
                error-message: root.shortcut-message;
                private property <bool> recorder-focused: shortcut-recorder.recorder-focused;
                changed recorder-focused => {
                    if self.recorder-focused { self.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                }
                changed error-message => {
                    if (self.error-message != "" && self.recorder-focused) {
                        self.ensure-visible(KitThemes.scroll-behavior(self.theme));
                    }
                }

                shortcut-recorder := ShortcutRecorderButton {
                    description: shortcut-row.error-message != "" ? shortcut-row.error-message : shortcut-row.description;
                    shortcut-label: root.toggle-shortcut-label;
                    recording: root.shortcut-recording;
                    capture-eligible: root.capture-eligible;
                    generation: root.shortcut-generation;
                    record-requested => { root.shortcut-record-requested(); }
                    key-allowed(text, ctrl, shift, alt, meta) => { return root.shortcut-key-allowed(text, ctrl, shift, alt, meta); }
                    rejected(text, ctrl, shift, alt, meta) => { root.shortcut-rejected(text, ctrl, shift, alt, meta); }
                    captured(text, ctrl, shift, alt, meta) => { root.shortcut-captured(text, ctrl, shift, alt, meta); }
                    released(text, ctrl, shift, alt, meta) => { root.shortcut-released(text, ctrl, shift, alt, meta); }
                    cleared => { root.shortcut-cleared(); }
                    cancelled => { root.shortcut-cancelled(); }
                }
            }
            if root.step == OnboardingStep.shortcut && !root.accessibility-granted: accessibility-alert := KitAlert {
                severity: AlertSeverity.warning;
                message: @tr("Le collage automatique a besoin de l'Accessibilité, qui n'est pas encore accordée. Le texte ira dans votre historique à la place.");

                KitButton {
                    control-size: ControlSize.compact;
                    text: @tr("Vérifier les permissions");
                    text-wrap: word-wrap;
                    activated => { root.review-accessibility-requested(); }
                    focus-observed(focused) => {
                        if focused { accessibility-alert.ensure-visible(KitThemes.scroll-behavior(self.theme)); }
                    }
                }
            }
        }
    }

    KitDivider { }

    KitFooter {
        KitContainer {
            max-content-width: Theme.onboarding-column-width;
            gutter: LayoutSpace.roomy;

            KitWrap {
                alignment: end;
                cross-axis-alignment: center;
                if root.step-index > 0: KitButton {
                    text: @tr("Retour");
                    intent: ButtonIntent.quiet;
                    disabled: root.busy;
                    activated => { root.back-requested(); }
                }
                KitButton {
                    text: root.continue-label;
                    intent: ButtonIntent.primary;
                    disabled: root.busy || !root.continue-enabled;
                    activated => { root.continue-requested(); }
                }
            }
        }
    }
}
