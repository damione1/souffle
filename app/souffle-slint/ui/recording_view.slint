import { AppText, AppNumericText, Typography } from "@typography";
import { AlertSeverity, ButtonIntent, ControlSize, KitAlert, KitBadge, KitButton, KitCard, KitDivider, KitIcon, KitInline, KitScrollArea, KitSurface, KitTextArea, KitThemeContext, SurfaceLevel, Tone } from "@kit";
import { ProLevelWaveform } from "@kit-pro";
import { LucideDesign } from "@kit-icons/design.slint";
import { LucideText } from "@kit-icons/text.slint";
import { LucideMultimedia } from "@kit-icons/multimedia.slint";
import { RecordingMode, SpeakerRole, LiveSystemAudio, MicStall, MeetingIdleBanner, WakeResumeNotice } from "types.slint";
import { Theme } from "theme.slint";
import { MicStallBanner } from "components/mic_stall_banner.slint";
import { StatusBanner } from "components/status_banner.slint";
import { TranscriptBlock } from "components/transcript_section.slint";
import { TranscriptWord, TranscriptWordFlow, DictionaryAliasPopover } from "components/transcript_words.slint";
import { LiveTranscriptParagraph } from "components/live_transcript_paragraph.slint";

// Vertical centring of a fixed-height control inside the toolbar row.
component CenterY inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    @children
}

// A raised kit surface that fills the slot its parent layout gives it, so a
// scroll area inside can take the remaining height. KitCard and KitSurface
// size to their content, which would collapse such a scroll area.
component StretchCard inherits Rectangle {
    in property <length> pad-x;
    in property <length> pad-y;
    in property <length> gap;

    KitSurface {
        width: parent.width;
        height: parent.height;
        level: SurfaceLevel.raised;
    }

    VerticalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: root.gap;
        @children
    }
}

// The two modes share the session toolbar, while their bodies stay distinct:
// dictation is a single writing surface; meetings add transcript context and
// live notes.
export component RecordingView inherits Rectangle {
    in property <RecordingMode> mode; // never idle - see main_window.slint
    // Dictation path - mono-lane flat buffer, unchanged (AC7).
    in property <string> live-text;
    in property <string> live-tentative;
    // The dictation as words (Rust, `push_dictation_words`), the one the
    // engine still holds dimmed at the end.
    in property <[TranscriptWord]> live-dictation-words;
    // Meeting path - paragraph model from LiveTranscript (SOU-237).
    in property <[TranscriptBlock]> live-transcript-blocks;
    // True when live-transcript-blocks is empty and live-tentative is empty
    // (placeholder "À l'écoute…" logic).
    in property <bool> live-transcript-empty: true;
    // Elapsed offset in seconds, set by Rust to the real elapsed since
    // recording started - anchors the free-running timer (AC6).
    in property <int> live-elapsed-offset-seconds: 0;
    in property <float> audio-level: 0.0;
    // SOU-282: see main_window.slint; stops the waveform tick when hidden.
    in property <bool> window-visible: true;
    in-out property <string> notes;
    // Live verdict on the meeting's system-audio leg (see LiveSystemAudio).
    in property <LiveSystemAudio> system-audio: LiveSystemAudio.pending;
    in property <bool> auto-paste: false;
    // SOU-126: a meeting goes on without a stuck microphone; say which one.
    in property <bool> mic-stall-visible: false;
    in property <MicStall> mic-stall-kind;
    in property <string> mic-stall-device;
    // SOU-258: the view mounts on the click, before the session exists (a
    // meeting's engine reset takes seconds). SOU-260: capture already runs
    // while this is true, so the clock counts from the click like the audio
    // does; only the transcript waits, and catches up once the engine is
    // ready. Stop stays live: main.rs stops capture at once and stops the
    // session itself once it exists.
    in property <bool> starting: false;
    // A stop clicked during the start is queued behind it: the button dims
    // and ignores further clicks until that stop has run.
    in property <bool> stop-pending: false;
    // SOU-294: LiveSessionCard.svelte's idle banner. `meeting-idle-minutes`
    // is the silence so far, rounded, at least 1.
    in property <MeetingIdleBanner> meeting-idle-banner: MeetingIdleBanner.hidden;
    in property <int> meeting-idle-minutes: 0;
    // SOU-295: only `resumed` is shown here (the detail shows the other).
    in property <WakeResumeNotice> wake-resume-notice: WakeResumeNotice.hidden;

    callback stop-requested();
    callback wake-resume-notice-dismissed();
    callback notes-changed(string);
    callback mic-stall-restart-requested();
    callback mic-stall-dismissed();
    callback meeting-idle-keep-recording();
    // (term, pronunciation) saved from a live word's alias popover - the
    // same handler as the post-meeting transcript's.
    callback alias-save-requested(string, string);
    callback paragraph-edit-requested(int);

    // Live meeting autoscroll (LiveSessionCard.svelte's scheduleAutoscroll),
    // done here rather than from Rust: follow the bottom while the reader
    // is within `live-follow-slack` of it, and leave them alone once they
    // scroll further up. It used to be a Rust poll reading the content and
    // viewport heights through `in-out` properties bound `<=>` to
    // MainWindow; the outer, binding-less side of that two-way binding won,
    // so Rust always read 0 and never scrolled (SOU-256).
    property <bool> live-follow: true;
    property <length> live-follow-slack: 40px;
    function live-pin-to-bottom() {
        live-scroll.content-y = min(0px, live-scroll.visible-height - live-scroll.content-height);
    }

    property <string> combined-text: root.live-tentative == "" ? root.live-text
        : root.live-text == "" ? root.live-tentative
        : root.live-text + @tr(" {}", root.live-tentative);

    // Seconds counted by the timer since Rust last anchored the offset.
    // Kept apart from the offset so a late anchor (the start settling after
    // the clock already ran from the click) replaces the count instead of
    // being lost: assigning to a bound property would drop its binding.
    property <int> ticks-since-anchor: 0;
    changed live-elapsed-offset-seconds => { root.ticks-since-anchor = 0; }
    property <int> elapsed-seconds: root.live-elapsed-offset-seconds + root.ticks-since-anchor;
    property <int> elapsed-minutes: root.elapsed-seconds / 60;
    property <int> elapsed-remainder: Math.mod(root.elapsed-seconds, 60);
    property <string> elapsed-label: root.elapsed-minutes + ":" +
        (root.elapsed-remainder < 10 ? "0" : "") + root.elapsed-remainder;

    Timer {
        interval: 1s;
        running: root.mode != RecordingMode.idle;
        triggered => { root.ticks-since-anchor += 1; }
    }


    VerticalLayout {
        width: min(root.width - KitThemeContext.current.spacing.unit * 13, Theme.page-column-width);
        height: root.height;
        x: (root.width - self.width) / 2;
        padding-top: Theme.page-top-padding;
        spacing: KitThemeContext.current.spacing.unit * 4.5;

        KitCard {
            level: SurfaceLevel.raised;
            inset: compact;

            KitInline {
                height: KitThemeContext.current.spacing.unit * 10;
                gap: regular;

                CenterY {
                    status := KitBadge {
                        text: root.mode == RecordingMode.meeting ? @tr("Réunion en direct") : @tr("Dictée");
                        tone: Tone.danger;
                        subtle: true;
                        dot: true;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    waveform := ProLevelWaveform {
                        running: root.mode != RecordingMode.idle && root.window-visible;
                        level: root.audio-level;
                    }
                }

                elapsed-counter := AppNumericText {
                    width: KitThemeContext.current.spacing.unit * 12;
                    horizontal-stretch: 0;
                    text: root.elapsed-label;
                    typography: Typography.body;
                    text-color: Theme.text-primary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                CenterY {
                    stop-control := KitButton {
                        accessible-name: @tr("Arrêter l'enregistrement");
                        text: @tr("Arrêter");
                        intent: ButtonIntent.destructive;
                        disabled: root.stop-pending;
                        leading-icon: LucideMultimedia.square();
                        activated => { root.stop-requested(); }
                    }
                }
            }
        }

        // Keep Stop in place. A stack of recording warnings can exceed the
        // minimum window height, so the notes must be reachable below it.
        capture-scroll := KitScrollArea {
            focusable: self.scrollable;
            label: status.text;
            Rectangle {
                width: capture-scroll.visible-width;
                height: max(capture-scroll.visible-height, sections.min-height);

                sections := VerticalLayout {
                    padding-bottom: KitThemeContext.current.spacing.unit * 10;
                    spacing: KitThemeContext.current.spacing.unit * 4.5;
                    if root.mic-stall-visible: MicStallBanner {
                        vertical-stretch: 0;
                        kind: root.mic-stall-kind;
                        device: root.mic-stall-device;
                        restart-requested => { root.mic-stall-restart-requested(); }
                        dismissed => { root.mic-stall-dismissed(); }
                    }

                    if root.mode == RecordingMode.meeting && root.wake-resume-notice == WakeResumeNotice.resumed: StatusBanner {
                        vertical-stretch: 0;
                        message: @tr("Enregistrement repris après la mise en veille.");
                        dismissed => { root.wake-resume-notice-dismissed(); }
                    }

                    if root.mode == RecordingMode.meeting && root.system-audio == LiveSystemAudio.unavailable: KitAlert {
                        severity: AlertSeverity.warning;
                        accessible-label: @tr("Attention. Seul votre microphone est enregistré. L'audio des autres participants est indisponible.");
                        message: @tr("Seul votre microphone est enregistré. L’audio des autres participants est indisponible.");
                    }

                    // The silence episode offers to keep recording or stop now
                    // (the meeting stops by itself 2 min later otherwise); the
                    // max-duration guard is already stopping it, so no buttons.
                    if root.mode == RecordingMode.meeting && root.meeting-idle-banner != MeetingIdleBanner.hidden: KitAlert {
                        severity: root.meeting-idle-banner == MeetingIdleBanner.max-duration
                            ? AlertSeverity.warning : AlertSeverity.information;
                        message: root.meeting-idle-banner == MeetingIdleBanner.max-duration
                            ? @tr("Durée maximale de la réunion atteinte. Arrêt de l'enregistrement.")
                            : @tr("Aucune parole détectée depuis {} min. L'enregistrement va bientôt s'arrêter.", root.meeting-idle-minutes);
                        if root.meeting-idle-banner == MeetingIdleBanner.silence: KitButton {
                            text: @tr("Continuer l'enregistrement");
                            intent: ButtonIntent.primary;
                            control-size: ControlSize.compact;
                            activated => { root.meeting-idle-keep-recording(); }
                        }
                        if root.meeting-idle-banner == MeetingIdleBanner.silence: KitButton {
                            text: @tr("Arrêter maintenant");
                            intent: ButtonIntent.destructive-soft;
                            control-size: ControlSize.compact;
                            disabled: root.stop-pending;
                            activated => { root.stop-requested(); }
                        }
                    }

                    if root.mode == RecordingMode.dictation: StretchCard {
                        min-height: KitThemeContext.current.spacing.unit * 75;
                        vertical-stretch: 1;
                        pad-x: KitThemeContext.current.spacing.unit * 7.5;
                        pad-y: KitThemeContext.current.spacing.unit * 7;
                        gap: KitThemeContext.current.spacing.unit * 4.5;

                        // A plain stretched layout child: no wrapper Rectangle
                        // or `height: 100%` (SOU-256).
                        dictation-scroll := KitScrollArea {
                            vertical-stretch: 1;

                            VerticalLayout {
                                width: parent.width;
                                alignment: start;
                                // Gutter for the overlay scrollbar, so it never
                                // sits on the last characters of a line.
                                padding-right: KitThemeContext.current.spacing.unit * 3;
                                if root.starting || root.combined-text == "": AppText {
                                    text: root.starting ? @tr("Démarrage…") : @tr("À l'écoute…");
                                    typography: Typography.body;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                if !root.starting && root.combined-text != "": TranscriptWordFlow {
                                    words: root.live-dictation-words;
                                    typography: Typography.preview;
                                    color: Theme.text-primary;
                                }
                            }
                        }

                        if root.auto-paste: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: KitThemeContext.current.spacing.unit * 3.5;

                            KitDivider { }
                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: KitThemeContext.current.spacing.unit * 2;
                                alignment: start;

                                KitIcon {
                                    glyph: LucideText.clipboard-check();
                                    ink: Theme.accent;
                                }
                                AppText {
                                    text: @tr("Collé automatiquement dans votre dernière app à l’arrêt");
                                    typography: Typography.hint;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    StretchCard {
                        visible: root.mode == RecordingMode.meeting;
                        min-height: root.mode == RecordingMode.meeting ? KitThemeContext.current.spacing.unit * 90 : 0px;
                        max-height: root.mode == RecordingMode.meeting ? 100000px : 0px;
                        vertical-stretch: root.mode == RecordingMode.meeting ? 1 : 0;
                        pad-x: KitThemeContext.current.spacing.unit * 6.5;
                        pad-y: KitThemeContext.current.spacing.unit * 5.5;
                        gap: KitThemeContext.current.spacing.unit * 4.5;

                        // One hover tracker for the card; the repeated paragraphs keep
                        // their own word/action hitboxes instead of nesting row trackers.
                        live-pointer := TouchArea {
                            // Click a finalized word -> add it to the dictionary, same popover
                            // as the post-meeting transcript (SOU-223). It stays outside the
                            // card's layout: the layout would give it a row and own its x/y.
                            live-alias := DictionaryAliasPopover {
                                save-requested(term, pronunciation) => { root.alias-save-requested(term, pronunciation); }
                            }

                            // SOU-256: no `alignment` here, on purpose. Any alignment
                            // other than the default `stretch` makes a layout give each
                            // child its preferred height and ignore vertical-stretch,
                            // which collapsed live-scroll. The header is fixed-height
                            // and vertical-stretch: 0, so the scroll area takes the rest.
                            VerticalLayout {
                                spacing: KitThemeContext.current.spacing.unit * 4.5;

                                HorizontalLayout {
                                    height: system-audio-badge.preferred-height;
                                    vertical-stretch: 0;
                                    alignment: space-between;

                                    AppText {
                                        text: @tr("TRANSCRIPTION EN DIRECT");
                                        typography: Typography.caption-emphasis;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }

                                    system-audio-badge := KitBadge {
                                        text: root.system-audio == LiveSystemAudio.active ? @tr("Audio système actif")
                                            : root.system-audio == LiveSystemAudio.pending ? @tr("Vérification de l’audio système")
                                            : @tr("Micro seul");
                                        tone: root.system-audio == LiveSystemAudio.active ? Tone.success
                                            : root.system-audio == LiveSystemAudio.pending ? Tone.warning
                                            : Tone.neutral;
                                        subtle: true;
                                        dot: true;
                                    }
                                }

                                live-scroll := KitScrollArea {
                                    vertical-stretch: 1;

                                    changed content-height => {
                                        if root.live-follow {
                                            root.live-pin-to-bottom();
                                        }
                                    }
                                    changed visible-height => {
                                        if root.live-follow {
                                            root.live-pin-to-bottom();
                                        }
                                    }
                                    // Only a scroll the reader made (wheel, trackpad or
                                    // scrollbar drag) decides whether new text keeps
                                    // following. Not `changed content-y`: that also fires
                                    // for the pin above, and when the content grows again
                                    // before it runs it would read the fresh pin as
                                    // "scrolled up" and stop following for good.
                                    scrolled => {
                                        root.live-follow = self.content-y <= self.visible-height - self.content-height + root.live-follow-slack;
                                    }

                                    live-content := VerticalLayout {
                                        width: parent.width;
                                        alignment: start;
                                        spacing: KitThemeContext.current.spacing.unit * 4.5;
                                        // Gutter for the overlay scrollbar, so it never
                                        // sits on the last characters of a line.
                                        padding-right: KitThemeContext.current.spacing.unit * 3;

                                        if root.live-transcript-empty: AppText {
                                            text: root.starting ? @tr("Démarrage…") : @tr("À l'écoute…");
                                            typography: Typography.body;
                                            color: Theme.text-muted;
                                        }

                                        for block[i] in root.live-transcript-blocks: LiveTranscriptParagraph {
                                            block: block;
                                            editing-enabled: !root.starting && !root.stop-pending;
                                            // Clipped rows must not react to the fixed
                                            // card header while their top is scrolled away.
                                            pointer-active: live-pointer.has-hover
                                                && live-pointer.absolute-position.x + live-pointer.mouse-x >= live-scroll.absolute-position.x
                                                && live-pointer.absolute-position.x + live-pointer.mouse-x < live-scroll.absolute-position.x + live-scroll.width
                                                && live-pointer.absolute-position.y + live-pointer.mouse-y >= live-scroll.absolute-position.y
                                                && live-pointer.absolute-position.y + live-pointer.mouse-y < live-scroll.absolute-position.y + live-scroll.height;
                                            pointer-x: live-pointer.absolute-position.x + live-pointer.mouse-x;
                                            pointer-y: live-pointer.absolute-position.y + live-pointer.mouse-y;
                                            edit-requested => { root.paragraph-edit-requested(i); }
                                            word-clicked(word, at-x, at-y) => { live-alias.open(word, at-x, at-y); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.mode == RecordingMode.meeting: KitCard {
                        level: SurfaceLevel.raised;
                        inset: regular;
                        gap: compact;

                        KitInline {
                            gap: compact;
                            KitIcon {
                                glyph: LucideDesign.pen-line();
                                ink: Theme.text-muted;
                            }
                            AppText {
                                text: @tr("NOTES");
                                typography: Typography.caption-emphasis;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        notes-input := KitTextArea {
                            min-lines: 3;
                            max-lines: 3;
                            text <=> root.notes;
                            placeholder: @tr("Notez décisions, actions, noms…");
                            accessible-name: @tr("Notes de la réunion");
                            edited(value) => { root.notes-changed(value); }
                        }
                    }
                }
            }
        }
    }
}
