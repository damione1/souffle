import { Theme } from "../theme.slint";

// Port of app.css `.field-input`. Stock LineEdit is taller and Fluent-gray.
export component ThemedLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;

    callback edited(string);
    callback accepted(string);

    height: 40px;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.45) : Theme.ghost-border;
    background: Theme.input;
    opacity: root.enabled ? 1.0 : 0.5;

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        font-size: 14px;
        font-family: "Archivo";
        color: Theme.text-secondary;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 12px;
        width: input.width;
        height: parent.height;
        text: root.placeholder;
        font-size: 14px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
}
