import { Theme } from "../theme.slint";

// Port of components/ui/EmptyState.svelte (icon slot dropped: no icon set
// is wired to this UI yet, not a hidden omission - add one when a caller
// actually needs it).
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> message;

    alignment: center;
    spacing: 6px;
    padding: 32px;

    if root.title != "": Text {
        text: root.title;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
    }
    Text {
        text: root.message;
        horizontal-alignment: center;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
