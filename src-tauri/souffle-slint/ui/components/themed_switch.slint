import { Theme } from "../theme.slint";

// Port of app.css's `.switch` (42x24 pill track, 18x18 white knob sliding
// from x=3 to x=21). `std-widgets.slint`'s `Switch` ignores `Theme` the
// same way `Button` did - see `themed_button.slint`.
export component ThemedSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;

    // Carries the new value directly - no internal state to read back via
    // `self.checked` (this component is purely one-way, same reasoning as
    // `FilterChip`: no risk of the widget's own state disagreeing with the
    // caller's source of truth).
    callback toggled(bool);

    width: 42px;
    height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 12px;
    background: root.checked ? Theme.accent : Theme.surface-3;
    opacity: root.enabled ? 1.0 : 0.5;

    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }

    knob := Rectangle {
        x: root.checked ? 21px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;

        animate x { duration: 150ms; easing: ease; }
    }
}
