import { Theme } from "../theme.slint";
import { LucideIcon, IconSet } from "lucide_icon.slint";

// Port of app.css `.field-number`. Stock SpinBox ignores Theme and
// inflates to a huge square inside SettingsField's stretch pool.
export component ThemedSpinBox inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;

    callback edited(int);

    width: 80px;
    height: 36px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.ghost-border;
    background: Theme.input;
    opacity: root.enabled ? 1.0 : 0.5;

    accessible-role: none;
    accessible-enabled: root.enabled;

    Text {
        x: 10px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.value;
        font-size: 14px;
        color: Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    up := TouchArea {
        x: parent.width - 22px;
        y: 1px;
        width: 20px;
        height: 17px;
        enabled: root.enabled && root.value < root.maximum;
        clicked => { root.edited(min(root.maximum, root.value + root.step)); }
    }
    LucideIcon {
        icon: IconSet.ChevronUp;
        icon-color: Theme.text-muted;
        size: 12px;
        x: parent.width - 18px;
        y: 3px;
    }

    down := TouchArea {
        x: parent.width - 22px;
        y: 18px;
        width: 20px;
        height: 17px;
        enabled: root.enabled && root.value > root.minimum;
        clicked => { root.edited(max(root.minimum, root.value - root.step)); }
    }
    LucideIcon {
        icon: IconSet.ChevronDown;
        icon-color: Theme.text-muted;
        size: 12px;
        x: parent.width - 18px;
        y: 20px;
    }
}
