import { TimelineKind } from "../types.slint";
import { Theme } from "../theme.slint";

// Port of features/timeline/components/TimelineItem.svelte. Struct name
// avoids "TimelineItem" itself: Slint generates a Rust type of the same
// name, and that name is also the Svelte component's - kept distinct to
// avoid confusing the two in Rust.
export struct TimelineEntry {
    kind: TimelineKind,
    id: string,
    title: string,
    time-label: string,
    duration-label: string,
    has-summary: bool,
    summary-is-stale: bool,
}

export component TimelineItemRow inherits Rectangle {
    in property <TimelineEntry> entry;
    in property <bool> is-live: false;

    callback opened();
    callback removed();

    property <bool> confirming-delete: false;

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;

        row-area := TouchArea {
            accessible-role: button;
            accessible-label: root.entry.title;
            accessible-action-default => { root.opened(); }
            clicked => { root.opened(); }

            HorizontalLayout {
                spacing: 10px;

                Text {
                    text: root.entry.kind == TimelineKind.meeting ? "\u{1F465}" : "\u{1F4DD}";
                    vertical-alignment: center;
                }

                Text {
                    text: root.entry.title;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    color: Theme.text-primary;
                }

                if root.entry.has-summary: Text {
                    text: "\u{2605}";
                    color: root.entry.summary-is-stale ? Theme.warning : Theme.accent;
                    vertical-alignment: center;
                }

                if root.entry.duration-label != "": Text {
                    text: root.entry.duration-label;
                    color: Theme.text-muted;
                    font-family: "monospace";
                    vertical-alignment: center;
                }

                Text {
                    text: root.entry.time-label;
                    color: Theme.text-muted;
                    font-family: "monospace";
                    vertical-alignment: center;
                }

                if root.entry.kind == TimelineKind.meeting: Text {
                    text: "\u{203A}";
                    vertical-alignment: center;
                }
            }
        }

        // Hover-reveal, not permanently visible - matches TimelineItem.svelte's
        // `opacity-0 group-hover:opacity-100` (a bare `Trash2` icon behind a
        // "confirm" text swap, not an always-on "Supprimer" label; found while
        // comparing against the reference during SOU-195).
        if !root.is-live: Rectangle {
            width: 70px;
            opacity: row-area.has-hover || delete-area.has-hover ? 1.0 : 0.0;
            animate opacity { duration: 100ms; }

            delete-area := TouchArea {
                accessible-role: button;
                accessible-label: root.confirming-delete ? "Confirmer la suppression" : "Supprimer";
                accessible-action-default => {
                    if root.confirming-delete {
                        root.confirming-delete = false;
                        root.removed();
                    } else {
                        root.confirming-delete = true;
                    }
                }
                clicked => {
                    if root.confirming-delete {
                        root.confirming-delete = false;
                        root.removed();
                    } else {
                        root.confirming-delete = true;
                    }
                }

                if !root.confirming-delete: Text {
                    text: "\u{1F5D1}";
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
                if root.confirming-delete: Text {
                    text: "Confirmer";
                    color: Theme.danger;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
