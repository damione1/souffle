// Port of MeetingTranscriptSection.svelte - read-only display only so far
// (milestone 8a/8b): paragraph grouping with speaker labels and
// session-break dividers, click-to-seek on a paragraph's timestamp, and
// virtualized scrolling (AC15). Not yet ported: bulk edit mode, per-word
// inline edit + dictionary alias popover (TranscriptWordLine.svelte,
// milestone 8d).
export struct TranscriptBlock {
    is-session-break: bool,
    speaker-label: string,
    timestamp: string,
    text: string,
    // -1 when the paragraph isn't attributed to any recorded audio session.
    recording-session-index: int,
    start-time: float,
    end-label: string,
    start-label: string,
}

export component TranscriptSection inherits VerticalLayout {
    // Only the currently visible slice of the transcript, not the whole
    // thing - `main.rs` owns the full block list and pushes a new slice in
    // whenever `scroll-top` moves far enough (AC15: only on-screen rows +
    // margin are ever mounted here, verifiable by `blocks.length` staying
    // small regardless of how many total paragraphs the meeting has).
    in property <[TranscriptBlock]> blocks;
    in property <int> segment-count;
    in property <bool> has-audio: false;
    // Estimated height in px (`main.rs`, see `transcript::compute_offsets`)
    // of everything scrolled past above/below the current slice - plain
    // `float`, not `length`, since `main.rs` only has access to Slint's
    // stable `set_*`/`get_*` API, not the `length`-wrapping type used
    // internally by generated component code. Rendered as blank spacers so
    // the scrollbar/drag physics feel like a real list of `segment-count`
    // items instead of just `blocks.length` of them.
    in property <float> spacer-before: 0.0;
    in property <float> spacer-after: 0.0;
    // Two-way bound down from `MeetingDetail`/`MainWindow` to
    // `flick.viewport-y` below, so `main.rs` can poll the real scroll
    // position and decide the next slice - see the doc comment on
    // `visible_window` in `transcript.rs` for why this can't be pure Slint
    // (variable-height rows need real text layout to size precisely, which
    // only the already-mounted rows have; the rest are estimates).
    in-out property <length> scroll-top: 0px;

    // (recording-session-index, start-time) of the clicked paragraph.
    callback paragraph-clicked(int, float);

    spacing: 8px;

    Text {
        text: "Transcript \u{b7} " + root.segment-count + " segments";
        font-size: 11px;
        font-weight: 600;
        color: #888888;
    }

    if root.segment-count == 0: Text {
        text: "Pas de transcript pour cette r\u{e9}union.";
        color: #888888;
        font-size: 12px;
    }

    if root.segment-count > 0: Rectangle {
        height: 260px;
        border-width: 1px;
        border-color: #3a3a3a;
        clip: true;

        flick := Flickable {
            width: 100%;
            height: 100%;
            viewport-y <=> root.scroll-top;

            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                alignment: start;

                Rectangle { height: root.spacer-before * 1px; }

                for block in root.blocks: VerticalLayout {
                    if !block.is-session-break: VerticalLayout {
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if block.speaker-label != "": Text {
                                text: block.speaker-label;
                                font-size: 11px;
                                font-weight: 600;
                                color: #4a9eff;
                                vertical-alignment: center;
                            }

                            ts-btn := Rectangle {
                                width: 40px;

                                accessible-role: button;
                                accessible-label: "Aller \u{e0} " + block.timestamp;
                                accessible-action-default => {
                                    root.paragraph-clicked(block.recording-session-index, block.start-time);
                                }

                                TouchArea {
                                    enabled: root.has-audio;
                                    clicked => {
                                        root.paragraph-clicked(block.recording-session-index, block.start-time);
                                    }
                                }

                                Text {
                                    text: block.timestamp;
                                    font-family: "monospace";
                                    font-size: 10.5px;
                                    color: #777777;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: block.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    if block.is-session-break: HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Rectangle {
                            height: 1px;
                            background: #3a3a3a;
                            vertical-stretch: 1;
                        }
                        Text {
                            text: block.end-label + " / " + block.start-label;
                            font-size: 10px;
                            color: #777777;
                        }
                        Rectangle {
                            height: 1px;
                            background: #3a3a3a;
                            vertical-stretch: 1;
                        }
                    }
                }

                Rectangle { height: root.spacer-after * 1px; }
            }
        }
    }
}
