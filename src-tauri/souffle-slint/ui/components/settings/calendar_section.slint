import { Switch, SpinBox, CheckBox, Button } from "std-widgets.slint";
import { SettingsField } from "settings_field.slint";

// One calendar in the picker list. Pre-grouped and pre-sorted by Rust
// (`calendar_ui.rs`) so this stays a single flat `for` loop instead of the
// Svelte version's nested `{#each grouped as [source, group]}` - `show-header`
// is true only on the first row of each `source-title` run.
export struct CalendarRow {
    id: string,
    title: string,
    source-title: string,
    selected: bool,
    show-header: bool,
}

// Port of CalendarSettingsSection.svelte.
export component CalendarSection inherits VerticalLayout {
    in property <bool> enabled;
    in property <string> permission; // "granted" | "denied" | "unknown" | "unsupported"
    in property <bool> autostart-enabled;
    in property <int> reminder-minutes;
    in property <[CalendarRow]> calendars;

    callback enabled-changed(bool);
    callback autostart-enabled-changed(bool);
    callback reminder-minutes-changed(int);
    callback calendar-toggled(string);
    callback open-system-settings-requested();

    spacing: 10px;

    Text {
        text: "Réunions";
        font-size: 13.5px;
        font-weight: 700;
        color: white;
    }

    SettingsField {
        label: "Intégration du calendrier";
        description: "Afficher les réunions à venir et proposer de démarrer l'enregistrement.";

        Switch {
            checked: root.enabled;
            toggled => { root.enabled-changed(self.checked); }
        }
    }

    if root.permission == "denied": Rectangle {
        border-width: 1px;
        border-color: #a02a2a;
        border-radius: 6px;
        background: #3a1414;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            alignment: space-between;

            Text {
                text: "L'accès au calendrier a été refusé.";
                color: #f08080;
                font-size: 11.5px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            Button {
                text: "Ouvrir Réglages Système";
                clicked => { root.open-system-settings-requested(); }
            }
        }
    }

    if root.enabled && root.permission == "granted": SettingsField {
        label: "Démarrage automatique";
        description: "Proposer de démarrer l'enregistrement quand une réunion commence.";

        Switch {
            checked: root.autostart-enabled;
            toggled => { root.autostart-enabled-changed(self.checked); }
        }
    }

    if root.enabled && root.permission == "granted": SettingsField {
        label: "Rappel (minutes avant)";

        SpinBox {
            minimum: 1;
            maximum: 30;
            value: root.reminder-minutes;
            edited(value) => { root.reminder-minutes-changed(value); }
        }
    }

    if root.enabled && root.permission == "granted" && root.calendars.length > 0: VerticalLayout {
        spacing: 4px;

        Text {
            text: "Calendriers";
            font-size: 13px;
            font-weight: 600;
            color: white;
        }
        Text {
            text: "Aucune sélection = tous les calendriers.";
            font-size: 11.5px;
            color: #999;
        }

        for row in root.calendars: VerticalLayout {
            if row.show-header && row.source-title != "": Text {
                text: row.source-title;
                font-size: 10.5px;
                font-weight: 700;
                color: #999;
            }

            HorizontalLayout {
                spacing: 8px;

                CheckBox {
                    checked: row.selected;
                    toggled => { root.calendar-toggled(row.id); }
                }
                Text {
                    text: row.title;
                    font-size: 12.5px;
                    color: #ddd;
                    vertical-alignment: center;
                }
            }
        }
    }
}
