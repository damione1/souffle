import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";
import { ThemedButton, ThemedButtonKind } from "../themed_button.slint";
import { ThemedSpinBox } from "../themed_spin.slint";
import { ThemedCheckbox } from "../themed_checkbox.slint";
import { AccessState } from "../../types.slint";

export struct CalendarRow {
    id: string,
    title: string,
    source-title: string,
    selected: bool,
    show-header: bool,
}

// Port of CalendarSettingsSection.svelte.
export component CalendarSection inherits VerticalLayout {
    in property <bool> enabled;
    in property <AccessState> permission;
    in property <bool> autostart-enabled;
    in property <int> reminder-minutes;
    in property <[CalendarRow]> calendars;

    callback enabled-changed(bool);
    callback autostart-enabled-changed(bool);
    callback reminder-minutes-changed(int);
    callback calendar-toggled(string);
    callback open-system-settings-requested();

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "CALENDRIER";

        SettingsField {
            show-divider: false;
            label: "Intégration du calendrier";
            description: "Afficher les réunions du jour sur l'accueil et rappeler avant qu'elles commencent.";

            ThemedSwitch {
                checked: root.enabled;
                toggled(new) => { root.enabled-changed(new); }
            }
        }

        if root.permission == AccessState.denied: Rectangle {
            background: Theme.danger.with-alpha(0.1);

            HorizontalLayout {
                padding: 12px;
                spacing: 16px;
                alignment: space-between;

                Text {
                    text: "L'accès au calendrier a été refusé.";
                    color: Theme.text-primary;
                    font-size: 13.5px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                ThemedButton {
                    text: "Ouvrir les Réglages Système";
                    kind: ThemedButtonKind.primary;
                    clicked => { root.open-system-settings-requested(); }
                }
            }
        }

        if root.enabled && root.permission == AccessState.granted: SettingsField {
            label: "Proposer au début de la réunion";
            description: "Quand un événement commence et que l'audio système est actif, proposer de démarrer l'enregistrement.";

            ThemedSwitch {
                checked: root.autostart-enabled;
                toggled(new) => { root.autostart-enabled-changed(new); }
            }
        }

        if root.enabled && root.permission == AccessState.granted: SettingsField {
            label: "Délai du rappel";
            description: "Minutes avant un événement pour proposer de démarrer une transcription (1-30).";

            ThemedSpinBox {
                value: root.reminder-minutes;
                minimum: 1;
                maximum: 30;
                step: 1;
                edited(value) => { root.reminder-minutes-changed(value); }
            }
        }

        if root.enabled && root.permission == AccessState.granted && root.calendars.length > 0: VerticalLayout {
            padding-top: 15px;
            padding-bottom: 15px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            alignment: start;

            Text {
                text: "Calendriers";
                font-size: 13.5px;
                color: Theme.text-secondary;
            }
            Text {
                text: "Tous les calendriers sont inclus ; décochez ceux à masquer.";
                font-size: 12px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            for row in root.calendars: VerticalLayout {
                alignment: start;
                spacing: 4px;

                if row.show-header && row.source-title != "": Text {
                    text: row.source-title;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1.65px;
                    color: Theme.text-muted;
                    padding-top: 8px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    ThemedCheckbox {
                        checked: row.selected;
                        toggled(_) => { root.calendar-toggled(row.id); }
                    }
                    Text {
                        text: row.title;
                        font-size: 13.5px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
