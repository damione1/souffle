import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedComboBox } from "../themed_combo.slint";
import { StatusIndicator } from "status_indicator.slint";

// Port of ModelSettingsSection.svelte. The download/switch state machine
// itself is not reimplemented here (AC2): it stays entirely in Rust
// (`model_ui.rs`, calling the same `get_model_status`/`download_model`/
// `load_model` commands the Svelte controller calls), this component only
// displays whatever state Rust pushes and forwards the chosen label back.
export component ModelSection inherits VerticalLayout {
    in property <string> status-text;
    in property <bool> ready;
    in property <[string]> model-labels;
    in property <string> selected-model-label;
    in property <bool> busy;
    in property <bool> downloading;
    in property <string> download-progress-label;
    in property <float> download-progress-fraction;
    in property <[string]> unload-timeout-labels;
    in property <string> unload-timeout-label;
    in property <string> error-message;

    callback model-changed(string);
    callback unload-timeout-changed(string);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: @tr("MODÈLE DE TRANSCRIPTION");

    SettingsField {
        show-divider: false;
        label: @tr("Modèle de transcription");
        description: @tr("Choisissez un modèle : il se télécharge et se charge tout seul. Tout tourne sur ce Mac.");

        StatusIndicator {
            text: root.status-text;
            indicator-color: root.ready ? Theme.accent : Theme.warning;
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-bottom: 15px;
        combo-host := Rectangle {
            height: Theme.settings-control-height;
            vertical-stretch: 0;
            clip: true;
            ThemedComboBox {
                control-label: @tr("Modèle de transcription");
                width: parent.width;
                combo-width: parent.width;
                model: root.model-labels;
                current-value: root.selected-model-label;
                enabled: !root.busy;
                selected(value) => { root.model-changed(value); }
            }
        }
    }

    if root.downloading: VerticalLayout {
        spacing: 4px;
        Text {
            text: root.download-progress-label;
            font-size: 11px;
            color: Theme.text-muted;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface-3;
            Rectangle {
                height: 6px;
                width: parent.width * max(0.05, root.download-progress-fraction);
                border-radius: 3px;
                background: Theme.accent;
            }
        }
    }

    if root.error-message != "": Text {
        text: root.error-message;
        color: Theme.danger;
        font-size: 11.5px;
        wrap: word-wrap;
    }

    SettingsField {
        label: @tr("Délai avant déchargement");
        description: @tr("Décharger le modèle de la mémoire après une période d'inactivité.");

        ThemedComboBox {
            control-label: @tr("Délai avant déchargement");
            model: root.unload-timeout-labels;
            current-value: root.unload-timeout-label;
            selected(value) => { root.unload-timeout-changed(value); }
        }
    }
    }
}
