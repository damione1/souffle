import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";
import { ThemedButton } from "../themed_button.slint";
import { ThemedComboBox } from "../themed_combo.slint";
import { LucideIcon, IconSet } from "../lucide_icon.slint";

enum MicIconKind { refresh, up, down, trash }

component MicIconButton inherits Rectangle {
    in property <MicIconKind> kind;
    in property <bool> enabled: true;
    in property <color> glyph-color: Theme.text-primary;
    in property <string> control-label;
    callback clicked();

    width: Theme.settings-control-height;
    height: Theme.settings-control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: key-focus.has-focus ? 2px : 1px;
    border-color: key-focus.has-focus ? Theme.accent : Theme.ghost-border;
    background: area.pressed ? Theme.surface-2 : area.has-hover && root.enabled ? Theme.surface-4 : Theme.surface-3;
    opacity: root.enabled ? 1.0 : 0.4;

    accessible-role: button;
    accessible-label: root.control-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    forward-focus: key-focus;
    key-focus := FocusScope {
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    LucideIcon {
        icon: root.kind == MicIconKind.refresh ? IconSet.RefreshCw
            : (root.kind == MicIconKind.up ? IconSet.ChevronUp
            : (root.kind == MicIconKind.down ? IconSet.ChevronDown
            : IconSet.Trash2));
        icon-color: root.glyph-color;
        size: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}

// One row of the priority list. Fully precomputed by Rust
// (`microphone_list.rs`, a port of `microphone-list.ts`'s pure functions) so
// this stays a plain `for` repeater with no lookup logic in `.slint` - Slint
// has no array-search construct usable inside a `pure function` body, only
// as an item-tree repeater (confirmed against i-slint-compiler's grammar
// while building this section).
export struct MicrophoneRow {
    uid: string,
    name: string,
    transport-label: string,
    is-default: bool,
    connected: bool,
    hidden: bool,
    last-seen-label: string,
    is-first: bool,
    is-last: bool,
}

// Port of MicrophoneSettingsSection.svelte. Device pickers forward the
// chosen *label* back to Rust (which already holds the device list used to
// build that label array) rather than an index or uid resolved in `.slint` -
// same reason as the `MicrophoneRow` precomputation above.
export component MicrophoneSection inherits VerticalLayout {
    in property <[string]> device-labels;
    in property <string> selected-device-label;
    in property <bool> pin-unavailable;
    in property <string> sample-rate-label; // "" hides the row
    in property <bool> sample-rate-high;
    in property <bool> resetting-sample-rate;
    in property <bool> allow-bluetooth-mic;
    in property <[MicrophoneRow]> microphones;
    in property <bool> has-disconnected;

    callback device-changed(string);
    callback refresh-requested();
    callback reset-devices-requested();
    callback reset-sample-rate-requested();
    callback allow-bluetooth-mic-changed(bool);
    callback move-device-requested(string, int);
    callback toggle-hidden-requested(string, bool);
    callback remove-device-requested(string);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: @tr("MICROPHONE");

    SettingsField {
        show-divider: false;
        label: "Périphérique d'entrée";
        description: "Choisissez le microphone que Soufflé écoute et configurez le traitement audio.";

        HorizontalLayout {
            spacing: 6px;
            alignment: center;
            horizontal-stretch: 0;

            ThemedComboBox {
                control-label: @tr("Microphone actif");
                model: root.device-labels;
                current-value: root.selected-device-label;
                selected(value) => { root.device-changed(value); }
            }
            MicIconButton {
                kind: MicIconKind.refresh;
                control-label: @tr("Actualiser les microphones");
                clicked => { root.refresh-requested(); }
            }
            if root.has-disconnected: ThemedButton {
                text: @tr("Réinitialiser la liste");
                clicked => { root.reset-devices-requested(); }
            }
        }
    }

    if root.pin-unavailable: Text {
        text: @tr("Le périphérique choisi n'est plus disponible ; un autre est utilisé en attendant.");
        color: Theme.warning;
        font-size: 11.5px;
        wrap: word-wrap;
    }

    if root.sample-rate-label != "": SettingsField {
        label: "Fréquence d'échantillonnage";
        description: "Fréquence native du périphérique sélectionné.";

        Rectangle {
            height: Theme.settings-control-height;
            width: sample-rate-text.width + 24px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-soft;
            background: Theme.input;

            sample-rate-text := Text {
                x: 12px;
                height: parent.height;
                text: root.sample-rate-label;
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    if root.sample-rate-high: VerticalLayout {
        spacing: 6px;

        Text {
            text: @tr("Cette fréquence élevée peut perturber les appels en visioconférence pendant l'enregistrement.");
            color: Theme.warning;
            font-size: 11.5px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;

            ThemedButton {
                text: root.resetting-sample-rate ? "Réinitialisation…" : "Réinitialiser à 48 kHz";
                enabled: !root.resetting-sample-rate;
                clicked => { root.reset-sample-rate-requested(); }
            }
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-top: 15px;
        padding-bottom: 8px;
        spacing: 8px;

        Text {
            text: @tr("Ordre de préférence");
            font-size: 13.5px;
            color: Theme.text-secondary;
        }
        Text {
            text: @tr("Utilisé quand plusieurs micros sont branchés en même temps.");
            font-size: 12px;
            color: Theme.text-muted;
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.border-soft;
            border-radius: 6px;
            clip: true;
            background: Theme.surface-1;
            vertical-stretch: 0;

            VerticalLayout {
                spacing: 0px;

                for row in root.microphones: VerticalLayout {
                    spacing: 0px;
                    opacity: row.connected ? 1.0 : 0.7;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.name;
                                    font-size: 12.5px;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                    wrap: no-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: row.transport-label + (row.is-default ? " · par défaut" : "");
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                            if !row.connected && row.last-seen-label != "": Text {
                                text: row.last-seen-label;
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            horizontal-stretch: 0;

                            MicIconButton {
                                kind: MicIconKind.up;
                                control-label: "Monter " + row.name;
                                enabled: !row.is-first;
                                clicked => { root.move-device-requested(row.uid, -1); }
                            }
                            MicIconButton {
                                kind: MicIconKind.down;
                                control-label: "Descendre " + row.name;
                                enabled: !row.is-last;
                                clicked => { root.move-device-requested(row.uid, 1); }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                ThemedSwitch {
                                    control-label: "Masquer " + row.name;
                                    checked: row.hidden;
                                    toggled(new) => { root.toggle-hidden-requested(row.uid, new); }
                                }
                                Text {
                                    text: @tr("Masquer");
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: Theme.settings-control-height;
                                height: Theme.settings-control-height;
                                horizontal-stretch: 0;
                                vertical-stretch: 0;

                                if !row.connected: MicIconButton {
                                    kind: MicIconKind.trash;
                                    control-label: "Supprimer " + row.name;
                                    glyph-color: Theme.danger;
                                    clicked => { root.remove-device-requested(row.uid); }
                                }
                            }
                        }
                    }

                    if !row.is-last: Rectangle {
                        height: 1px;
                        background: Theme.border-soft;
                        vertical-stretch: 0;
                    }
                }
            }
        }
    }

    SettingsField {
        label: "Autoriser les micros Bluetooth";
        description: "Sinon, un casque Bluetooth n'est jamais sélectionné automatiquement (évite le mode mono basse qualité).";

        ThemedSwitch {
            control-label: @tr("Autoriser les micros Bluetooth");
            checked: root.allow-bluetooth-mic;
            toggled(new) => { root.allow-bluetooth-mic-changed(new); }
        }
    }
    }
}
