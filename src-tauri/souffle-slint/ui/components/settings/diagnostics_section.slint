import { ComboBox, Button, ScrollView } from "std-widgets.slint";
import { SettingsField } from "settings_field.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";

// Port of DiagnosticsSettingsSection.svelte. `log-tail` is refreshed by
// main.rs on a timer while the Diagnostics tab is visible (same poll idea as
// the Svelte version's setInterval), not computed here.
export component DiagnosticsSection inherits VerticalLayout {
    in-out property <bool> debug-transcription;
    in property <string> log-level; // "error" | "warn" | "info" | "debug" | "trace"
    in property <string> log-tail;
    in property <bool> copying-diagnostics: false;

    callback debug-transcription-changed(bool);
    callback log-level-changed(string);
    callback copy-diagnostics-requested();

    // `LogLevel::as_str()` <-> the French combobox labels below.
    pure function log-level-label(value: string) -> string {
        if value == "error" { return "Erreur"; }
        if value == "warn" { return "Avertissement"; }
        if value == "debug" { return "Débogage"; }
        if value == "trace" { return "Trace"; }
        return "Info";
    }

    pure function log-level-value(label: string) -> string {
        if label == "Erreur" { return "error"; }
        if label == "Avertissement" { return "warn"; }
        if label == "Débogage" { return "debug"; }
        if label == "Trace" { return "trace"; }
        return "info";
    }

    spacing: 10px;

    Text {
        text: "Diagnostics";
        font-size: 13.5px;
        font-weight: 700;
        color: Theme.text-primary;
    }

    SettingsField {
        label: "Niveau de journal";
        description: "Quantité de détails écrits dans le fichier journal.";

        ComboBox {
            model: ["Erreur", "Avertissement", "Info", "Débogage", "Trace"];
            current-value: root.log-level-label(root.log-level);
            selected(value) => { root.log-level-changed(root.log-level-value(value)); }
        }
    }

    SettingsField {
        label: "Journaux détaillés de transcription";
        description: "Enregistre des détails supplémentaires sur la reconnaissance vocale pour le dépannage.";

        ThemedSwitch {
            checked: root.debug-transcription;
            toggled(new) => { root.debug-transcription-changed(new); }
        }
    }

    VerticalLayout {
        spacing: 4px;

        Text {
            text: "Journal en direct";
            font-size: 13px;
            font-weight: 600;
            color: Theme.text-primary;
        }
        Text {
            text: "Fin du fichier journal actuel, actualisé toutes les quelques secondes.";
            font-size: 11.5px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        Rectangle {
            height: 140px;
            border-width: 1px;
            border-color: Theme.surface-4;

            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    alignment: start;

                    Text {
                        text: root.log-tail == "" ? "Aucune entrée de journal pour l'instant." : root.log-tail;
                        font-family: "monospace";
                        font-size: 10.5px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;

        Button {
            text: root.copying-diagnostics ? "Copie…" : "Copier les diagnostics";
            enabled: !root.copying-diagnostics;
            clicked => { root.copy-diagnostics-requested(); }
        }
    }
}
