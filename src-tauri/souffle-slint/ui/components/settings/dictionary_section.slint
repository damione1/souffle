import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";
import { ThemedButton } from "../themed_button.slint";
import { ThemedLineEdit } from "../themed_line_edit.slint";
import { ListView } from "std-widgets.slint";


// Port of DictionarySettingsSection.svelte. Simplified: aliases (comma-
// separated pronunciations) show as plain text per entry rather than
// individually removable chips - add/delete/list are the real thing
// against the dictionary DB, this only drops the one-alias-at-a-time
// removal affordance (documented gap, not a placeholder).
export struct DictionaryRow {
    id: int,
    term: string,
    aliases-display: string,
    category: string,
}

export component DictionarySection inherits VerticalLayout {
    in property <bool> learn-from-edit;
    in property <[DictionaryRow]> entries;
    in-out property <string> new-term-draft: "";
    in-out property <string> new-pronunciation-draft: "";
    in-out property <string> new-category-draft: "";
    in property <string> add-error;
    in property <int> delete-error-id;
    in property <string> delete-error;

    callback learn-from-edit-changed(bool);
    callback add-requested(string, string, string);
    callback delete-requested(int);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "DICTIONNAIRE PERSONNALISÉ";

    SettingsField {
        show-divider: false;
        label: "Apprendre depuis les corrections après collage";
        description: "Quand le collage auto est actif, retenir les corrections mot à mot faites dans l'app cible pour les dictées suivantes.";

        ThemedSwitch {
            control-label: "Apprendre depuis les corrections après collage";
            checked: root.learn-from-edit;
            toggled(new) => { root.learn-from-edit-changed(new); }
        }
    }

    VerticalLayout {
        padding-left: Theme.settings-inset;
        padding-right: Theme.settings-inset;
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 8px;

        Text {
            text: "Termes techniques, noms propres ou acronymes mal reconnus.";
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "TERME";
                    font-size: 10.5px;
                    color: Theme.text-tertiary;
                    font-family: "Archivo Bold";
                    letter-spacing: 1px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "PRONONCIATION";
                    font-size: 10.5px;
                    color: Theme.text-tertiary;
                    font-family: "Archivo Bold";
                    letter-spacing: 1px;
                    width: 110px;
                }
                Text {
                    text: "CATÉGORIE";
                    font-size: 10.5px;
                    color: Theme.text-tertiary;
                    font-family: "Archivo Bold";
                    letter-spacing: 1px;
                    width: 100px;
                }
                Rectangle {
                    width: 88px;
                    height: 1px;
                    horizontal-stretch: 0;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                ThemedLineEdit {
                    text <=> root.new-term-draft;
                    placeholder: "ex. Kubernetes";
                    control-label: "Terme";
                    horizontal-stretch: 1;
                }
                ThemedLineEdit {
                    text <=> root.new-pronunciation-draft;
                    placeholder: "ex. vaysix";
                    control-label: "Prononciation facultative";
                    width: 110px;
                }
                ThemedLineEdit {
                    text <=> root.new-category-draft;
                    placeholder: "ex. tech";
                    control-label: "Catégorie facultative";
                    width: 100px;
                }
                ThemedButton {
                    text: "Ajouter";
                    enabled: root.new-term-draft != "";
                    clicked => {
                        root.add-requested(root.new-term-draft, root.new-pronunciation-draft, root.new-category-draft);
                    }
                }
            }
        }

        if root.add-error != "": Text {
            text: root.add-error;
            color: Theme.danger;
            font-size: 11px;
        }

        if root.entries.length == 0: Text {
            text: "Aucune entrée.";
            font-size: 12px;
            color: Theme.text-muted;
        }
    }

    dictionary-list := ListView {
        height: min(root.entries.length * 64px, 360px);
        visible: root.entries.length > 0;

        for row in root.entries: Rectangle {
            height: root.delete-error != "" && root.delete-error-id == row.id ? 88px : 64px;

            Rectangle {
                x: Theme.settings-inset;
                width: parent.width - 2 * Theme.settings-inset;
                height: parent.height - 6px;
                border-width: 1px;
                border-color: Theme.border-soft;
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: row.term + (row.aliases-display == "" ? "" : "  (" + row.aliases-display + ")");
                                font-size: 12.5px;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            if row.category != "": Text {
                                text: row.category;
                                font-size: 10.5px;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }
                        ThemedButton {
                            text: "Supprimer";
                            clicked => { root.delete-requested(row.id); }
                        }
                    }

                    if root.delete-error != "" && root.delete-error-id == row.id: Text {
                        text: root.delete-error;
                        color: Theme.danger;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }
        }
    }
    }
}
