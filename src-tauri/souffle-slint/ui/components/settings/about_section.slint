import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";
import { ThemedButton } from "../themed_button.slint";

// Port of AboutSettingsSection.svelte. `UpdateAction` (the download-progress
// + install button shown once an update is found) is not built here - a
// full updater UI is a standalone feature disproportionate to this tab, and
// is left for a follow-up ticket. "Check for updates" itself is real
// (`check_for_updates`), it just reports the result as text rather than
// offering to install it.
export component AboutSection inherits VerticalLayout {
    in property <string> app-version;
    in property <string> transcription-label;
    in property <string> summary-label;
    in property <bool> auto-update-check;
    in property <bool> checking-updates;
    in property <string> update-status;

    callback check-updates-requested();
    callback auto-update-check-changed(bool);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "À PROPOS";

        SettingsField {
            show-divider: false;
            label: "Version";

            Text {
                text: root.app-version == "local build" ? "Build local" : "v" + root.app-version;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                overflow: elide;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        SettingsField {
            label: "Transcription";

            Text {
                text: root.transcription-label;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                overflow: elide;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        SettingsField {
            label: "Résumés";

            Text {
                text: root.summary-label;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                overflow: elide;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        SettingsField {
            label: "Confidentialité";

            Text {
                text: "100% local";
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                width: Theme.settings-control-width;
                vertical-alignment: center;
            }
        }

        SettingsField {
            label: "Mises à jour";
            description: root.update-status;

            ThemedButton {
                text: root.checking-updates ? "Vérification…" : "Vérifier les mises à jour";
                enabled: !root.checking-updates;
                clicked => { root.check-updates-requested(); }
            }
        }

        SettingsField {
            label: "Vérification automatique";
            description: "Vérifier les mises à jour au démarrage.";

            ThemedSwitch {
                control-label: "Vérification automatique des mises à jour";
                checked: root.auto-update-check;
                toggled(new) => { root.auto-update-check-changed(new); }
            }
        }
    }
}
