import { TextEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { SettingsGroup } from "settings_group.slint";
import { ThemedButton } from "../themed_button.slint";
import { ThemedLineEdit } from "../themed_line_edit.slint";

// Port of SnippetsSettingsSection.svelte. Which row is being edited is
// tracked in Rust (`snippets_editing` in main.rs), not local `.slint`
// state, so only one row edits at a time and the edit form always reads
// the real backing entry.
export struct SnippetRow {
    id: int,
    trigger: string,
    expansion: string,
    editing: bool,
}

export component SnippetsSection inherits VerticalLayout {
    in property <[SnippetRow]> entries;
    in-out property <string> new-trigger-draft: "";
    in-out property <string> new-expansion-draft: "";
    in property <string> add-error;
    in-out property <string> edit-trigger-draft: "";
    in-out property <string> edit-expansion-draft: "";
    in property <string> update-error;

    callback add-requested(string, string);
    callback delete-requested(int);
    callback edit-requested(int);
    callback cancel-edit-requested();
    callback save-edit-requested(int, string, string);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "SNIPPETS VOCAUX";

    Text {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 15px;
        text: "Dites une phrase déclencheur au début d'une dictée pour coller un bloc de texte à la place. La comparaison ignore casse et accents ; aucun polish IA ne tourne quand un snippet correspond.";
        font-size: 12px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }

    VerticalLayout {
        spacing: 4px;

        Text { text: "DÉCLENCHEUR"; font-size: 10.5px; color: Theme.text-tertiary; font-family: "Archivo Bold"; letter-spacing: 1px; }
        ThemedLineEdit { text <=> root.new-trigger-draft; }
        Text { text: "EXPANSION"; font-size: 10.5px; color: Theme.text-tertiary; font-family: "Archivo Bold"; letter-spacing: 1px; }
        TextEdit {
            text <=> root.new-expansion-draft;
            height: 60px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            ThemedButton {
                text: "Ajouter un snippet";
                enabled: root.new-trigger-draft != "" && root.new-expansion-draft != "";
                clicked => {
                    root.add-requested(root.new-trigger-draft, root.new-expansion-draft);
                    root.new-trigger-draft = "";
                    root.new-expansion-draft = "";
                }
            }
        }
    }

    if root.add-error != "": Text {
        text: root.add-error;
        color: Theme.danger;
        font-size: 11px;
    }

    if root.entries.length == 0: Text {
        text: "Aucune formule.";
        color: Theme.text-muted;
        font-size: 11.5px;
    }

    for row in root.entries: Rectangle {
        border-width: 1px;
        border-color: Theme.surface-4;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            if !row.editing: VerticalLayout {
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: row.trigger;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        ThemedButton {
                            text: "Modifier";
                            clicked => { root.edit-requested(row.id); }
                        }
                        ThemedButton {
                            text: "Supprimer";
                            clicked => { root.delete-requested(row.id); }
                        }
                    }
                }
                Text {
                    text: row.expansion;
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            if row.editing: VerticalLayout {
                spacing: 4px;

                Text { text: "DÉCLENCHEUR"; font-size: 10.5px; color: Theme.text-tertiary; font-family: "Archivo Bold"; letter-spacing: 1px; }
                ThemedLineEdit { text <=> root.edit-trigger-draft; }
                Text { text: "EXPANSION"; font-size: 10.5px; color: Theme.text-tertiary; font-family: "Archivo Bold"; letter-spacing: 1px; }
                TextEdit {
                    text <=> root.edit-expansion-draft;
                    height: 60px;
                    wrap: word-wrap;
                }
                if root.update-error != "": Text {
                    text: root.update-error;
                    color: Theme.danger;
                    font-size: 11px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    ThemedButton {
                        text: "Annuler";
                        clicked => { root.cancel-edit-requested(); }
                    }
                    ThemedButton {
                        text: "Enregistrer";
                        enabled: root.edit-trigger-draft != "" && root.edit-expansion-draft != "";
                        clicked => { root.save-edit-requested(row.id, root.edit-trigger-draft, root.edit-expansion-draft); }
                    }
                }
            }
        }
    }
    }
}
