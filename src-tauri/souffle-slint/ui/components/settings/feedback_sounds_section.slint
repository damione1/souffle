import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedSwitch } from "../themed_switch.slint";
import { ThemedSlider } from "../themed_slider.slint";

// Port of FeedbackSoundsSettingsSection.svelte.
export component FeedbackSoundsSection inherits VerticalLayout {
    in property <bool> enabled;
    in property <int> volume;

    callback enabled-changed(bool);
    callback volume-changed(int);

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "SONS DE DICTÉE";

        SettingsField {
            show-divider: false;
            label: "Activer les sons";
            description: "Jouer un son au démarrage et à l'arrêt de l'enregistrement.";

            ThemedSwitch {
                control-label: "Activer les sons";
                checked: root.enabled;
                toggled(new) => { root.enabled-changed(new); }
            }
        }

        if root.enabled: SettingsField {
            label: "Volume";

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                horizontal-stretch: 0;

                ThemedSlider {
                    value: root.volume;
                    minimum: 0;
                    maximum: 100;
                    changed(value) => { root.volume-changed(value); }
                }

                Text {
                    text: root.volume + "%";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    width: 34px;
                }
            }
        }
    }
}
