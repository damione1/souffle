import { Switch, Slider } from "std-widgets.slint";
import { SettingsField } from "settings_field.slint";

// Port of FeedbackSoundsSettingsSection.svelte.
export component FeedbackSoundsSection inherits VerticalLayout {
    in property <bool> enabled;
    in property <int> volume;

    callback enabled-changed(bool);
    callback volume-changed(int);

    spacing: 10px;

    Text {
        text: "Sons de retour";
        font-size: 13.5px;
        font-weight: 700;
        color: white;
    }

    SettingsField {
        label: "Activer les sons";
        description: "Jouer un son au démarrage et à l'arrêt de l'enregistrement.";

        Switch {
            checked: root.enabled;
            toggled => { root.enabled-changed(self.checked); }
        }
    }

    if root.enabled: SettingsField {
        label: "Volume";

        HorizontalLayout {
            spacing: 10px;
            max-width: 220px;

            Slider {
                minimum: 0;
                maximum: 100;
                value: root.volume;
                horizontal-stretch: 1;
                changed(value) => { root.volume-changed(round(value)); }
            }

            Text {
                text: root.volume + "%";
                color: #999;
                font-size: 11.5px;
                vertical-alignment: center;
                width: 34px;
            }
        }
    }
}
