import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { ThemedButton } from "../themed_button.slint";
import { ThemedComboBox } from "../themed_combo.slint";
import { ThemedLineEdit } from "../themed_line_edit.slint";
import { SummaryProvider } from "../../types.slint";

// Port of IntelligenceSettingsSection.svelte. The exact per-reason-code
// wording (`KNOWN_REASON_KEYS`) and the fine-grained model-picker
// visibility state machine (`ollamaModelPickerState`) are simplified to
// generic messages/conditions here - functional parity (the real
// check_summary_providers status drives everything), wording polish is a
// follow-up pass. Model pickers forward their chosen *label* back to Rust
// for id resolution, same reasoning as the audio device pickers.
export component IntelligenceSection inherits VerticalLayout {
    in property <SummaryProvider> summary-provider;
    in property <bool> apple-intelligence-available;
    in property <string> apple-intelligence-reason; // "" when available
    in property <string> ollama-url;
    in property <bool> ollama-available;
    in property <bool> ollama-checking;
    in property <int> summary-model-count;
    in property <bool> model-picker-visible;
    in property <[string]> model-labels;
    in property <string> selected-model-label;
    in property <bool> show-ollama-setup;
    in property <bool> ollama-pulling;
    in property <string> ollama-pull-status;
    in property <string> ollama-pull-error;
    in property <string> recommended-model;
    in property <string> unusable-message; // "" when the chosen provider can run

    callback summary-provider-changed(SummaryProvider);
    callback ollama-url-changed(string);
    callback ollama-model-changed(string);
    callback retry-requested();
    callback download-recommended-requested();
    callback open-apple-intelligence-settings-requested();

    pure function provider-label(value: SummaryProvider) -> string {
        if value == SummaryProvider.apple-intelligence { return "Apple Intelligence"; }
        if value == SummaryProvider.ollama { return "Ollama"; }
        if value == SummaryProvider.auto { return "Automatique"; }
        return "";
    }

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "RÉSUMÉS";

    SettingsField {
        show-divider: false;
        label: "Moteur";
        description: "Le moteur qui rédige les résumés et nettoie la dictée.";

        ThemedComboBox {
            control-label: "Moteur de résumé";
            model: [
                root.provider-label(SummaryProvider.auto),
                root.provider-label(SummaryProvider.apple-intelligence),
                root.provider-label(SummaryProvider.ollama),
            ];
            current-value: root.provider-label(root.summary-provider);
            selected(value) => {
                if value == root.provider-label(SummaryProvider.apple-intelligence) {
                    root.summary-provider-changed(SummaryProvider.apple-intelligence);
                }
                if value == root.provider-label(SummaryProvider.ollama) {
                    root.summary-provider-changed(SummaryProvider.ollama);
                }
                if value == root.provider-label(SummaryProvider.auto) {
                    root.summary-provider-changed(SummaryProvider.auto);
                }
            }
        }
    }

    if root.unusable-message != "": Rectangle {
        border-width: 1px;
        border-color: Theme.danger;
        border-radius: 6px;
        background: Theme.surface-2;

        VerticalLayout {
            padding: 10px;
            Text {
                text: root.unusable-message;
                color: Theme.danger;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
    }

    SettingsField {
        label: "Apple Intelligence";

        HorizontalLayout {
            spacing: 6px;
            alignment: center;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.apple-intelligence-available ? Theme.success : Theme.text-faint;
                vertical-stretch: 0;
            }
            Text {
                text: root.apple-intelligence-available ? "Disponible" : "Non disponible";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
        }
    }

    if root.apple-intelligence-reason != "": Rectangle {
        border-width: 1px;
        border-color: Theme.surface-4;
        border-radius: 6px;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            alignment: space-between;

            Text {
                text: root.apple-intelligence-reason;
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.apple-intelligence-reason == "apple_intelligence_not_enabled": ThemedButton {
                text: "Réglages Système";
                clicked => { root.open-apple-intelligence-settings-requested(); }
            }
        }
    }

    SettingsField {
        label: "URL Ollama";
        description: "Adresse du serveur Ollama local ou distant.";

        ThemedLineEdit {
            width: Theme.settings-control-width;
            control-label: "URL Ollama";
            placeholder: "http://localhost:11434";
            text: root.ollama-url;
            edited(value) => { root.ollama-url-changed(value); }
        }
    }

    SettingsField {
        label: "État de la connexion";
        description: root.summary-model-count == 0 ? "Aucun modèle trouvé."
            : root.summary-model-count == 1 ? "1 modèle trouvé."
            : root.summary-model-count + " modèles trouvés.";

        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                vertical-stretch: 0;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.ollama-available ? Theme.success : Theme.text-faint;
                    vertical-stretch: 0;
                }
                Text {
                    text: root.ollama-available ? "Connecté" : "Non disponible";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
            ThemedButton {
                text: "Réessayer";
                enabled: !root.ollama-checking && !root.ollama-pulling;
                clicked => { root.retry-requested(); }
            }
        }
    }

    if root.model-picker-visible: SettingsField {
        label: "Modèle de résumé";

        ThemedComboBox {
            control-label: "Modèle de résumé";
            model: root.model-labels;
            current-value: root.selected-model-label;
            selected(value) => { root.ollama-model-changed(value); }
        }
    }

    if root.show-ollama-setup: VerticalLayout {
        spacing: 8px;

        Text {
            text: "Aucun modèle compatible installé.";
            color: Theme.warning;
            font-size: 11.5px;
        }

        if root.ollama-pull-error != "": Text {
            text: "Échec du téléchargement : " + root.ollama-pull-error;
            color: Theme.danger;
            font-size: 11.5px;
            wrap: word-wrap;
        }

        if root.ollama-pulling: Text {
            text: root.ollama-pull-status == "" ? "Téléchargement de " + root.recommended-model + "…" : root.ollama-pull-status;
            color: Theme.text-muted;
            font-size: 11.5px;
        }

        if !root.ollama-pulling: HorizontalLayout {
            alignment: end;
            ThemedButton {
                text: "Télécharger " + root.recommended-model;
                clicked => { root.download-recommended-requested(); }
            }
        }
    }
    }
}
