import { SettingsField } from "settings_field.slint";
import { SettingsGroup } from "settings_group.slint";
import { Theme } from "../../theme.slint";
import { LucideIcon, IconSet } from "../lucide_icon.slint";

// Port of PermissionsSettingsSection.svelte.
export component PermissionsSection inherits VerticalLayout {
    callback review-requested();

    spacing: 22px;
    alignment: start;

    SettingsGroup {
        title: "PERMISSIONS";

        SettingsField {
            show-divider: false;
            label: "Permissions";
            description: "Revérifier ou réparer les permissions macOS si le collage ou l'enregistrement cesse de fonctionner après une mise à jour.";

            review := Rectangle {
                height: 32px;
                width: 16px + 6px + btn-label.width + 8px;
                background: area.has-hover ? Theme.surface-2 : transparent;
                border-radius: 4px;

                LucideIcon {
                    icon: IconSet.Shield;
                    icon-color: area.has-hover ? Theme.text-primary : Theme.text-muted;
                    size: 16px;
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                }
                btn-label := Text {
                    x: 26px;
                    height: parent.height;
                    text: "Vérifier les permissions";
                    font-size: 13px;
                    color: area.has-hover ? Theme.text-primary : Theme.text-muted;
                    vertical-alignment: center;
                }
                area := TouchArea {
                    clicked => { root.review-requested(); }
                }
            }
        }
    }
}
