import { Theme } from "../../theme.slint";

// Compact status used on the right side of SettingsField rows. Children are
// positioned explicitly because a nested HorizontalLayout does not center its
// fixed-size dot on the text's cross axis reliably.
export component StatusIndicator inherits Rectangle {
    in property <string> text;
    in property <color> indicator-color: Theme.text-faint;

    height: 20px;
    width: 8px + 6px + label.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.indicator-color;
    }

    label := Text {
        x: 14px;
        y: 0px;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}
