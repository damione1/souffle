import { MarkdownBlock } from "markdown_block.slint";
import { Theme } from "../../theme.slint";

export component MarkdownView inherits VerticalLayout {
    in property <[MarkdownBlock]> blocks;

    callback link-clicked(string);

    alignment: start;
    spacing: 6px;

    for block in root.blocks: VerticalLayout {
        if block.kind == "heading": Text {
            text: block.text;
            font-size: 13.5px;
            font-weight: 700;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
        if block.kind == "bullet": HorizontalLayout {
            spacing: 6px;
            Text { text: "•"; color: Theme.text-muted; font-size: 12px; }
            Text {
                text: block.text;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if block.kind == "paragraph": Text {
            text: block.text;
            color: Theme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
        if block.kind == "link": TouchArea {
            clicked => { root.link-clicked(block.url); }
            Text {
                text: block.text;
                color: Theme.accent;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
    }
}
