import { LineEdit } from "std-widgets.slint";
import { NotesSaveState } from "types.slint";
import { AudioPlayerSection } from "components/audio_player_section.slint";
import { TranscriptSection, TranscriptBlock } from "components/transcript_section.slint";
import { SummarySection, StructuredActionItem } from "components/summary_section.slint";
import { LucideIcon, IconSet } from "components/lucide_icon.slint";
import { ThemedTextArea } from "components/themed_text_area.slint";
import { Theme } from "theme.slint";

// Port of MeetingHeaderSection.svelte + MeetingNotesSection.svelte -
// completed-meeting variant only. The live-recording variant of
// MeetingHeaderSection (stop button, recording badge, system-audio notice)
// is out of scope: this app shows RecordingView instead while a meeting is
// live (see main_window.slint), never this component.
//
// Milestones 6-9 scope, said here rather than hidden: header (title,
// rename, date/duration/segment count, participants) + notes (load, edit,
// debounced autosave) + native audio playback/waveform + read-only
// transcript with speaker labels, virtualized for long meetings + read-only
// summary (raw + structured). Not yet ported: transcript bulk/per-word edit
// + dictionary alias popover, summary generation itself (model/template
// pickers, streaming), export menu and resume-recording (need the native
// file dialog from SOU-191, not available to this headless bridge yet).
export component MeetingDetail inherits Rectangle {
    in property <string> title;
    in property <string> meta-line;
    in property <string> model-label;
    in property <[string]> participant-labels;
    in-out property <string> notes;
    in property <NotesSaveState> notes-save-state;
    in property <bool> has-audio: false;
    in property <bool> audio-is-playing: false;
    in property <[float]> audio-peaks;
    in property <float> audio-progress;
    in property <string> audio-position-label;
    in property <string> audio-duration-label;
    in property <[TranscriptBlock]> transcript-blocks;
    in property <int> transcript-segment-count;
    in property <float> transcript-spacer-before: 0.0;
    in property <float> transcript-spacer-after: 0.0;
    in-out property <length> transcript-scroll-top: 0px;
    in property <string> summary;
    in property <bool> summary-is-stale: false;
    in property <string> summary-model-label;
    in property <[string]> summary-key-points;
    in property <[string]> summary-decisions;
    in property <[StructuredActionItem]> summary-action-items;
    in property <[string]> summary-open-questions;
    in property <bool> summary-is-generating: false;
    in property <string> summary-generation-progress: "";
    in property <bool> can-resume: true;

    callback back-requested();
    callback resume-requested();
    callback summarize-requested();
    callback rename-requested(string);
    callback notes-changed(string);
    callback audio-play-pause-requested();
    callback audio-seek-requested(float);
    callback transcript-paragraph-clicked(int, float);
    callback transcript-alias-save-requested(string, string);

    property <bool> editing-title: false;
    property <string> title-draft;
    property <bool> is-empty-meeting: !root.has-audio && root.transcript-segment-count == 0 && root.summary == "";

    content := VerticalLayout {
        width: min(root.width - 52px, 720px);
        height: root.height;
        x: (root.width - self.width) / 2;
        padding-top: 26px;
        padding-bottom: 34px;
        spacing: 14px;

        back-btn := Rectangle {
            height: 28px;
            vertical-stretch: 0;

            border-radius: 4px;
            border-width: back-focus.has-focus ? 2px : 0px;
            border-color: Theme.accent;
            background: back-area.pressed ? Theme.surface-3 : back-area.has-hover ? Theme.surface-2 : transparent;

            accessible-role: button;
            accessible-label: @tr("Retour \u{e0} l'historique");
            accessible-action-default => { root.back-requested(); }

            forward-focus: back-focus;
            back-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        root.back-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            back-area := TouchArea {
                clicked => {
                    back-focus.focus();
                    root.back-requested();
                }
            }

            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                height: 18px;
                spacing: 8px;
                alignment: start;
                LucideIcon {
                    width: 18px;
                    height: 18px;
                    icon: IconSet.ArrowLeft;
                    icon-color: Theme.text-secondary;
                }
                Text {
                    text: @tr("Historique");
                    font-size: 13px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            spacing: 14px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 14px;

                if !root.editing-title: title-btn := Rectangle {
                    height: 34px;
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    border-radius: 4px;
                    border-width: title-focus.has-focus ? 2px : 0px;
                    border-color: Theme.accent;
                    background: title-area.has-hover ? Theme.surface-2 : transparent;

                    accessible-role: button;
                    accessible-label: @tr("Renommer la r\u{e9}union");
                    accessible-action-default => {
                        root.title-draft = root.title;
                        root.editing-title = true;
                    }

                    forward-focus: title-focus;
                    title-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == Key.Return || event.text == Key.Space {
                                root.title-draft = root.title;
                                root.editing-title = true;
                                return accept;
                            }
                            return reject;
                        }
                    }

                    title-area := TouchArea {
                        clicked => {
                            title-focus.focus();
                            root.title-draft = root.title;
                            root.editing-title = true;
                        }
                    }

                    Text {
                        text: root.title;
                        font-family: "Archivo SemiBold";
                        font-size: 24px;
                        font-weight: 700;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                if root.editing-title: LineEdit {
                    text <=> root.title-draft;
                    accessible-label: @tr("Titre de la réunion");
                    accepted => {
                        root.editing-title = false;
                        if (root.title-draft != "" && root.title-draft != root.title) {
                            root.rename-requested(root.title-draft);
                        }
                    }
                }

                HorizontalLayout {
                    height: 26px;
                    vertical-stretch: 0;
                    spacing: 9px;
                    alignment: start;

                    Text {
                        text: root.meta-line;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    if root.model-label != "": Rectangle {
                        width: model-chip.preferred-width + 16px;
                        height: 24px;
                        horizontal-stretch: 0;
                        border-width: 1px;
                        border-color: Theme.surface-4;

                        model-chip := Text {
                            text: root.model-label;
                            color: Theme.accent;
                            font-family: "JetBrains Mono";
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.participant-labels.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    for label in root.participant-labels: Text {
                        text: label;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }
            }

            if root.can-resume: resume-btn := Rectangle {
                width: resume-txt.preferred-width + 24px;
                height: 32px;
                horizontal-stretch: 0;
                vertical-stretch: 0;
                border-radius: 4px;
                border-width: resume-focus.has-focus ? 2px : 0px;
                border-color: Theme.text-primary;
                background: resume-area.pressed ? Theme.accent.darker(0.2) : resume-area.has-hover ? Theme.accent.darker(0.1) : Theme.accent;

                accessible-role: button;
                accessible-label: @tr("Reprendre l'enregistrement");
                accessible-action-default => { root.resume-requested(); }

                forward-focus: resume-focus;
                resume-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            root.resume-requested();
                            return accept;
                        }
                        return reject;
                    }
                }

                resume-area := TouchArea {
                    clicked => {
                        resume-focus.focus();
                        root.resume-requested();
                    }
                }

                resume-txt := Text {
                    text: @tr("Reprendre");
                    font-family: "Archivo SemiBold";
                    font-size: 13px;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.surface-4;
        }

        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                width: parent.width - 12px;
                padding-right: 14px;
                spacing: 22px;

                    Flickable {
                        vertical-stretch: 0;
                        viewport-height: notes-inner.preferred-height;
                        max-height: 250px;
                        notes-inner := VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                height: 24px;
                                vertical-stretch: 0;
                                spacing: 8px;

                                LucideIcon {
                                    width: 18px;
                                    height: 18px;
                                    icon: IconSet.PenLine;
                                    icon-color: Theme.accent;
                                }

                                Text {
                                    text: @tr("Notes");
                                    font-size: 13px;
                                    font-family: "Archivo SemiBold";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                if root.notes-save-state == NotesSaveState.saved: Text {
                                    text: @tr("Enregistr\u{e9}");
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                if root.notes-save-state == NotesSaveState.pending: Text {
                                    text: @tr("Enregistrement\u{2026}");
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            notes-edit := ThemedTextArea {
                                text <=> root.notes;
                                area-height: 96px;
                                placeholder: @tr("Ajoutez les décisions, actions et noms importants…");
                                control-label: @tr("Notes de la réunion");
                                edited(value) => { root.notes-changed(value); }
                            }

                            Text {
                                text: @tr("Les notes sont enregistr\u{e9}es avec la r\u{e9}union et am\u{e9}liorent le r\u{e9}sum\u{e9}.");
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        vertical-stretch: 0;
                        background: Theme.surface-4;
                    }

                    if root.is-empty-meeting: Rectangle {
                        height: 84px;
                        vertical-stretch: 0;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.border-soft;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 5px;
                            alignment: center;

                            Text {
                                text: @tr("Cette réunion ne contient aucun enregistrement.");
                                font-family: "Archivo SemiBold";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: @tr("Aucun audio, aucune transcription et aucun résumé.");
                                font-size: 11.5px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if !root.is-empty-meeting: AudioPlayerSection {
                        vertical-stretch: 0;
                        has-audio: root.has-audio;
                        is-playing: root.audio-is-playing;
                        peaks: root.audio-peaks;
                        progress: root.audio-progress;
                        position-label: root.audio-position-label;
                        duration-label: root.audio-duration-label;
                        play-pause-requested => { root.audio-play-pause-requested(); }
                        seek-requested(fraction) => { root.audio-seek-requested(fraction); }
                    }

                    if !root.is-empty-meeting: TranscriptSection {
                        vertical-stretch: 1;
                        blocks: root.transcript-blocks;
                        segment-count: root.transcript-segment-count;
                        has-audio: root.has-audio;
                        spacer-before: root.transcript-spacer-before;
                        spacer-after: root.transcript-spacer-after;
                        scroll-top <=> root.transcript-scroll-top;
                        paragraph-clicked(session, time) => { root.transcript-paragraph-clicked(session, time); }
                        alias-save-requested(term, pronunciation) => { root.transcript-alias-save-requested(term, pronunciation); }
                    }

                    if !root.is-empty-meeting: Flickable {
                        vertical-stretch: 0;
                        viewport-height: summary-inner.preferred-height;
                        max-height: 250px;
                        summary-inner := SummarySection {
                            vertical-stretch: 0;
                            summary: root.summary;
                            summary-is-stale: root.summary-is-stale;
                            summary-model-label: root.summary-model-label;
                            key-points: root.summary-key-points;
                            decisions: root.summary-decisions;
                            action-items: root.summary-action-items;
                            open-questions: root.summary-open-questions;
                            is-generating: root.summary-is-generating;
                            generation-progress: root.summary-generation-progress;
                            generate-requested => { root.summarize-requested(); }
                        }
                    }
                }
            }
        }
}
