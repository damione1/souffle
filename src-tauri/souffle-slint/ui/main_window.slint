import { LineEdit, Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Soufflé";
    preferred-width: 480px;
    preferred-height: 320px;

    // AC5: state Rust pushes into the UI is a plain property, no IPC/serialization.
    in-out property <string> status-text: "idle";
    // AC5: an action the UI asks Rust to perform is a plain callback.
    callback ping-requested();

    MenuBar {
        Menu {
            title: "Edit";
            MenuItem {
                title: "Cut";
                shortcut: @keys(Control + X);
                activated => { field.cut(); }
            }
            MenuItem {
                title: "Copy";
                shortcut: @keys(Control + C);
                activated => { field.copy(); }
            }
            MenuItem {
                title: "Paste";
                shortcut: @keys(Control + V);
                activated => { field.paste(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                activated => { field.select-all(); }
            }
        }
    }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "Soufflé — Slint shell (SOU-186 spike)";
            font-size: 16px;
        }

        // LineEdit (not bare TextInput) so this field is exposed to
        // accessibility: it sets accessible-role: text-input internally,
        // where the bare TextInput primitive sets none by default (AC7).
        field := LineEdit {
            text: "Type here to test Cut/Copy/Paste";
        }

        Button {
            text: "Ping backend";
            clicked => { root.ping-requested(); }
        }

        Text {
            text: "status: " + root.status-text;
        }
    }
}
