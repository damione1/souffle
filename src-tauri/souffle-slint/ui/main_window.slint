import { IdleView } from "idle_view.slint";
import { RecordingView } from "recording_view.slint";
import { MeetingDetail } from "meeting_detail.slint";
import { TimelineDayGroup } from "components/timeline_section.slint";
import { TranscriptBlock } from "components/transcript_section.slint";
import { RecordingMode, TimelineFilter, TimelineKind, NotesSaveState } from "types.slint";

export component MainWindow inherits Window {
    title: "Soufflé";
    preferred-width: 720px;
    preferred-height: 780px;

    in property <string> dictation-shortcut;
    in property <bool> model-ready: true;
    in-out property <string> search-query;
    in-out property <TimelineFilter> kind-filter: TimelineFilter.all;
    in property <string> transcription-status-message;
    in property <string> meeting-status-message;
    in property <[TimelineDayGroup]> timeline-groups;
    in property <bool> timeline-is-empty: true;
    in property <bool> timeline-has-matches: true;
    in property <string> live-meeting-id;
    // Rust-driven, set after a real start/stop command succeeds, never
    // optimistically from the UI alone.
    in-out property <RecordingMode> recording-mode: RecordingMode.idle;
    in-out property <string> live-text;
    in-out property <string> live-tentative;

    // Non-empty while a completed meeting is open in MeetingDetail. Empty
    // means "show the Timeline instead" - checked together with
    // recording-mode below so a live meeting always shows RecordingView
    // first, never MeetingDetail underneath it.
    in-out property <string> active-meeting-id;
    in property <string> meeting-detail-title;
    in property <string> meeting-detail-meta;
    in property <string> meeting-detail-model-label;
    in property <[string]> meeting-detail-participants;
    in-out property <string> meeting-detail-notes;
    in property <NotesSaveState> meeting-detail-notes-save-state;
    in property <bool> meeting-detail-has-audio;
    in property <bool> meeting-detail-audio-is-playing;
    in property <[float]> meeting-detail-audio-peaks;
    in property <float> meeting-detail-audio-progress;
    in property <string> meeting-detail-audio-position-label;
    in property <string> meeting-detail-audio-duration-label;
    in property <[TranscriptBlock]> meeting-detail-transcript-blocks;
    in property <int> meeting-detail-transcript-segment-count;
    in property <float> meeting-detail-transcript-spacer-before: 0.0;
    in property <float> meeting-detail-transcript-spacer-after: 0.0;
    // `length`-typed so it can two-way bind all the way down to the real
    // Flickable inside TranscriptSection (see that component's doc comment
    // on `scroll-top`) - internal plumbing only, not read directly by Rust.
    in-out property <length> meeting-detail-transcript-scroll-top: 0px;
    // What `main.rs` actually polls on a timer to decide the next visible
    // slice (AC15): the same value as above, converted to a plain float so
    // Rust doesn't need Slint's internal `length`-wrapping type.
    out property <float> meeting-detail-transcript-scroll-top-px: root.meeting-detail-transcript-scroll-top / 1px;

    callback dictate-requested();
    callback meeting-requested();
    callback filter-changed(TimelineFilter);
    callback search-changed(string);
    callback dismiss-transcription-status();
    callback dismiss-meeting-status();
    callback timeline-item-opened(TimelineKind, string);
    callback timeline-item-removed(TimelineKind, string);
    callback stop-requested();
    callback meeting-detail-back();
    callback meeting-detail-rename(string);
    callback meeting-detail-notes-changed(string);
    callback meeting-detail-audio-play-pause-requested();
    callback meeting-detail-audio-seek-requested(float);
    callback meeting-detail-transcript-paragraph-clicked(int, float);

    // Invoked by `main.rs` (as `invoke_reset_meeting_detail_transcript_scroll`)
    // when a different meeting's transcript loads, so scrolling meeting A
    // down doesn't leave meeting B's transcript scrolled down too - a
    // `public function` rather than a Rust-side property write, since the
    // property below needs `length`, which isn't part of Slint's stable
    // Rust API (see the doc comment on it).
    public function reset-meeting-detail-transcript-scroll() {
        root.meeting-detail-transcript-scroll-top = 0px;
    }

    if root.recording-mode == RecordingMode.idle && root.active-meeting-id == "": IdleView {
        dictation-shortcut: root.dictation-shortcut;
        model-ready: root.model-ready;
        search-query <=> root.search-query;
        kind-filter: root.kind-filter;
        transcription-status-message: root.transcription-status-message;
        meeting-status-message: root.meeting-status-message;
        timeline-groups: root.timeline-groups;
        timeline-is-empty: root.timeline-is-empty;
        timeline-has-matches: root.timeline-has-matches;
        live-meeting-id: root.live-meeting-id;
        dictate-requested => { root.dictate-requested(); }
        meeting-requested => { root.meeting-requested(); }
        filter-changed(kind) => { root.filter-changed(kind); }
        search-changed(query) => { root.search-changed(query); }
        dismiss-transcription-status => { root.dismiss-transcription-status(); }
        dismiss-meeting-status => { root.dismiss-meeting-status(); }
        timeline-item-opened(kind, id) => { root.timeline-item-opened(kind, id); }
        timeline-item-removed(kind, id) => { root.timeline-item-removed(kind, id); }
    }

    if root.recording-mode == RecordingMode.idle && root.active-meeting-id != "": MeetingDetail {
        title: root.meeting-detail-title;
        meta-line: root.meeting-detail-meta;
        model-label: root.meeting-detail-model-label;
        participant-labels: root.meeting-detail-participants;
        notes <=> root.meeting-detail-notes;
        notes-save-state: root.meeting-detail-notes-save-state;
        has-audio: root.meeting-detail-has-audio;
        audio-is-playing: root.meeting-detail-audio-is-playing;
        audio-peaks: root.meeting-detail-audio-peaks;
        audio-progress: root.meeting-detail-audio-progress;
        audio-position-label: root.meeting-detail-audio-position-label;
        audio-duration-label: root.meeting-detail-audio-duration-label;
        transcript-blocks: root.meeting-detail-transcript-blocks;
        transcript-segment-count: root.meeting-detail-transcript-segment-count;
        transcript-spacer-before: root.meeting-detail-transcript-spacer-before;
        transcript-spacer-after: root.meeting-detail-transcript-spacer-after;
        transcript-scroll-top <=> root.meeting-detail-transcript-scroll-top;
        back-requested => { root.meeting-detail-back(); }
        rename-requested(title) => { root.meeting-detail-rename(title); }
        notes-changed(value) => { root.meeting-detail-notes-changed(value); }
        audio-play-pause-requested => { root.meeting-detail-audio-play-pause-requested(); }
        audio-seek-requested(fraction) => { root.meeting-detail-audio-seek-requested(fraction); }
        transcript-paragraph-clicked(session, time) => { root.meeting-detail-transcript-paragraph-clicked(session, time); }
    }

    if root.recording-mode != RecordingMode.idle: RecordingView {
        mode: root.recording-mode;
        live-text: root.live-text;
        live-tentative: root.live-tentative;
        stop-requested => { root.stop-requested(); }
    }
}
