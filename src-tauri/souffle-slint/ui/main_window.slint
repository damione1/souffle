import { IdleView } from "idle_view.slint";
import { RecordingView } from "recording_view.slint";
import { MeetingDetail } from "meeting_detail.slint";
import { SettingsView } from "settings_view.slint";
import { CalendarRow } from "components/settings/calendar_section.slint";
import { MicrophoneRow } from "components/settings/microphone_section.slint";
import { TimelineDayGroup } from "components/timeline_section.slint";
import { TranscriptBlock } from "components/transcript_section.slint";
import { StructuredActionItem } from "components/summary_section.slint";
import { RecordingMode, TimelineFilter, TimelineKind, NotesSaveState } from "types.slint";

export component MainWindow inherits Window {
    title: "Soufflé";
    preferred-width: 720px;
    preferred-height: 780px;

    in property <string> dictation-shortcut;
    in property <bool> model-ready: true;
    in-out property <string> search-query;
    in-out property <TimelineFilter> kind-filter: TimelineFilter.all;
    in property <string> transcription-status-message;
    in property <string> meeting-status-message;
    in property <[TimelineDayGroup]> timeline-groups;
    in property <bool> timeline-is-empty: true;
    in property <bool> timeline-has-matches: true;
    in property <string> live-meeting-id;
    // Rust-driven, set after a real start/stop command succeeds, never
    // optimistically from the UI alone.
    in-out property <RecordingMode> recording-mode: RecordingMode.idle;
    in-out property <string> live-text;
    in-out property <string> live-tentative;

    // Non-empty while a completed meeting is open in MeetingDetail. Empty
    // means "show the Timeline instead" - checked together with
    // recording-mode below so a live meeting always shows RecordingView
    // first, never MeetingDetail underneath it.
    in-out property <string> active-meeting-id;
    in property <string> meeting-detail-title;
    in property <string> meeting-detail-meta;
    in property <string> meeting-detail-model-label;
    in property <[string]> meeting-detail-participants;
    in-out property <string> meeting-detail-notes;
    in property <NotesSaveState> meeting-detail-notes-save-state;
    in property <bool> meeting-detail-has-audio;
    in property <bool> meeting-detail-audio-is-playing;
    in property <[float]> meeting-detail-audio-peaks;
    in property <float> meeting-detail-audio-progress;
    in property <string> meeting-detail-audio-position-label;
    in property <string> meeting-detail-audio-duration-label;
    in property <[TranscriptBlock]> meeting-detail-transcript-blocks;
    in property <int> meeting-detail-transcript-segment-count;
    in property <float> meeting-detail-transcript-spacer-before: 0.0;
    in property <float> meeting-detail-transcript-spacer-after: 0.0;
    // `length`-typed so it can two-way bind all the way down to the real
    // Flickable inside TranscriptSection (see that component's doc comment
    // on `scroll-top`) - internal plumbing only, not read directly by Rust.
    in-out property <length> meeting-detail-transcript-scroll-top: 0px;
    // What `main.rs` actually polls on a timer to decide the next visible
    // slice (AC15): the same value as above, converted to a plain float so
    // Rust doesn't need Slint's internal `length`-wrapping type.
    out property <float> meeting-detail-transcript-scroll-top-px: root.meeting-detail-transcript-scroll-top / 1px;
    in property <string> meeting-detail-summary;
    in property <bool> meeting-detail-summary-is-stale;
    in property <string> meeting-detail-summary-model-label;
    in property <[string]> meeting-detail-summary-key-points;
    in property <[string]> meeting-detail-summary-decisions;
    in property <[StructuredActionItem]> meeting-detail-summary-action-items;
    in property <[string]> meeting-detail-summary-open-questions;

    // SOU-188: Settings overlay. Toggled from IdleView's gear button;
    // `settings-requested` (not a plain property flip) because opening it
    // must first load the real settings from disk (see main.rs) - closing
    // needs no such round trip, so `settings-open` alone is enough there.
    in-out property <bool> settings-open: false;
    in property <bool> settings-autostart-enabled;
    in property <bool> settings-debug-transcription;
    in property <string> settings-log-level;
    in property <string> settings-log-tail;
    in property <bool> settings-copying-diagnostics;
    in property <string> settings-theme;
    in property <string> settings-locale;
    in property <bool> settings-auto-paste;
    in property <string> settings-paste-method;
    in property <int> settings-paste-delay-ms;
    in property <int> settings-paste-delay-min;
    in property <int> settings-paste-delay-max;
    in property <bool> settings-pill-hidden;
    in property <bool> settings-feedback-sounds-enabled;
    in property <int> settings-feedback-sounds-volume;
    in property <string> settings-toggle-shortcut-label;
    in property <string> settings-ptt-shortcut-label;
    in property <bool> settings-native-tap-warning-visible;
    in-out property <string> settings-recording-field: "";
    in-out property <string> settings-shortcut-error: "";
    in property <bool> settings-calendar-enabled;
    in property <string> settings-calendar-permission;
    in property <bool> settings-calendar-autostart-enabled;
    in property <int> settings-calendar-reminder-minutes;
    in property <[CalendarRow]> settings-calendars;
    in property <[string]> settings-audio-device-labels;
    in property <string> settings-selected-device-label;
    in property <bool> settings-pin-unavailable;
    in property <string> settings-sample-rate-label;
    in property <bool> settings-sample-rate-high;
    in property <bool> settings-resetting-sample-rate;
    in property <bool> settings-allow-bluetooth-mic;
    in property <[MicrophoneRow]> settings-microphones;
    in property <bool> settings-has-disconnected-devices;
    in property <bool> settings-is-laptop;
    in property <[string]> settings-clamshell-device-labels;
    in property <string> settings-clamshell-device-label;
    in property <bool> settings-system-audio-supported;
    in property <bool> settings-capture-system-audio;
    in property <string> settings-meeting-transcription-language;
    in property <bool> settings-meeting-autostop-enabled;
    in property <[string]> settings-meeting-autostop-labels;
    in property <string> settings-meeting-autostop-label;
    in property <[string]> settings-meeting-max-duration-labels;
    in property <string> settings-meeting-max-duration-label;
    in property <bool> settings-vad-enabled;
    in property <bool> settings-filler-removal;
    in property <bool> settings-stutter-collapse;
    in property <bool> settings-dictionary-correction;

    callback settings-requested();
    callback settings-closed();
    callback settings-autostart-changed(bool);
    callback settings-permissions-review-requested();
    callback settings-debug-transcription-changed(bool);
    callback settings-log-level-changed(string);
    callback settings-copy-diagnostics-requested();
    callback settings-theme-changed(string);
    callback settings-locale-changed(string);
    callback settings-auto-paste-changed(bool);
    callback settings-paste-method-changed(string);
    callback settings-paste-delay-changed(int);
    callback settings-pill-hidden-changed(bool);
    callback settings-feedback-sounds-enabled-changed(bool);
    callback settings-feedback-sounds-volume-changed(int);
    callback settings-shortcut-record-requested(string);
    callback settings-shortcut-captured(string, string, bool, bool, bool, bool);
    callback settings-shortcut-released(string, string, bool, bool, bool, bool);
    callback settings-shortcut-cleared(string);
    callback settings-shortcut-cancelled();
    callback settings-calendar-enabled-changed(bool);
    callback settings-calendar-autostart-enabled-changed(bool);
    callback settings-calendar-reminder-minutes-changed(int);
    callback settings-calendar-toggled(string);
    callback settings-calendar-open-system-settings-requested();
    callback settings-device-changed(string);
    callback settings-refresh-devices-requested();
    callback settings-reset-devices-requested();
    callback settings-reset-sample-rate-requested();
    callback settings-allow-bluetooth-mic-changed(bool);
    callback settings-move-device-requested(string, int);
    callback settings-toggle-hidden-requested(string, bool);
    callback settings-remove-device-requested(string);
    callback settings-clamshell-device-changed(string);
    callback settings-capture-system-audio-changed(bool);
    callback settings-meeting-transcription-language-changed(string);
    callback settings-meeting-autostop-enabled-changed(bool);
    callback settings-meeting-autostop-changed(string);
    callback settings-meeting-max-duration-changed(string);
    callback settings-vad-enabled-changed(bool);
    callback settings-filler-removal-changed(bool);
    callback settings-stutter-collapse-changed(bool);
    callback settings-dictionary-correction-changed(bool);

    callback dictate-requested();
    callback meeting-requested();
    callback filter-changed(TimelineFilter);
    callback search-changed(string);
    callback dismiss-transcription-status();
    callback dismiss-meeting-status();
    callback timeline-item-opened(TimelineKind, string);
    callback timeline-item-removed(TimelineKind, string);
    callback stop-requested();
    callback meeting-detail-back();
    callback meeting-detail-rename(string);
    callback meeting-detail-notes-changed(string);
    callback meeting-detail-audio-play-pause-requested();
    callback meeting-detail-audio-seek-requested(float);
    callback meeting-detail-transcript-paragraph-clicked(int, float);
    callback meeting-detail-transcript-alias-save-requested(string, string);

    // Invoked by `main.rs` (as `invoke_reset_meeting_detail_transcript_scroll`)
    // when a different meeting's transcript loads, so scrolling meeting A
    // down doesn't leave meeting B's transcript scrolled down too - a
    // `public function` rather than a Rust-side property write, since the
    // property below needs `length`, which isn't part of Slint's stable
    // Rust API (see the doc comment on it).
    public function reset-meeting-detail-transcript-scroll() {
        root.meeting-detail-transcript-scroll-top = 0px;
    }

    if root.recording-mode == RecordingMode.idle && root.active-meeting-id == "": IdleView {
        dictation-shortcut: root.dictation-shortcut;
        model-ready: root.model-ready;
        search-query <=> root.search-query;
        kind-filter: root.kind-filter;
        transcription-status-message: root.transcription-status-message;
        meeting-status-message: root.meeting-status-message;
        timeline-groups: root.timeline-groups;
        timeline-is-empty: root.timeline-is-empty;
        timeline-has-matches: root.timeline-has-matches;
        live-meeting-id: root.live-meeting-id;
        dictate-requested => { root.dictate-requested(); }
        meeting-requested => { root.meeting-requested(); }
        filter-changed(kind) => { root.filter-changed(kind); }
        search-changed(query) => { root.search-changed(query); }
        dismiss-transcription-status => { root.dismiss-transcription-status(); }
        dismiss-meeting-status => { root.dismiss-meeting-status(); }
        timeline-item-opened(kind, id) => { root.timeline-item-opened(kind, id); }
        timeline-item-removed(kind, id) => { root.timeline-item-removed(kind, id); }
        settings-requested => { root.settings-requested(); }
    }

    if root.recording-mode == RecordingMode.idle && root.active-meeting-id != "": MeetingDetail {
        title: root.meeting-detail-title;
        meta-line: root.meeting-detail-meta;
        model-label: root.meeting-detail-model-label;
        participant-labels: root.meeting-detail-participants;
        notes <=> root.meeting-detail-notes;
        notes-save-state: root.meeting-detail-notes-save-state;
        has-audio: root.meeting-detail-has-audio;
        audio-is-playing: root.meeting-detail-audio-is-playing;
        audio-peaks: root.meeting-detail-audio-peaks;
        audio-progress: root.meeting-detail-audio-progress;
        audio-position-label: root.meeting-detail-audio-position-label;
        audio-duration-label: root.meeting-detail-audio-duration-label;
        transcript-blocks: root.meeting-detail-transcript-blocks;
        transcript-segment-count: root.meeting-detail-transcript-segment-count;
        transcript-spacer-before: root.meeting-detail-transcript-spacer-before;
        transcript-spacer-after: root.meeting-detail-transcript-spacer-after;
        transcript-scroll-top <=> root.meeting-detail-transcript-scroll-top;
        summary: root.meeting-detail-summary;
        summary-is-stale: root.meeting-detail-summary-is-stale;
        summary-model-label: root.meeting-detail-summary-model-label;
        summary-key-points: root.meeting-detail-summary-key-points;
        summary-decisions: root.meeting-detail-summary-decisions;
        summary-action-items: root.meeting-detail-summary-action-items;
        summary-open-questions: root.meeting-detail-summary-open-questions;
        back-requested => { root.meeting-detail-back(); }
        rename-requested(title) => { root.meeting-detail-rename(title); }
        notes-changed(value) => { root.meeting-detail-notes-changed(value); }
        audio-play-pause-requested => { root.meeting-detail-audio-play-pause-requested(); }
        audio-seek-requested(fraction) => { root.meeting-detail-audio-seek-requested(fraction); }
        transcript-paragraph-clicked(session, time) => { root.meeting-detail-transcript-paragraph-clicked(session, time); }
        transcript-alias-save-requested(term, pronunciation) => { root.meeting-detail-transcript-alias-save-requested(term, pronunciation); }
    }

    if root.recording-mode != RecordingMode.idle: RecordingView {
        mode: root.recording-mode;
        live-text: root.live-text;
        live-tentative: root.live-tentative;
        stop-requested => { root.stop-requested(); }
    }

    // Drawn last so it overlays whatever is behind it, mirroring App.svelte
    // hiding HomeView under the Settings overlay rather than replacing it.
    if root.settings-open: SettingsView {
        width: 100%;
        height: 100%;
        autostart-enabled: root.settings-autostart-enabled;
        debug-transcription: root.settings-debug-transcription;
        log-level: root.settings-log-level;
        log-tail: root.settings-log-tail;
        copying-diagnostics: root.settings-copying-diagnostics;
        theme: root.settings-theme;
        locale: root.settings-locale;
        auto-paste: root.settings-auto-paste;
        paste-method: root.settings-paste-method;
        paste-delay-ms: root.settings-paste-delay-ms;
        paste-delay-min: root.settings-paste-delay-min;
        paste-delay-max: root.settings-paste-delay-max;
        pill-hidden: root.settings-pill-hidden;
        feedback-sounds-enabled: root.settings-feedback-sounds-enabled;
        feedback-sounds-volume: root.settings-feedback-sounds-volume;
        toggle-shortcut-label: root.settings-toggle-shortcut-label;
        ptt-shortcut-label: root.settings-ptt-shortcut-label;
        native-tap-warning-visible: root.settings-native-tap-warning-visible;
        recording-field <=> root.settings-recording-field;
        shortcut-error <=> root.settings-shortcut-error;
        calendar-enabled: root.settings-calendar-enabled;
        calendar-permission: root.settings-calendar-permission;
        calendar-autostart-enabled: root.settings-calendar-autostart-enabled;
        calendar-reminder-minutes: root.settings-calendar-reminder-minutes;
        calendars: root.settings-calendars;
        audio-device-labels: root.settings-audio-device-labels;
        selected-device-label: root.settings-selected-device-label;
        pin-unavailable: root.settings-pin-unavailable;
        sample-rate-label: root.settings-sample-rate-label;
        sample-rate-high: root.settings-sample-rate-high;
        resetting-sample-rate: root.settings-resetting-sample-rate;
        allow-bluetooth-mic: root.settings-allow-bluetooth-mic;
        microphones: root.settings-microphones;
        has-disconnected-devices: root.settings-has-disconnected-devices;
        is-laptop: root.settings-is-laptop;
        clamshell-device-labels: root.settings-clamshell-device-labels;
        clamshell-device-label: root.settings-clamshell-device-label;
        system-audio-supported: root.settings-system-audio-supported;
        capture-system-audio: root.settings-capture-system-audio;
        meeting-transcription-language: root.settings-meeting-transcription-language;
        meeting-autostop-enabled: root.settings-meeting-autostop-enabled;
        meeting-autostop-labels: root.settings-meeting-autostop-labels;
        meeting-autostop-label: root.settings-meeting-autostop-label;
        meeting-max-duration-labels: root.settings-meeting-max-duration-labels;
        meeting-max-duration-label: root.settings-meeting-max-duration-label;
        vad-enabled: root.settings-vad-enabled;
        filler-removal: root.settings-filler-removal;
        stutter-collapse: root.settings-stutter-collapse;
        dictionary-correction: root.settings-dictionary-correction;
        close-requested => {
            root.settings-open = false;
            root.settings-closed();
        }
        autostart-changed(value) => { root.settings-autostart-changed(value); }
        permissions-review-requested => { root.settings-permissions-review-requested(); }
        debug-transcription-changed(value) => { root.settings-debug-transcription-changed(value); }
        log-level-changed(value) => { root.settings-log-level-changed(value); }
        copy-diagnostics-requested => { root.settings-copy-diagnostics-requested(); }
        theme-changed(value) => { root.settings-theme-changed(value); }
        locale-changed(value) => { root.settings-locale-changed(value); }
        auto-paste-changed(value) => { root.settings-auto-paste-changed(value); }
        paste-method-changed(value) => { root.settings-paste-method-changed(value); }
        paste-delay-changed(value) => { root.settings-paste-delay-changed(value); }
        pill-hidden-changed(value) => { root.settings-pill-hidden-changed(value); }
        feedback-sounds-enabled-changed(value) => { root.settings-feedback-sounds-enabled-changed(value); }
        feedback-sounds-volume-changed(value) => { root.settings-feedback-sounds-volume-changed(value); }
        shortcut-record-requested(field) => { root.settings-shortcut-record-requested(field); }
        shortcut-captured(field, text, ctrl, shift, alt, meta) => { root.settings-shortcut-captured(field, text, ctrl, shift, alt, meta); }
        shortcut-released(field, text, ctrl, shift, alt, meta) => { root.settings-shortcut-released(field, text, ctrl, shift, alt, meta); }
        shortcut-cleared(field) => { root.settings-shortcut-cleared(field); }
        shortcut-cancelled => { root.settings-shortcut-cancelled(); }
        calendar-enabled-changed(value) => { root.settings-calendar-enabled-changed(value); }
        calendar-autostart-enabled-changed(value) => { root.settings-calendar-autostart-enabled-changed(value); }
        calendar-reminder-minutes-changed(value) => { root.settings-calendar-reminder-minutes-changed(value); }
        calendar-toggled(id) => { root.settings-calendar-toggled(id); }
        calendar-open-system-settings-requested => { root.settings-calendar-open-system-settings-requested(); }
        device-changed(value) => { root.settings-device-changed(value); }
        refresh-devices-requested => { root.settings-refresh-devices-requested(); }
        reset-devices-requested => { root.settings-reset-devices-requested(); }
        reset-sample-rate-requested => { root.settings-reset-sample-rate-requested(); }
        allow-bluetooth-mic-changed(value) => { root.settings-allow-bluetooth-mic-changed(value); }
        move-device-requested(uid, direction) => { root.settings-move-device-requested(uid, direction); }
        toggle-hidden-requested(uid, hidden) => { root.settings-toggle-hidden-requested(uid, hidden); }
        remove-device-requested(uid) => { root.settings-remove-device-requested(uid); }
        clamshell-device-changed(value) => { root.settings-clamshell-device-changed(value); }
        capture-system-audio-changed(value) => { root.settings-capture-system-audio-changed(value); }
        meeting-transcription-language-changed(value) => { root.settings-meeting-transcription-language-changed(value); }
        meeting-autostop-enabled-changed(value) => { root.settings-meeting-autostop-enabled-changed(value); }
        meeting-autostop-changed(value) => { root.settings-meeting-autostop-changed(value); }
        meeting-max-duration-changed(value) => { root.settings-meeting-max-duration-changed(value); }
        vad-enabled-changed(value) => { root.settings-vad-enabled-changed(value); }
        filler-removal-changed(value) => { root.settings-filler-removal-changed(value); }
        stutter-collapse-changed(value) => { root.settings-stutter-collapse-changed(value); }
        dictionary-correction-changed(value) => { root.settings-dictionary-correction-changed(value); }
    }
}
