import { AutostartSection } from "components/settings/autostart_section.slint";
import { PermissionsSection } from "components/settings/permissions_section.slint";
import { DiagnosticsSection } from "components/settings/diagnostics_section.slint";
import { InterfaceSection } from "components/settings/interface_section.slint";
import { FeedbackSoundsSection } from "components/settings/feedback_sounds_section.slint";
import { CalendarSection, CalendarRow } from "components/settings/calendar_section.slint";
import { MicrophoneSection, MicrophoneRow } from "components/settings/microphone_section.slint";
import { AudioSection } from "components/settings/audio_section.slint";
import { DataSection } from "components/settings/data_section.slint";
import { AboutSection } from "components/settings/about_section.slint";
import { IntelligenceSection } from "components/settings/intelligence_section.slint";
import { DictationPolishSection } from "components/settings/dictation_polish_section.slint";
import { SummaryTemplatesSection } from "components/settings/summary_templates_section.slint";
import { ModelSection } from "components/settings/model_section.slint";
import { DictionarySection, DictionaryRow } from "components/settings/dictionary_section.slint";
import { SnippetsSection, SnippetRow } from "components/settings/snippets_section.slint";
import { Theme } from "theme.slint";
import { LucideIcon, IconSet } from "components/lucide_icon.slint";
import { SettingsTabBar, SettingsTabPage } from "components/settings/settings_tabs.slint";
import { AppTheme, AppLocale, PasteMethod, MeetingLanguage, LogLevel, AudioRetention, AccessState, ShortcutField, SummaryProvider, SettingsTab } from "types.slint";

// Port of components/SettingsView.svelte's tab shell (SOU-188). Svelte
// groups its 17 sections into 6 tabs (Transcription / IA / Audio / Interface
// / Réunions / Système); this mirrors that same grouping one-for-one so the
// two stay comparable file-for-file. Only the tabs whose sections are
// actually wired below are present - see the ticket journal for which
// milestone added which tab. `TabWidget` does not support conditional
// (`if`/`for`) tabs (a compiler-enforced restriction), so tabs are added
// directly in this source as each is implemented, not hidden behind a flag.
export component SettingsView inherits Rectangle {
    in-out property <SettingsTab> tab: SettingsTab.transcription;
    in property <bool> autostart-enabled;
    in property <bool> debug-transcription;
    in property <LogLevel> log-level;
    in property <string> log-tail;
    in property <bool> copying-diagnostics: false;
    in property <AppTheme> theme;
    in property <AppLocale> locale;
    in property <bool> auto-paste;
    in property <PasteMethod> paste-method;
    in property <int> paste-delay-ms;
    in property <int> paste-delay-min;
    in property <int> paste-delay-max;
    in property <bool> pill-hidden;
    in property <bool> feedback-sounds-enabled;
    in property <int> feedback-sounds-volume;
    in property <string> toggle-shortcut-label;
    in property <string> ptt-shortcut-label;
    in property <bool> native-tap-warning-visible;
    in property <ShortcutField> recording-field: ShortcutField.none;
    in-out property <string> shortcut-error: "";
    in property <string> save-error;
    in property <string> draft-save-error;
    in property <bool> calendar-enabled;
    in property <AccessState> calendar-permission;
    in property <bool> calendar-autostart-enabled;
    in property <int> calendar-reminder-minutes;
    in property <[CalendarRow]> calendars;
    in property <[string]> audio-device-labels;
    in property <string> selected-device-label;
    in property <bool> pin-unavailable;
    in property <string> sample-rate-label;
    in property <bool> sample-rate-high;
    in property <bool> resetting-sample-rate;
    in property <bool> allow-bluetooth-mic;
    in property <[MicrophoneRow]> microphones;
    in property <bool> has-disconnected-devices;
    in property <bool> is-laptop;
    in property <[string]> clamshell-device-labels;
    in property <string> clamshell-device-label;
    in property <bool> system-audio-supported;
    in property <bool> capture-system-audio;
    in property <MeetingLanguage> meeting-transcription-language;
    in property <bool> meeting-autostop-enabled;
    in property <[string]> meeting-autostop-labels;
    in property <string> meeting-autostop-label;
    in property <[string]> meeting-max-duration-labels;
    in property <string> meeting-max-duration-label;
    in property <bool> vad-enabled;
    in property <bool> filler-removal;
    in property <bool> stutter-collapse;
    in property <bool> dictionary-correction;
    in property <string> data-stats-line;
    in property <string> data-recordings-line;
    in property <AudioRetention> meeting-audio-retention;
    in property <bool> data-exporting;
    in property <string> data-export-status;
    in property <bool> data-export-status-is-error;
    in property <string> mcp-binary-path;
    in property <bool> mcp-exists;
    in property <string> mcp-claude-desktop-snippet;
    in property <string> mcp-claude-code-command;
    in property <bool> testing-mcp;
    in property <string> mcp-test-status;
    in property <string> app-version;
    in property <string> about-transcription-label;
    in property <string> about-summary-label;
    in property <bool> auto-update-check;
    in property <bool> checking-updates;
    in property <string> update-status;
    in property <SummaryProvider> summary-provider;
    in property <bool> apple-intelligence-available;
    in property <string> apple-intelligence-reason;
    in property <string> ollama-url;
    in property <bool> ollama-available;
    in property <bool> ollama-checking;
    in property <int> summary-model-count;
    in property <bool> summary-model-picker-visible;
    in property <[string]> summary-model-ids;
    in property <[string]> summary-model-labels;
    in property <string> selected-summary-model-label;
    in property <bool> show-ollama-setup;
    in property <bool> ollama-pulling;
    in property <string> ollama-pull-status;
    in property <string> ollama-pull-error;
    in property <string> recommended-ollama-model;
    in property <string> summary-refresh-error;
    in property <string> summary-unusable-message;
    in property <bool> dictation-polish-enabled;
    in property <bool> dictation-polish-provider-available;
    in property <[string]> dictation-polish-template-ids;
    in property <[string]> dictation-polish-template-labels;
    in property <string> active-dictation-polish-label;
    in-out property <string> active-dictation-polish-prompt;
    in property <[string]> summary-template-ids;
    in property <[string]> summary-template-labels;
    in property <string> default-summary-template-label;
    in property <string> editing-summary-template-label;
    in property <bool> editing-summary-template-is-builtin;
    in-out property <string> editing-summary-template-name;
    in-out property <string> editing-summary-template-prompt;
    in-out property <string> new-summary-template-draft: "";
    in property <string> model-status-text;
    in property <bool> model-ready;
    in property <[string]> model-labels;
    in property <string> selected-model-label;
    in property <bool> model-busy;
    in property <bool> model-downloading;
    in property <string> model-download-progress-label;
    in property <float> model-download-progress-fraction;
    in property <[string]> unload-timeout-labels;
    in property <string> unload-timeout-label;
    in property <string> model-error-message;
    in property <bool> dictation-learn-from-edit;
    in property <[DictionaryRow]> dictionary-entries;
    in property <string> dictionary-add-error;
    in property <int> dictionary-delete-error-id;
    in property <string> dictionary-delete-error;
    in property <[SnippetRow]> snippets;
    in property <string> snippet-add-error;
    in property <int> snippet-delete-error-id;
    in property <string> snippet-delete-error;
    in property <string> snippet-update-error;
    in-out property <string> new-dictionary-term-draft: "";
    in-out property <string> new-dictionary-pronunciation-draft: "";
    in-out property <string> new-dictionary-category-draft: "";
    in-out property <string> new-snippet-trigger-draft: "";
    in-out property <string> new-snippet-expansion-draft: "";
    in-out property <string> edit-snippet-trigger-draft: "";
    in-out property <string> edit-snippet-expansion-draft: "";

    callback close-requested();
    callback autostart-changed(bool);
    callback permissions-review-requested();
    callback debug-transcription-changed(bool);
    callback log-level-changed(LogLevel);
    callback copy-diagnostics-requested();
    callback theme-changed(AppTheme);
    callback locale-changed(AppLocale);
    callback auto-paste-changed(bool);
    callback paste-method-changed(PasteMethod);
    callback paste-delay-changed(int);
    callback pill-hidden-changed(bool);
    callback feedback-sounds-enabled-changed(bool);
    callback feedback-sounds-volume-changed(int);
    callback shortcut-record-requested(ShortcutField);
    callback shortcut-captured(ShortcutField, string, bool, bool, bool, bool);
    callback shortcut-released(ShortcutField, string, bool, bool, bool, bool);
    callback shortcut-cleared(ShortcutField);
    callback shortcut-cancelled();
    callback calendar-enabled-changed(bool);
    callback calendar-autostart-enabled-changed(bool);
    callback calendar-reminder-minutes-changed(int);
    callback calendar-toggled(string);
    callback calendar-open-system-settings-requested();
    callback device-changed(string);
    callback refresh-devices-requested();
    callback reset-devices-requested();
    callback reset-sample-rate-requested();
    callback allow-bluetooth-mic-changed(bool);
    callback move-device-requested(string, int);
    callback toggle-hidden-requested(string, bool);
    callback remove-device-requested(string);
    callback clamshell-device-changed(string);
    callback capture-system-audio-changed(bool);
    callback meeting-transcription-language-changed(MeetingLanguage);
    callback meeting-autostop-enabled-changed(bool);
    callback meeting-autostop-changed(string);
    callback meeting-max-duration-changed(string);
    callback vad-enabled-changed(bool);
    callback filler-removal-changed(bool);
    callback stutter-collapse-changed(bool);
    callback dictionary-correction-changed(bool);
    callback meeting-audio-retention-changed(AudioRetention);
    callback data-export-requested();
    callback data-reveal-requested();
    callback mcp-copy-desktop-snippet-requested();
    callback mcp-copy-code-command-requested();
    callback mcp-test-requested();
    callback check-updates-requested();
    callback auto-update-check-changed(bool);
    callback summary-provider-changed(SummaryProvider);
    callback ollama-url-changed(string);
    callback ollama-model-changed(string);
    callback summary-providers-retry-requested();
    callback download-recommended-ollama-model-requested();
    callback open-apple-intelligence-settings-requested();
    callback dictation-polish-enabled-changed(bool);
    callback dictation-polish-template-changed(string);
    callback dictation-polish-prompt-changed(string);
    callback summary-template-default-changed(string);
    callback summary-template-edit-target-changed(string);
    callback summary-template-delete-requested();
    callback summary-template-name-changed(string);
    callback summary-template-prompt-changed(string);
    callback summary-template-add-requested(string);
    callback model-changed(string);
    callback unload-timeout-changed(string);
    callback dictation-learn-from-edit-changed(bool);
    callback dictionary-add-requested(string, string, string);
    callback dictionary-delete-requested(int);
    callback snippet-add-requested(string, string);
    callback snippet-delete-requested(int);
    callback snippet-edit-requested(int);
    callback snippet-cancel-edit-requested();
    callback snippet-save-edit-requested(int, string, string);

    // Opaque on purpose: this overlays IdleView/MeetingDetail rather than
    // replacing them (mirrors App.svelte hiding HomeView behind Settings
    // instead of unmounting it), so without a solid background both would
    // paint into the same window at once.
    background: Theme.canvas;

    // The settings tree overlays a kept-alive HomeView. Painting an opaque
    // Rectangle doesn't consume input, so empty pixels used to click through.
    TouchArea { }

    VerticalLayout {
        padding-left: 26px;
        padding-right: 26px;
        padding-top: 18px;
        padding-bottom: 12px;
        spacing: 16px;

        done := Rectangle {
            height: 32px;
            width: 16px + 6px + done-label.width + 20px;
            border-radius: 4px;
            border-width: done-focus.has-focus ? 2px : 0px;
            border-color: Theme.accent;
            background: done-area.pressed ? Theme.surface-3 : done-area.has-hover ? Theme.surface-2 : transparent;
            vertical-stretch: 0;

            accessible-role: button;
            accessible-label: "Fermer les paramètres";
            accessible-action-default => { root.close-requested(); }

            forward-focus: done-focus;

            done-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space || event.text == Key.Escape {
                        root.close-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            LucideIcon {
                icon: IconSet.ArrowLeft;
                icon-color: done-area.has-hover ? Theme.text-primary : Theme.text-muted;
                size: 16px;
                x: 10px;
                y: (parent.height - self.height) / 2;
            }
            done-label := Text {
                x: 32px;
                y: (parent.height - self.height) / 2;
                text: "Terminé";
                font-size: 13px;
                color: done-area.has-hover ? Theme.text-primary : Theme.text-muted;
            }
            done-area := TouchArea {
                clicked => {
                    done-focus.focus();
                    root.close-requested();
                }
            }
        }

        Text {
            text: "Paramètres";
            font-size: 20px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-stretch: 0;
        }

        if root.save-error != "" && root.draft-save-error == "": Text {
            text: @tr("Enregistrement des réglages : {}", root.save-error);
            color: Theme.danger;
            wrap: word-wrap;
            vertical-stretch: 0;
        }

        if root.draft-save-error != "": Text {
            text: @tr("Brouillon conservé : {}", root.draft-save-error);
            color: Theme.danger;
            wrap: word-wrap;
            vertical-stretch: 0;
        }

        HorizontalLayout {
            alignment: start;
            vertical-stretch: 0;
            SettingsTabBar {
                current <=> root.tab;
            }
        }

        Rectangle {
            vertical-stretch: 1;

                    trans-page := SettingsTabPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.tab == SettingsTab.transcription;

                        ModelSection {
                            status-text: root.model-status-text;
                            ready: root.model-ready;
                            model-labels: root.model-labels;
                            selected-model-label: root.selected-model-label;
                            busy: root.model-busy;
                            downloading: root.model-downloading;
                            download-progress-label: root.model-download-progress-label;
                            download-progress-fraction: root.model-download-progress-fraction;
                            unload-timeout-labels: root.unload-timeout-labels;
                            unload-timeout-label: root.unload-timeout-label;
                            error-message: root.model-error-message;
                            model-changed(value) => { root.model-changed(value); }
                            unload-timeout-changed(value) => { root.unload-timeout-changed(value); }
                        }

                        DictionarySection {
                            learn-from-edit: root.dictation-learn-from-edit;
                            entries: root.dictionary-entries;
                            new-term-draft <=> root.new-dictionary-term-draft;
                            new-pronunciation-draft <=> root.new-dictionary-pronunciation-draft;
                            new-category-draft <=> root.new-dictionary-category-draft;
                            add-error: root.dictionary-add-error;
                            delete-error-id: root.dictionary-delete-error-id;
                            delete-error: root.dictionary-delete-error;
                            learn-from-edit-changed(value) => { root.dictation-learn-from-edit-changed(value); }
                            add-requested(term, pronunciation, category) => { root.dictionary-add-requested(term, pronunciation, category); }
                            delete-requested(id) => { root.dictionary-delete-requested(id); }
                        }

                        SnippetsSection {
                            entries: root.snippets;
                            new-trigger-draft <=> root.new-snippet-trigger-draft;
                            new-expansion-draft <=> root.new-snippet-expansion-draft;
                            add-error: root.snippet-add-error;
                            delete-error-id: root.snippet-delete-error-id;
                            delete-error: root.snippet-delete-error;
                            edit-trigger-draft <=> root.edit-snippet-trigger-draft;
                            edit-expansion-draft <=> root.edit-snippet-expansion-draft;
                            update-error: root.snippet-update-error;
                            add-requested(trigger, expansion) => { root.snippet-add-requested(trigger, expansion); }
                            delete-requested(id) => { root.snippet-delete-requested(id); }
                            edit-requested(id) => { root.snippet-edit-requested(id); }
                            cancel-edit-requested => { root.snippet-cancel-edit-requested(); }
                            save-edit-requested(id, trigger, expansion) => { root.snippet-save-edit-requested(id, trigger, expansion); }
                        }
                }

                    ai-page := SettingsTabPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.tab == SettingsTab.ai;

                        IntelligenceSection {
                            summary-provider: root.summary-provider;
                            apple-intelligence-available: root.apple-intelligence-available;
                            apple-intelligence-reason: root.apple-intelligence-reason;
                            ollama-url: root.ollama-url;
                            ollama-available: root.ollama-available;
                            ollama-checking: root.ollama-checking;
                            summary-model-count: root.summary-model-count;
                            model-picker-visible: root.summary-model-picker-visible;
                            model-ids: root.summary-model-ids;
                            model-labels: root.summary-model-labels;
                            selected-model-label: root.selected-summary-model-label;
                            show-ollama-setup: root.show-ollama-setup;
                            ollama-pulling: root.ollama-pulling;
                            ollama-pull-status: root.ollama-pull-status;
                            ollama-pull-error: root.ollama-pull-error;
                            recommended-model: root.recommended-ollama-model;
                            refresh-error: root.summary-refresh-error;
                            unusable-message: root.summary-unusable-message;
                            summary-provider-changed(value) => { root.summary-provider-changed(value); }
                            ollama-url-changed(value) => { root.ollama-url-changed(value); }
                            ollama-model-changed(value) => { root.ollama-model-changed(value); }
                            retry-requested => { root.summary-providers-retry-requested(); }
                            download-recommended-requested => { root.download-recommended-ollama-model-requested(); }
                            open-apple-intelligence-settings-requested => { root.open-apple-intelligence-settings-requested(); }
                        }

                        DictationPolishSection {
                            enabled: root.dictation-polish-enabled;
                            provider-available: root.dictation-polish-provider-available;
                            template-ids: root.dictation-polish-template-ids;
                            template-labels: root.dictation-polish-template-labels;
                            active-template-label: root.active-dictation-polish-label;
                            active-prompt <=> root.active-dictation-polish-prompt;
                            enabled-changed(value) => { root.dictation-polish-enabled-changed(value); }
                            template-changed(value) => { root.dictation-polish-template-changed(value); }
                            prompt-changed(value) => { root.dictation-polish-prompt-changed(value); }
                            open-provider-settings-requested => { root.open-apple-intelligence-settings-requested(); }
                        }

                        SummaryTemplatesSection {
                            template-ids: root.summary-template-ids;
                            template-labels: root.summary-template-labels;
                            default-template-label: root.default-summary-template-label;
                            editing-template-label: root.editing-summary-template-label;
                            editing-is-builtin: root.editing-summary-template-is-builtin;
                            editing-name <=> root.editing-summary-template-name;
                            editing-prompt <=> root.editing-summary-template-prompt;
                            new-template-draft <=> root.new-summary-template-draft;
                            default-changed(value) => { root.summary-template-default-changed(value); }
                            edit-target-changed(value) => { root.summary-template-edit-target-changed(value); }
                            delete-requested => { root.summary-template-delete-requested(); }
                            name-changed(value) => { root.summary-template-name-changed(value); }
                            prompt-changed(value) => { root.summary-template-prompt-changed(value); }
                            add-requested(name) => { root.summary-template-add-requested(name); }
                        }
                }

                    audio-page := SettingsTabPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.tab == SettingsTab.audio;

                        MicrophoneSection {
                            device-labels: root.audio-device-labels;
                            selected-device-label: root.selected-device-label;
                            pin-unavailable: root.pin-unavailable;
                            sample-rate-label: root.sample-rate-label;
                            sample-rate-high: root.sample-rate-high;
                            resetting-sample-rate: root.resetting-sample-rate;
                            allow-bluetooth-mic: root.allow-bluetooth-mic;
                            microphones: root.microphones;
                            has-disconnected: root.has-disconnected-devices;
                            device-changed(value) => { root.device-changed(value); }
                            refresh-requested => { root.refresh-devices-requested(); }
                            reset-devices-requested => { root.reset-devices-requested(); }
                            reset-sample-rate-requested => { root.reset-sample-rate-requested(); }
                            allow-bluetooth-mic-changed(value) => { root.allow-bluetooth-mic-changed(value); }
                            move-device-requested(uid, direction) => { root.move-device-requested(uid, direction); }
                            toggle-hidden-requested(uid, hidden) => { root.toggle-hidden-requested(uid, hidden); }
                            remove-device-requested(uid) => { root.remove-device-requested(uid); }
                        }

                        AudioSection {
                            is-laptop: root.is-laptop;
                            clamshell-device-labels: root.clamshell-device-labels;
                            clamshell-device-label: root.clamshell-device-label;
                            system-audio-supported: root.system-audio-supported;
                            capture-system-audio: root.capture-system-audio;
                            meeting-transcription-language: root.meeting-transcription-language;
                            meeting-autostop-enabled: root.meeting-autostop-enabled;
                            meeting-autostop-labels: root.meeting-autostop-labels;
                            meeting-autostop-label: root.meeting-autostop-label;
                            meeting-max-duration-labels: root.meeting-max-duration-labels;
                            meeting-max-duration-label: root.meeting-max-duration-label;
                            vad-enabled: root.vad-enabled;
                            filler-removal: root.filler-removal;
                            stutter-collapse: root.stutter-collapse;
                            dictionary-correction: root.dictionary-correction;
                            clamshell-device-changed(value) => { root.clamshell-device-changed(value); }
                            capture-system-audio-changed(value) => { root.capture-system-audio-changed(value); }
                            meeting-transcription-language-changed(value) => { root.meeting-transcription-language-changed(value); }
                            meeting-autostop-enabled-changed(value) => { root.meeting-autostop-enabled-changed(value); }
                            meeting-autostop-changed(value) => { root.meeting-autostop-changed(value); }
                            meeting-max-duration-changed(value) => { root.meeting-max-duration-changed(value); }
                            vad-enabled-changed(value) => { root.vad-enabled-changed(value); }
                            filler-removal-changed(value) => { root.filler-removal-changed(value); }
                            stutter-collapse-changed(value) => { root.stutter-collapse-changed(value); }
                            dictionary-correction-changed(value) => { root.dictionary-correction-changed(value); }
                        }
                }

                    interface-page := SettingsTabPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.tab == SettingsTab.interface;

                        InterfaceSection {
                            theme: root.theme;
                            locale: root.locale;
                            auto-paste: root.auto-paste;
                            paste-method: root.paste-method;
                            paste-delay-ms: root.paste-delay-ms;
                            paste-delay-min: root.paste-delay-min;
                            paste-delay-max: root.paste-delay-max;
                            toggle-shortcut-label: root.toggle-shortcut-label;
                            ptt-shortcut-label: root.ptt-shortcut-label;
                            recording-field: root.recording-field;
                            shortcut-error: root.shortcut-error;
                            native-tap-warning-visible: root.native-tap-warning-visible;
                            pill-hidden: root.pill-hidden;
                            theme-changed(value) => { root.theme-changed(value); }
                            locale-changed(value) => { root.locale-changed(value); }
                            auto-paste-changed(value) => { root.auto-paste-changed(value); }
                            paste-method-changed(value) => { root.paste-method-changed(value); }
                            paste-delay-changed(value) => { root.paste-delay-changed(value); }
                            pill-hidden-changed(value) => { root.pill-hidden-changed(value); }
                            shortcut-record-requested(field) => { root.shortcut-record-requested(field); }
                            shortcut-captured(field, text, ctrl, shift, alt, meta) => { root.shortcut-captured(field, text, ctrl, shift, alt, meta); }
                            shortcut-released(field, text, ctrl, shift, alt, meta) => { root.shortcut-released(field, text, ctrl, shift, alt, meta); }
                            shortcut-cleared(field) => { root.shortcut-cleared(field); }
                            shortcut-cancelled => { root.shortcut-cancelled(); }
                            permissions-review-requested => { root.permissions-review-requested(); }
                        }

                        FeedbackSoundsSection {
                            enabled: root.feedback-sounds-enabled;
                            volume: root.feedback-sounds-volume;
                            enabled-changed(value) => { root.feedback-sounds-enabled-changed(value); }
                            volume-changed(value) => { root.feedback-sounds-volume-changed(value); }
                        }
                }

                    meetings-page := SettingsTabPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.tab == SettingsTab.meetings;

                        CalendarSection {
                            enabled: root.calendar-enabled;
                            permission: root.calendar-permission;
                            autostart-enabled: root.calendar-autostart-enabled;
                            reminder-minutes: root.calendar-reminder-minutes;
                            calendars: root.calendars;
                            enabled-changed(value) => { root.calendar-enabled-changed(value); }
                            autostart-enabled-changed(value) => { root.calendar-autostart-enabled-changed(value); }
                            reminder-minutes-changed(value) => { root.calendar-reminder-minutes-changed(value); }
                            calendar-toggled(id) => { root.calendar-toggled(id); }
                            open-system-settings-requested => { root.calendar-open-system-settings-requested(); }
                        }
                }

                    system-page := SettingsTabPage {
                    width: parent.width;
                    height: parent.height;
                    active: root.tab == SettingsTab.system;

                        AutostartSection {
                            autostart-enabled: root.autostart-enabled;
                            autostart-changed(value) => { root.autostart-changed(value); }
                        }

                        PermissionsSection {
                            review-requested => { root.permissions-review-requested(); }
                        }

                        DiagnosticsSection {
                            debug-transcription: root.debug-transcription;
                            log-level: root.log-level;
                            log-tail: root.log-tail;
                            copying-diagnostics: root.copying-diagnostics;
                            debug-transcription-changed(value) => { root.debug-transcription-changed(value); }
                            log-level-changed(value) => { root.log-level-changed(value); }
                            copy-diagnostics-requested => { root.copy-diagnostics-requested(); }
                        }

                        DataSection {
                            stats-line: root.data-stats-line;
                            recordings-line: root.data-recordings-line;
                            retention: root.meeting-audio-retention;
                            exporting: root.data-exporting;
                            export-status: root.data-export-status;
                            export-status-is-error: root.data-export-status-is-error;
                            mcp-binary-path: root.mcp-binary-path;
                            mcp-exists: root.mcp-exists;
                            mcp-claude-desktop-snippet: root.mcp-claude-desktop-snippet;
                            mcp-claude-code-command: root.mcp-claude-code-command;
                            testing-mcp: root.testing-mcp;
                            mcp-test-status: root.mcp-test-status;
                            retention-changed(value) => { root.meeting-audio-retention-changed(value); }
                            export-requested => { root.data-export-requested(); }
                            reveal-requested => { root.data-reveal-requested(); }
                            copy-desktop-snippet-requested => { root.mcp-copy-desktop-snippet-requested(); }
                            copy-code-command-requested => { root.mcp-copy-code-command-requested(); }
                            test-mcp-requested => { root.mcp-test-requested(); }
                        }

                        AboutSection {
                            app-version: root.app-version;
                            transcription-label: root.about-transcription-label;
                            summary-label: root.about-summary-label;
                            auto-update-check: root.auto-update-check;
                            checking-updates: root.checking-updates;
                            update-status: root.update-status;
                            check-updates-requested => { root.check-updates-requested(); }
                            auto-update-check-changed(value) => { root.auto-update-check-changed(value); }
                        }
                    }
                }
    }
}
