export global Theme {
    in-out property <bool> is-dark: false;
    out property <color> background: is-dark ? #1e1e1e : #ffffff;
    out property <color> text: is-dark ? #ffffff : #000000;
    out property <color> primary: #007bff;
    out property <color> draft-text: is-dark ? #aaaaaa : #666666;
    out property <color> surface: is-dark ? #2d2d2d : #f5f5f5;
    out property <color> border: is-dark ? #444444 : #e0e0e0;
}
