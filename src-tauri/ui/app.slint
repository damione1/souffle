import { Theme } from "theme.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { SettingsView } from "settings.slint";
import { TimelineView, MeetingDetailView, MeetingInfo, Paragraph } from "timeline.slint";
import { OnboardingView, WhatsNewDialog, UpdateAvailableDialog, PermissionStatus } from "onboarding.slint";

export { Paragraph, MeetingInfo, PermissionStatus }

component IdleView inherits VerticalBox {
    callback start-dictation();
    callback start-meeting();

    HorizontalBox {
        alignment: center;
        Button { text: "Dicter"; clicked => { root.start-dictation(); } }
        Button { text: "Réunion"; clicked => { root.start-meeting(); } }
    }
    
    LineEdit { placeholder-text: "Recherche..."; }
    
    HorizontalBox {
        Text { text: "Filtres: Tout | Récents | Favoris"; color: Theme.text; }
    }
    
    ScrollView {
        VerticalBox {
            Text { text: "Historique récent..."; color: Theme.text; }
            Text { text: "- Réunion 1"; color: Theme.text; }
            Text { text: "- Dictée 1"; color: Theme.text; }
        }
    }
}

component LiveViewDictation inherits VerticalBox {
    in property <string> final-text: "";
    in property <string> draft-text: "";
    
    Text { text: "Mode Dictée"; font-size: 20px; font-weight: 700; color: Theme.text; }
    
    ScrollView {
        HorizontalBox {
            alignment: start;
            Text {
                text: final-text;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: draft-text + " |";
                color: Theme.draft-text;
                wrap: word-wrap;
            }
        }
    }
}

component LiveViewMeeting inherits VerticalBox {
    in property <[Paragraph]> paragraphs: [];
    callback toggle-edit(int);
    
    Text { text: "Mode Réunion"; font-size: 20px; font-weight: 700; color: Theme.text; }
    
    ScrollView {
        VerticalBox {
            for p[i] in paragraphs : Rectangle {
                background: Theme.surface;
                border-radius: 4px;
                VerticalBox {
                    padding: 10px;
                    Text { text: p.speaker; color: Theme.primary; font-weight: 700; }
                    if !p.is-editing : TouchArea {
                        clicked => { root.toggle-edit(i); }
                        Text {
                            text: p.text;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                    if p.is-editing : TextEdit {
                        text: p.text;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Soufflé Slint Spike";
    width: 800px;
    height: 600px;
    background: Theme.background;
    no-frame: true; // Chrome macOS AC6

    in-out property <bool> is-dark <=> Theme.is-dark;
    in-out property <string> current-view: "idle"; // idle, dictation, meeting
    
    // Dictation state
    in property <string> dict-final-text: "";
    in property <string> dict-draft-text: "";
    
    // Meeting state
    in-out property <[Paragraph]> meeting-paragraphs: [];
    in-out property <[MeetingInfo]> timeline-meetings: [];
    in-out property <MeetingInfo> current-meeting;
    in property <string> summary-raw: "";
    in property <string> summary-structured: "";
    
    callback start-dictation();
    callback start-meeting();
    callback open-settings();
    callback open-timeline();
    callback open-meeting-detail(string);
    callback cancel-edit();
    callback toggle-theme();
    callback drag-window();
    callback toggle-paragraph-edit(int);
    callback download-model();
    callback delete-model();

    // Onboarding and updates
    in-out property <int> onboarding-step: 0;
    in property <[PermissionStatus]> permissions: [];
    in property <string> changelog-text: "# What's New";
    in property <float> update-progress: 0.0;
    in property <bool> update-downloading: false;
    in property <bool> update-ready: false;
    
    callback request-permission(string);
    callback finish-onboarding();
    callback close-whats-new();
    callback start-update();
    callback install-and-restart();
    callback close-update();

    // Chrome drag area
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if event.text == "," && event.modifiers.meta { // Cmd+, on macOS
                root.open-settings();
                return accept;
            }
            if event.text == Key.Escape {
                root.cancel-edit();
                return accept;
            }
            return reject;
        }
        
        VerticalBox {
            // Header for dragging
            TouchArea {
                height: 30px;
                width: 100%;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.drag-window();
                    }
                }
                Text { text: "Soufflé (Drag me)"; color: Theme.text; horizontal-alignment: center; }
            }
            
            HorizontalBox {
                Button { text: "Toggle Theme"; clicked => { root.toggle-theme(); } }
                Button { text: "Timeline"; clicked => { root.open-timeline(); } }
                Button { text: "Back to Home"; clicked => { root.current-view = "idle"; } }
            }

            if current-view == "idle" : IdleView {
                start-dictation => { root.start-dictation(); }
                start-meeting => { root.start-meeting(); }
            }
            
            if current-view == "dictation" : LiveViewDictation {
                final-text: root.dict-final-text;
                draft-text: root.dict-draft-text;
            }
            
            if current-view == "meeting" : LiveViewMeeting {
                paragraphs: root.meeting-paragraphs;
                toggle-edit(idx) => { root.toggle-paragraph-edit(idx); }
            }
            
            if current-view == "settings" : SettingsView {
                close-settings => { root.current-view = "idle"; }
                download-model => { root.download-model(); }
                delete-model => { root.delete-model(); }
            }
            
            if current-view == "timeline" : TimelineView {
                meetings: root.timeline-meetings;
                open-meeting(id) => { root.open-meeting-detail(id); }
            }
            
            if current-view == "meeting-detail" : MeetingDetailView {
                meeting: root.current-meeting;
                paragraphs: root.meeting-paragraphs;
                summary-raw: root.summary-raw;
                summary-structured: root.summary-structured;
                toggle-edit(idx) => { root.toggle-paragraph-edit(idx); }
                back => { root.open-timeline(); }
            }
            
            if current-view == "onboarding" : OnboardingView {
                step: root.onboarding-step;
                permissions: root.permissions;
                request-permission(name) => { root.request-permission(name); }
                finish-onboarding => { root.finish-onboarding(); }
            }
            
            if current-view == "whats-new" : WhatsNewDialog {
                changelog: root.changelog-text;
                close => { root.close-whats-new(); }
            }
            
            if current-view == "update-available" : UpdateAvailableDialog {
                download-progress: root.update-progress;
                downloading: root.update-downloading;
                ready-to-install: root.update-ready;
                start-update => { root.start-update(); }
                install-and-restart => { root.install-and-restart(); }
                close => { root.close-update(); }
            }
        }
    }
}


